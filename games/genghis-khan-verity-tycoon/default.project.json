{
  "name": "GenghisKhanVerityTycoon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "ServerStorage": {
      "VerityFallback": {
        "$path": "src/world/VerityFallback.model.json"
      },
      "VerityBall": {
        "$path": "src/world/VerityBall.model.json"
      }
    },
    "Players": {
      "$properties": {
        "MaxPlayers": 6,
        "RespawnTime": 4
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "ShadowSoftness": 0.15,
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 1
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    },
    "Workspace": {
      "Terrain": {
        "$properties": {
          "Decoration": true,
          "GrassLength": 1
        }
      }
    }
  }
