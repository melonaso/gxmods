<Item class="ModuleScript" referent="RBX00000003"><Properties>
<string name="Name">Net</string>
<string name="Source"><![CDATA[--!strict
-- Envoltorio de remotes. El servidor los crea; el cliente los espera.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(script.Parent.Remotes)

local Net = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
	end
	for _, name in Remotes do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

local function get(name: Remotes.RemoteName): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.fireClient(player: Player, name: Remotes.RemoteName, ...: any)
	get(name):FireClient(player, ...)
end

function Net.fireAll(name: Remotes.RemoteName, ...: any)
	get(name):FireAllClients(...)
end

function Net.fireServer(name: Remotes.RemoteName, ...: any)
	get(name):FireServer(...)
end

function Net.onServer(name: Remotes.RemoteName, handler: (Player, ...any) -> ()): RBXScriptConnection
	return get(name).OnServerEvent:Connect(handler)
end

function Net.onClient(name: Remotes.RemoteName, handler: (...any) -> ()): RBXScriptConnection
	return get(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000004"><Properties>
<string name="Name">Remotes</string>
<string name="Source"><![CDATA[--!strict
-- Lista unica de remotes. Agregar uno = agregar una linea aqui.
-- Notify: servidor -> cliente. ThroatSing: cliente -> servidor, sin datos
-- (el servidor valida cooldown y que el jugador este vivo).
-- FinalJoin: cliente -> servidor, sin datos (solo vale durante la convocatoria).
-- Rebirth: cliente -> servidor, sin datos (solo si el jugador tiene CanRebirth).
-- Las compras van por Touched y los ataques por Tool.Activated.
export type RemoteName = "Notify" | "ThroatSing" | "FinalJoin" | "Rebirth"

local NAMES: { RemoteName } = { "Notify", "ThroatSing", "FinalJoin", "Rebirth" }

return NAMES
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties>
<string name="Name">Types</string>
<string name="Source"><![CDATA[--!strict
-- Tipos compartidos entre servidor y cliente.

export type Profile = {
	Gold: number,
	Owned: { [string]: boolean },
	VerityKills: number,
	Rebirths: number,
}

export type ButtonKind = "Dropper" | "Weapon" | "Multiplier" | "Shelter" | "Decor" | "Wall" | "Floor"

export type ButtonDef = {
	Id: string,
	Name: string,
	Cost: number,
	Kind: ButtonKind,
	Requires: string?,
	Floor: number?, -- 1 (planta baja, por defecto) o 2 (segundo piso)
	-- Dropper
	Slot: number?,
	Value: number?,
	Interval: number?,
	OreColor: Color3?,
	-- Weapon
	WeaponId: string?,
	-- Multiplier
	Multiplier: number?,
	-- Wall
	WallHP: number?,
	WallHeight: number?,
	WallColor: Color3?,
	WallMaterial: Enum.Material?,
}

export type WeaponDef = {
	DisplayName: string,
	Damage: number,
	Range: number,
	Cooldown: number,
	Ranged: boolean,
}

export type NotifyKind = "info" | "warning" | "danger" | "reward"

export type VerityPhase = "Waiting" | "Active" | "Fleeing" | "Final"

return nil
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties>
<string name="Name">VerityPose</string>
<string name="Source"><![CDATA[--!strict
-- Línea de tiempo del ataque "levantar y aplastar" y medidas del rig de
-- Verity. Funciona con cualquier modelo: VerityModel (servidor) mide el rig
-- al prepararlo y guarda las medidas como atributos del modelo; el cliente
-- anima con ellas y el servidor calcula dónde están las manos para mover a
-- la víctima, sin depender de la red.

local Pose = {}

export type RigData = {
	rootY: number, -- altura del centro de HumanoidRootPart sobre los pies
	hipHeight: number,
	crouchDrop: number,
	crouchAngle: number,
	waist: Vector3, -- pivotes en espacio del modelo (pies en el origen, mirando a -Z)
	shoulder: Vector3,
	elbow: Vector3,
	grip: Vector3,
	hasWaist: boolean,
	hasArms: boolean,
}

Pose.KillGrab = 0.45 -- la víctima termina de llegar a las manos
Pose.KillImpact = 1.75 -- golpe contra el suelo
Pose.KillDuration = 2.4

local rad = math.rad
-- tiempo, hombro (adelante +), codo, cintura (adelante -)
local KEYS = {
	{ 0.00, 0, 0, 0 },
	{ 0.35, rad(60), rad(25), rad(-32) }, -- se inclina y alcanza
	{ 0.45, rad(60), rad(25), rad(-32) },
	{ 1.30, rad(168), rad(12), rad(8) }, -- levanta sobre la cabeza
	{ 1.55, rad(176), rad(18), rad(12) }, -- tensa antes del golpe
	{ 1.75, rad(48), rad(0), rad(-38) }, -- aplasta
	{ 2.40, 0, 0, 0 },
}

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

-- Devuelve (hombro, codo, cintura) en radianes para el instante t.
function Pose.killAngles(t: number): (number, number, number)
	if t <= 0 then
		return 0, 0, 0
	end
	for i = 1, #KEYS - 1 do
		local a, b = KEYS[i], KEYS[i + 1]
		if t <= b[1] then
			local alpha = smooth((t - a[1]) / (b[1] - a[1]))
			return a[2] + (b[2] - a[2]) * alpha, a[3] + (b[3] - a[3]) * alpha, a[4] + (b[4] - a[4]) * alpha
		end
	end
	return 0, 0, 0
end

-- Lee las medidas que VerityModel guardó en el modelo.
function Pose.read(model: Instance): RigData
	local function v(name: string, default: Vector3): Vector3
		local value = model:GetAttribute(name)
		return if typeof(value) == "Vector3" then value else default
	end
	local function n(name: string, default: number): number
		local value = model:GetAttribute(name)
		return if typeof(value) == "number" then value else default
	end
	local height = n("RigHeight", 16)
	return {
		rootY = n("RootY", height * 0.5),
		hipHeight = n("HipHeightStand", height * 0.42),
		crouchDrop = n("CrouchDrop", height * 0.2),
		crouchAngle = n("CrouchAngle", math.rad(60)),
		waist = v("PivotWaist", Vector3.new(0, height * 0.5, 0)),
		shoulder = v("PivotShoulder", Vector3.new(0, height * 0.72, 0)),
		elbow = v("PivotElbow", Vector3.new(0, height * 0.5, 0)),
		grip = v("PivotGrip", Vector3.new(0, height * 0.25, 0)),
		hasWaist = model:GetAttribute("HasWaist") == true,
		hasArms = model:GetAttribute("HasArms") == true,
	}
end

-- Punto medio entre las dos manos, en espacio del modelo, en el instante t.
function Pose.gripLocal(t: number, rig: RigData): Vector3
	local shoulder, elbow, waist = Pose.killAngles(t)
	if not rig.hasArms then
		-- modelo sin brazos articulados: la víctima "flota" siguiendo la curva
		local lift = math.sin(math.clamp(shoulder / rad(176), 0, 1) * math.pi * 0.5)
		return Vector3.new(0, rig.shoulder.Y * (0.55 + 0.6 * lift), -rig.shoulder.Y * 0.35 * (1 - lift * 0.6))
	end
	if not rig.hasWaist then
		waist = 0
	end
	local upper = CFrame.Angles(shoulder, 0, 0)
	local elbowPos = rig.shoulder + upper:VectorToWorldSpace(rig.elbow - rig.shoulder)
	local grip = elbowPos + (upper * CFrame.Angles(elbow, 0, 0)):VectorToWorldSpace(rig.grip - rig.elbow)
	grip = rig.waist + CFrame.Angles(waist, 0, 0):VectorToWorldSpace(grip - rig.waist)
	return Vector3.new(0, grip.Y, grip.Z)
end

return Pose
]]></string>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000018"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX00000017"><Properties>
<string name="Name">Server</string>
<string name="Source"><![CDATA[--!strict
-- Unico punto de entrada del servidor. Arranque en dos fases:
-- init() de todos los sistemas primero, luego start() de todos.
-- Cada sistema arranca protegido: si uno falla, se avisa en Output y los
-- demas siguen funcionando (antes un error cortaba todo el arranque).
local Systems = script.Systems

local loaded: { [string]: any } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			loaded[child.Name] = result
		else
			warn("[Server] no se pudo cargar " .. child.Name .. ": " .. tostring(result))
		end
	end
end

for name, system in loaded do
	if typeof(system.init) == "function" then
		local ok, err = pcall(system.init)
		if not ok then
			warn("[Server] " .. name .. ".init fallo: " .. tostring(err))
		end
	end
end

for name, system in loaded do
	if typeof(system.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(system.start)
			if not ok then
				warn("[Server] " .. name .. ".start fallo: " .. tostring(err))
			end
		end)
	end
end
]]></string>
</Properties>
<Item class="Folder" referent="RBX0000000E"><Properties>
<string name="Name">Lib</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000009"><Properties>
<string name="Name">Build</string>
<string name="Source"><![CDATA[--!strict
-- Ayudas para construir el mapa con Parts (sin assets externos).
local PhysicsService = game:GetService("PhysicsService")

local Build = {}

-- Verity atraviesa paredes y vallas: solo choca con el suelo.
Build.GROUND_GROUP = "Ground"
Build.VERITY_GROUP = "VerityGhost"
Build.WALL_GROUP = "VerityWall" -- murallas: frenan a Verity, los jugadores pasan
Build.SOLID_GROUP = "Solid" -- refugios: nadie los atraviesa, ni Verity
local groupsReady = false
function Build.ensureGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	for _, name in { Build.GROUND_GROUP, Build.VERITY_GROUP, Build.WALL_GROUP, Build.SOLID_GROUP } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(Build.VERITY_GROUP, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(Build.VERITY_GROUP, Build.VERITY_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(Build.VERITY_GROUP, Build.GROUND_GROUP, true)
	PhysicsService:CollisionGroupSetCollidable(Build.WALL_GROUP, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(Build.WALL_GROUP, Build.VERITY_GROUP, true)
	PhysicsService:CollisionGroupSetCollidable(Build.SOLID_GROUP, Build.VERITY_GROUP, true)
end

-- Todas las piezas del modelo pasan a ser solidas tambien para Verity.
function Build.markSolid(model: Instance)
	Build.ensureGroups()
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.CollisionGroup = Build.SOLID_GROUP
		end
	end
end

function Build.markGround(part: BasePart)
	Build.ensureGroups()
	part.CollisionGroup = Build.GROUND_GROUP
end

export type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3?,
	Material: Enum.Material?,
	Parent: Instance?,
	Anchored: boolean?,
	CanCollide: boolean?,
	Transparency: number?,
	Shape: Enum.PartType?,
}

function Build.part(props: PartProps): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "Part"
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color or Color3.fromRGB(163, 162, 165)
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Anchored = if props.Anchored == nil then true else props.Anchored
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Transparency = props.Transparency or 0
	if props.Shape then
		p.Shape = props.Shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.Parent
	return p
end

function Build.billboard(adornee: BasePart, text: string, offsetY: number, width: number?): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width or 200, 50)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	gui.Adornee = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = text
	label.Parent = gui

	gui.Parent = adornee
	return label
end

-- Zona invisible donde Verity no puede ver al jugador.
-- ownerUserId = nil -> refugio publico.
function Build.hidingZone(parent: Instance, cf: CFrame, size: Vector3, ownerUserId: number?): Part
	local zone = Build.part({
		Name = "HidingZone",
		Size = size,
		CFrame = cf,
		Parent = parent,
		CanCollide = false,
		Transparency = 1,
	})
	zone.CanQuery = false
	zone.CanTouch = false
	if ownerUserId then
		zone:SetAttribute("OwnerUserId", ownerUserId)
	end
	return zone
end

-- Choza rectangular con puerta en el lado local -Z.
function Build.boxShelter(parent: Instance, cf: CFrame, w: number, d: number, h: number, color: Color3, material: Enum.Material): Model
	local model = Instance.new("Model")
	model.Name = "Shelter"
	local t = 1.5
	local door = 6
	local function wall(size: Vector3, offset: Vector3)
		Build.part({ Name = "Wall", Size = size, CFrame = cf * CFrame.new(offset), Color = color, Material = material, Parent = model })
	end
	wall(Vector3.new(w, h, t), Vector3.new(0, h / 2, d / 2)) -- fondo
	wall(Vector3.new(t, h, d), Vector3.new(-w / 2, h / 2, 0)) -- izquierda
	wall(Vector3.new(t, h, d), Vector3.new(w / 2, h / 2, 0)) -- derecha
	local side = (w - door) / 2
	wall(Vector3.new(side, h, t), Vector3.new(-(door / 2 + side / 2), h / 2, -d / 2))
	wall(Vector3.new(side, h, t), Vector3.new(door / 2 + side / 2, h / 2, -d / 2))
	wall(Vector3.new(door, h - 7, t), Vector3.new(0, h - (h - 7) / 2, -d / 2)) -- dintel
	wall(Vector3.new(w + t, t, d + t), Vector3.new(0, h + t / 2, 0)) -- techo
	model.Parent = parent
	return model
end

-- Yurta redonda hecha de segmentos, con la puerta en el lado local -Z.
function Build.yurt(parent: Instance, cf: CFrame, radius: number, height: number): Model
	local model = Instance.new("Model")
	model.Name = "Yurt"
	local segments = 16
	local felt = Color3.fromRGB(235, 225, 200)
	local segWidth = 2 * math.pi * radius / segments + 0.3
	for i = 0, segments - 1 do
		local angle = (i + 0.5) / segments * 2 * math.pi
		-- angulo 0 apunta a -Z (la puerta): dejamos libre el segmento 0 y el ultimo
		if i ~= 0 and i ~= segments - 1 then
			local dir = Vector3.new(math.sin(angle), 0, -math.cos(angle))
			local pos = dir * radius + Vector3.new(0, height / 2, 0)
			local segCf = cf * CFrame.lookAt(pos, Vector3.new(0, height / 2, 0))
			Build.part({ Name = "Felt", Size = Vector3.new(segWidth, height, 1), CFrame = segCf, Color = felt, Material = Enum.Material.Fabric, Parent = model })
		end
	end
	-- techo conico: discos (cilindros acostados) cada vez mas chicos
	local upright = CFrame.Angles(0, 0, math.pi / 2) -- el eje del cilindro es X; lo ponemos vertical
	local tiers = { 1.1, 0.75, 0.45 }
	for i, scale in tiers do
		local r = (radius + 1) * scale
		Build.part({
			Name = "Roof",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, r * 2, r * 2),
			CFrame = cf * CFrame.new(0, height + (i - 0.5) * 1.2, 0) * upright,
			Color = felt,
			Material = Enum.Material.Fabric,
			Parent = model,
		})
	end
	Build.part({
		Name = "Crown",
		Size = Vector3.new(3, 1, 3),
		CFrame = cf * CFrame.new(0, height + #tiers * 1.2 + 0.5, 0),
		Color = Color3.fromRGB(170, 30, 30),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	-- marco de puerta
	Build.part({
		Name = "Door",
		Size = Vector3.new(6, 1, 1.2),
		CFrame = cf * CFrame.new(0, 7.5, -radius),
		Color = Color3.fromRGB(170, 30, 30),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	model.Parent = parent
	return model
end

return Build
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties>
<string name="Name">Horse</string>
<string name="Source"><![CDATA[--!strict
-- Caballo mongol para la batalla final. Es decorativo y va soldado al
-- jinete: el jugador se mueve como siempre (WASD), pero mas rapido y mas
-- alto (HipHeight). Las patas tienen Motor6D para que Controllers/HorseAnimator
-- las haga galopar y ponga al jinete con las piernas abiertas (montado).
-- Espacio del jinete: -Z = hacia delante, +Y = arriba. Solo avatares R15.
local Build = require(script.Parent.Build)

local Horse = {}

local BROWN = Color3.fromRGB(115, 72, 40)
local DARK = Color3.fromRGB(35, 25, 18)
local RED = Color3.fromRGB(160, 30, 30)
local BODY_Y = -2.3 -- centro del cuerpo respecto a HumanoidRootPart
local LEG_LEN = 3.1
-- la pezuna toca el suelo: raiz a (|BODY_Y| + 1.2 + LEG_LEN) studs del suelo
local ROOT_HEIGHT = -BODY_Y + 1.2 + LEG_LEN

local LEGS = {
	{ name = "LegFL", x = -0.75, z = -2.5 },
	{ name = "LegFR", x = 0.75, z = -2.5 },
	{ name = "LegBL", x = -0.75, z = 2.6 },
	{ name = "LegBR", x = 0.75, z = 2.6 },
}

function Horse.isMounted(character: Model): boolean
	return character:FindFirstChild("Horse") ~= nil
end

-- Construye el caballo alrededor de "base" (la posicion de la raiz del jinete).
-- Devuelve el modelo y el cuerpo (a donde se suelda todo lo demas).
local function buildHorse(base: CFrame, coat: Color3?): (Model, Part)
	local horse = Instance.new("Model")
	horse.Name = "Horse"
	local brown = coat or BROWN

	local function part(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
		local p = Build.part({ Name = name, Size = size, CFrame = base * offset, Color = color, Material = material or Enum.Material.SmoothPlastic, Anchored = false, CanCollide = false })
		p.Massless = true
		p.CanQuery = false
		p.CanTouch = false
		p.Parent = horse
		return p
	end
	local function weldTo(p0: BasePart, p1: BasePart)
		local w = Instance.new("WeldConstraint")
		w.Part0 = p0
		w.Part1 = p1
		w.Parent = p1
	end

	local body = part("Body", Vector3.new(2.4, 2.4, 6.4), CFrame.new(0, BODY_Y, 0.3), brown)

	-- cuello, cabeza, orejas, crin, cola, montura
	weldTo(body, part("Neck", Vector3.new(1.2, 3.2, 1.5), CFrame.new(0, BODY_Y + 1.4, -3.2) * CFrame.Angles(math.rad(-35), 0, 0), brown))
	weldTo(body, part("Mane", Vector3.new(0.35, 3, 0.7), CFrame.new(0, BODY_Y + 1.7, -2.8) * CFrame.Angles(math.rad(-35), 0, 0), DARK))
	weldTo(body, part("Head", Vector3.new(1.1, 1.2, 2.6), CFrame.new(0, BODY_Y + 2.6, -4.6) * CFrame.Angles(math.rad(-25), 0, 0), brown))
	weldTo(body, part("Muzzle", Vector3.new(1, 1, 0.6), CFrame.new(0, BODY_Y + 2.05, -5.85) * CFrame.Angles(math.rad(-25), 0, 0), DARK))
	weldTo(body, part("EarL", Vector3.new(0.25, 0.6, 0.25), CFrame.new(-0.35, BODY_Y + 3.4, -4.0), brown))
	weldTo(body, part("EarR", Vector3.new(0.25, 0.6, 0.25), CFrame.new(0.35, BODY_Y + 3.4, -4.0), brown))
	weldTo(body, part("Tail", Vector3.new(0.45, 2.8, 0.45), CFrame.new(0, BODY_Y - 0.4, 3.9) * CFrame.Angles(math.rad(30), 0, 0), DARK))
	weldTo(body, part("Saddle", Vector3.new(2.6, 0.45, 2.4), CFrame.new(0, BODY_Y + 1.3, 0.1), RED, Enum.Material.Fabric))
	weldTo(body, part("Blanket", Vector3.new(2.65, 1.2, 2.2), CFrame.new(0, BODY_Y + 0.6, 0.1), Color3.fromRGB(30, 70, 140), Enum.Material.Fabric))

	-- patas articuladas (Motor6D en la cadera del caballo)
	for _, leg in LEGS do
		local hip = CFrame.new(leg.x, -1.2, leg.z) -- borde de abajo del cuerpo
		local legPart = part(leg.name, Vector3.new(0.6, LEG_LEN, 0.6), CFrame.new(0, BODY_Y, 0.3) * hip * CFrame.new(0, -LEG_LEN / 2, 0), brown)
		local motor = Instance.new("Motor6D")
		motor.Name = leg.name
		motor.Part0 = body
		motor.Part1 = legPart
		motor.C0 = hip
		motor.C1 = CFrame.new(0, LEG_LEN / 2, 0)
		motor.Parent = legPart
		weldTo(legPart, part("Hoof", Vector3.new(0.7, 0.4, 0.7), CFrame.new(0, BODY_Y, 0.3) * hip * CFrame.new(0, -LEG_LEN + 0.1, 0), DARK))
	end

	return horse, body
end

function Horse.mount(character: Model, speed: number)
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not (root and root:IsA("BasePart") and humanoid) or Horse.isMounted(character) then
		return
	end
	local horse, body = buildHorse(root.CFrame)
	local mount = Instance.new("Weld")
	mount.Name = "MountWeld"
	mount.Part0 = root
	mount.Part1 = body
	mount.C0 = CFrame.new(0, BODY_Y, 0.3)
	mount.Parent = body
	horse.Parent = character
	character:SetAttribute("BaseHipHeight", humanoid.HipHeight)
	character:SetAttribute("BaseWalkSpeed", humanoid.WalkSpeed)
	humanoid.HipHeight = ROOT_HEIGHT - root.Size.Y / 2
	humanoid.WalkSpeed = speed
	character:SetAttribute("Mounted", true)
end

-- Caballo salvaje decorativo, de pie en "ground" (posicion en el suelo) mirando a yaw.
function Horse.statue(ground: Vector3, yaw: number, coat: Color3, parent: Instance): Model
	local base = CFrame.new(ground + Vector3.new(0, ROOT_HEIGHT, 0)) * CFrame.Angles(0, yaw, 0)
	local horse = buildHorse(base, coat)
	for _, name in { "Saddle", "Blanket" } do -- salvaje: sin montura
		local p = horse:FindFirstChild(name)
		if p then
			p:Destroy()
		end
	end
	for _, inst in horse:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.Anchored = true
		end
	end
	horse.Name = "WildHorse"
	horse.Parent = parent
	return horse
end

function Horse.dismount(character: Model)
	local horse = character:FindFirstChild("Horse")
	if horse then
		horse:Destroy()
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.HipHeight = (character:GetAttribute("BaseHipHeight") :: number?) or humanoid.HipHeight
		humanoid.WalkSpeed = (character:GetAttribute("BaseWalkSpeed") :: number?) or 16
	end
	character:SetAttribute("Mounted", nil)
end

return Horse
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties>
<string name="Name">Sfx</string>
<string name="Source"><![CDATA[--!strict
-- Efectos de sonido creados en el servidor (los oyen todos).
-- Con parent = una pieza, el sonido es 3D; con parent = workspace, es global.
-- Cada sonido va a un SoundGroup de SoundService:
--   "Effects" (por defecto): se ensordece mientras suena el canto de garganta
--   "Song": el canto mismo, que nunca se ensordece
-- (Controllers/SoundDuck hace el ensordecido en cada cliente.)
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local Sfx = {}

export type Options = {
	Volume: number?,
	Speed: number?,
	MinDistance: number?,
	MaxDistance: number?,
	Lifetime: number?,
	Group: string?,
}

function Sfx.group(name: string): SoundGroup
	local existing = SoundService:FindFirstChild(name)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local g = Instance.new("SoundGroup")
	g.Name = name
	g.Parent = SoundService
	return g
end

function Sfx.play(id: string | number, parent: Instance, options: Options?): Sound?
	if id == 0 or id == "" then
		return nil
	end
	local o: Options = options or {}
	local sound = Instance.new("Sound")
	sound.SoundId = if typeof(id) == "number" then "rbxassetid://" .. id else id
	sound.Volume = o.Volume or 1
	sound.PlaybackSpeed = o.Speed or 1
	sound.RollOffMinDistance = o.MinDistance or 10
	sound.RollOffMaxDistance = o.MaxDistance or 150
	sound.SoundGroup = Sfx.group(o.Group or "Effects")
	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, o.Lifetime or 10)
	return sound
end

return Sfx
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties>
<string name="Name">VerityModel</string>
<string name="Source"><![CDATA[--!strict
-- Tomado del proyecto "Survive A Verity" (rama claude/keen-galileo-at0rx6),
-- sin el sistema de skins.
-- Prepara el modelo de Verity a partir de cualquier fuente:
--   1. ServerStorage.VerityCharacter  (importado del Toolbox por el usuario)
--   2. InsertService:LoadAsset(Config.Verity.AssetId)
--   3. ServerStorage.VerityFallback   (modelo de respaldo hecho con piezas)
--
-- "Preparar" significa: quitar scripts (los modelos gratis pueden traer
-- virus), asegurar Humanoid y HumanoidRootPart, soldar piezas sueltas,
-- escalar a Config.Verity.Height, medir hombros/codos/manos para la
-- animación del ataque y añadir el punto de agarre para los objetos.

local CollectionService = game:GetService("CollectionService")
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Pose = require(ReplicatedStorage.Shared.VerityPose)
local VerityRig = require(script.Parent.Parent.Lib.VerityRig)

local VerityModel = {}

local template: Model? = nil
local sourceName = "ninguna"

local NAMES = {
	waist = { "Waist" },
	rightShoulder = { "RightShoulder", "Right Shoulder" },
	leftShoulder = { "LeftShoulder", "Left Shoulder" },
	rightElbow = { "RightElbow" },
	leftElbow = { "LeftElbow" },
	rightHip = { "RightHip", "Right Hip" },
	rightKnee = { "RightKnee" },
	rightAnkle = { "RightAnkle" },
}
local HAND_PARTS = { "RightHand", "Right Arm", "RightLowerArm" }
local REMOVE_CLASSES = { "BaseScript", "ModuleScript", "HumanoidDescription", "Tool", "ForceField", "ProximityPrompt", "ClickDetector", "Sound" }
local SCALE_VALUES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale", "BodyProportionScale", "BodyTypeScale" }

local function findMotor(model: Model, names: { string }): Motor6D?
	for _, inst in model:GetDescendants() do
		if inst:IsA("Motor6D") and table.find(names, inst.Name) then
			return inst
		end
	end
	return nil
end

local function verticalExtent(part: BasePart): number
	local cf, half = part.CFrame, part.Size / 2
	return math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z
end

-- Altura más baja y más alta de las piezas (sin contar la raíz).
local function verticalBounds(model: Model, root: BasePart): (number, number)
	local low, high = math.huge, -math.huge
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and inst ~= root then
			local e = verticalExtent(inst)
			low = math.min(low, inst.Position.Y - e)
			high = math.max(high, inst.Position.Y + e)
		end
	end
	if low == math.huge then
		low, high = root.Position.Y - root.Size.Y / 2, root.Position.Y + root.Size.Y / 2
	end
	return low, high
end

-- Suelda a la raíz toda pieza que no esté conectada a ella por uniones.
local function weldLoose(model: Model, root: BasePart)
	local links: { [BasePart]: { BasePart } } = {}
	local function link(a: Instance?, b: Instance?)
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			links[a] = links[a] or {}
			links[b] = links[b] or {}
			table.insert(links[a], b)
			table.insert(links[b], a)
		end
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("JointInstance") then
			link(inst.Part0, inst.Part1)
		elseif inst:IsA("WeldConstraint") then
			link(inst.Part0, inst.Part1)
		end
	end
	local seen: { [BasePart]: boolean } = { [root] = true }
	local queue = { root }
	while #queue > 0 do
		local current = table.remove(queue) :: BasePart
		for _, other in links[current] or {} do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and not seen[inst] then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = inst
			weld.Parent = inst
		end
	end
end

local function prepare(source: Instance): Model?
	local model: Model
	if source:IsA("Model") then
		model = source:Clone()
	else
		local wrapper = Instance.new("Model")
		source:Clone().Parent = wrapper
		model = wrapper
	end
	-- Si el Humanoid está en un submodelo, ese submodelo es el personaje.
	local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
	if humanoid and humanoid.Parent ~= model and humanoid.Parent and humanoid.Parent:IsA("Model") then
		local inner = humanoid.Parent :: Model
		inner.Parent = nil
		model:Destroy()
		model = inner
	end

	-- Seguridad: fuera scripts y cosas que no deben venir con el modelo.
	for _, inst in model:GetDescendants() do
		for _, class in REMOVE_CLASSES do
			if inst:IsA(class) then
				inst:Destroy()
				break
			end
		end
	end

	if model:GetAttribute("VerityRig") and not model:FindFirstChildWhichIsA("Motor6D", true) then
		VerityRig.assemble(model)
	end

	local hasParts = false
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") then
			hasParts = true
			inst.Anchored = false
		end
	end
	if not hasParts then
		model:Destroy()
		return nil
	end

	humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		humanoid = Instance.new("Humanoid")
		humanoid.Parent = model
	end
	local hum = humanoid :: Humanoid
	for _, name in SCALE_VALUES do
		local value = hum:FindFirstChild(name)
		if value then
			value:Destroy()
		end
	end

	local rootInstance = model:FindFirstChild("HumanoidRootPart")
	local root: BasePart
	if rootInstance and rootInstance:IsA("BasePart") then
		root = rootInstance
	else
		local cf, size = model:GetBoundingBox()
		local newRoot = Instance.new("Part")
		newRoot.Name = "HumanoidRootPart"
		newRoot.Size = Vector3.new(math.max(2, size.X * 0.35), math.max(2, size.Y * 0.15), math.max(1, size.Z * 0.35))
		newRoot.CFrame = CFrame.new(cf.Position)
		newRoot.Parent = model
		root = newRoot
	end
	model.PrimaryPart = root
	weldLoose(model, root)

	-- Escala a la altura deseada.
	local low, high = verticalBounds(model, root)
	if high - low > 0.1 then
		model:ScaleTo(model:GetScale() * Config.Verity.Height / (high - low))
	end
	low, high = verticalBounds(model, root)
	local height = high - low

	-- Física: solo la raíz colisiona y tiene masa.
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") then
			local isRoot = inst == root
			inst.CanCollide = isRoot
			inst.Massless = not isRoot
			inst.CanTouch = true
			if isRoot then
				inst.Transparency = 1
			end
		end
	end

	-- Medidas del rig en espacio del modelo (pies en el origen, mirando a -Z).
	local origin = CFrame.new(root.Position.X, low, root.Position.Z) * root.CFrame.Rotation
	local function local_(p: Vector3): Vector3
		return origin:PointToObjectSpace(p)
	end
	local function pivot(motor: Motor6D): Vector3
		return local_(((motor.Part0 :: BasePart).CFrame * motor.C0).Position)
	end
	local function centered(a: Vector3?, b: Vector3?): Vector3?
		if a and b then
			local m = (a + b) / 2
			return Vector3.new(0, m.Y, m.Z)
		end
		local only = a or b
		return if only then Vector3.new(0, only.Y, only.Z) else nil
	end

	local rootY = root.Position.Y - low
	local hipHeight = math.max(0, root.Position.Y - root.Size.Y / 2 - low)
	model:SetAttribute("RigHeight", height)
	model:SetAttribute("RootY", rootY)
	model:SetAttribute("HipHeightStand", hipHeight)

	local rs, ls = findMotor(model, NAMES.rightShoulder), findMotor(model, NAMES.leftShoulder)
	local re, le = findMotor(model, NAMES.rightElbow), findMotor(model, NAMES.leftElbow)
	local handPart: BasePart? = nil
	for _, name in HAND_PARTS do
		local found = model:FindFirstChild(name, true)
		if found and found:IsA("BasePart") then
			handPart = found
			break
		end
	end
	local shoulder = centered(rs and pivot(rs), ls and pivot(ls))
	if shoulder and handPart then
		local grip = local_(handPart.Position - Vector3.new(0, verticalExtent(handPart) * 0.6, 0))
		grip = Vector3.new(0, grip.Y, grip.Z)
		local elbow = centered(re and pivot(re), le and pivot(le)) or grip
		model:SetAttribute("HasArms", true)
		model:SetAttribute("PivotShoulder", shoulder)
		model:SetAttribute("PivotElbow", elbow)
		model:SetAttribute("PivotGrip", grip)
	else
		model:SetAttribute("HasArms", false)
		model:SetAttribute("PivotShoulder", Vector3.new(0, height * 0.72, 0))
	end
	local waist = findMotor(model, NAMES.waist)
	model:SetAttribute("HasWaist", waist ~= nil)
	model:SetAttribute("PivotWaist", if waist then centered(pivot(waist), nil) else Vector3.new(0, rootY, 0))

	-- Agacharse: cuánto baja la cadera y cuánto se doblan las rodillas.
	local hip, knee, ankle = findMotor(model, NAMES.rightHip), findMotor(model, NAMES.rightKnee), findMotor(model, NAMES.rightAnkle)
	if hip and knee then
		local thigh = (pivot(hip) - pivot(knee)).Magnitude
		local shin = if ankle then (pivot(knee) - pivot(ankle)).Magnitude else pivot(knee).Y
		local legs = thigh + shin
		local drop = math.min(legs * 0.45, hipHeight * 0.8)
		model:SetAttribute("CrouchDrop", drop)
		model:SetAttribute("CrouchAngle", math.acos(math.clamp((legs - drop) / legs, -1, 1)))
	else
		model:SetAttribute("CrouchDrop", math.min(height * 0.12, hipHeight * 0.8))
		model:SetAttribute("CrouchAngle", math.rad(30))
	end

	-- Punto de agarre para los objetos de la tienda (Tools).
	local rightHand = model:FindFirstChild("RightHand")
	if not (rightHand and rightHand:IsA("BasePart")) then
		local anchorPart = handPart or root
		local hand = Instance.new("Part")
		hand.Name = "RightHand"
		hand.Size = Vector3.new(0.6, 0.6, 0.6)
		hand.Transparency = 1
		hand.CanCollide = false
		hand.Massless = true
		hand.CFrame = CFrame.new(anchorPart.Position - Vector3.new(0, verticalExtent(anchorPart) * 0.8, 0)) * root.CFrame.Rotation
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = anchorPart
		weld.Part1 = hand
		weld.Parent = hand
		hand.Parent = model
		rightHand = hand
	end
	if not (rightHand :: Instance):FindFirstChild("RightGripAttachment") then
		local attachment = Instance.new("Attachment")
		attachment.Name = "RightGripAttachment"
		attachment.Position = Vector3.new(0, -(rightHand :: BasePart).Size.Y / 2, 0)
		attachment.Parent = rightHand
	end

	hum.RigType = Enum.HumanoidRigType.R15
	hum.AutomaticScalingEnabled = false
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.HipHeight = hipHeight
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = 100
	hum.Health = 100

	model.Name = "Verity"
	model:SetAttribute("VerityRig", true)
	CollectionService:AddTag(model, "VerityRig")
	return model
end

local function tryLoadAsset(id: number): Instance?
	if id == 0 then
		return nil
	end
	local ok, container = pcall(InsertService.LoadAsset, InsertService, id)
	if not ok or not container then
		return nil
	end
	local first = (container :: Instance):FindFirstChildWhichIsA("Model") or (container :: Instance):GetChildren()[1]
	return first
end

local function resolve()
	local candidates: { { name: string, get: () -> Instance? } } = {
		{ name = "ServerStorage.VerityCharacter", get = function()
			return ServerStorage:FindFirstChild("VerityCharacter")
		end },
		{ name = `Toolbox {Config.Verity.AssetId}`, get = function()
			return tryLoadAsset(Config.Verity.AssetId)
		end },
		{ name = "ServerStorage.VerityFallback", get = function()
			return ServerStorage:FindFirstChild("VerityFallback")
		end },
	}
	for _, candidate in candidates do
		local source = candidate.get()
		if source then
			local ok, result = pcall(prepare, source)
			if ok and result then
				template = result
				sourceName = candidate.name
				print(`[VerityModel] usando el modelo de {candidate.name} ({string.format("%.1f", result:GetAttribute("RigHeight") :: number)} studs)`)
				Workspace:SetAttribute("VeritySource", sourceName)
				return
			end
			warn(`[VerityModel] no se pudo preparar {candidate.name}: {result}`)
		end
	end
	warn("[VerityModel] no hay ningún modelo de Verity disponible")
end

-- Devuelve un Verity nuevo (sin parent).
function VerityModel.create(): (Model?, Pose.RigData?)
	if not template then
		return nil, nil
	end
	local model = template:Clone()
	return model, Pose.read(model)
end

function VerityModel.source(): string
	return sourceName
end

-- Lib (no Systems): lo llama Verity.init().
function VerityModel.load()
	if not template then
		resolve()
	end
end

return VerityModel
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties>
<string name="Name">VerityRig</string>
<string name="Source"><![CDATA[--!strict
-- Ensambla el modelo ServerStorage.VerityCharacter: crea los Motor6D y las
-- soldaduras a partir de los atributos que escribe tools/verity_rig.py.
-- Debe llamarse ANTES de mover el modelo (las posiciones de los pivotes
-- están en el espacio original del modelo, pies en el origen).

local CollectionService = game:GetService("CollectionService")

local VerityRig = {}

function VerityRig.assemble(model: Model): BasePart
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	assert(root, "VerityCharacter necesita HumanoidRootPart")

	for _, part in model:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		part.Anchored = false
		local parentName = part:GetAttribute("JointParent")
		local weldTo = part:GetAttribute("WeldTo")
		if typeof(parentName) == "string" then
			local parent = model:FindFirstChild(parentName) :: BasePart
			local pivot = CFrame.new(part:GetAttribute("JointPivot") :: Vector3)
			local motor = Instance.new("Motor6D")
			motor.Name = (part:GetAttribute("Motor") :: string?) or part.Name
			motor.Part0 = parent
			motor.Part1 = part
			motor.C0 = parent.CFrame:Inverse() * pivot
			motor.C1 = part.CFrame:Inverse() * pivot
			motor.Parent = part
		elseif typeof(weldTo) == "string" then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = model:FindFirstChild(weldTo) :: BasePart
			weld.Part1 = part
			weld.Parent = part
		end
	end

	model.PrimaryPart = root
	CollectionService:AddTag(model, "VerityRig")
	return root
end

return VerityRig
]]></string>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000016"><Properties>
<string name="Name">Systems</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000000F"><Properties>
<string name="Name">FinalBattle</string>
<string name="Source"><![CDATA[--!strict
-- Batalla final contra la forma final de Verity.
--   1. Quien compro TODO su tycoon pisa el circulo dorado de su campamento
--      (Tycoon.luau) y convoca la batalla: Idle -> Lobby.
--   2. Durante LobbySeconds todos ven un boton "Unirse" (remote FinalJoin).
--      Las noches normales se pausan (Verity.setHold).
--   3. Lobby -> Battle: los que se unieron viajan al campo, montados a
--      caballo, y aparece la forma final (Verity.spawnFinal).
--   4. Si un jinete muere o se va, sale de la batalla. Si no queda nadie,
--      Verity resiste (Verity.abortFinal).
--   5. Verity.FinalEnded -> Ending: anuncio y, a los pocos segundos, todos
--      vuelven a su campamento a pie (LoadCharacter).
-- Atributos para el HUD: workspace.FinalPhase ("Lobby"/"Battle"/"Ending"),
-- FinalStartsAt (fin de la convocatoria) y FinalCaller (quien convoco).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Horse = require(script.Parent.Parent.Lib.Horse)
local PlayerData = require(script.Parent.PlayerData)
local Verity = require(script.Parent.Verity)

local F = Config.FinalBattle

type State = "Idle" | "Lobby" | "Battle" | "Ending"

local FinalBattle = {}

local state: State = "Idle"
local joined: { [Player]: boolean } = {}
local riders: { Player } = {} -- todos los que empezaron la batalla (para ofrecer renacer)
local deathConns: { RBXScriptConnection } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function setPhase(value: string?)
	workspace:SetAttribute("FinalPhase", value)
end

-- Compro todos los botones de su tycoon.
function FinalBattle.isUnlocked(player: Player): boolean
	for _, def in Config.Buttons do
		if not PlayerData.owns(player, def.Id) then
			return false
		end
	end
	return true
end

local function clearDeathConns()
	for _, c in deathConns do
		c:Disconnect()
	end
	deathConns = {}
end

local function reset()
	clearDeathConns()
	joined = {}
	state = "Idle"
	setPhase(nil)
	workspace:SetAttribute("FinalCaller", nil)
	Verity.setHold(false)
end

local function leave(player: Player)
	joined[player] = nil
	Verity.removeParticipant(player)
end

local function begin()
	if state ~= "Lobby" then
		return
	end
	riders = {}
	for player in joined do
		if player.Parent and player.Character then
			table.insert(riders, player)
		end
	end
	if #riders == 0 or Verity.getPhase() ~= "Waiting" then
		Net.fireAll("Notify", "La batalla final se cancelo.", "warning")
		reset()
		return
	end

	state = "Battle"
	setPhase("Battle")
	-- jinetes en un anillo alrededor del centro, mirando a Verity
	for i, player in riders do
		local character = player.Character :: Model
		local angle = (i - 1) / #riders * math.pi * 2
		local pos = F.Arena + Vector3.new(math.cos(angle), 0, math.sin(angle)) * F.StartRadius + Vector3.new(0, 9, 0)
		character:PivotTo(CFrame.lookAt(pos, F.Arena + Vector3.new(0, 9, 0)))
		Horse.mount(character, F.HorseSpeed)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			table.insert(deathConns, humanoid.Died:Connect(function()
				leave(player)
				Net.fireClient(player, "Notify", "Caiste en la batalla final. Vuelves a tu campamento.", "danger")
			end))
		end
		Net.fireClient(player, "Notify", "A CABALLO, KHAN. Derrota a la forma final de Verity.", "danger")
	end

	if not Verity.spawnFinal(F.Arena, riders) then
		for _, player in riders do
			player:LoadCharacter()
		end
		Net.fireAll("Notify", "La batalla final se cancelo.", "warning")
		reset()
		return
	end

	-- si ya no queda ningun jinete vivo en el campo, Verity resiste
	task.spawn(function()
		while state == "Battle" do
			task.wait(1)
			local alive = 0
			for player in joined do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 and (root.Position - F.Arena).Magnitude < F.ArenaHalfSize * 2 then
					alive += 1
				else
					leave(player)
				end
			end
			if alive == 0 and state == "Battle" then
				Verity.abortFinal()
			end
		end
	end)
end

-- Convocar (o unirse si ya hay una convocatoria).
function FinalBattle.request(player: Player, force: boolean?)
	if state == "Lobby" then
		FinalBattle.join(player)
		return
	end
	if state ~= "Idle" then
		Net.fireClient(player, "Notify", "Ya hay una batalla final en curso.", "info")
		return
	end
	if not force and not FinalBattle.isUnlocked(player) then
		return
	end
	if Verity.getPhase() ~= "Waiting" then
		Net.fireClient(player, "Notify", "Espera a que termine la noche de Verity.", "warning")
		return
	end
	state = "Lobby"
	joined = { [player] = true }
	Verity.setHold(true)
	workspace:SetAttribute("FinalCaller", player.DisplayName)
	workspace:SetAttribute("FinalStartsAt", now() + F.LobbySeconds)
	setPhase("Lobby")
	Net.fireAll("Notify", string.format("%s CONVOCA LA BATALLA FINAL contra Verity. Unete en %d s.", player.DisplayName, F.LobbySeconds), "danger")
	task.delay(F.LobbySeconds, begin)
end

function FinalBattle.join(player: Player)
	if state == "Lobby" and not joined[player] and player.Character then
		joined[player] = true
		Net.fireClient(player, "Notify", "Te uniste a la batalla final. Prepara tus armas.", "reward")
	end
end

local function onEnded(victory: boolean)
	if state ~= "Battle" then
		return
	end
	state = "Ending"
	setPhase("Ending")
	workspace:SetAttribute("FinalVictory", victory)
	clearDeathConns()
	if victory then
		-- cada jinete que empezo la batalla puede renacer si quiere (HUD le pregunta)
		for _, player in riders do
			if player.Parent then
				player:SetAttribute("CanRebirth", true)
			end
		end
	end
	task.delay(8, function()
		-- todos de vuelta a su campamento, a pie (Tycoon los lleva a casa al reaparecer)
		for player in joined do
			if player.Parent then
				player:LoadCharacter()
			end
		end
		reset()
	end)
end

function FinalBattle.init()
	setPhase(nil)
	Net.onServer("FinalJoin", function(player: Player)
		FinalBattle.join(player)
	end)
	Verity.FinalEnded:Connect(onEnded)
	Players.PlayerRemoving:Connect(leave)

	-- Comando de prueba: "/final" convoca sin tener el tycoon completo (Studio o creador)
	local function allowed(player: Player?): boolean
		return player ~= nil and (RunService:IsStudio() or player.UserId == game.CreatorId)
	end
	pcall(function()
		local command = Instance.new("TextChatCommand")
		command.Name = "FinalCommand"
		command.PrimaryAlias = "/final"
		command.Triggered:Connect(function(source: TextSource)
			local player = Players:GetPlayerByUserId(source.UserId)
			if player and allowed(player) then
				FinalBattle.request(player, true)
			end
		end)
		command.Parent = game:GetService("TextChatService")
	end)
	local function hook(player: Player)
		player.Chatted:Connect(function(message)
			if message:lower() == "/final" and allowed(player) then
				FinalBattle.request(player, true)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
end

return FinalBattle
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties>
<string name="Name">PlayerData</string>
<string name="Source"><![CDATA[--!strict
-- Oro, compras y muertes de Verity por jugador, con guardado en DataStore.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)

type Session = {
	profile: Types.Profile,
	canSave: boolean,
	goldValue: IntValue,
	killsValue: IntValue,
	rebirthValue: IntValue,
}

local PlayerData = {}

local sessions: { [Player]: Session } = {}
local store: DataStore? = nil

local loadedEvent = Instance.new("BindableEvent")
-- Se dispara con (player) cuando su perfil ya esta cargado.
PlayerData.Loaded = loadedEvent.Event

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function sync(session: Session)
	session.goldValue.Value = math.floor(session.profile.Gold)
	session.killsValue.Value = session.profile.VerityKills
	session.rebirthValue.Value = session.profile.Rebirths
end

local function load(player: Player)
	local profile: Types.Profile = { Gold = Config.StartingGold, Owned = {}, VerityKills = 0, Rebirths = 0 }
	local canSave = false
	-- SaveStatus (lo muestra el HUD): "ok" se guarda | "off" sin DataStore | "error" no se pudo leer
	local status = "off"

	if store then
		local ok, data = false, nil
		for attempt = 1, 3 do
			ok, data = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				break
			end
			task.wait(attempt)
		end
		if ok then
			canSave = true
			status = "ok"
			if typeof(data) == "table" then
				profile.Gold = math.max(0, tonumber(data.Gold) or profile.Gold)
				profile.VerityKills = math.max(0, tonumber(data.VerityKills) or 0)
				profile.Rebirths = math.max(0, math.floor(tonumber(data.Rebirths) or 0))
				if typeof(data.Owned) == "table" then
					for id, value in data.Owned do
						if typeof(id) == "string" and value == true then
							profile.Owned[id] = true
						end
					end
				end
			end
		else
			status = "error"
			-- No sobrescribimos datos que no pudimos leer.
			warn("[PlayerData] No se pudo cargar a " .. player.Name .. "; esta sesion no se guardara.")
		end
	end

	if not player.Parent then
		return -- se fue mientras cargaba
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local goldValue = Instance.new("IntValue")
	goldValue.Name = "Oro"
	goldValue.Parent = leaderstats
	local killsValue = Instance.new("IntValue")
	killsValue.Name = "Verity"
	killsValue.Parent = leaderstats
	local rebirthValue = Instance.new("IntValue")
	rebirthValue.Name = "Renacer"
	rebirthValue.Parent = leaderstats
	leaderstats.Parent = player
	player:SetAttribute("SaveStatus", status)

	local session: Session = { profile = profile, canSave = canSave, goldValue = goldValue, killsValue = killsValue, rebirthValue = rebirthValue }
	sessions[player] = session
	sync(session)
	loadedEvent:Fire(player)
end

local function save(player: Player)
	local session = sessions[player]
	if not session or not session.canSave or not store then
		return
	end
	local snapshot = {
		Gold = math.floor(session.profile.Gold),
		VerityKills = session.profile.VerityKills,
		Rebirths = session.profile.Rebirths,
		Owned = table.clone(session.profile.Owned),
	}
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function()
			return snapshot
		end)
	end)
	if not ok then
		warn("[PlayerData] Error guardando a " .. player.Name .. ": " .. tostring(err))
	end
end

function PlayerData.isLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

function PlayerData.getGold(player: Player): number
	local s = sessions[player]
	return if s then s.profile.Gold else 0
end

function PlayerData.addGold(player: Player, amount: number)
	local s = sessions[player]
	if not s or amount <= 0 then
		return
	end
	s.profile.Gold += amount
	sync(s)
end

function PlayerData.trySpend(player: Player, amount: number): boolean
	local s = sessions[player]
	if not s or s.profile.Gold < amount then
		return false
	end
	s.profile.Gold -= amount
	sync(s)
	return true
end

function PlayerData.owns(player: Player, id: string): boolean
	local s = sessions[player]
	return s ~= nil and s.profile.Owned[id] == true
end

function PlayerData.setOwned(player: Player, id: string)
	local s = sessions[player]
	if s then
		s.profile.Owned[id] = true
	end
end

function PlayerData.addVerityKill(player: Player)
	local s = sessions[player]
	if s then
		s.profile.VerityKills += 1
		sync(s)
	end
end

function PlayerData.getRebirths(player: Player): number
	local s = sessions[player]
	return if s then s.profile.Rebirths else 0
end

-- Cuanto oro extra gana por sus renacimientos (1 = nada extra).
function PlayerData.rebirthMultiplier(player: Player?): number
	if not player then
		return 1
	end
	return 1 + Config.Rebirth.BonusPerRebirth * PlayerData.getRebirths(player)
end

-- Renacer: campamento y oro desde cero, +1 renacimiento. Se guarda al momento.
function PlayerData.rebirth(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	s.profile.Owned = {}
	s.profile.Gold = Config.StartingGold
	s.profile.Rebirths += 1
	sync(s)
	task.spawn(save, player)
end

function PlayerData.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore no disponible (activa 'Studio Access to API Services'). Sin guardado.")
	end

	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		sessions[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for player in sessions do
			pending += 1
			task.spawn(function()
				save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

function PlayerData.start()
	while true do
		task.wait(Config.AutosaveSeconds)
		for player in sessions do
			task.spawn(save, player)
		end
	end
end

return PlayerData
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties>
<string name="Name">ThroatSing</string>
<string name="Source"><![CDATA[--!strict
-- Canto de garganta mongol (khöömei). El cliente solo pide cantar (remote sin
-- datos); aqui se valida el cooldown y se aplican los efectos:
--   - Verity a menos de StunRadius queda aturdido (lento y sin atacar) y recibe dano
--   - los jugadores a menos de HealRadius (tu incluido) se curan
--   - ondas de sonido visibles y el canto, que oyen todos
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Build = require(script.Parent.Parent.Lib.Build)
local Sfx = require(script.Parent.Parent.Lib.Sfx)
local Verity = require(script.Parent.Verity)

local T = Config.ThroatSing

local ThroatSing = {}

local readyAt: { [Player]: number } = {}

local function waves(root: BasePart)
	for i = 0, 2 do
		task.delay(i * 0.45, function()
			if not root.Parent then
				return
			end
			local ring = Build.part({
				Name = "SongWave",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, 4, 4),
				-- cilindro acostado = anillo plano a la altura del pecho
				CFrame = CFrame.new(root.Position) * CFrame.Angles(0, 0, math.pi / 2),
				Color = Color3.fromRGB(120, 200, 255),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = workspace,
			})
			ring.CanQuery = false
			ring.CanTouch = false
			ring.Transparency = 0.3
			local d = T.StunRadius * 2
			TweenService:Create(ring, TweenInfo.new(1.1, Enum.EasingStyle.Quad), { Size = Vector3.new(0.3, d, d), Transparency = 1 }):Play()
			task.delay(1.2, function()
				ring:Destroy()
			end)
		end)
	end
end

local function sing(player: Player)
	local t = os.clock()
	if t < (readyAt[player] or 0) then
		return -- en cooldown (el cliente tambien lo bloquea, pero aqui manda el servidor)
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (root and root:IsA("BasePart") and humanoid and humanoid.Health > 0) then
		return
	end
	readyAt[player] = t + T.Cooldown
	player:SetAttribute("SingReadyAt", workspace:GetServerTimeNow() + T.Cooldown)

	-- el canto (grupo "Song": no se ensordece; fuerte hasta MinDistance).
	-- Sin el audio subido no suena nada: ningun sonido de la biblioteca se
	-- parece a un canto, y el sustituto metalico sonaba a hierro doblandose.
	local sound: Sound?
	if Config.Sounds.ThroatSing ~= 0 then
		sound = Sfx.play(Config.Sounds.ThroatSing, root, { Volume = 2, Group = "Song", MinDistance = 40, MaxDistance = T.DuckRadius, Lifetime = T.Duration + 1 })
		-- los clientes cercanos ensordecen todo lo demas mientras dure (Controllers/SoundDuck)
		local songUntil = workspace:GetServerTimeNow() + T.Duration
		workspace:SetAttribute("SongUntil", math.max((workspace:GetAttribute("SongUntil") :: number?) or 0, songUntil))
		workspace:SetAttribute("SongPos", root.Position)
	elseif RunService:IsStudio() then
		Net.fireClient(player, "Notify", "El canto aun no tiene audio: sube assets/audio/khoomei.ogg y pega su ID en Config.Uploads.ThroatSing", "warning")
	end
	if sound then
		task.delay(T.Duration, function()
			if sound.Parent then
				sound:Stop()
				sound:Destroy()
			end
		end)
	end
	waves(root)

	-- curar aliados cercanos
	for _, other in Players:GetPlayers() do
		local oc = other.Character
		local orr = oc and oc:FindFirstChild("HumanoidRootPart")
		local oh = oc and oc:FindFirstChildOfClass("Humanoid")
		if orr and orr:IsA("BasePart") and oh and oh.Health > 0 and (orr.Position - root.Position).Magnitude <= T.HealRadius then
			oh.Health = math.min(oh.MaxHealth, oh.Health + T.Heal)
		end
	end

	-- aturdir a Verity
	local vpos = Verity.getPosition()
	if vpos and (Vector3.new(vpos.X, 0, vpos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude <= T.StunRadius then
		Verity.stun(T.StunSeconds)
		Verity.damage(player, T.Damage)
		Net.fireClient(player, "Notify", "Tu canto de garganta aturde a Verity", "reward")
	end
end

function ThroatSing.init()
	Net.onServer("ThroatSing", sing)
	Players.PlayerRemoving:Connect(function(player)
		readyAt[player] = nil
	end)
end

return ThroatSing
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties>
<string name="Name">Tycoon</string>
<string name="Source"><![CDATA[--!strict
-- Plots del tycoon: botones de compra, droppers (animales/caravanas),
-- cinta, colector, caja para recoger oro, empalizada, Gran Yurta,
-- murallas contra Verity y segundo piso.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Build = require(script.Parent.Parent.Lib.Build)
local Sfx = require(script.Parent.Parent.Lib.Sfx)
local FinalBattle = require(script.Parent.FinalBattle)
local Verity = require(script.Parent.Verity)
local PlayerData = require(script.Parent.PlayerData)
local Weapons = require(script.Parent.Weapons)
local World = require(script.Parent.World)

type Plot = {
	index: number,
	cframe: CFrame,
	model: Model,
	owner: Player?,
	generation: number, -- sube cada vez que se libera el plot; corta los bucles viejos
	pending: number,
	multiplier: number,
	built: { Instance },
	buttons: { [string]: BasePart },
	finalPad: BasePart,
	claimPad: BasePart,
	cashLabel: TextLabel,
	signLabel: TextLabel,
	spawn: BasePart,
	spawnConn: RBXScriptConnection?,
	arrows: { BasePart },
	guideLabel: TextLabel,
	wall: Model?,
	weaponTable: CFrame,
	gate: { left: BasePart, right: BasePart, open: boolean, y: number }?,
	floor2: Model?,
}

local Tycoon = {}

local SLOT_X = { -21, -9, 3, 15 }
local H2 = Config.Floor2Height
-- posicion de la fila de droppers/cinta en cada piso (local al plot)
local LINE = {
	[1] = { y = 0, z = 30 }, -- al fondo del campamento: deja libre el centro
	[2] = { y = H2, z = 14 },
}
local SAND = Color3.fromRGB(214, 190, 140)

local plots: { Plot } = {}
local plotOf: { [Player]: Plot } = {}
local lastWarn: { [Player]: number } = {}
local tycoonFolder: Folder
local oreFolder: Folder

local defsById: { [string]: Types.ButtonDef } = {}
for _, def in Config.Buttons do
	defsById[def.Id] = def
end

local function isOwnerTouch(plot: Plot, hit: BasePart): Player?
	local character = hit.Parent
	if not character then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	if player and plot.owner == player then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			return player
		end
	end
	return nil
end

local function updateCash(plot: Plot)
	local text = string.format("Recoger: %d oro", math.floor(plot.pending))
	plot.cashLabel.Text = text
	local floor2 = plot.floor2
	local label2 = floor2 and floor2:FindFirstChild("Floor2Cash", true)
	if label2 and label2:IsA("TextLabel") then
		label2.Text = text
	end
end

local function available(plot: Plot, def: Types.ButtonDef): boolean
	local owner = plot.owner
	if not owner or PlayerData.owns(owner, def.Id) then
		return false
	end
	return def.Requires == nil or PlayerData.owns(owner, def.Requires :: string)
end

local function refreshButtons(plot: Plot)
	for id, button in plot.buttons do
		button.Parent = if available(plot, defsById[id]) then plot.model else nil
	end
	-- tycoon completo: aparece el circulo de la batalla final
	local owner = plot.owner
	plot.finalPad.Parent = if owner and FinalBattle.isUnlocked(owner) then plot.model else nil
end

-- ===== Construcciones =====

-- Cinta + barandas + colector de un piso. El colector suma al oro pendiente del plot.
local function buildLine(plot: Plot, parent: Instance, floor: number)
	local line = LINE[floor]
	local cf = plot.cframe * CFrame.new(0, line.y, line.z)
	local conveyor = Build.part({ Name = "Conveyor", Size = Vector3.new(50, 1, 5), CFrame = cf * CFrame.new(-2, 1.5, 0), Color = Color3.fromRGB(40, 35, 30), Material = Enum.Material.Fabric, Parent = parent })
	-- una pieza anclada con velocidad mueve lo que cae encima
	conveyor.AssemblyLinearVelocity = plot.cframe.RightVector * Config.ConveyorSpeed
	Build.part({ Name = "RailA", Size = Vector3.new(50, 1.5, 0.5), CFrame = cf * CFrame.new(-2, 2.75, 2.75), Color = Color3.fromRGB(110, 70, 35), Material = Enum.Material.Wood, Parent = parent })
	Build.part({ Name = "RailB", Size = Vector3.new(50, 1.5, 0.5), CFrame = cf * CFrame.new(-2, 2.75, -2.75), Color = Color3.fromRGB(110, 70, 35), Material = Enum.Material.Wood, Parent = parent })
	local collector = Build.part({ Name = "Collector", Size = Vector3.new(4, 4, 7), CFrame = cf * CFrame.new(25, 3, 0), Color = Color3.fromRGB(230, 190, 60), Material = Enum.Material.Neon, Parent = parent })
	collector.Touched:Connect(function(hit)
		if hit:GetAttribute("PlotIndex") ~= plot.index then
			return
		end
		local value = hit:GetAttribute("OreValue")
		hit:Destroy()
		if plot.owner and typeof(value) == "number" then
			plot.pending += value * plot.multiplier * PlayerData.rebirthMultiplier(plot.owner :: Player)
			updateCash(plot)
		end
	end)
end

local function buildCashPad(plot: Plot, parent: Instance, offset: Vector3): TextLabel
	local cashPad = Build.part({ Name = "CashPad", Size = Vector3.new(6, 1, 6), CFrame = plot.cframe * CFrame.new(offset), Color = Color3.fromRGB(60, 200, 90), Material = Enum.Material.Neon, Parent = parent })
	cashPad.Touched:Connect(function(hit)
		local player = isOwnerTouch(plot, hit)
		if player and plot.pending > 0 then
			Sfx.play(Config.Sounds.Collect, cashPad, { Volume = 0.8, Speed = 1.4 })
			PlayerData.addGold(player, math.floor(plot.pending))
			plot.pending = 0
			updateCash(plot)
		end
	end)
	return Build.billboard(cashPad, "Recoger: 0 oro", 4, 220)
end

local function buildDropper(plot: Plot, def: Types.ButtonDef)
	local owner = plot.owner :: Player
	local generation = plot.generation
	local x = SLOT_X[def.Slot or 1]
	local line = LINE[def.Floor or 1]
	local cf = plot.cframe * CFrame.new(0, line.y, line.z)
	local model = Instance.new("Model")
	model.Name = "Dropper_" .. def.Id
	Build.part({ Name = "Pillar", Size = Vector3.new(1, 10, 1), CFrame = cf * CFrame.new(x, 6, -5), Color = Color3.fromRGB(110, 70, 35), Material = Enum.Material.Wood, Parent = model })
	Build.part({ Name = "Arm", Size = Vector3.new(1, 1, 5), CFrame = cf * CFrame.new(x, 10.5, -2.5), Color = Color3.fromRGB(110, 70, 35), Material = Enum.Material.Wood, Parent = model })
	local hopper = Build.part({ Name = "Hopper", Size = Vector3.new(4, 3, 4), CFrame = cf * CFrame.new(x, 9.5, 0), Color = def.OreColor or SAND, Material = Enum.Material.Fabric, Parent = model })
	Build.billboard(hopper, def.Name, 3, 160)
	model.Parent = plot.model
	table.insert(plot.built, model)

	task.spawn(function()
		while plot.generation == generation and plot.owner == owner and model.Parent do
			task.wait(def.Interval or 2)
			if plot.generation ~= generation then
				break
			end
			local ore = Build.part({
				Name = "Ore",
				Size = Vector3.new(1.2, 1.2, 1.2),
				CFrame = hopper.CFrame * CFrame.new(0, -2.2, 0),
				Color = def.OreColor or SAND,
				Material = Enum.Material.SmoothPlastic,
				Anchored = false,
				Parent = oreFolder,
			})
			ore:SetAttribute("OreValue", def.Value or 1)
			ore:SetAttribute("PlotIndex", plot.index)
			ore:SetNetworkOwner(nil) -- el servidor controla la fisica (anti-trampas)
			Debris:AddItem(ore, 25)
		end
	end)
end

local function buildFence(plot: Plot)
	local model = Instance.new("Model")
	model.Name = "Fence"
	local wood = Color3.fromRGB(120, 80, 40)
	local cf = plot.cframe
	local function seg(size: Vector3, offset: Vector3)
		Build.part({ Name = "Stake", Size = size, CFrame = cf * CFrame.new(offset), Color = wood, Material = Enum.Material.Wood, Parent = model })
	end
	seg(Vector3.new(80, 5, 1), Vector3.new(0, 3, 39.5)) -- fondo
	seg(Vector3.new(1, 5, 80), Vector3.new(-39.5, 3, 0))
	seg(Vector3.new(1, 5, 80), Vector3.new(39.5, 3, 0))
	seg(Vector3.new(30, 5, 1), Vector3.new(-25, 3, -39.5)) -- frente con entrada de 20
	seg(Vector3.new(30, 5, 1), Vector3.new(25, 3, -39.5))
	model.Parent = plot.model
	table.insert(plot.built, model)
end

local function buildShelter(plot: Plot)
	local owner = plot.owner :: Player
	-- la puerta de la yurta mira hacia el frente del plot
	local cf = plot.cframe * CFrame.new(-29, 0, 10) -- lado izquierdo, puerta hacia la entrada
	local yurt = Build.yurt(plot.model, cf, 9, 10)
	Build.markSolid(yurt)
	table.insert(plot.built, yurt)
	local zone = Build.hidingZone(World.getHidingFolder(), cf * CFrame.new(0, 5, 0), Vector3.new(14, 10, 14), owner.UserId)
	table.insert(plot.built, zone)
end

-- Muralla alrededor del plot con una puerta en el frente.
--   - los muros son solidos para todos (grupo Solid)
--   - la puerta tiene una barrera invisible que solo frena a Verity (grupo
--     VerityWall): los jugadores siempre pasan; las hojas se abren solas
--     cuando alguien se acerca (updateGates)
--   - barra de vida encima de la puerta
-- Verity.luau golpea los WallSegment hasta romperlos y los repara al irse.
local GATE_HALF = 6 -- media anchura de la puerta

local function buildWall(plot: Plot, def: Types.ButtonDef)
	local owner = plot.owner :: Player
	if plot.wall then
		plot.wall:Destroy() -- el nivel nuevo reemplaza al anterior
		plot.wall = nil
		plot.gate = nil
	end
	Build.ensureGroups()
	local h = def.WallHeight or 14
	local maxHp = def.WallHP or 500
	local model = Instance.new("Model")
	model.Name = "Wall_" .. plot.index
	local function seg(size: Vector3, offset: Vector3, group: string): Part
		local p = Build.part({ Name = "WallSegment", Size = size, CFrame = plot.cframe * CFrame.new(offset), Color = def.WallColor, Material = def.WallMaterial, Parent = model })
		p.CollisionGroup = group
		return p
	end
	local y = h / 2 + 1
	local side = (86 - GATE_HALF * 2) / 2
	seg(Vector3.new(86, h, 2), Vector3.new(0, y, 42), Build.SOLID_GROUP) -- fondo
	seg(Vector3.new(2, h, 82), Vector3.new(42, y, 0), Build.SOLID_GROUP)
	seg(Vector3.new(2, h, 82), Vector3.new(-42, y, 0), Build.SOLID_GROUP)
	seg(Vector3.new(side, h, 2), Vector3.new(-(GATE_HALF + side / 2), y, -42), Build.SOLID_GROUP) -- frente izq.
	seg(Vector3.new(side, h, 2), Vector3.new(GATE_HALF + side / 2, y, -42), Build.SOLID_GROUP) -- frente der.
	-- barrera invisible de la puerta: solo para Verity
	local barrier = seg(Vector3.new(GATE_HALF * 2, h, 2), Vector3.new(0, y, -42), Build.WALL_GROUP)
	barrier.Transparency = 1
	barrier:SetAttribute("Invisible", true)
	-- dintel
	Build.part({ Name = "Lintel", Size = Vector3.new(GATE_HALF * 2 + 4, 2, 3), CFrame = plot.cframe * CFrame.new(0, h + 2, -42), Color = Color3.fromRGB(170, 30, 30), Material = Enum.Material.Wood, Parent = model }).CollisionGroup = Build.SOLID_GROUP

	-- hojas de la puerta (decorativas: no chocan con nadie)
	local function leaf(hingeX: number, dir: number): Part
		local p = Build.part({
			Name = "GateLeaf",
			Size = Vector3.new(GATE_HALF, h, 0.8),
			CFrame = plot.cframe * CFrame.new(hingeX, y, -42) * CFrame.new(dir * GATE_HALF / 2, 0, 0),
			Color = Color3.fromRGB(110, 70, 35),
			Material = Enum.Material.WoodPlanks,
			CanCollide = false,
			Parent = model,
		})
		p.CanQuery = false
		p.CanTouch = false
		return p
	end
	local left = leaf(-GATE_HALF, 1)
	local right = leaf(GATE_HALF, -1)
	plot.gate = { left = left, right = right, open = false, y = y }

	-- barra de vida encima de la puerta
	local sign = Build.part({ Name = "WallSign", Size = Vector3.new(1, 1, 1), CFrame = plot.cframe * CFrame.new(0, h + 6, -42), Transparency = 1, CanCollide = false, Parent = model })
	sign.CanQuery = false
	sign.CanTouch = false
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(320, 58)
	gui.MaxDistance = 250
	gui.Adornee = sign
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 24)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.3
	title.Parent = gui
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 26)
	bar.Position = UDim2.fromOffset(0, 30)
	bar.BackgroundColor3 = Color3.fromRGB(25, 10, 10)
	bar.BorderSizePixel = 0
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local amount = Instance.new("TextLabel")
	amount.Size = UDim2.fromScale(1, 1)
	amount.BackgroundTransparency = 1
	amount.Font = Enum.Font.GothamBold
	amount.TextScaled = true
	amount.TextColor3 = Color3.new(1, 1, 1)
	amount.TextStrokeTransparency = 0.3
	amount.ZIndex = 2
	amount.Parent = bar
	for _, frame in { bar, fill } do
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = frame
	end
	gui.Parent = sign

	local function refresh()
		local hp = (model:GetAttribute("HP") :: number?) or 0
		local ratio = math.clamp(hp / maxHp, 0, 1)
		title.Text = def.Name
		fill.Size = UDim2.fromScale(ratio, 1)
		-- verde con vida llena, rojo cuando se esta rompiendo
		fill.BackgroundColor3 = Color3.fromRGB(220, 50, 40):Lerp(Color3.fromRGB(60, 200, 80), ratio)
		if model:GetAttribute("Broken") then
			amount.Text = "ROTA - se repara cuando Verity se vaya"
			title.TextColor3 = Color3.fromRGB(255, 80, 80)
		else
			amount.Text = string.format("%d / %d", hp, maxHp)
			title.TextColor3 = Color3.new(1, 1, 1)
		end
	end
	model:SetAttribute("MaxHP", maxHp)
	model:SetAttribute("HP", maxHp)
	model:SetAttribute("Broken", false)
	model:SetAttribute("OwnerUserId", owner.UserId)
	model:GetAttributeChangedSignal("HP"):Connect(refresh)
	model:GetAttributeChangedSignal("Broken"):Connect(refresh)
	refresh()
	model.Parent = World.getWallFolder()
	plot.wall = model
	table.insert(plot.built, model)
end

-- Abre las puertas cuando hay un jugador vivo a menos de 14 studs y las cierra si no.
local GATE_TWEEN = TweenInfo.new(0.5, Enum.EasingStyle.Quad)
local function updateGates()
	local roots: { Vector3 } = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			table.insert(roots, root.Position)
		end
	end
	for _, plot in plots do
		local gate = plot.gate
		if gate and gate.left.Parent then
			local center = (plot.cframe * CFrame.new(0, gate.y, -42)).Position
			local near = false
			for _, pos in roots do
				if (pos - center).Magnitude <= 14 then
					near = true
					break
				end
			end
			if near ~= gate.open then
				gate.open = near
				local angle = if near then math.rad(100) else 0
				local hingeL = plot.cframe * CFrame.new(-GATE_HALF, gate.y, -42)
				local hingeR = plot.cframe * CFrame.new(GATE_HALF, gate.y, -42)
				-- se abren hacia fuera del campamento (-Z local)
				TweenService:Create(gate.left, GATE_TWEEN, { CFrame = hingeL * CFrame.Angles(0, angle, 0) * CFrame.new(GATE_HALF / 2, 0, 0) }):Play()
				TweenService:Create(gate.right, GATE_TWEEN, { CFrame = hingeR * CFrame.Angles(0, -angle, 0) * CFrame.new(-GATE_HALF / 2, 0, 0) }):Play()
			end
		end
	end
end

-- Segundo piso: losa sobre la mitad trasera, escalera, cinta, colector y caja.
local function buildFloor2(plot: Plot)
	if plot.floor2 then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Floor2"
	local cf = plot.cframe
	local wood = Color3.fromRGB(150, 105, 60)
	Build.part({ Name = "Slab", Size = Vector3.new(80, 1, 40), CFrame = cf * CFrame.new(0, H2, 20), Color = wood, Material = Enum.Material.WoodPlanks, Parent = model })
	for _, x in { -39, 39 } do
		for _, z in { 1, 39 } do
			Build.part({ Name = "Column", Size = Vector3.new(2, H2, 2), CFrame = cf * CFrame.new(x, H2 / 2, z), Color = Color3.fromRGB(170, 30, 30), Material = Enum.Material.Wood, Parent = model })
		end
	end
	-- baranda del borde delantero (deja libre la llegada de la escalera)
	Build.part({ Name = "Railing", Size = Vector3.new(73, 3, 0.6), CFrame = cf * CFrame.new(3.5, H2 + 2, 0.3), Color = Color3.fromRGB(170, 30, 30), Material = Enum.Material.Wood, Parent = model })
	-- escalera: escalones macizos de ~1 stud por el lado izquierdo, subiendo hacia atras
	local steps = 19
	local rise = (H2 + 0.5 - 1) / steps
	for i = 1, steps do
		local height = rise * i
		Build.part({
			Name = "Step",
			Size = Vector3.new(5, height, 2),
			CFrame = cf * CFrame.new(-36, 1 + height / 2, -38 + 2 * (i - 1) + 1),
			Color = wood,
			Material = Enum.Material.WoodPlanks,
			Parent = model,
		})
	end
	buildLine(plot, model, 2)
	local label2 = buildCashPad(plot, model, Vector3.new(25, H2 + 1.2, 30))
	label2.Name = "Floor2Cash"
	model.Parent = plot.model
	plot.floor2 = model
	table.insert(plot.built, model)
	updateCash(plot)
end

-- Armeria: las armas compradas se exhiben tumbadas sobre la mesa del centro.
local WEAPON_SLOT = { Sable = -6, Arco = -2, Lanza = 2, Trueno = 6 }
local function displayWeapon(plot: Plot, id: string)
	local x = WEAPON_SLOT[id]
	if not x or plot.model:FindFirstChild("Display_" .. id) then
		return
	end
	local display = Weapons.displayModel(id)
	if display then
		display:PivotTo(plot.weaponTable * CFrame.new(x, 0.35, 0))
		display.Parent = plot.model
		table.insert(plot.built, display)
	end
end

local function buildWeaponTable(model: Model, top: CFrame)
	local wood = Color3.fromRGB(105, 68, 38)
	Build.part({ Name = "TableTop", Size = Vector3.new(17, 0.6, 10), CFrame = top * CFrame.new(0, -0.3, 0), Color = wood, Material = Enum.Material.WoodPlanks, Parent = model })
	Build.part({ Name = "TableRunner", Size = Vector3.new(16, 0.05, 3), CFrame = top * CFrame.new(0, 0.02, 0), Color = Color3.fromRGB(150, 30, 30), Material = Enum.Material.Fabric, Parent = model })
	for _, x in { -7.8, 7.8 } do
		for _, z in { -4.3, 4.3 } do
			Build.part({ Name = "TableLeg", Size = Vector3.new(0.8, 3.2, 0.8), CFrame = top * CFrame.new(x, -2.2, z), Color = wood, Material = Enum.Material.Wood, Parent = model })
		end
	end
	local sign = Build.part({ Name = "ArmorySign", Size = Vector3.new(1, 1, 1), CFrame = top * CFrame.new(0, 4.5, 0), Transparency = 1, CanCollide = false, Parent = model })
	sign.CanQuery = false
	Build.billboard(sign, "Armeria del Khan", 0, 220).TextColor3 = Color3.fromRGB(240, 210, 140)
end

local function applyBuild(plot: Plot, def: Types.ButtonDef)
	local owner = plot.owner
	if not owner then
		return
	end
	if def.Kind == "Dropper" then
		buildDropper(plot, def)
	elseif def.Kind == "Weapon" and def.WeaponId then
		Weapons.grant(owner, def.WeaponId)
		displayWeapon(plot, def.WeaponId)
	elseif def.Kind == "Multiplier" then
		plot.multiplier = math.max(plot.multiplier, def.Multiplier or 1)
	elseif def.Kind == "Shelter" then
		buildShelter(plot)
	elseif def.Kind == "Decor" then
		buildFence(plot)
	elseif def.Kind == "Wall" then
		buildWall(plot, def)
	elseif def.Kind == "Floor" then
		buildFloor2(plot)
	end
end

local function tryBuy(plot: Plot, def: Types.ButtonDef, player: Player, button: BasePart)
	if not available(plot, def) then
		return
	end
	if not PlayerData.trySpend(player, def.Cost) then
		local t = os.clock()
		if t - (lastWarn[player] or 0) > 2 then
			lastWarn[player] = t
			Net.fireClient(player, "Notify", string.format("Necesitas %d oro para %s", def.Cost, def.Name), "info")
		end
		return
	end
	PlayerData.setOwned(player, def.Id)
	if def.Kind == "Weapon" then
		Sfx.play(Config.Sounds.WeaponUnlock, button, { Volume = 1 })
	else
		Sfx.play(Config.Sounds.Purchase, button, { Volume = 0.8, Speed = 0.8 })
	end
	applyBuild(plot, def)
	refreshButtons(plot)
	Net.fireClient(player, "Notify", "Comprado: " .. def.Name, "reward")
end

-- ===== Plots =====

-- Camino con flechas desde la plaza: azul si el campamento esta libre, gris si tiene dueno.
local function setGuide(plot: Plot)
	local owner = plot.owner
	local color = if owner then Color3.fromRGB(150, 150, 150) else Color3.fromRGB(70, 150, 255)
	for _, arrow in plot.arrows do
		arrow.Color = color
		arrow.Material = if owner then Enum.Material.SmoothPlastic else Enum.Material.Neon
	end
	plot.guideLabel.Text = if owner
		then string.format("Campamento %d: de %s", plot.index, owner.DisplayName)
		else string.format("Campamento %d: LIBRE", plot.index)
	plot.guideLabel.TextColor3 = if owner then Color3.fromRGB(220, 220, 220) else Color3.fromRGB(170, 210, 255)
end


-- Declarada aqui porque el circulo "Reclamar" de buildPlot la llama y se
-- define mas abajo (una funcion local solo existe desde su linea).
local assign: (Player, Plot) -> ()

local function buildPlot(index: number): Plot
	local angle = (index - 1) / Config.PlotCount * math.pi * 2
	local pos = Vector3.new(math.cos(angle) * Config.PlotRingRadius, 0, math.sin(angle) * Config.PlotRingRadius)
	-- -Z local (el frente) mira al centro del mapa
	local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0))

	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	Build.markGround(Build.part({ Name = "Base", Size = Vector3.new(80, 1, 80), CFrame = cf * CFrame.new(0, 0.5, 0), Color = SAND, Material = Enum.Material.Sand, Parent = model }))

	local post = Build.part({ Name = "SignPost", Size = Vector3.new(1, 10, 1), CFrame = cf * CFrame.new(0, 5, -38), Color = Color3.fromRGB(110, 70, 35), Material = Enum.Material.Wood, Parent = model })
	local signLabel = Build.billboard(post, "Campamento libre", 7, 260)

	-- punto de aparicion del dueno (lo teletransportamos al reaparecer)
	local spawn = Build.part({ Name = "HomePad", Size = Vector3.new(6, 1, 6), CFrame = cf * CFrame.new(28, 1.2, -30), Color = Color3.fromRGB(170, 30, 30), Material = Enum.Material.Slate, Parent = model })

	model.Parent = tycoonFolder

	local plot: Plot = {
		index = index,
		cframe = cf,
		model = model,
		owner = nil,
		generation = 0,
		pending = 0,
		multiplier = 1,
		built = {},
		buttons = {},
		cashLabel = nil :: any, -- se asigna abajo
		finalPad = nil :: any, -- se asigna abajo
		claimPad = nil :: any, -- se asigna abajo
		signLabel = signLabel,
		spawn = spawn,
		spawnConn = nil,
		arrows = {},
		guideLabel = nil :: any, -- se asigna abajo
		wall = nil,
		weaponTable = cf * CFrame.new(4, 3.8, 6),
		gate = nil,
		floor2 = nil,
	}
	buildLine(plot, model, 1)
	plot.cashLabel = buildCashPad(plot, model, Vector3.new(25, 1.2, -12))
	buildWeaponTable(model, plot.weaponTable)

	-- circulo dorado de la batalla final (oculto hasta completar el tycoon)
	local finalPad = Build.part({
		Name = "FinalPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 8, 8),
		CFrame = cf * CFrame.new(14, 1.2, -30) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 190, 40),
		Material = Enum.Material.Neon,
	})
	local finalLabel = Build.billboard(finalPad, "BATALLA FINAL\npisa aqui para convocarla", 5, 260)
	finalLabel.TextColor3 = Color3.fromRGB(255, 120, 60)
	local finalDebounce = false
	finalPad.Touched:Connect(function(hit)
		if finalDebounce then
			return
		end
		local player = isOwnerTouch(plot, hit)
		if player then
			finalDebounce = true
			FinalBattle.request(player)
			task.delay(3, function()
				finalDebounce = false
			end)
		end
	end)
	plot.finalPad = finalPad

	-- circulo azul para reclamar el campamento (visible mientras este libre)
	local claimPad = Build.part({
		Name = "ClaimPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 9, 9),
		CFrame = cf * CFrame.new(0, 1.2, -36) * CFrame.Angles(0, 0, math.pi / 2), -- alrededor del poste del estandarte
		Color = Color3.fromRGB(70, 150, 255),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	Build.billboard(claimPad, "RECLAMAR CAMPAMENTO\npisa aqui", 5, 260).TextColor3 = Color3.fromRGB(170, 210, 255)
	claimPad.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if player then
			assign(player, plot)
		end
	end)
	plot.claimPad = claimPad

	-- camino de tierra con flechas desde la plaza hasta la entrada del campamento
	local dir = Vector3.new(pos.X, 0, pos.Z).Unit
	local from = dir * 30
	local to = dir * (Config.PlotRingRadius - 47)
	local length = (to - from).Magnitude
	local path = Build.part({
		Name = "Path",
		Size = Vector3.new(7, 0.2, length),
		CFrame = CFrame.lookAt((from + to) / 2 + Vector3.new(0, 0.08, 0), to + Vector3.new(0, 0.08, 0)),
		Color = Color3.fromRGB(135, 110, 75),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = model,
	})
	path.CanQuery = false
	for d = 6, length - 4, 20 do
		local at = CFrame.lookAt(from + dir * d + Vector3.new(0, 0.25, 0), to + Vector3.new(0, 0.25, 0))
		local shaft = Build.part({ Name = "ArrowShaft", Size = Vector3.new(1.4, 0.15, 5), CFrame = at, Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		-- punta: cuadrado girado 45 grados en la parte delantera
		local tip = Build.part({ Name = "ArrowTip", Size = Vector3.new(3, 0.15, 3), CFrame = at * CFrame.new(0, 0, -2.6) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		for _, p in { shaft, tip } do
			p.CanQuery = false
			p.CanTouch = false
			table.insert(plot.arrows, p)
		end
	end
	local guidePost = Build.part({ Name = "GuideSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(from + dir * 6 + Vector3.new(0, 6, 0)), Transparency = 1, CanCollide = false, Parent = model })
	guidePost.CanQuery = false
	plot.guideLabel = Build.billboard(guidePost, "", 0, 260)
	setGuide(plot)

	-- botones en dos filas de 6, entre la cinta y la entrada
	local perFloor = { 0, 0 }
	for _, def in Config.Buttons do
		local floor = def.Floor or 1
		perFloor[floor] += 1
		local i = perFloor[floor]
		local col = (i - 1) % 6
		local row = (i - 1) // 6
		local offset = if floor == 1
			then Vector3.new(-25 + col * 8, 1.2, -12 - row * 9)
			else Vector3.new(-25 + col * 8, H2 + 1.2, 30 - row * 7)
		local button = Build.part({
			Name = "Button_" .. def.Id,
			Size = Vector3.new(5, 1, 5),
			CFrame = cf * CFrame.new(offset),
			Color = Color3.fromRGB(200, 40, 40),
			Material = Enum.Material.Neon,
		})
		local label = Build.billboard(button, string.format("%s\n%d oro", def.Name, def.Cost), 3.5, 180)
		label.Size = UDim2.fromScale(1, 1)
		local debounce = false
		button.Touched:Connect(function(hit)
			if debounce then
				return
			end
			local player = isOwnerTouch(plot, hit)
			if player then
				debounce = true
				tryBuy(plot, def, player, button)
				task.delay(0.5, function()
					debounce = false
				end)
			end
		end)
		plot.buttons[def.Id] = button
	end

	return plot
end

-- Borra todo lo construido (al irse el dueno o al renacer).
local function resetBuilds(plot: Plot)
	plot.generation += 1
	plot.pending = 0
	plot.multiplier = 1
	for _, inst in plot.built do
		inst:Destroy()
	end
	plot.built = {}
	plot.wall = nil
	plot.gate = nil
	plot.floor2 = nil
	updateCash(plot)
end

local function release(plot: Plot)
	local owner = plot.owner
	resetBuilds(plot)
	plot.owner = nil
	plot.signLabel.Text = "Campamento libre"
	plot.claimPad.Parent = plot.model
	setGuide(plot)
	if plot.spawnConn then
		plot.spawnConn:Disconnect()
		plot.spawnConn = nil
	end
	updateCash(plot)
	refreshButtons(plot)
	if owner then
		plotOf[owner] = nil
	end
end

-- El jugador reclama un campamento libre pisando su circulo "Reclamar".
function assign(player: Player, p: Plot)
	if plotOf[player] or not player.Parent or p.owner then
		return
	end
	if not PlayerData.isLoaded(player) then
		local t = os.clock()
		if t - (lastWarn[player] or 0) > 2 then
			lastWarn[player] = t
			Net.fireClient(player, "Notify", "Cargando tus datos... pisa el circulo otra vez en un momento.", "info")
		end
		return
	end
	p.owner = player
	plotOf[player] = p
	p.signLabel.Text = "Campamento de " .. player.DisplayName
	p.claimPad.Parent = nil
	player:SetAttribute("HasPlot", true)
	setGuide(p)

	-- reconstruye lo que ya habia comprado (en orden de la lista)
	for _, def in Config.Buttons do
		if PlayerData.owns(player, def.Id) then
			applyBuild(p, def)
		end
	end
	refreshButtons(p)

	-- desde ahora reaparece en su campamento
	p.spawnConn = player.CharacterAdded:Connect(function(character: Model)
		task.wait(0.1)
		character:PivotTo(p.spawn.CFrame + Vector3.new(0, 4, 0))
	end)
	Sfx.play(Config.Sounds.WeaponUnlock, p.spawn, { Volume = 1, Speed = 0.7 })
	Net.fireClient(player, "Notify", "Has levantado tu campamento, Khan. Reune rebanos y armas antes de que caiga la noche.", "reward")
	-- el ciclo de Verity empieza con el primer campamento del servidor
	Verity.startCycle()
end

-- Renacer (tras ganar la batalla final, si el jugador quiere): empieza de
-- cero con mas oro para siempre. Lo ofrece FinalBattle con CanRebirth.
local function rebirth(player: Player)
	if not player:GetAttribute("CanRebirth") then
		return
	end
	player:SetAttribute("CanRebirth", false)
	PlayerData.rebirth(player)
	Weapons.revoke(player)
	local plot = plotOf[player]
	if plot then
		resetBuilds(plot)
		refreshButtons(plot)
	end
	Sfx.play(Config.Sounds.Victory, workspace, { Volume = 0.8 })
	Net.fireClient(player, "Notify", string.format("RENACISTE (x%d). Tu campamento empieza de cero, pero ahora ganas x%.1f de oro.", PlayerData.getRebirths(player), PlayerData.rebirthMultiplier(player)), "reward")
end

function Tycoon.init()
	tycoonFolder = Instance.new("Folder")
	tycoonFolder.Name = "Tycoons"
	tycoonFolder.Parent = workspace
	oreFolder = Instance.new("Folder")
	oreFolder.Name = "Ore"
	oreFolder.Parent = tycoonFolder

	for i = 1, Config.PlotCount do
		table.insert(plots, buildPlot(i))
	end

	Net.onServer("Rebirth", rebirth)
	local function onJoin(player: Player)
		player:SetAttribute("HasPlot", false)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in Players:GetPlayers() do
		onJoin(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local plot = plotOf[player]
		if plot then
			release(plot)
		end
		lastWarn[player] = nil
	end)
end

function Tycoon.start()
	while true do
		task.wait(0.2)
		updateGates()
	end
end

return Tycoon
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties>
<string name="Name">Verity</string>
<string name="Source"><![CDATA[--!strict
-- Verity tiene dos modos:
--   Noche (cada N minutos): la bola sonriente del portal se retuerce y se
--     transforma en el monstruo, que persigue al jugador visible mas cercano.
--     Atraviesa todo salvo el suelo, los refugios y las murallas (que golpea
--     hasta romperlas). Si lo matan, NO desaparece: huye herido hacia el
--     portal y se pierde en la oscuridad. Si nadie lo mata, se va al acabarse
--     el tiempo.
--   Final (Systems/FinalBattle): forma final mas grande y fuerte en el campo
--     de batalla, contra los jinetes que se unieron. Si muere, se hunde en la
--     tierra para siempre (hasta la proxima batalla final).
-- Modelo/rig y animaciones: los de "Survive A Verity" (Lib/VerityModel,
-- Controllers/VerityAnimator y Controllers/BallFX).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Pose = require(Shared.VerityPose)
local Types = require(Shared.Types)

local Build = require(script.Parent.Parent.Lib.Build)
local Sfx = require(script.Parent.Parent.Lib.Sfx)
local VerityModel = require(script.Parent.Parent.Lib.VerityModel)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local V = Config.Verity
local F = Config.FinalBattle
local S = Config.Sounds

type Mode = "Night" | "Final"

local Verity = {}

local phase: Types.VerityPhase = "Waiting"
local mode: Mode = "Night"
local P: any = V -- parametros del modo actual (Config.Verity o Config.FinalBattle)
local home = World.PortalPosition -- adonde vuelve / ronda
local participants: { [Player]: boolean }? = nil -- modo Final: solo estos son objetivo
local hold = false -- FinalBattle pausa las noches mientras convoca / pelea
local cycleStarted = false -- el contador empieza con el primer campamento reclamado
local nextAt = 0
local endsAt = 0
local health = 0
local maxHealth = 0
local model: Model? = nil
local root: BasePart? = nil
local humanoid: Humanoid? = nil
local highlight: Highlight? = nil
local ball: Model? = nil
local releasing = false -- transformacion o muerte: la IA esta apagada
local rootY = 8
local attackUntil = 0
local stunnedUntil = 0
local lastScream = 0
local lastMoveOrder = 0
local lastHurtSound = 0
local fleeStart = 0
local contributions: { [number]: number } = {}
local heartbeatConn: RBXScriptConnection? = nil
local warned: { [number]: boolean } = {}

local finalEnded = Instance.new("BindableEvent")
-- (victory: boolean) cuando termina la batalla final
Verity.FinalEnded = finalEnded.Event

local function now(): number
	return workspace:GetServerTimeNow()
end

local function interval(): number
	return if RunService:IsStudio() then V.StudioIntervalSeconds else V.IntervalSeconds
end

local function publish()
	workspace:SetAttribute("VerityPhase", phase)
	workspace:SetAttribute("VerityNextAt", if cycleStarted then nextAt else nil)
	workspace:SetAttribute("VerityEndsAt", endsAt)
	workspace:SetAttribute("VerityHP", math.max(0, math.floor(health)))
	workspace:SetAttribute("VerityMaxHP", maxHealth)
end

-- ===== Escondites =====

local function insidePart(part: BasePart, point: Vector3): boolean
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local half = part.Size / 2
	return math.abs(localPoint.X) <= half.X and math.abs(localPoint.Y) <= half.Y and math.abs(localPoint.Z) <= half.Z
end

function Verity.isHidden(player: Player, point: Vector3): boolean
	for _, zone in World.getHidingFolder():GetChildren() do
		if zone:IsA("BasePart") then
			local owner = zone:GetAttribute("OwnerUserId")
			if (owner == nil or owner == player.UserId) and insidePart(zone, point) then
				return true
			end
		end
	end
	return false
end

local function rootOf(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local r = character:FindFirstChild("HumanoidRootPart")
	local h = character:FindFirstChildOfClass("Humanoid")
	if r and r:IsA("BasePart") and h and h.Health > 0 then
		return r, h
	end
	return nil, nil
end

-- ¿Puede Verity ir a por este jugador?
local function eligible(player: Player): boolean
	if mode == "Final" then
		return participants ~= nil and participants[player] == true
	end
	return not player:GetAttribute("Hidden")
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- ===== Bola sonriente (espera en el portal) =====

local function placeBall()
	if ball and ball.Parent then
		return
	end
	local template = ServerStorage:FindFirstChild("VerityBall")
	if not (template and template:IsA("Model")) then
		return
	end
	local m = template:Clone()
	local core = m:FindFirstChild("Core")
	if core and core:IsA("BasePart") then
		m.PrimaryPart = core
	end
	local center = World.PortalPosition + Vector3.new(0, 4, 0)
	-- mira hacia el centro del mapa (+Z desde el portal)
	m:PivotTo(CFrame.lookAt(center, center + Vector3.new(0, 0, 1)))
	m.Name = "VerityBall"
	CollectionService:AddTag(m, "VerityBall")
	m.Parent = workspace
	ball = m
end

-- ===== Murallas =====

local function wallSegments(wall: Instance): { BasePart }
	local list = {}
	for _, p in wall:GetChildren() do
		if p:IsA("BasePart") and p.Name == "WallSegment" then
			table.insert(list, p)
		end
	end
	return list
end

local function closestFlatDistance(part: BasePart, point: Vector3): number
	local lp = part.CFrame:PointToObjectSpace(point)
	local half = part.Size / 2
	local clamped = Vector3.new(math.clamp(lp.X, -half.X, half.X), math.clamp(lp.Y, -half.Y, half.Y), math.clamp(lp.Z, -half.Z, half.Z))
	return flat(part.CFrame:PointToWorldSpace(clamped) - point).Magnitude
end

-- Muralla intacta que le cierra el paso (a menos de 9 studs).
local function blockingWall(point: Vector3): Model?
	for _, wall in World.getWallFolder():GetChildren() do
		if wall:IsA("Model") and not wall:GetAttribute("Broken") then
			for _, seg in wallSegments(wall) do
				if closestFlatDistance(seg, point) <= 9 then
					return wall
				end
			end
		end
	end
	return nil
end

local function setWallBroken(wall: Model, broken: boolean)
	wall:SetAttribute("Broken", broken)
	for _, seg in wallSegments(wall) do
		seg.CanCollide = not broken
		if not seg:GetAttribute("Invisible") then -- la barrera de la puerta siempre es invisible
			seg.Transparency = if broken then 0.85 else 0
		end
	end
end

local function restoreWalls()
	for _, wall in World.getWallFolder():GetChildren() do
		if wall:IsA("Model") then
			wall:SetAttribute("HP", wall:GetAttribute("MaxHP"))
			setWallBroken(wall, false)
		end
	end
end

-- ===== Efectos =====

-- Rugido de monstruo (no grito): el asset propio si esta subido; si no, el
-- alarido de Pro Sound Effects a mitad de velocidad suena grave y gutural,
-- con un golpe de bajo muy lento debajo para darle cuerpo.
local function roar(parent: Instance, volume: number, maxDistance: number?, pitch: number?)
	local k = pitch or 1
	if S.VerityRoar ~= 0 then
		Sfx.play(S.VerityRoar, parent, { Volume = volume, Speed = k, MaxDistance = maxDistance })
	else
		Sfx.play(S.RoarSource, parent, { Volume = volume, Speed = 0.5 * k, MaxDistance = maxDistance })
		Sfx.play(S.Bass, parent, { Volume = volume, Speed = 0.3 * k, MaxDistance = maxDistance })
	end
end

local function flash(color: Color3)
	local h = highlight
	if not h then
		return
	end
	h.FillColor = color
	h.FillTransparency = 0.4
	task.delay(0.15, function()
		if h.Parent then
			h.FillTransparency = 1
		end
	end)
end

local function screamFx(at: Vector3, radius: number)
	local ring = Build.part({
		Name = "Roar",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(at + Vector3.new(0, 8, 0)),
		Color = Color3.fromRGB(120, 0, 0),
		Material = Enum.Material.ForceField,
		CanCollide = false,
		Parent = workspace,
	})
	ring.CanQuery = false
	ring.CanTouch = false
	local d = radius * 2
	TweenService:Create(ring, TweenInfo.new(0.6), { Size = Vector3.new(d, d, d), Transparency = 1 }):Play()
	task.delay(0.7, function()
		ring:Destroy()
	end)
end

-- ===== Ciclo de vida =====

local function despawn()
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
	if model then
		model:Destroy()
	end
	model, root, humanoid, highlight = nil, nil, nil, nil
	releasing = false
	phase = "Waiting"
	mode = "Night"
	P = V
	home = World.PortalPosition
	participants = nil
	nextAt = now() + interval()
	endsAt = 0
	health = 0
	warned = {}
	contributions = {}
	restoreWalls()
	publish()
	task.delay(3, placeBall) -- la bola vuelve al portal
end

local function giveRewards()
	local total = 0
	for _, dmg in contributions do
		total += dmg
	end
	for userId, dmg in contributions do
		local player = Players:GetPlayerByUserId(userId)
		if player and total > 0 then
			local reward = P.ParticipationReward + math.floor(P.RewardPool * dmg / total)
			PlayerData.addGold(player, reward)
			PlayerData.addVerityKill(player)
			Net.fireClient(player, "Notify", string.format("Recompensa por tu valor: +%d oro", reward), "reward")
		end
	end
end

-- Noche normal: herido, deja de pelear y corre de vuelta al portal.
local function startFlee()
	local r, h, m = root, humanoid, model
	if not r or not h or not m then
		despawn()
		return
	end
	phase = "Fleeing"
	fleeStart = now()
	attackUntil = 0
	m:SetAttribute("KillStart", nil)
	m:SetAttribute("Sprinting", true)
	h.WalkSpeed = V.FleeSpeed
	h:MoveTo(home)
	roar(r, 2.2, 260, 0.8)
	Sfx.play(S.Victory, workspace, { Volume = 1.2 })
	Net.fireAll("Notify", "VERITY, HERIDO, HUYE HACIA LA OSCURIDAD. Volvera...", "reward")
	publish()
end

-- Batalla final: se retuerce y se hunde en la tierra.
local function finalDeath()
	local m, r = model, root
	if not m or not r then
		finalEnded:Fire(true)
		despawn()
		return
	end
	releasing = true
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
	m:SetAttribute("KillStart", nil)
	m:SetAttribute("TransformStart", now()) -- la pose de transformacion sirve de agonia
	r.Anchored = true
	roar(r, 3, 600, 0.7)
	Sfx.play(S.Victory, workspace, { Volume = 1.5 })
	Net.fireAll("Notify", "LA FORMA FINAL DE VERITY HA CAIDO. El imperio del Khan es eterno.", "reward")
	task.spawn(function()
		local start = m:GetPivot()
		local depth = rootY * 2.2
		for i = 1, 70 do
			if not m.Parent then
				break
			end
			local a = i / 70
			local shake = (1 - a) * 0.8
			m:PivotTo(start * CFrame.new((math.random() - 0.5) * shake, -depth * a * a, (math.random() - 0.5) * shake))
			task.wait(0.05)
		end
		finalEnded:Fire(true)
		despawn()
	end)
end

local function defeat()
	giveRewards()
	if mode == "Final" then
		finalDeath()
	else
		startFlee()
	end
end

local function canAttack(t: number): boolean
	return t >= attackUntil + P.MeleeCooldown - P.AttackAnimTime and t >= stunnedUntil
end

-- Animacion "levantar y aplastar" (el cliente la ve via KillStart).
-- onImpact corre en el instante del golpe.
local function swing(onImpact: () -> ())
	local m = model
	if not m then
		return
	end
	local t = now()
	attackUntil = t + P.AttackAnimTime
	m:SetAttribute("KillStart", t)
	task.delay(Pose.KillImpact, function()
		if model == m and root and phase ~= "Fleeing" then
			flash(Color3.fromRGB(255, 0, 0))
			Sfx.play(S.Bass, root, { Volume = 2, Speed = 0.5, MaxDistance = 120 })
			onImpact()
		end
	end)
	task.delay(P.AttackAnimTime, function()
		if model == m then
			m:SetAttribute("KillStart", nil)
		end
	end)
end

local function attackPlayer(targetPlayer: Player)
	swing(function()
		local r, h = rootOf(targetPlayer)
		if r and h and root and eligible(targetPlayer) and flat(r.Position - root.Position).Magnitude <= P.MeleeRange + 3 then
			h:TakeDamage(P.MeleeDamage)
			Sfx.play(S.PlayerScream, r, { Volume = 0.7 })
		end
	end)
end

local function attackWall(wall: Model)
	swing(function()
		if not wall.Parent or wall:GetAttribute("Broken") then
			return
		end
		local hp = math.max(0, ((wall:GetAttribute("HP") :: number?) or 0) - V.WallDamage)
		wall:SetAttribute("HP", hp)
		if root then
			Sfx.play(S.Slash, root, { Volume = 1.5, Speed = 0.35 })
		end
		if hp <= 0 then
			setWallBroken(wall, true)
			local owner = Players:GetPlayerByUserId((wall:GetAttribute("OwnerUserId") :: number?) or 0)
			if owner then
				Net.fireClient(owner, "Notify", "Verity rompio tu muralla. Se reparara cuando se vaya.", "danger")
			end
		end
	end)
end

local function stepFlee(r: BasePart, h: Humanoid, t: number)
	if t - lastMoveOrder >= 0.2 then
		lastMoveOrder = t
		h:MoveTo(home)
	end
	if flat(home - r.Position).Magnitude < 10 or t - fleeStart > V.FleeTimeout then
		Net.fireAll("Notify", "Verity se perdio en la oscuridad del portal.", "warning")
		despawn()
	end
end

local function step(_dt: number)
	local r, h = root, humanoid
	if not model or not r or not h or releasing then
		return
	end
	local t = now()

	if r.Position.Y < home.Y - 40 then -- por si cae del mapa
		model:PivotTo(CFrame.new(home + Vector3.new(0, rootY, 0)))
	end

	if phase == "Fleeing" then
		stepFlee(r, h, t)
		return
	end

	if t >= endsAt then
		if mode == "Final" then
			Net.fireAll("Notify", "La forma final de Verity resistio. Volved mas fuertes.", "danger")
			finalEnded:Fire(false)
		else
			Net.fireAll("Notify", "Verity se desvanece en la niebla... por ahora.", "warning")
		end
		despawn()
		return
	end

	-- objetivo: el jugador valido y vivo mas cercano
	local position = r.Position
	local target: BasePart? = nil
	local targetPlayer: Player? = nil
	local bestDist = math.huge
	for _, player in Players:GetPlayers() do
		local pr = rootOf(player)
		if pr and eligible(player) then
			local d = flat(pr.Position - position).Magnitude
			if d < bestDist then
				bestDist = d
				target = pr
				targetPlayer = player
			end
		end
	end

	local stunned = t < stunnedUntil
	local enraged = health / maxHealth <= P.EnrageThreshold
	local speed = if enraged then P.EnragedSpeed else P.WalkSpeed
	h.WalkSpeed = if stunned then speed * 0.3 else speed
	model:SetAttribute("Sprinting", (enraged or mode == "Final") and target ~= nil and not stunned)

	-- moverse (quieto mientras ataca)
	if t - lastMoveOrder >= 0.1 then
		lastMoveOrder = t
		if t < attackUntil then
			h:MoveTo(position)
		elseif target then
			h:MoveTo(target.Position)
		elseif flat(home - position).Magnitude > 6 then
			h:MoveTo(home) -- nadie a la vista: vuelve a rondar su sitio
		end
	end

	if canAttack(t) then
		if targetPlayer and bestDist <= P.MeleeRange then
			attackPlayer(targetPlayer)
		elseif mode == "Night" and target and flat(r.AssemblyLinearVelocity).Magnitude < 3 then
			-- frenado por una muralla: la golpea
			local wall = blockingWall(position)
			if wall then
				attackWall(wall)
			end
		end
	end

	-- rugido: dana a todos los que esten a tiro
	if not stunned and t - lastScream >= P.ScreamCooldown then
		local victims = {}
		for _, player in Players:GetPlayers() do
			local pr, ph = rootOf(player)
			if pr and ph and eligible(player) and flat(pr.Position - position).Magnitude <= P.ScreamRadius then
				table.insert(victims, ph)
			end
		end
		if #victims > 0 then
			lastScream = t
			screamFx(position, P.ScreamRadius)
			roar(r, if mode == "Final" then 3 else 2, if mode == "Final" then 400 else 220, if mode == "Final" then 0.8 else 1)
			for _, ph in victims do
				ph:TakeDamage(P.ScreamDamage)
			end
			Net.fireAll("Notify", "Verity RUGE", "danger")
		end
	end

	publish()
end

function Verity.getPhase(): Types.VerityPhase
	return phase
end

function Verity.isActive(): boolean
	return (phase == "Active" or phase == "Final") and model ~= nil and root ~= nil and not releasing
end

-- "Grosor" de Verity para el alcance de las armas (la forma final es mas grande).
function Verity.getHitRadius(): number
	return V.HitRadius * (if mode == "Final" then F.Scale else 1)
end

function Verity.getPosition(): Vector3?
	if not Verity.isActive() then
		return nil
	end
	return (root :: BasePart).Position
end

-- Llamado por Weapons y ThroatSing tras validar alcance y cooldown.
function Verity.damage(player: Player, amount: number)
	if not Verity.isActive() or amount <= 0 then
		return
	end
	health -= amount
	contributions[player.UserId] = (contributions[player.UserId] or 0) + amount
	flash(Color3.fromRGB(255, 200, 0))
	local t = os.clock()
	if root and t - lastHurtSound > 0.25 then
		lastHurtSound = t
		Sfx.play(S.Bass, root, { Volume = 0.8, Speed = 1.8 })
	end
	if health <= 0 then
		health = 0
		publish()
		defeat()
	else
		publish()
	end
end

-- Canto de garganta: lo deja lento y sin atacar unos segundos.
function Verity.stun(seconds: number)
	if not Verity.isActive() then
		return
	end
	stunnedUntil = math.max(stunnedUntil, now() + seconds)
	flash(Color3.fromRGB(80, 180, 255))
end

-- Tycoon: alguien reclamo un campamento. La primera vez arranca el contador.
function Verity.startCycle()
	if cycleStarted then
		return
	end
	cycleStarted = true
	nextAt = now() + interval()
	warned = {}
	publish()
end

-- FinalBattle: mientras convoca o pelea, las noches normales se posponen.
function Verity.setHold(value: boolean)
	hold = value
end

-- FinalBattle: un jinete murio o se fue; deja de ser objetivo.
function Verity.removeParticipant(player: Player)
	if participants then
		participants[player] = nil
	end
end

-- FinalBattle: ya no queda nadie peleando.
function Verity.abortFinal()
	if mode == "Final" and phase == "Final" and not releasing then
		Net.fireAll("Notify", "Los jinetes cayeron. La forma final de Verity resistio.", "danger")
		finalEnded:Fire(false)
		despawn()
	end
end

-- Crea el monstruo invisible y lo revela con la animacion de transformacion.
-- scale: 1 en la noche, F.Scale en la batalla final.
local function emerge(at: Vector3, scale: number, onReleased: () -> ()): boolean
	local m, rig = VerityModel.create()
	if not m or not rig then
		warn("[Verity] No hay modelo de Verity (falta ServerStorage.VerityFallback).")
		return false
	end
	if scale ~= 1 then
		m:ScaleTo(m:GetScale() * scale)
	end
	local r = m.PrimaryPart
	local h = m:FindFirstChildOfClass("Humanoid")
	if not r or not h then
		m:Destroy()
		return false
	end
	h.HipHeight = rig.hipHeight * scale

	Build.ensureGroups()
	local hiddenParts: { [BasePart]: number } = {}
	for _, inst in m:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.CollisionGroup = Build.VERITY_GROUP
			if inst ~= r then
				hiddenParts[inst] = inst.Transparency
				inst.Transparency = 1 -- invisible hasta la transformacion
			end
		end
	end
	local hl = Instance.new("Highlight")
	hl.Name = "HitFlash"
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.Parent = m

	-- se mantiene de pie: solo puede girar sobre el eje vertical
	local upright = Instance.new("Attachment")
	upright.Name = "UprightAttachment"
	upright.CFrame = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, -Vector3.xAxis) -- eje X del attachment = arriba
	upright.Parent = r
	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.AlignType = Enum.AlignType.PrimaryAxisParallel
	align.Attachment0 = upright
	align.PrimaryAxis = Vector3.yAxis
	align.MaxTorque = 1e8
	align.Responsiveness = 60
	align.Parent = r

	rootY = rig.rootY * scale
	r.Anchored = true
	m:PivotTo(CFrame.new(at + Vector3.new(0, rootY + 0.5, 0)) * CFrame.Angles(0, math.pi, 0))
	h.WalkSpeed = P.WalkSpeed
	m.Parent = workspace

	model, root, humanoid, highlight = m, r, h, hl
	attackUntil = 0
	stunnedUntil = 0
	contributions = {}
	releasing = true

	local start = now()
	m:SetAttribute("TransformStart", start)
	Sfx.play(S.Bass, workspace, { Volume = 1.5, Speed = 0.35 })

	task.spawn(function()
		local duration = V.TransformTime
		local revealFrom = duration * 0.35
		local steps = 14
		task.wait(revealFrom)
		for i = 1, steps do
			local alpha = i / steps
			for part, base in hiddenParts do
				if part.Parent then
					part.Transparency = 1 - (1 - base) * alpha
				end
			end
			task.wait((duration - revealFrom) / steps)
		end
		if model ~= m then
			return
		end
		m:SetAttribute("TransformStart", nil)
		r.Anchored = false
		r:SetNetworkOwner(nil) -- el servidor mueve a Verity
		releasing = false
		lastScream = now()
		heartbeatConn = RunService.Heartbeat:Connect(step)
		onReleased()
	end)
	return true
end

-- Noche normal: la bola sonriente se retuerce y se convierte en el monstruo.
function Verity.spawn()
	if phase ~= "Waiting" then
		return
	end
	cycleStarted = true
	mode = "Night"
	P = V
	home = World.PortalPosition
	participants = nil
	local ok = emerge(home, 1, function()
		-- rugido de liberacion: lo oyen todos
		roar(workspace, 1.8)
		Net.fireAll("Notify", "VERITY HA DESPERTADO. Pelea con tus armas o escondete hasta que se vaya.", "danger")
	end)
	if not ok then
		nextAt = now() + interval()
		publish()
		return
	end
	if ball then
		ball:SetAttribute("TransformStart", now()) -- BallFX: se retuerce y se hunde en el monstruo
		task.delay(V.TransformTime, function()
			if ball then
				ball:Destroy()
				ball = nil
			end
		end)
	end
	local count = math.max(1, #Players:GetPlayers())
	maxHealth = V.BaseHealth + V.HealthPerPlayer * (count - 1)
	health = maxHealth
	phase = "Active"
	endsAt = now() + V.DurationSeconds + V.TransformTime
	publish()
	Net.fireAll("Notify", "La bola sonriente se retuerce...", "danger")
end

-- Batalla final: forma final en el centro del campo contra los jinetes.
function Verity.spawnFinal(center: Vector3, riders: { Player }): boolean
	if phase ~= "Waiting" then
		return false
	end
	mode = "Final"
	P = F
	home = center
	participants = {}
	for _, player in riders do
		(participants :: { [Player]: boolean })[player] = true
	end
	local ok = emerge(center, F.Scale, function()
		roar(workspace, 2.5, nil, 0.8)
		Net.fireAll("Notify", "LA FORMA FINAL DE VERITY HA DESPERTADO", "danger")
	end)
	if not ok then
		mode, P, home, participants = "Night", V, World.PortalPosition, nil
		return false
	end
	local m = model :: Model
	-- aura de fuego de la forma final
	local aura = Instance.new("Highlight")
	aura.Name = "FinalAura"
	aura.FillColor = Color3.fromRGB(90, 0, 0)
	aura.FillTransparency = 0.7
	aura.OutlineColor = Color3.fromRGB(255, 60, 0)
	aura.OutlineTransparency = 0
	aura.Parent = m
	local fire = Instance.new("Fire")
	fire.Size = 18
	fire.Heat = 20
	fire.Color = Color3.fromRGB(255, 80, 20)
	fire.SecondaryColor = Color3.fromRGB(120, 0, 0)
	fire.Parent = root

	maxHealth = F.BaseHealth + F.HealthPerPlayer * (math.max(1, #riders) - 1)
	health = maxHealth
	phase = "Final"
	endsAt = now() + F.Duration + V.TransformTime
	publish()
	return true
end

function Verity.init()
	VerityModel.load()
	nextAt = now() + interval()
	publish()

	-- Comando de prueba: "/verity" en el chat (solo en Studio o el creador del juego)
	local function allowed(player: Player?): boolean
		return player ~= nil and (RunService:IsStudio() or player.UserId == game.CreatorId)
	end
	pcall(function() -- chat nuevo (TextChatService)
		local command = Instance.new("TextChatCommand")
		command.Name = "VerityCommand"
		command.PrimaryAlias = "/verity"
		command.Triggered:Connect(function(source: TextSource)
			if allowed(Players:GetPlayerByUserId(source.UserId)) and not hold then
				Verity.spawn()
			end
		end)
		command.Parent = game:GetService("TextChatService")
	end)
	local function hook(player: Player) -- chat clasico
		player.Chatted:Connect(function(message)
			if message:lower() == "/verity" and allowed(player) and not hold then
				Verity.spawn()
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		Verity.removeParticipant(player)
	end)
end

function Verity.start()
	placeBall()
	while true do
		task.wait(0.25)

		-- actualizar quien esta escondido (lo lee la IA y el HUD del cliente)
		for _, player in Players:GetPlayers() do
			local r = rootOf(player)
			local hidden = r ~= nil and Verity.isHidden(player, r.Position)
			if player:GetAttribute("Hidden") ~= hidden then
				player:SetAttribute("Hidden", hidden)
			end
		end

		if phase == "Waiting" and cycleStarted then
			if hold then
				-- batalla final en marcha: la noche se pospone
				nextAt = math.max(nextAt, now() + 90)
				warned = {}
				publish()
			else
				local remaining = nextAt - now()
				for _, mark in V.WarningTimes do
					-- solo avisa al cruzar la marca (no si el intervalo ya empezo por debajo)
					if remaining <= mark and remaining > mark - 2 and not warned[mark] then
						warned[mark] = true
						local text = if mark >= 60
							then string.format("Verity despierta en %d minuto(s)...", mark // 60)
							else string.format("Verity despierta en %d segundos. Prepara tus armas o busca refugio.", mark)
						Net.fireAll("Notify", text, "warning")
					end
				end
				if remaining <= 0 then
					Verity.spawn()
				end
			end
		end
	end
end

return Verity
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties>
<string name="Name">Weapons</string>
<string name="Source"><![CDATA[--!strict
-- Armas: se crean por codigo, se guardan en StarterGear (se conservan al morir)
-- y el dano se valida en el servidor (alcance + cooldown). Solo danan a Verity.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Types = require(Shared.Types)

local Build = require(script.Parent.Parent.Lib.Build)
local Sfx = require(script.Parent.Parent.Lib.Sfx)
local Verity = require(script.Parent.Verity)

local Weapons = {}

-- colores de las armas (arriba: tambien los usa onActivated)
local STEEL = Color3.fromRGB(205, 208, 215)
local BRONZE = Color3.fromRGB(190, 140, 60)
local LEATHER = Color3.fromRGB(70, 42, 25)
local TRUENO_COLOR = Color3.fromRGB(120, 200, 255)

local bound: { [Tool]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local lastUse: { [Player]: { [string]: number } } = {}

local function playAnim(tool: Tool, name: string)
	-- el script Animate por defecto reacciona a este StringValue
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = name
	anim.Parent = tool
end

local function projectile(from: Vector3, to: Vector3, color: Color3)
	local dist = (to - from).Magnitude
	local bolt = Build.part({
		Name = "Projectile",
		Size = Vector3.new(0.3, 0.3, 2),
		CFrame = CFrame.lookAt(from, to),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = workspace,
	})
	bolt.CanQuery = false
	bolt.CanTouch = false
	local time = math.clamp(dist / 220, 0.05, 0.5)
	TweenService:Create(bolt, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) }):Play()
	task.delay(time + 0.05, function()
		bolt:Destroy()
	end)
end

-- ===== Arco compuesto: disparo =====

local B = Config.Bow

local function arrowProjectile(from: Vector3, to: Vector3)
	local dist = (to - from).Magnitude
	local arrow = Build.part({
		Name = "Arrow",
		Size = Vector3.new(0.14, 0.14, 3),
		CFrame = CFrame.lookAt(from, to),
		Color = Color3.fromRGB(110, 75, 40),
		Material = Enum.Material.Wood,
		CanCollide = false,
		Parent = workspace,
	})
	arrow.CanQuery = false
	arrow.CanTouch = false
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.08, 1.4)
	a0.Parent = arrow
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.08, 1.4)
	a1.Parent = arrow
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.2
	trail.Color = ColorSequence.new(Color3.fromRGB(240, 230, 200))
	trail.Transparency = NumberSequence.new(0.4, 1)
	trail.Parent = arrow
	local time = math.clamp(dist / 180, 0.05, 0.6)
	TweenService:Create(arrow, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) }):Play()
	task.delay(time + 0.3, function()
		arrow:Destroy()
	end)
end

-- Tensa (los clientes lo animan a partir de ShotAt) y dispara al terminar.
-- Sin Verity a tiro, la flecha sale igual hacia delante.
local function shootBow(tool: Tool, player: Player, character: Model, def: Types.WeaponDef)
	tool:SetAttribute("ShotAt", workspace:GetServerTimeNow())
	local handle = tool:FindFirstChild("Handle")
	if handle then
		Sfx.play(Config.Sounds.BowDraw, handle, { Volume = 0.6, Speed = 0.5 })
	end
	task.delay(B.DrawTime, function()
		if tool.Parent ~= character then
			return -- lo guardo antes de soltar
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not (root and root:IsA("BasePart") and humanoid and humanoid.Health > 0) then
			return
		end
		local from = if handle and handle:IsA("BasePart") then handle.Position else root.Position
		local bossPos = Verity.getPosition()
		local to: Vector3
		local hit = false
		if bossPos and Vector3.new(bossPos.X - root.Position.X, 0, bossPos.Z - root.Position.Z).Magnitude - Verity.getHitRadius() <= def.Range then
			to = bossPos
			hit = true
		else
			to = from + root.CFrame.LookVector * def.Range
		end
		arrowProjectile(from, to)
		Sfx.play(Config.Sounds.Lunge, if handle then handle else root, { Volume = 0.7, Speed = 1.8 })
		if hit then
			Verity.damage(player, def.Damage)
		end
	end)
end

local function onActivated(tool: Tool)
	local character = tool.Parent
	if not character then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	local id = tool:GetAttribute("WeaponId")
	if not player or typeof(id) ~= "string" then
		return
	end
	local def = Config.Weapons[id]
	if not def then
		return
	end

	local t = os.clock()
	local uses = lastUse[player]
	if not uses then
		uses = {}
		lastUse[player] = uses
	end
	if t - (uses[id] or 0) < def.Cooldown then
		return
	end
	uses[id] = t

	if id == "Arco" then
		shootBow(tool, player, character :: Model, def)
		return
	end

	local handleInst = tool:FindFirstChild("Handle")
	local soundAt: Instance = if handleInst then handleInst else tool
	if not def.Ranged then
		playAnim(tool, if id == "Lanza" then "Lunge" else "Slash")
		Sfx.play(if id == "Lanza" then Config.Sounds.Lunge else Config.Sounds.Slash, soundAt, { Volume = 0.8 })
	else
		Sfx.play(Config.Sounds.Bass, soundAt, { Volume = 1.5, Speed = 0.6 })
	end

	local bossPos = Verity.getPosition()
	local root = (character :: Model):FindFirstChild("HumanoidRootPart")
	local humanoid = (character :: Model):FindFirstChildOfClass("Humanoid")
	if not bossPos or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end

	local flat = Vector3.new(bossPos.X - root.Position.X, 0, bossPos.Z - root.Position.Z)
	if flat.Magnitude - Verity.getHitRadius() > def.Range then
		return
	end

	if def.Ranged then
		local handle = tool:FindFirstChild("Handle")
		local from = if handle and handle:IsA("BasePart") then handle.Position else root.Position
		projectile(from, bossPos, TRUENO_COLOR)
	end
	Verity.damage(player, def.Damage)
end

local function bind(tool: Instance)
	if not tool:IsA("Tool") or bound[tool] or tool:GetAttribute("WeaponId") == nil then
		return
	end
	bound[tool] = true
	tool.Activated:Connect(function()
		onActivated(tool)
	end)
end

-- ===== Armas cuerpo a cuerpo y baculo (modelos hechos con piezas) =====
-- Convencion del agarre (la misma que el arco): la mano queda en GripPos
-- (espacio del mango), +Z apunta hacia arriba / hacia la punta y +X hacia
-- delante (el filo). Todas las piezas se sueldan al mango.


local function newTool(id: string, def: Types.WeaponDef, gripPos: Vector3): Tool
	local tool = Instance.new("Tool")
	tool.Name = def.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = string.format("Dano %d | Alcance %d", def.Damage, def.Range)
	tool:SetAttribute("WeaponId", id)
	tool.GripPos = gripPos
	tool.GripForward = Vector3.new(-1, 0, 0)
	tool.GripRight = Vector3.new(0, 1, 0)
	tool.GripUp = Vector3.new(0, 0, 1)
	return tool
end

local function handlePart(tool: Tool, size: Vector3, color: Color3, material: Enum.Material): Part
	local handle = Build.part({ Name = "Handle", Size = size, CFrame = CFrame.new(), Color = color, Material = material, Anchored = false, CanCollide = false })
	handle.Massless = true
	handle.Parent = tool
	return handle
end

-- Pieza decorativa soldada al mango (cf en el espacio del mango).
local function attach(tool: Tool, handle: BasePart, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Build.part({ Name = name, Size = size, CFrame = cf, Color = color, Material = material, Shape = shape, Anchored = false, CanCollide = false })
	p.Massless = true
	p.CanQuery = false
	p.CanTouch = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = p
	weld.Parent = p
	p.Parent = tool
	return p
end

-- Cilindro con su eje a lo largo de Z (el eje propio del cilindro de Roblox es X).
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0)

-- Sable mongol: hoja curva de acero (se curva hacia atras), guarda redonda de
-- bronce con gavilanes, empunadura de cuero y pomo.
local function buildSaber(def: Types.WeaponDef): Tool
	local tool = newTool("Sable", def, Vector3.zero)
	local handle = handlePart(tool, Vector3.new(0.3, 0.36, 1.3), LEATHER, Enum.Material.Fabric)
	attach(tool, handle, "Pommel", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 0, -0.8), BRONZE, Enum.Material.Metal, Enum.PartType.Ball)
	attach(tool, handle, "Guard", Vector3.new(0.2, 1.0, 1.0), CFrame.new(0, 0, 0.75) * ALONG_Z, BRONZE, Enum.Material.Metal, Enum.PartType.Cylinder)
	attach(tool, handle, "Quillons", Vector3.new(1.5, 0.16, 0.16), CFrame.new(0, 0, 0.78), BRONZE, Enum.Material.Metal)
	-- hoja: segmentos que giran 5 grados cada uno hacia -X y se van afinando
	local point = Vector3.new(0, 0, 0.88)
	local widths = { 0.34, 0.33, 0.31, 0.29, 0.26, 0.22, 0.14 }
	local lengths = { 0.72, 0.72, 0.72, 0.72, 0.72, 0.6, 0.45 }
	for k = 1, #widths do
		local angle = math.rad(5 * (k - 1))
		local dir = Vector3.new(-math.sin(angle), 0, math.cos(angle))
		local nextPoint = point + dir * lengths[k]
		local blade = attach(tool, handle, "Blade", Vector3.new(widths[k], 0.07, lengths[k] + 0.05), CFrame.lookAt((point + nextPoint) / 2, nextPoint), STEEL, Enum.Material.Metal)
		blade.Reflectance = 0.25
		point = nextPoint
	end
	return tool
end

-- Lanza del Khan: asta larga, punta de hoja de acero, anillo de bronce, borla
-- de crin roja (tipica de las lanzas mongolas) y regaton en la base.
local function buildSpear(def: Types.WeaponDef): Tool
	local tool = newTool("Lanza", def, Vector3.new(0, 0, -1.5))
	local handle = handlePart(tool, Vector3.new(0.3, 0.3, 9), Color3.fromRGB(95, 62, 32), Enum.Material.Wood)
	attach(tool, handle, "Butt", Vector3.new(0.4, 0.4, 0.45), CFrame.new(0, 0, -4.65), BRONZE, Enum.Material.Metal)
	attach(tool, handle, "Collar", Vector3.new(0.4, 0.46, 0.46), CFrame.new(0, 0, 4.6) * ALONG_Z, BRONZE, Enum.Material.Metal, Enum.PartType.Cylinder)
	local head = { { z = 5.3, w = 0.55, l = 1.0 }, { z = 6.2, w = 0.32, l = 0.9 }, { z = 6.85, w = 0.12, l = 0.5 } }
	for _, seg in head do
		local p = attach(tool, handle, "SpearHead", Vector3.new(seg.w, 0.08, seg.l), CFrame.new(0, 0, seg.z), STEEL, Enum.Material.Metal)
		p.Reflectance = 0.25
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		attach(tool, handle, "Tassel", Vector3.new(0.09, 0.09, 1.5), CFrame.new(math.cos(a) * 0.22, math.sin(a) * 0.22, 3.85) * CFrame.Angles(math.sin(a) * 0.35, -math.cos(a) * 0.35, 0), Color3.fromRGB(170, 25, 25), Enum.Material.Fabric)
	end
	return tool
end

-- Trueno de Tengri: baculo de metal azul con anillos de oro, puntas de rayo y
-- un orbe que brilla (Tengri, el cielo eterno).
local function buildThunderStaff(def: Types.WeaponDef): Tool
	local tool = newTool("Trueno", def, Vector3.new(0, 0, -1.2))
	local handle = handlePart(tool, Vector3.new(0.34, 0.34, 6.5), Color3.fromRGB(40, 60, 120), Enum.Material.Metal)
	attach(tool, handle, "Cap", Vector3.new(0.45, 0.45, 0.3), CFrame.new(0, 0, -3.35), BRONZE, Enum.Material.Metal)
	for _, z in { 1.6, 2.4, 3.0 } do
		attach(tool, handle, "Ring", Vector3.new(0.18, 0.55, 0.55), CFrame.new(0, 0, z) * ALONG_Z, Color3.fromRGB(230, 190, 60), Enum.Material.Metal, Enum.PartType.Cylinder)
	end
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		attach(tool, handle, "Prong", Vector3.new(0.12, 0.12, 1.3), CFrame.new(math.cos(a) * 0.35, math.sin(a) * 0.35, 3.75) * CFrame.Angles(-math.sin(a) * 0.4, math.cos(a) * 0.4, 0), Color3.fromRGB(230, 190, 60), Enum.Material.Metal)
	end
	local orb = attach(tool, handle, "Orb", Vector3.new(0.95, 0.95, 0.95), CFrame.new(0, 0, 3.75), TRUENO_COLOR, Enum.Material.Neon, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color = TRUENO_COLOR
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = orb
	return tool
end

-- Arco recurvo mongol: mango forrado, palas curvas con las puntas (siyah)
-- hacia delante, cuerda en dos mitades y flecha encordada. La cuerda y la
-- flecha van con Weld (no WeldConstraint) para que el cliente las mueva al
-- tensar cambiando Weld.C0 (Controllers/BowAnimator).
local function buildBow(def: Types.WeaponDef): Tool
	local tool = Instance.new("Tool")
	tool.Name = def.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = string.format("Dano %d | Alcance %d", def.Damage, def.Range)
	tool:SetAttribute("WeaponId", "Arco")
	tool.GripPos = Vector3.zero
	tool.GripForward = Vector3.new(-1, 0, 0)
	tool.GripRight = Vector3.new(0, 1, 0)
	tool.GripUp = Vector3.new(0, 0, 1)

	local wood = Color3.fromRGB(95, 60, 30)
	local handle = Build.part({ Name = "Handle", Size = Vector3.new(0.3, 0.45, 1.2), CFrame = CFrame.new(), Color = wood, Material = Enum.Material.Wood, Anchored = false, CanCollide = false })
	handle.Massless = true
	handle.Parent = tool

	local function fixed(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, weldTo: BasePart?): Part
		local p = Build.part({ Name = name, Size = size, CFrame = cf, Color = color, Material = material, Anchored = false, CanCollide = false })
		p.Massless = true
		p.CanQuery = false
		p.CanTouch = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = weldTo or handle
		weld.Part1 = p
		weld.Parent = p
		p.Parent = tool
		return p
	end

	local function movable(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
		local p = Build.part({ Name = name, Size = size, CFrame = cf, Color = color, Material = material, Anchored = false, CanCollide = false })
		p.Massless = true
		p.CanQuery = false
		p.CanTouch = false
		local weld = Instance.new("Weld")
		weld.Name = "BowWeld"
		weld.Part0 = handle
		weld.Part1 = p
		weld.C0 = cf -- el mango esta en el origen al construir
		weld.Parent = p
		p.Parent = tool
		return p
	end

	-- forro rojo del agarre
	fixed("Wrap", Vector3.new(0.36, 0.5, 0.7), CFrame.new(), Color3.fromRGB(150, 30, 30), Enum.Material.Fabric)

	-- palas: de la empunadura hacia atras (hacia el arquero) y la punta hacia delante
	local limb = {
		Vector3.new(0, 0, 0.55),
		Vector3.new(-0.15, 0, 1.5),
		Vector3.new(-0.55, 0, 2.5),
		Vector3.new(-0.95, 0, 3.1),
		B.StringTop,
	}
	for _, side in { 1, -1 } do
		for i = 1, #limb - 1 do
			local a = limb[i] * Vector3.new(1, 1, side)
			local b = limb[i + 1] * Vector3.new(1, 1, side)
			local len = (b - a).Magnitude
			fixed("Limb", Vector3.new(0.2, 0.32, len + 0.12), CFrame.lookAt((a + b) / 2, b), wood, Enum.Material.Wood)
		end
		-- refuerzo de hueso en la punta
		local tip = B.StringTop * Vector3.new(1, 1, side)
		fixed("Nock", Vector3.new(0.26, 0.36, 0.26), CFrame.new(tip), Color3.fromRGB(235, 225, 200), Enum.Material.SmoothPlastic)
	end

	-- cuerda en reposo (el cliente la redibuja al tensar)
	local nock = Vector3.new(B.StringTop.X, 0, 0)
	local function stringCf(tipPoint: Vector3): (Vector3, CFrame)
		local len = (tipPoint - nock).Magnitude
		return Vector3.new(0.06, 0.06, len), CFrame.lookAt((tipPoint + nock) / 2, tipPoint)
	end
	local topSize, topCf = stringCf(B.StringTop)
	movable("StringTop", topSize, topCf, Color3.fromRGB(240, 235, 220), Enum.Material.SmoothPlastic)
	local bottomSize, bottomCf = stringCf(B.StringBottom)
	movable("StringBottom", bottomSize, bottomCf, Color3.fromRGB(240, 235, 220), Enum.Material.SmoothPlastic)

	-- flecha encordada: astil, punta de hierro y plumas rojas
	local center = nock + Vector3.new(B.ArrowLength / 2, 0, 0)
	local arrowCf = CFrame.lookAt(center, center + Vector3.xAxis)
	local arrow = movable("NockedArrow", Vector3.new(0.1, 0.1, B.ArrowLength), arrowCf, Color3.fromRGB(150, 110, 60), Enum.Material.Wood)
	fixed("ArrowHead", Vector3.new(0.22, 0.22, 0.5), arrowCf * CFrame.new(0, 0, -B.ArrowLength / 2 - 0.2), Color3.fromRGB(90, 90, 95), Enum.Material.Metal, arrow)
	fixed("Fletching", Vector3.new(0.04, 0.3, 0.6), arrowCf * CFrame.new(0, 0, B.ArrowLength / 2 - 0.4), Color3.fromRGB(180, 30, 30), Enum.Material.Fabric, arrow)
	return tool
end

local function buildTool(id: string): Tool?
	local def = Config.Weapons[id]
	if not def then
		return nil
	end
	if id == "Arco" then
		return buildBow(def)
	elseif id == "Sable" then
		return buildSaber(def)
	elseif id == "Lanza" then
		return buildSpear(def)
	elseif id == "Trueno" then
		return buildThunderStaff(def)
	end
	return nil
end

-- Copia decorativa del arma (anclada, sin Tool) para la mesa de la armeria.
-- Queda tumbada: su eje largo (Z) en horizontal y centrada en la empunadura.
function Weapons.displayModel(id: string): Model?
	local tool = buildTool(id)
	if not tool then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "Display_" .. id
	for _, inst in tool:GetChildren() do
		if inst:IsA("BasePart") then
			inst.Anchored = true
			inst.CanCollide = false
			inst.CanTouch = false
			inst.CanQuery = false
			inst.Parent = model
		end
	end
	tool:Destroy()
	local grip = model:FindFirstChild("Handle")
	if grip and grip:IsA("BasePart") then
		grip.Name = "Grip"
		model.PrimaryPart = grip
	end
	return model
end

function Weapons.grant(player: Player, id: string)
	local gear = player:FindFirstChild("StarterGear")
	if not gear then
		return
	end
	for _, existing in gear:GetChildren() do
		if existing:GetAttribute("WeaponId") == id then
			return
		end
	end
	local tool = buildTool(id)
	if not tool then
		return
	end
	tool.Parent = gear
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		local copy = tool:Clone()
		copy.Parent = backpack
		bind(copy)
	end
end

-- Quita todas las armas (al renacer): mochila, mano y StarterGear.
function Weapons.revoke(player: Player)
	local places: { Instance? } = { player:FindFirstChild("StarterGear"), player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, place in places do
		if place then
			for _, item in place:GetChildren() do
				if item:IsA("Tool") and item:GetAttribute("WeaponId") ~= nil then
					item:Destroy()
				end
			end
		end
	end
end

function Weapons.init()
	local function watchBackpack(player: Player)
		local backpack = player:WaitForChild("Backpack")
		for _, child in backpack:GetChildren() do
			bind(child)
		end
		backpack.ChildAdded:Connect(bind)
	end
	local function hook(player: Player)
		player.CharacterAdded:Connect(function()
			watchBackpack(player)
		end)
		if player.Character then
			task.spawn(watchBackpack, player)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastUse[player] = nil
	end)
end

return Weapons
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties>
<string name="Name">World</string>
<string name="Source"><![CDATA[--!strict
-- Construye la estepa: suelo, spawn central, estandarte del Khan,
-- cuevas del chaman (refugios publicos) y el portal por donde llega Verity.
local Lighting = game:GetService("Lighting")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Build = require(script.Parent.Parent.Lib.Build)
local Horse = require(script.Parent.Parent.Lib.Horse)

local World = {}

World.PortalPosition = Vector3.new(0, 0, -260)

local mapFolder: Folder? = nil
local hidingFolder: Folder? = nil
local wallFolder: Folder? = nil

-- Murallas compradas (Model con atributos HP, MaxHP, OwnerUserId, Broken).
function World.getWallFolder(): Folder
	if not wallFolder then
		local f = Instance.new("Folder")
		f.Name = "Walls"
		f.Parent = workspace
		wallFolder = f
	end
	return wallFolder :: Folder
end

function World.getMapFolder(): Folder
	if not mapFolder then
		local f = Instance.new("Folder")
		f.Name = "Map"
		f.Parent = workspace
		mapFolder = f
	end
	return mapFolder :: Folder
end

-- Carpeta con todas las zonas de escondite (publicas y Gran Yurta de cada plot).
function World.getHidingFolder(): Folder
	if not hidingFolder then
		local f = Instance.new("Folder")
		f.Name = "HidingZones"
		f.Parent = workspace
		hidingFolder = f
	end
	return hidingFolder :: Folder
end

-- ===== Terreno y paisaje =====
-- El suelo es el pasto natural del terreno de Roblox (hojas largas con
-- Decoration). Donde no debe salir pasto (plaza, campamentos, caminos,
-- cuevas, portal) el terreno es de otro material. Debajo hay piezas
-- invisibles (grupo Ground) que son el suelo de Verity.

local RIVER_Z = 239 -- el rio Onon cruza el sur del mapa
local RIVER_HALF = 7

local function plotCenters(): { CFrame }
	local list = {}
	for i = 1, Config.PlotCount do
		local angle = (i - 1) / Config.PlotCount * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * Config.PlotRingRadius, 0, math.sin(angle) * Config.PlotRingRadius)
		table.insert(list, CFrame.lookAt(pos, Vector3.zero))
	end
	return list
end

-- ===== Rellenos de terreno alineados a la rejilla =====
-- El terreno de Roblox va en celdas de 4x4x4 studs. Un relleno girado o
-- redondo (FillBlock con rotacion, FillCylinder) deja el borde de arriba
-- "suavizado" y levanta el suelo unos 2 studs, tapando pisos y botones.
-- Por eso todo se rellena con bloques SIN girar, alineados a la rejilla y con
-- la cara de arriba en FILL_TOP. Las formas giradas o redondas se
-- arman fila a fila con tramos rectos.
local VOXEL = 4
-- Roblox dibuja la superficie del terreno unos 2 studs POR ENCIMA del borde
-- de arriba del relleno (visto en el juego: con rellenos hasta y = 0 el suelo
-- tapaba los botones y el spawn). Por eso todo se rellena hasta y = -2 y la
-- superficie visible queda a ras de los pisos (y = 0).
local FILL_TOP = -2

local function fillRect(terrain: Terrain, x0: number, x1: number, z0: number, z1: number, material: Enum.Material)
	local ax0 = math.floor(math.min(x0, x1) / VOXEL) * VOXEL
	local ax1 = math.ceil(math.max(x0, x1) / VOXEL) * VOXEL
	local az0 = math.floor(math.min(z0, z1) / VOXEL) * VOXEL
	local az1 = math.ceil(math.max(z0, z1) / VOXEL) * VOXEL
	if ax1 > ax0 and az1 > az0 then
		terrain:FillBlock(CFrame.new((ax0 + ax1) / 2, FILL_TOP - 6, (az0 + az1) / 2), Vector3.new(ax1 - ax0, 12, az1 - az0), material)
	end
end

-- Recorre la rejilla por filas y rellena los tramos de celdas cuyo centro esta dentro.
local function fillShape(terrain: Terrain, minX: number, maxX: number, minZ: number, maxZ: number, inside: (Vector3) -> boolean, material: Enum.Material)
	local x0 = math.floor(minX / VOXEL) * VOXEL
	local x1 = math.ceil(maxX / VOXEL) * VOXEL
	local z0 = math.floor(minZ / VOXEL) * VOXEL
	local z1 = math.ceil(maxZ / VOXEL) * VOXEL
	for z = z0, z1 - VOXEL, VOXEL do
		local runStart: number? = nil
		for x = x0, x1, VOXEL do
			local cellInside = x < x1 and inside(Vector3.new(x + VOXEL / 2, 0, z + VOXEL / 2))
			if cellInside and runStart == nil then
				runStart = x
			elseif not cellInside and runStart ~= nil then
				fillRect(terrain, runStart, x, z, z + VOXEL, material)
				runStart = nil
			end
		end
	end
end

local function fillDisc(terrain: Terrain, center: Vector3, radius: number, material: Enum.Material)
	fillShape(terrain, center.X - radius, center.X + radius, center.Z - radius, center.Z + radius, function(p)
		return Vector3.new(p.X - center.X, 0, p.Z - center.Z).Magnitude <= radius
	end, material)
end

-- Rectangulo girado (cf a nivel del suelo, tamano en sus ejes X y Z locales).
local function fillRotatedRect(terrain: Terrain, cf: CFrame, sizeX: number, sizeZ: number, material: Enum.Material)
	local hx, hz = sizeX / 2, sizeZ / 2
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, corner in { Vector3.new(-hx, 0, -hz), Vector3.new(hx, 0, -hz), Vector3.new(-hx, 0, hz), Vector3.new(hx, 0, hz) } do
		local w = cf:PointToWorldSpace(corner)
		minX, maxX = math.min(minX, w.X), math.max(maxX, w.X)
		minZ, maxZ = math.min(minZ, w.Z), math.max(maxZ, w.Z)
	end
	fillShape(terrain, minX, maxX, minZ, maxZ, function(p)
		local l = cf:PointToObjectSpace(Vector3.new(p.X, cf.Position.Y, p.Z))
		return math.abs(l.X) <= hx and math.abs(l.Z) <= hz
	end, material)
end

-- Pasto natural de Roblox: Terrain con material Grass y Decoration (las hojas
-- largas que se mueven con el viento). GrassLength = 1 es el largo maximo.
-- Las hojas solo se dibujan con calidad grafica media o alta.
local function naturalGrass(terrain: Terrain)
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 140, 58))
	pcall(function()
		terrain.Decoration = true
	end)
	pcall(function()
		(terrain :: any).GrassLength = 1
	end)
end

-- Suelo invisible de Verity (solo choca con el grupo Ground): coincide con la
-- superficie del terreno (y = 0).
local function verityFloor(name: string, size: Vector3, cf: CFrame, parent: Instance)
	local p = Build.part({ Name = name, Size = size, CFrame = cf, Transparency = 1, Parent = parent })
	p.CanQuery = false
	Build.markGround(p)
end

local function buildGround(map: Folder)
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	local terrain = workspace.Terrain
	naturalGrass(terrain)
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(118, 98, 70))
	terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(205, 182, 135))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(108, 102, 96))
	terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(130, 120, 105))
	terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(70, 58, 45))
	terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(235, 238, 245))
	terrain.WaterColor = Color3.fromRGB(45, 85, 100)
	terrain.WaterTransparency = 0.45
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 6
	terrain.WaterReflectance = 0.6

	-- pradera de pasto natural (superficie en y = 0)
	local HALF = 550
	terrain:FillBlock(CFrame.new(0, FILL_TOP - 6, 0), Vector3.new(HALF * 2, 12, HALF * 2), Enum.Material.Grass)

	-- rio Onon: lecho y orillas de arena, agua encima
	terrain:FillBlock(CFrame.new(0, FILL_TOP - 2, RIVER_Z), Vector3.new(HALF * 2, 4, RIVER_HALF * 2 + 10), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(0, FILL_TOP - 3, RIVER_Z), Vector3.new(HALF * 2, 6, RIVER_HALF * 2), Enum.Material.Water)
	local riverSign = Build.part({ Name = "RiverSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(0, 8, RIVER_Z), Transparency = 1, CanCollide = false, Parent = map })
	Build.billboard(riverSign, "Rio Onon", 0, 220).TextColor3 = Color3.fromRGB(180, 220, 255)

	-- donde NO debe salir pasto: plaza empedrada (con sus yurtas), arena bajo los
	-- campamentos, tierra en los caminos y las cuevas, barro en el portal.
	-- Se rellena toda la profundidad (12 studs, superficie en y = 0) con
	-- bloques alineados a la rejilla (ver fillRect): asi ni salen hojas ni el
	-- suelo se levanta sobre los pisos y los botones.
	fillDisc(terrain, Vector3.zero, 50, Enum.Material.Cobblestone)
	for _, cf in plotCenters() do
		fillRotatedRect(terrain, cf, 100, 100, Enum.Material.Sand)
		-- camino de la plaza a la entrada (mismo trazado que las flechas de Tycoon)
		local dir = Vector3.new(cf.Position.X, 0, cf.Position.Z).Unit
		local from = dir * 28
		local to = dir * (Config.PlotRingRadius - 45)
		fillRotatedRect(terrain, CFrame.lookAt((from + to) / 2, to), 10, (to - from).Magnitude, Enum.Material.Ground)
	end
	for i = 0, 3 do
		local angle = math.pi / 4 + i * math.pi / 2
		fillDisc(terrain, Vector3.new(math.cos(angle) * 75, 0, math.sin(angle) * 75), 20, Enum.Material.Ground)
	end
	fillDisc(terrain, World.PortalPosition, 30, Enum.Material.Mud)

	-- horizonte: colinas y montanas nevadas SOLO lejos (nada toca edificios, campamentos ni el portal)
	local rng = Random.new(1206) -- 1206: Temujin es proclamado Gengis Khan
	for _ = 1, 26 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(400, 440)
		local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		if math.abs(pos.Z - RIVER_Z) > 40 then
			local r = rng:NextNumber(18, 32) -- borde interior >= 368
			terrain:FillBall(pos - Vector3.new(0, r * 0.55, 0), r, Enum.Material.Grass)
		end
	end
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local dist = rng:NextNumber(500, 540)
		local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		local r = rng:NextNumber(70, 100) -- borde interior >= 400
		terrain:FillBall(pos - Vector3.new(0, r * 0.35, 0), r, Enum.Material.Rock)
		terrain:FillBall(pos + Vector3.new(0, r * 0.45, 0), r * 0.3, Enum.Material.Snow)
	end

	-- suelo de Verity: sin cubrir el rio (el agua se cruza nadando)
	local north = RIVER_Z - RIVER_HALF + HALF
	verityFloor("Steppe", Vector3.new(HALF * 2, 2, north), CFrame.new(0, -1, -HALF + north / 2), map)
	local south = HALF - (RIVER_Z + RIVER_HALF)
	verityFloor("SteppeSouth", Vector3.new(HALF * 2, 2, south), CFrame.new(0, -1, HALF - south / 2), map)
end

-- Ovoos (altares de piedras con seda azul), yurtas nomadas,
-- fogata en la plaza y caballos salvajes pastando.
local function buildScenery(map: Folder)
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = map
	local rng = Random.new(1162) -- 1162: nace Temujin
	local plots = plotCenters()

	local function free(pos: Vector3, margin: number): boolean
		if pos.Magnitude < 34 or math.abs(pos.Z - RIVER_Z) < RIVER_HALF + 8 then
			return false
		end
		if (pos - World.PortalPosition).Magnitude < 40 then
			return false
		end
		for _, cf in plots do
			if (pos - cf.Position).Magnitude < 66 + margin then
				return false
			end
		end
		for i = 0, 3 do
			local angle = math.pi / 4 + i * math.pi / 2
			if (pos - Vector3.new(math.cos(angle) * 75, 0, math.sin(angle) * 75)).Magnitude < 22 + margin then
				return false
			end
		end
		return true
	end
	local function randomSpot(minR: number, maxR: number, margin: number): Vector3?
		for _ = 1, 30 do
			local angle = rng:NextNumber(0, math.pi * 2)
			local dist = rng:NextNumber(minR, maxR)
			local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
			if free(pos, margin) then
				return pos
			end
		end
		return nil
	end

	-- ovoos: monton de piedras con un palo y cintas de seda azul (khadag)
	local function ovoo(pos: Vector3)
		local model = Instance.new("Model")
		model.Name = "Ovoo"
		for layer = 0, 3 do
			local r = 6 - layer * 1.4
			for k = 0, 7 - layer do
				local a = k / (8 - layer) * math.pi * 2 + layer
				local s = rng:NextNumber(1.6, 2.6)
				Build.part({ Name = "Stone", Size = Vector3.new(s, s * 0.8, s), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, 0.6 + layer * 1.3, math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0), Color = Color3.fromRGB(120, 115, 108), Material = Enum.Material.Slate, Parent = model })
			end
		end
		Build.part({ Name = "Pole", Size = Vector3.new(0.6, 12, 0.6), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)), Color = Color3.fromRGB(110, 75, 40), Material = Enum.Material.Wood, Parent = model })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			local ribbon = Build.part({
				Name = "Khadag",
				Size = Vector3.new(0.1, 3, 0.7),
				CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 1.2, 10, math.sin(a) * 1.2)) * CFrame.Angles(0, -a, math.rad(25)),
				Color = Color3.fromRGB(40, 110, 200),
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = model,
			})
			ribbon.CanQuery = false
		end
		model.Parent = scenery
	end
	ovoo(Vector3.new(235, 0, -70))
	ovoo(Vector3.new(-235, 0, 70))
	ovoo(Vector3.new(120, 0, -235))

	-- yurtas nomadas alrededor de la plaza, con la puerta hacia el estandarte
	for _, angle in { 0, math.pi, -math.pi / 2 } do
		local pos = Vector3.new(math.cos(angle) * 40, 0, math.sin(angle) * 40)
		local yurt = Build.yurt(scenery, CFrame.lookAt(pos, Vector3.zero), 6, 7)
		Build.markSolid(yurt)
	end

	-- fogata de la plaza
	local fireCf = CFrame.new(10, 0, -10)
	for k = 0, 3 do
		Build.part({ Name = "Log", Size = Vector3.new(0.8, 0.8, 4), CFrame = fireCf * CFrame.Angles(0, k * math.pi / 4, 0) * CFrame.new(0, 0.4, 0), Color = Color3.fromRGB(80, 55, 35), Material = Enum.Material.Wood, Parent = scenery })
	end
	local ember = Build.part({ Name = "Embers", Size = Vector3.new(2, 0.6, 2), CFrame = fireCf * CFrame.new(0, 0.6, 0), Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = scenery })
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 12
	fire.Parent = ember
	local smoke = Instance.new("Smoke")
	smoke.Opacity = 0.08
	smoke.RiseVelocity = 4
	smoke.Size = 3
	smoke.Parent = ember
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 22
	light.Brightness = 1.5
	light.Parent = ember

	-- caballos salvajes pastando en grupos
	local coats = { Color3.fromRGB(115, 72, 40), Color3.fromRGB(70, 45, 30), Color3.fromRGB(190, 170, 140), Color3.fromRGB(40, 32, 28) }
	for _, herd in { Vector3.new(220, 0, 165), Vector3.new(-230, 0, -160), Vector3.new(0, 0, 205), Vector3.new(-240, 0, 180) } do
		for k = 1, 3 do
			local pos = herd + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
			Horse.statue(pos, rng:NextNumber(0, math.pi * 2), coats[rng:NextInteger(1, #coats)], scenery)
		end
	end
end

-- Luz de la estepa: atmosfera con bruma, nubes, sol con rayos y un leve grading.
local function buildLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(70, 70, 80)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 135, 125)
	Lighting.ExposureCompensation = 0.1
	local function ensure(className: string, name: string, parent: Instance): Instance
		local existing = parent:FindFirstChild(name)
		if existing then
			return existing
		end
		local inst = Instance.new(className)
		inst.Name = name
		inst.Parent = parent
		return inst
	end
	local atmosphere = ensure("Atmosphere", "SteppeAtmosphere", Lighting) :: Atmosphere
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(199, 186, 160)
	atmosphere.Decay = Color3.fromRGB(120, 110, 95)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.4
	ensure("Sky", "SteppeSky", Lighting)
	local bloom = ensure("BloomEffect", "SteppeBloom", Lighting) :: BloomEffect
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.6
	local rays = ensure("SunRaysEffect", "SteppeSunRays", Lighting) :: SunRaysEffect
	rays.Intensity = 0.08
	rays.Spread = 0.8
	local grade = ensure("ColorCorrectionEffect", "SteppeGrade", Lighting) :: ColorCorrectionEffect
	grade.Saturation = 0.12
	grade.Contrast = 0.08
	grade.TintColor = Color3.fromRGB(255, 248, 235)
	local clouds = ensure("Clouds", "SteppeClouds", workspace.Terrain) :: Clouds
	clouds.Cover = 0.55
	clouds.Density = 0.55
end

local function buildCenter(map: Folder)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CentralSpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, 20)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(170, 30, 30)
	spawn.Material = Enum.Material.Slate
	spawn.Parent = map

	-- Sulde: estandarte de crines del Khan
	Build.part({ Name = "SuldePole", Size = Vector3.new(1, 30, 1), CFrame = CFrame.new(0, 15, 0), Color = Color3.fromRGB(90, 60, 30), Material = Enum.Material.Wood, Parent = map })
	Build.part({
		Name = "SuldeTuft",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(0, 28, 0),
		Color = Color3.fromRGB(30, 25, 20),
		Material = Enum.Material.Fabric,
		Parent = map,
	})
	local tip = Build.part({ Name = "SuldeTip", Size = Vector3.new(0.6, 4, 0.6), CFrame = CFrame.new(0, 32, 0), Color = Color3.fromRGB(230, 190, 60), Material = Enum.Material.Metal, Parent = map })
	Build.billboard(tip, "ESTEPA DEL KHAN", 4, 300)
end

local function buildCaves(map: Folder)
	local hiding = World.getHidingFolder()
	for i = 0, 3 do
		local angle = math.pi / 4 + i * math.pi / 2
		local pos = Vector3.new(math.cos(angle) * 75, 0, math.sin(angle) * 75)
		-- la puerta (lado -Z local) mira hacia el centro
		local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
		local cave = Build.boxShelter(map, cf, 22, 22, 11, Color3.fromRGB(95, 90, 85), Enum.Material.Slate)
		cave.Name = "ShamanCave"
		Build.markSolid(cave)
		Build.hidingZone(hiding, cf * CFrame.new(0, 5, 0), Vector3.new(19, 10, 19), nil)
		local sign = Build.part({ Name = "Sign", Size = Vector3.new(1, 1, 1), CFrame = cf * CFrame.new(0, 14, -11), Transparency = 1, CanCollide = false, Parent = cave })
		Build.billboard(sign, "Cueva del Chaman (refugio)", 0, 260)
		-- fogata adentro
		local fire = Build.part({ Name = "Fire", Size = Vector3.new(2, 1, 2), CFrame = cf * CFrame.new(0, 0.5, 4), Color = Color3.fromRGB(80, 50, 30), Material = Enum.Material.Wood, Parent = cave })
		Instance.new("Fire", fire).Size = 4
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 160, 80)
		light.Range = 18
		light.Parent = fire
	end
end

local function buildPortal(map: Folder)
	local base = World.PortalPosition
	for i = 0, 9 do
		local angle = i / 10 * math.pi * 2
		local h = 8 + (i % 3) * 3
		Build.part({
			Name = "PortalStone",
			Size = Vector3.new(2.5, h, 2.5),
			CFrame = CFrame.new(base + Vector3.new(math.cos(angle) * 16, h / 2, math.sin(angle) * 16)) * CFrame.Angles(0, angle, math.rad(6)),
			Color = Color3.fromRGB(20, 20, 24),
			Material = Enum.Material.Basalt,
			Parent = map,
		})
	end
	local core = Build.part({
		Name = "PortalCore",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 26, 26),
		CFrame = CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(10, 0, 0),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = map,
	})
	core.Transparency = 0.2
	local sign = Build.part({ Name = "PortalSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(base + Vector3.new(0, 18, 0)), Transparency = 1, CanCollide = false, Parent = map })
	Build.billboard(sign, "Aqui despierta Verity", 0, 260).TextColor3 = Color3.fromRGB(255, 80, 80)
end

-- Campo de la batalla final: llanura aparte, lejos del mapa principal, con
-- piedras, braseros y paredes invisibles en el borde (para no caerse a caballo).
local function buildArena(map: Folder)
	local F = Config.FinalBattle
	local center = F.Arena
	local half = F.ArenaHalfSize
	local arena = Instance.new("Folder")
	arena.Name = "FinalArena"
	arena.Parent = map
	-- campo de batalla: pasto natural con manchas de tierra pisoteada
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(center + Vector3.new(0, FILL_TOP - 6, 0)), Vector3.new(half * 2 + 120, 12, half * 2 + 120), Enum.Material.Grass)
	local arenaRng = Random.new(1227) -- 1227: muere Gengis Khan
	for _ = 1, 30 do
		local p = center + Vector3.new(arenaRng:NextNumber(-half + 30, half - 30), 0, arenaRng:NextNumber(-half + 30, half - 30))
		fillDisc(terrain, p, arenaRng:NextNumber(10, 26), Enum.Material.Ground)
	end
	verityFloor("ArenaGround", Vector3.new(half * 2 + 20, 2, half * 2 + 20), CFrame.new(center + Vector3.new(0, -1, 0)), arena)
	for i = 0, 3 do
		local angle = i * math.pi / 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local edge = Build.part({
			Name = "ArenaEdge",
			Size = Vector3.new(half * 2 + 20, 60, 4),
			CFrame = CFrame.lookAt(center + dir * (half + 8) + Vector3.new(0, 30, 0), center + Vector3.new(0, 30, 0)),
			Transparency = 1,
			Parent = arena,
		})
		edge.CanQuery = false
	end
	-- anillo de piedras y braseros
	for i = 0, 15 do
		local angle = i / 16 * math.pi * 2
		local pos = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (half - 30)
		local h = 14 + (i % 3) * 6
		Build.part({ Name = "Stone", Size = Vector3.new(5, h, 5), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, angle, math.rad(5)), Color = Color3.fromRGB(40, 38, 40), Material = Enum.Material.Basalt, Parent = arena })
		if i % 2 == 0 then
			local brazier = Build.part({ Name = "Brazier", Size = Vector3.new(4, 3, 4), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0) - (pos - center).Unit * 10), Color = Color3.fromRGB(60, 40, 25), Material = Enum.Material.Metal, Parent = arena })
			local fire = Instance.new("Fire")
			fire.Size = 8
			fire.Parent = brazier
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 140, 60)
			light.Range = 40
			light.Brightness = 2
			light.Parent = brazier
		end
	end
	local sign = Build.part({ Name = "ArenaSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(center + Vector3.new(0, 70, 0)), Transparency = 1, CanCollide = false, Parent = arena })
	Build.billboard(sign, "CAMPO DE LA BATALLA FINAL", 0, 500).TextColor3 = Color3.fromRGB(255, 120, 60)
end

function World.init()
	local map = World.getMapFolder()
	buildGround(map)
	buildCenter(map)
	buildCaves(map)
	buildPortal(map)
	buildArena(map)
	buildScenery(map)
	buildLighting()

end

return World
]]></string>
