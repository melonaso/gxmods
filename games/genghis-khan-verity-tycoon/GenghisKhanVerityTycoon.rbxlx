<Item class="LocalScript" referent="RBX00000026"><Properties>
<string name="Name">Client</string>
<string name="Source"><![CDATA[--!strict
-- Unico punto de entrada del cliente. Arranque en dos fases:
-- init() de todos los controladores primero, luego start() de todos.
-- Cada controlador arranca protegido: si uno falla, se avisa en Output y los
-- demas siguen funcionando (antes un error cortaba todo el arranque).
local Controllers = script.Controllers

local loaded: { [string]: any } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			loaded[child.Name] = result
		else
			warn("[Client] no se pudo cargar " .. child.Name .. ": " .. tostring(result))
		end
	end
end

for name, system in loaded do
	if typeof(system.init) == "function" then
		local ok, err = pcall(system.init)
		if not ok then
			warn("[Client] " .. name .. ".init fallo: " .. tostring(err))
		end
	end
end

for name, system in loaded do
	if typeof(system.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(system.start)
			if not ok then
				warn("[Client] " .. name .. ".start fallo: " .. tostring(err))
			end
		end)
	end
end
]]></string>
</Properties>
<Item class="Folder" referent="RBX00000025"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000019"><Properties>
<string name="Name">BallFX</string>
<string name="Source"><![CDATA[--!strict
-- Tomado del proyecto "Survive A Verity" (rama claude/keen-galileo-at0rx6).
-- Animación local de la bola sonriente (diseño original de Verity):
--   - espera: flota, se balancea y da tics como si mirara a su alrededor
--   - transformación (TransformStart): se retuerce cada vez más rápido,
--     tiembla, se eleva hasta el pecho del monstruo y se hunde en él
-- El servidor solo coloca la bola y marca TransformStart; todo el movimiento
-- es local (las piezas están ancladas).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Config = require(ReplicatedStorage.Shared.Config)

type Ball = {
	model: Model,
	base: CFrame,
	twitchAt: number,
	twitch: CFrame,
	goo: ParticleEmitter?,
}

local BallFX = {}

local balls: { [Model]: Ball } = {}

local function track(inst: Instance)
	if not inst:IsA("Model") or balls[inst] then
		return
	end
	local core = inst:WaitForChild("Core", 5)
	if not core then
		return
	end
	balls[inst] = { model = inst, base = inst:GetPivot(), twitchAt = os.clock() + 1, twitch = CFrame.identity }
end

local function gooEmitter(ball: Ball): ParticleEmitter?
	if ball.goo then
		return ball.goo
	end
	local core = ball.model:FindFirstChild("Core")
	if not (core and core:IsA("BasePart")) then
		return nil
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = if Assets.Splash ~= "" then Assets.Splash else Assets.GlowOrb
	emitter.Color = ColorSequence.new(Color3.fromRGB(240, 210, 70), Color3.fromRGB(150, 110, 20))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.1) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Rate = 0
	emitter.Parent = core
	ball.goo = emitter
	return emitter
end

local function update(ball: Ball)
	local model = ball.model
	local clock = os.clock()
	local transformStart = model:GetAttribute("TransformStart") :: number?

	if not transformStart then
		if clock >= ball.twitchAt then
			ball.twitchAt = clock + 1.2 + math.random() * 2.5
			ball.twitch = CFrame.Angles((math.random() - 0.5) * 0.4, (math.random() - 0.5) * 1.2, (math.random() - 0.5) * 0.5)
		end
		local float = CFrame.new(0, math.sin(clock * 1.6) * 0.35, 0)
		local sway = CFrame.Angles(0, math.sin(clock * 0.5) * 0.3, math.sin(clock * 1.1) * 0.06)
		model:PivotTo(ball.base * float * sway * ball.twitch)
		local breathe = 1 + math.sin(clock * 2) * 0.025
		if math.abs(model:GetScale() - breathe) > 0.001 then
			model:ScaleTo(breathe)
		end
		return
	end

	local p = math.clamp((Workspace:GetServerTimeNow() - transformStart) / Config.Verity.TransformTime, 0, 1)
	local twist = math.clamp(p / 0.45, 0, 1)
	local rise = math.clamp((p - 0.45) / 0.35, 0, 1)
	local implode = math.clamp((p - 0.8) / 0.2, 0, 1)

	local spin = (twist ^ 2) * 9 + rise * 14 + implode * 10
	local shake = 0.45 * twist * (1 - implode)
	local offset = Vector3.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, (math.random() - 0.5) * shake)
	local wobble = math.sin(clock * 28) * 0.35 * twist
	local height = rise * rise * 7.5
	local scale = (1 + 0.22 * math.sin(clock * 32) * twist) * (1 - 0.4 * rise) * (1 - 0.95 * implode)

	model:PivotTo(ball.base * CFrame.new(offset + Vector3.new(0, height, 0)) * CFrame.Angles(wobble, spin, wobble * 0.6))
	model:ScaleTo(math.max(0.05, scale))

	local goo = gooEmitter(ball)
	if goo then
		goo.Rate = if p < 0.85 then 30 + 120 * twist else 0
	end
end

function BallFX.start()
	for _, inst in CollectionService:GetTagged("VerityBall") do
		task.spawn(track, inst)
	end
	CollectionService:GetInstanceAddedSignal("VerityBall"):Connect(function(inst)
		task.spawn(track, inst)
	end)
	CollectionService:GetInstanceRemovedSignal("VerityBall"):Connect(function(inst)
		balls[inst :: Model] = nil
	end)
	RunService.RenderStepped:Connect(function()
		for model, ball in balls do
			if model.Parent then
				update(ball)
			else
				balls[model] = nil
			end
		end
	end)
end

return BallFX
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties>
<string name="Name">BowAnimator</string>
<string name="Source"><![CDATA[--!strict
-- Animacion del Arco Compuesto, para cualquier jugador que lo tenga equipado:
--   listo   : flecha encordada, brazo izquierdo apoyado en la cuerda
--   tensar  : (ShotAt .. +DrawTime) la cuerda y la flecha retroceden hacia el
--             arquero y el brazo izquierdo tira hacia la cara
--   soltar  : la flecha desaparece (sale la del servidor) y la cuerda vibra
--   recargar: (tras RecoverTime) aparece una flecha nueva
-- El brazo derecho ya lo pone al frente la animacion "toolnone" de Roblox.
-- Todo es local: cambia Weld.C0 de la cuerda/flecha y Motor6D.C0 del brazo.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local B = Config.Bow

type Joint = { motor: Motor6D, base: CFrame, frame: CFrame }
type State = {
	tool: Tool,
	shoulder: Joint?,
	elbow: Joint?,
	blend: number,
}

local BowAnimator = {}

local states: { [Tool]: State } = {}

local function joint(character: Model, names: { string }): Joint?
	for _, inst in character:GetDescendants() do
		if inst:IsA("Motor6D") and table.find(names, inst.Name) then
			return { motor = inst, base = inst.C0, frame = inst.C0.Rotation }
		end
	end
	return nil
end

-- rotacion expresada en el marco del torso, sea cual sea el C0 (R15 o R6)
local function setJoint(j: Joint?, rotation: CFrame)
	if j and j.motor.Parent then
		j.motor.C0 = j.base * (j.frame:Inverse() * rotation * j.frame)
	end
end

local function restore(state: State)
	for _, j in { state.shoulder, state.elbow } do
		if j and j.motor.Parent then
			j.motor.C0 = j.base
		end
	end
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function placeString(tool: Tool, name: string, tip: Vector3, nock: Vector3)
	local part = tool:FindFirstChild(name)
	local weld = part and part:FindFirstChild("BowWeld")
	if part and part:IsA("BasePart") and weld and weld:IsA("Weld") then
		part.Size = Vector3.new(0.06, 0.06, (tip - nock).Magnitude)
		weld.C0 = CFrame.lookAt((tip + nock) / 2, tip)
	end
end

local function setArrowVisible(arrow: BasePart, visible: boolean)
	local t = if visible then 0 else 1
	arrow.LocalTransparencyModifier = t
	-- punta y plumas son piezas aparte soldadas a la flecha
	local tool = arrow.Parent
	if tool then
		for _, name in { "ArrowHead", "Fletching" } do
			local p = tool:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				p.LocalTransparencyModifier = t
			end
		end
	end
end

local function animate(state: State, character: Model, dt: number)
	local tool = state.tool
	local shotAt = (tool:GetAttribute("ShotAt") :: number?) or -math.huge
	local p = workspace:GetServerTimeNow() - shotAt

	local draw = 0
	local vibrate = 0
	local arrowVisible = true
	if p >= 0 and p < B.DrawTime then
		draw = smooth(p / B.DrawTime)
	elseif p >= B.DrawTime and p < B.DrawTime + B.RecoverTime then
		local q = p - B.DrawTime
		vibrate = math.sin(q * 70) * 0.25 * (1 - q / B.RecoverTime)
		arrowVisible = false
	end

	-- cuerda: el punto de encordar retrocede hacia el arquero (-X)
	local nock = Vector3.new(B.StringTop.X - B.DrawDistance * draw + vibrate, 0, 0)
	placeString(tool, "StringTop", B.StringTop, nock)
	placeString(tool, "StringBottom", B.StringBottom, nock)

	local arrow = tool:FindFirstChild("NockedArrow")
	local arrowWeld = arrow and arrow:FindFirstChild("BowWeld")
	if arrow and arrow:IsA("BasePart") and arrowWeld and arrowWeld:IsA("Weld") then
		local center = nock + Vector3.new(B.ArrowLength / 2, 0, 0)
		arrowWeld.C0 = CFrame.lookAt(center, center + Vector3.xAxis)
		setArrowVisible(arrow, arrowVisible)
	end

	-- brazo izquierdo: al frente apoyado en la cuerda; al tensar tira hacia la cara
	state.blend = math.min(1, state.blend + dt * 6) -- entra suave al equipar
	local k = state.blend
	local pitch = math.rad(80) * k
	local yaw = -(0.45 + 0.25 * draw) * k -- hacia el centro del cuerpo
	setJoint(state.shoulder, CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0))
	setJoint(state.elbow, CFrame.Angles(math.rad(25 + 85 * draw) * k, 0, 0))
end

function BowAnimator.start()
	RunService.RenderStepped:Connect(function(dt)
		local seen: { [Tool]: boolean } = {}
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local tool = character and character:FindFirstChildOfClass("Tool")
			if character and tool and tool:GetAttribute("WeaponId") == "Arco" then
				seen[tool] = true
				local state = states[tool]
				if not state then
					state = {
						tool = tool,
						shoulder = joint(character, { "LeftShoulder", "Left Shoulder" }),
						elbow = joint(character, { "LeftElbow" }),
						blend = 0,
					}
					states[tool] = state
				end
				animate(state, character, dt)
			end
		end
		-- arco guardado o personaje muerto: brazo a su sitio
		for tool, state in states do
			if not seen[tool] then
				restore(state)
				states[tool] = nil
			end
		end
	end)
end

return BowAnimator
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001B"><Properties>
<string name="Name">Guide</string>
<string name="Source"><![CDATA[--!strict
-- Mientras no tengas campamento (y ya acabo la intro), un haz azul en arco
-- sale de tu personaje hacia el circulo RECLAMAR libre mas cercano.
-- Las flechas de los caminos y sus letreros ("Campamento N: LIBRE") solo se
-- ven en TU pantalla cuando ya termino la intro y aun no tienes campamento
-- (los demas jugadores sin campamento los siguen viendo).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local HUD = require(script.Parent.HUD)

local player = Players.LocalPlayer

local Guide = {}

local beam: Beam
local guidesHidden: boolean? = nil

local function setGuidesHidden(hidden: boolean)
	local folder = workspace:FindFirstChild("Tycoons")
	if not folder then
		return
	end
	for _, inst in folder:GetDescendants() do
		if inst:IsA("BasePart") and (inst.Name == "ArrowShaft" or inst.Name == "ArrowTip") then
			inst.LocalTransparencyModifier = if hidden then 1 else 0
		elseif inst:IsA("BillboardGui") and inst.Parent and inst.Parent.Name == "GuideSign" then
			inst.Enabled = not hidden
		end
	end
	guidesHidden = hidden
end
local fromAttachment: Attachment
local toAttachment: Attachment

-- El eje X de un Attachment es la direccion del arco del Beam: lo ponemos hacia arriba.
local UP_AXIS = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, -Vector3.xAxis)

local function nearestFreePad(from: Vector3): BasePart?
	local folder = workspace:FindFirstChild("Tycoons")
	if not folder then
		return nil
	end
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, plot in folder:GetChildren() do
		local pad = plot:FindFirstChild("ClaimPad")
		if pad and pad:IsA("BasePart") then
			local d = (pad.Position - from).Magnitude
			if d < bestDist then
				bestDist = d
				best = pad
			end
		end
	end
	return best
end

function Guide.init()
	fromAttachment = Instance.new("Attachment")
	fromAttachment.Name = "GuideFrom"
	fromAttachment.CFrame = UP_AXIS
	toAttachment = Instance.new("Attachment")
	toAttachment.Name = "GuideTo"
	toAttachment.CFrame = UP_AXIS
	beam = Instance.new("Beam")
	beam.Name = "CampGuide"
	beam.Attachment0 = fromAttachment
	beam.Attachment1 = toAttachment
	beam.Color = ColorSequence.new(Color3.fromRGB(90, 170, 255), Color3.fromRGB(170, 220, 255))
	beam.Transparency = NumberSequence.new(0.15, 0.4)
	beam.LightEmission = 1
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.Segments = 24
	beam.CurveSize0 = 30 -- sube desde el jugador...
	beam.CurveSize1 = -30 -- ...y baja sobre el circulo
	beam.Enabled = false
end

function Guide.start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.3 then
			return
		end
		acc = 0
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hasPlot = player:GetAttribute("HasPlot") == true
		local introDone = HUD.isIntroDone()
		-- las flechas solo aparecen al terminar la intro y mientras no tengas campamento
		local hide = hasPlot or not introDone
		if guidesHidden ~= hide then
			setGuidesHidden(hide)
		end
		local wanted = introDone and not hasPlot
		local pad = if wanted and root and root:IsA("BasePart") then nearestFreePad(root.Position) else nil
		if pad and root and root:IsA("BasePart") then
			fromAttachment.Parent = root
			toAttachment.Parent = pad
			beam.Parent = root
			beam.Enabled = true
		else
			beam.Enabled = false
		end
	end)
end

return Guide
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001C"><Properties>
<string name="Name">HUD</string>
<string name="Source"><![CDATA[--!strict
-- Cuenta atras de Verity, barra de vida, aviso de "escondido" y notificaciones.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local player = Players.LocalPlayer

local COLORS = {
	info = Color3.fromRGB(240, 240, 240),
	warning = Color3.fromRGB(255, 200, 60),
	danger = Color3.fromRGB(255, 70, 70),
	reward = Color3.fromRGB(120, 255, 140),
}

local HUD = {}

local timerLabel: TextLabel
local hpFrame: Frame
local hpFill: Frame
local hpText: TextLabel
local hiddenLabel: TextLabel
local joinButton: TextButton
local joinedFinal = false
local introDone = false

-- Controllers/Intro avisa cuando termina la introduccion
function HUD.setIntroDone()
	introDone = true
end

function HUD.isIntroDone(): boolean
	return introDone
end
local toast: TextLabel
local toastToken = 0

local function label(parent: Instance, size: UDim2, pos: UDim2, textSize: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.AnchorPoint = Vector2.new(0.5, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = textSize
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	l.TextWrapped = true
	l.Parent = parent
	return l
end

local function format(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

local function showToast(text: string, kind: string?)
	toastToken += 1
	local token = toastToken
	toast.Text = text
	toast.TextColor3 = COLORS[kind or "info"] or COLORS.info
	toast.TextTransparency = 0
	toast.TextStrokeTransparency = 0.4
	task.delay(4, function()
		if token == toastToken then
			TweenService:Create(toast, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function HUD.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "VerityHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false

	timerLabel = label(gui, UDim2.fromOffset(500, 34), UDim2.new(0.5, 0, 0, 8), 24)

	hpFrame = Instance.new("Frame")
	hpFrame.Size = UDim2.new(0.5, 0, 0, 22)
	hpFrame.Position = UDim2.new(0.5, 0, 0, 46)
	hpFrame.AnchorPoint = Vector2.new(0.5, 0)
	hpFrame.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
	hpFrame.BorderSizePixel = 0
	hpFrame.Visible = false
	hpFrame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = hpFrame

	hpFill = Instance.new("Frame")
	hpFill.Size = UDim2.fromScale(1, 1)
	hpFill.BackgroundColor3 = Color3.fromRGB(200, 20, 20)
	hpFill.BorderSizePixel = 0
	hpFill.Parent = hpFrame
	corner:Clone().Parent = hpFill

	hpText = label(hpFrame, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0), 16)

	hiddenLabel = label(gui, UDim2.fromOffset(500, 30), UDim2.new(0.5, 0, 1, -130), 20)
	hiddenLabel.TextColor3 = Color3.fromRGB(140, 220, 255)
	hiddenLabel.Text = "ESCONDIDO - Verity no puede verte"
	hiddenLabel.Visible = false

	local version = Instance.new("TextLabel")
	version.Size = UDim2.fromOffset(260, 18)
	version.Position = UDim2.new(0, 16, 1, -52)
	version.AnchorPoint = Vector2.new(0, 1)
	version.BackgroundTransparency = 1
	version.Font = Enum.Font.Gotham
	version.TextSize = 13
	version.TextXAlignment = Enum.TextXAlignment.Left
	version.TextColor3 = Color3.fromRGB(200, 200, 200)
	version.TextStrokeTransparency = 0.6
	version.Text = "Genghis Khan Verity Tycoon " .. Config.Version
	version.Parent = gui

	-- si tu progreso se guarda o no (lo decide el servidor al cargar tus datos)
	local saveLabel = Instance.new("TextLabel")
	saveLabel.Size = UDim2.fromOffset(520, 18)
	saveLabel.Position = UDim2.new(0, 16, 1, -70)
	saveLabel.AnchorPoint = Vector2.new(0, 1)
	saveLabel.BackgroundTransparency = 1
	saveLabel.Font = Enum.Font.GothamBold
	saveLabel.TextSize = 13
	saveLabel.TextXAlignment = Enum.TextXAlignment.Left
	saveLabel.TextStrokeTransparency = 0.5
	saveLabel.Parent = gui
	local function showSave()
		local status = player:GetAttribute("SaveStatus")
		if status == "ok" then
			saveLabel.Text = "Progreso: se guarda"
			saveLabel.TextColor3 = Color3.fromRGB(120, 230, 130)
		elseif status == nil then
			saveLabel.Text = "Progreso: cargando..."
			saveLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
		else
			saveLabel.Text = "Progreso: NO se guarda (publica el juego y activa el acceso a API en Game Settings > Security)"
			saveLabel.TextColor3 = Color3.fromRGB(255, 110, 90)
		end
	end
	player:GetAttributeChangedSignal("SaveStatus"):Connect(showSave)
	showSave()

	joinButton = Instance.new("TextButton")
	joinButton.Size = UDim2.fromOffset(420, 54)
	joinButton.Position = UDim2.new(0.5, 0, 0.7, 0)
	joinButton.AnchorPoint = Vector2.new(0.5, 0.5)
	joinButton.BackgroundColor3 = Color3.fromRGB(200, 120, 20)
	joinButton.Font = Enum.Font.GothamBlack
	joinButton.TextSize = 20
	joinButton.TextColor3 = Color3.new(1, 1, 1)
	joinButton.Visible = false
	joinButton.Parent = gui
	local joinCorner = Instance.new("UICorner")
	joinCorner.CornerRadius = UDim.new(0, 10)
	joinCorner.Parent = joinButton
	joinButton.Activated:Connect(function()
		joinedFinal = true
		joinButton.Visible = false
		Net.fireServer("FinalJoin")
	end)

	toast = label(gui, UDim2.fromOffset(620, 60), UDim2.new(0.5, 0, 0, 80), 22)
	toast.TextTransparency = 1
	toast.TextStrokeTransparency = 1

	gui.Parent = player:WaitForChild("PlayerGui")
end

function HUD.start()
	Net.onClient("Notify", function(text: any, kind: any)
		if typeof(text) == "string" then
			showToast(text, if typeof(kind) == "string" then kind else nil)
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		local t = workspace:GetServerTimeNow()
		local phase = workspace:GetAttribute("VerityPhase")
		local finalPhase = workspace:GetAttribute("FinalPhase")

		-- convocatoria de la batalla final: boton para unirse
		if finalPhase == "Lobby" then
			local startsAt = (workspace:GetAttribute("FinalStartsAt") :: number?) or t
			joinButton.Visible = not joinedFinal
			joinButton.Text = string.format("UNIRSE A LA BATALLA FINAL (%ds)", math.max(0, math.ceil(startsAt - t)))
		else
			joinButton.Visible = false
			joinedFinal = false
		end

		local hp = (workspace:GetAttribute("VerityHP") :: number?) or 0
		local maxHp = math.max(1, (workspace:GetAttribute("VerityMaxHP") :: number?) or 1)
		local ends = (workspace:GetAttribute("VerityEndsAt") :: number?) or t
		if phase == "Active" or phase == "Final" then
			timerLabel.Text = if phase == "Final"
				then "BATALLA FINAL - quedan " .. format(ends - t)
				else "VERITY ESTA AQUI - se ira en " .. format(ends - t)
			timerLabel.TextColor3 = COLORS.danger
			hpFrame.Visible = true
			hpFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
			hpFill.BackgroundColor3 = if phase == "Final" then Color3.fromRGB(255, 90, 20) else Color3.fromRGB(200, 20, 20)
			hpText.Text = string.format("%s  %d / %d", if phase == "Final" then "FORMA FINAL DE VERITY" else "VERITY", hp, maxHp)
			hiddenLabel.Visible = phase == "Active" and player:GetAttribute("Hidden") == true
		elseif phase == "Fleeing" then
			timerLabel.Text = "VERITY HUYE HERIDO HACIA LA OSCURIDAD"
			timerLabel.TextColor3 = COLORS.reward
			hpFrame.Visible = false
			hiddenLabel.Visible = false
		elseif finalPhase == "Lobby" then
			timerLabel.Text = string.format("%s convoca la BATALLA FINAL", tostring(workspace:GetAttribute("FinalCaller") or "Un Khan"))
			timerLabel.TextColor3 = COLORS.warning
			hpFrame.Visible = false
			hiddenLabel.Visible = false
		elseif not player:GetAttribute("HasPlot") then
			-- aun no tiene campamento: sin contador, solo el objetivo
			timerLabel.Text = if introDone then "Elige tu campamento: pisa un circulo azul RECLAMAR" else ""
			timerLabel.TextColor3 = Color3.fromRGB(170, 210, 255)
			hpFrame.Visible = false
			hiddenLabel.Visible = false
		else
			local nextAt = workspace:GetAttribute("VerityNextAt") :: number?
			local remaining = if nextAt then nextAt - t else math.huge
			timerLabel.Text = if nextAt then "Verity llega en " .. format(remaining) else ""
			timerLabel.TextColor3 = if remaining <= 60 then COLORS.warning else COLORS.info
			hpFrame.Visible = false
			hiddenLabel.Visible = false
		end
	end)
end

return HUD
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001D"><Properties>
<string name="Name">HorseAnimator</string>
<string name="Source"><![CDATA[--!strict
-- Anima a los jinetes de la batalla final (personajes con el atributo Mounted):
--   - caballo: las cuatro patas galopan segun la velocidad (diagonales
--     alternadas: delantera izq. con trasera der.), con el cuello cabeceando
--   - jinete: piernas abiertas a los lados del caballo y rodillas dobladas.
-- Se hace en Stepped (PreSimulation), DESPUES de que el Animator de Roblox
-- aplique la animacion de caminar/correr, asi que esta pose la reemplaza en
-- las piernas. Los brazos siguen con sus animaciones (armas, arco).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local HorseAnimator = {}

type Rider = { phase: number }

local riders: { [Model]: Rider } = {}

local LEGS = { LegFL = 0, LegBR = 0, LegFR = math.pi, LegBL = math.pi } -- desfase del galope

local function motor(parent: Instance?, name: string): Motor6D?
	if not parent then
		return nil
	end
	local found = parent:FindFirstChild(name, true)
	return if found and found:IsA("Motor6D") then found else nil
end

local function animate(character: Model, rider: Rider, dt: number)
	local root = character:FindFirstChild("HumanoidRootPart")
	local horse = character:FindFirstChild("Horse")
	if not (root and root:IsA("BasePart") and horse) then
		return
	end
	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local gallop = math.clamp(speed / 30, 0, 1)
	rider.phase += dt * (2 + speed * 0.32)
	local ph = rider.phase

	-- patas del caballo
	for name, offset in LEGS do
		local leg = motor(horse, name)
		if leg then
			local swing = math.sin(ph + offset) * 0.75 * gallop
			leg.Transform = CFrame.Angles(swing, 0, 0)
		end
	end

	-- jinete montado: muslos hacia delante y abiertos, rodillas dobladas
	local bounce = math.sin(ph * 2) * 0.08 * gallop
	local hips = { LeftHip = -1, RightHip = 1 }
	for name, side in hips do
		local hip = motor(character, name)
		if hip then
			hip.Transform = CFrame.Angles(0, 0, side * 0.55) * CFrame.Angles(math.rad(55) + bounce, 0, 0)
		end
	end
	for _, name in { "LeftKnee", "RightKnee" } do
		local knee = motor(character, name)
		if knee then
			knee.Transform = CFrame.Angles(math.rad(-75), 0, 0)
		end
	end
end

function HorseAnimator.start()
	RunService.Stepped:Connect(function(_, dt)
		for _, player in Players:GetPlayers() do
			local character = player.Character
			if character and character:GetAttribute("Mounted") then
				local rider = riders[character]
				if not rider then
					rider = { phase = 0 }
					riders[character] = rider
				end
				animate(character, rider, dt)
			end
		end
		for character in riders do
			if not character.Parent or not character:GetAttribute("Mounted") then
				riders[character] = nil
			end
		end
	end)
end

return HorseAnimator
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties>
<string name="Name">Intro</string>
<string name="Source"><![CDATA[--!strict
-- Introduccion cinematografica al entrar al juego: la historia de como te
-- proclaman Gengis Khan (kurultai de 1206 junto al rio Onon) y el secreto de
-- la estepa (Verity). Camara en tomas sobre el mapa real, franjas negras de
-- cine, texto que se escribe letra a letra y boton para saltar.
-- Al terminar: camara normal, controles activos y el HUD pide reclamar un
-- campamento (el contador de Verity aun no existe).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local HUD = require(script.Parent.HUD)

type Shot = {
	from: CFrame,
	to: CFrame,
	lines: { string },
	title: boolean?,
}

local SHOTS: { Shot } = {
	{ -- la estepa
		from = CFrame.lookAt(Vector3.new(-260, 45, 180), Vector3.new(0, 10, 0)),
		to = CFrame.lookAt(Vector3.new(-170, 35, 120), Vector3.new(0, 15, 0)),
		lines = {
			"Año 1206. La estepa de Mongolia.",
			"Durante siglos, las tribus de las llanuras se mataron entre sí por pastos, caballos y venganza.",
		},
	},
	{ -- el kurultai ante el estandarte
		from = CFrame.lookAt(Vector3.new(34, 18, 34), Vector3.new(0, 26, 0)),
		to = CFrame.lookAt(Vector3.new(-30, 24, 34), Vector3.new(0, 28, 0)),
		lines = {
			"Hoy, junto al río Onón, todos los clanes se han reunido en un gran kurultai.",
			"Ante el estandarte blanco de nueve colas te alzan sobre un fieltro blanco... y te dan un nuevo nombre.",
		},
		title = true,
	},
	{ -- el circulo de piedras negras
		from = CFrame.lookAt(Vector3.new(0, 40, -150), Vector3.new(0, 4, -260)),
		to = CFrame.lookAt(Vector3.new(0, 10, -226), Vector3.new(0, 5, -260)),
		lines = {
			"Pero la estepa guarda un secreto que ningún kan se ha atrevido a nombrar.",
			"En el círculo de piedras negras del norte duerme una sonrisa amarilla.",
			"Los chamanes la llaman Verity. Cuando cae la noche, despierta... y caza.",
		},
	},
	{ -- los campamentos
		from = CFrame.lookAt(Vector3.new(0, 60, 40), Vector3.new(150, 0, 0)),
		to = CFrame.lookAt(Vector3.new(0, 140, 30), Vector3.new(0, 0, 0)),
		lines = {
			"Levanta tu campamento. Reúne rebaños, caravanas de seda y armas.",
			"Y cuando caiga la noche, Khan... pelea, o escóndete.",
		},
	},
}

local CHAR_TIME = 0.03 -- segundos por letra
local HOLD = 2.2 -- segundos que se queda cada frase

local Intro = {}

local skip = false
local cameraTween: Tween? = nil -- el movimiento de la toma en curso (se cancela al saltar)
local gui: ScreenGui
local blackout: Frame
local story: TextLabel
local titleMain: TextLabel
local titleSub: TextLabel

local function sleep(seconds: number)
	local elapsed = 0
	while elapsed < seconds and not skip do
		elapsed += task.wait(0.05)
	end
end

local function fade(target: number, seconds: number)
	TweenService:Create(blackout, TweenInfo.new(seconds), { BackgroundTransparency = target }):Play()
	sleep(seconds)
end

local function typewrite(line: string)
	story.Text = line
	story.MaxVisibleGraphemes = 0
	local total = utf8.len(line) or #line
	local shown = 0
	while shown < total and not skip do
		shown += 1
		story.MaxVisibleGraphemes = shown
		task.wait(CHAR_TIME)
	end
	story.MaxVisibleGraphemes = -1
	sleep(HOLD)
end

local function showTitle()
	for _, label in { titleMain, titleSub } do
		TweenService:Create(label, TweenInfo.new(1.2), { TextTransparency = 0, TextStrokeTransparency = 0.4 }):Play()
	end
	story.Text = ""
	sleep(3.2)
	for _, label in { titleMain, titleSub } do
		TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end
	sleep(0.8)
end

local function shotDuration(shot: Shot): number
	local seconds = 0
	for _, line in shot.lines do
		seconds += (utf8.len(line) or #line) * CHAR_TIME + HOLD
	end
	return seconds + (if shot.title then 4 else 0)
end

local function buildGui(player: Player)
	gui = Instance.new("ScreenGui")
	gui.Name = "Intro"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100

	local function bar(y: number, anchor: number)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0.14, 0)
		f.Position = UDim2.fromScale(0, y)
		f.AnchorPoint = Vector2.new(0, anchor)
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BorderSizePixel = 0
		f.Parent = gui
		return f
	end
	bar(0, 0)
	local bottom = bar(1, 1)

	story = Instance.new("TextLabel")
	story.Size = UDim2.new(0.8, 0, 0.8, 0)
	story.Position = UDim2.fromScale(0.5, 0.5)
	story.AnchorPoint = Vector2.new(0.5, 0.5)
	story.BackgroundTransparency = 1
	story.Font = Enum.Font.Garamond
	story.TextScaled = true
	story.TextWrapped = true
	story.TextColor3 = Color3.fromRGB(240, 225, 190)
	story.Text = ""
	story.Parent = bottom
	local size = Instance.new("UITextSizeConstraint")
	size.MaxTextSize = 30
	size.Parent = story

	local function title(text: string, y: number, textSize: number, color: Color3): TextLabel
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, textSize + 10)
		l.Position = UDim2.fromScale(0.5, y)
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.Fantasy
		l.TextSize = textSize
		l.TextColor3 = color
		l.TextStrokeColor3 = Color3.new(0, 0, 0)
		l.TextTransparency = 1
		l.TextStrokeTransparency = 1
		l.Text = text
		l.Parent = gui
		return l
	end
	titleMain = title("GENGIS KHAN", 0.42, 84, Color3.fromRGB(235, 190, 80))
	titleSub = title("VERITY TYCOON", 0.54, 40, Color3.fromRGB(200, 40, 40))

	local skipButton = Instance.new("TextButton")
	skipButton.Size = UDim2.fromOffset(150, 36)
	skipButton.Position = UDim2.new(1, -20, 1, -20)
	skipButton.AnchorPoint = Vector2.new(1, 1)
	skipButton.BackgroundColor3 = Color3.fromRGB(40, 30, 20)
	skipButton.BackgroundTransparency = 0.2
	skipButton.Font = Enum.Font.GothamBold
	skipButton.TextSize = 16
	skipButton.TextColor3 = Color3.fromRGB(240, 225, 190)
	skipButton.Text = "Saltar intro  >"
	skipButton.ZIndex = 3
	skipButton.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = skipButton
	skipButton.Activated:Connect(function()
		skip = true
		-- corta ya el movimiento de camara de la toma; si no, sigue moviendo la
		-- camara un rato y pelea con la camara normal
		if cameraTween then
			cameraTween:Cancel()
		end
	end)

	blackout = Instance.new("Frame")
	blackout.Size = UDim2.fromScale(1, 1)
	blackout.BackgroundColor3 = Color3.new(0, 0, 0)
	blackout.BorderSizePixel = 0
	blackout.ZIndex = 2
	blackout.Parent = gui

	gui.Parent = player:WaitForChild("PlayerGui")
end

local function controls(player: Player): any
	local ok, result = pcall(function()
		local module = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		return module:GetControls()
	end)
	return if ok then result else nil
end

function Intro.start()
	local player = Players.LocalPlayer
	if Config.Intro and Config.Intro.Enabled == false then
		HUD.setIntroDone()
		return
	end
	buildGui(player)
	local character = player.Character or player.CharacterAdded:Wait()
	workspace:WaitForChild("Map", 15)
	local ctrl = controls(player)
	if ctrl then
		ctrl:Disable()
	end
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)

	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable

	for i, shot in SHOTS do
		if skip then
			break
		end
		camera.CFrame = shot.from
		local tween = TweenService:Create(camera, TweenInfo.new(shotDuration(shot), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = shot.to })
		cameraTween = tween
		tween:Play()
		if i == 1 then
			fade(1, 2)
		end
		for _, line in shot.lines do
			if skip then
				break
			end
			typewrite(line)
		end
		if shot.title and not skip then
			showTitle()
		end
	end

	-- vuelta al jugador, en el spawn del centro
	if cameraTween then
		cameraTween:Cancel()
		cameraTween = nil
	end
	skip = false
	story.Text = ""
	fade(0, 0.6)
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") then
		camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 8, 16), root.Position)
	end
	camera.CameraType = Enum.CameraType.Custom
	if humanoid then
		camera.CameraSubject = humanoid
	end
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)
	if ctrl then
		ctrl:Enable()
	end
	HUD.setIntroDone()
	fade(1, 1.2)
	gui:Destroy()
end

return Intro
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties>
<string name="Name">Music</string>
<string name="Source"><![CDATA[--!strict
-- Musica de fondo segun el momento (temas tradicionales mongoles de
-- tools/compose_music.py si estan subidos en Config.Uploads; si no, la
-- musica de respaldo de Config.Music):
--   Calma   -> construyendo el tycoon ("Estepa")
--   Aviso   -> ultimo minuto antes de que llegue Verity ("Presagio")
--   Batalla -> Verity aqui, huyendo o batalla final ("Batalla")
-- Boton "Musica" abajo a la izquierda para silenciarla.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local M = Config.Music

type Mode = "Calm" | "Warning" | "Battle"

local Music = {}

local mode: Mode? = nil
local track: Sound? = nil
local muted = false

-- tema propio si esta subido; si no, la lista de respaldo
local UPLOAD_KEY = { Calm = "MusicCalm", Warning = "MusicWarning", Battle = "MusicBattle" }
local function playlist(m: Mode): { number }
	local id = (Config.Uploads :: any)[UPLOAD_KEY[m]]
	if typeof(id) == "number" and id ~= 0 then
		return { id }
	end
	return M[m] :: { number }
end
local index: { [string]: number } = { Calm = 0, Warning = 0, Battle = 0 }

local musicGroup: SoundGroup

local function newSound(id: number, looped: boolean): Sound
	local s = Instance.new("Sound")
	s.SoundGroup = musicGroup -- lo ensordece Controllers/SoundDuck durante el canto
	s.SoundId = "rbxassetid://" .. id
	s.Looped = looped
	s.Volume = 0
	s.Parent = SoundService
	return s
end

local function fadeOut(s: Sound)
	TweenService:Create(s, TweenInfo.new(1.5), { Volume = 0 }):Play()
	task.delay(1.6, function()
		s:Destroy()
	end)
end

local playNext: (Mode) -> ()

function playNext(m: Mode)
	local list = playlist(m)
	if #list == 0 then
		return
	end
	index[m] = index[m] % #list + 1
	local s = newSound(list[index[m]], false)
	track = s
	s:Play()
	TweenService:Create(s, TweenInfo.new(1.5), { Volume = if muted then 0 else M.Volume }):Play()
	s.Ended:Connect(function()
		if track == s and mode == m then
			s:Destroy()
			playNext(m)
		end
	end)
	-- si la pista no carga (moderada o no disponible), pasa a la siguiente
	task.delay(6, function()
		if track == s and mode == m and s.TimeLength == 0 and #list > 1 then
			s:Destroy()
			playNext(m)
		end
	end)
end

local function setMode(m: Mode)
	if m == mode then
		return
	end
	mode = m
	if track then
		fadeOut(track)
		track = nil
	end
	playNext(m)
end

local function currentMode(): Mode
	local phase = workspace:GetAttribute("VerityPhase")
	if phase == "Active" or phase == "Final" or phase == "Fleeing" then
		return "Battle"
	end
	local nextAt = (workspace:GetAttribute("VerityNextAt") :: number?) or math.huge
	if nextAt - workspace:GetServerTimeNow() <= 60 then
		return "Warning"
	end
	return "Calm"
end

function Music.init()
	-- grupo local (solo en este cliente)
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "Music"
	musicGroup.Parent = SoundService

	local gui = Instance.new("ScreenGui")
	gui.Name = "MusicToggle"
	gui.ResetOnSpawn = false
	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(110, 30)
	button.Position = UDim2.new(0, 16, 1, -16)
	button.AnchorPoint = Vector2.new(0, 1)
	button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	button.BackgroundTransparency = 0.3
	button.Font = Enum.Font.GothamBold
	button.TextSize = 16
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Text = "Musica: si"
	button.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button
	button.Activated:Connect(function()
		muted = not muted
		button.Text = if muted then "Musica: no" else "Musica: si"
		if track then
			track.Volume = if muted then 0 else M.Volume
		end
	end)
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

function Music.start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then
			return
		end
		acc = 0
		setMode(currentMode())
	end)
end

return Music
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties>
<string name="Name">Rebirth</string>
<string name="Source"><![CDATA[--!strict
-- Renacer tras ganar la batalla final (atributo CanRebirth que pone el servidor):
--   - aparece una ventana que pregunta si quieres renacer
--   - si eliges "Ahora no", queda un boton "Renacer" abajo a la izquierda
--     mientras sigas pudiendo hacerlo (hasta salir del juego)
-- Renacer = campamento y oro desde cero, +50 % de oro para siempre.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local player = Players.LocalPlayer

local Rebirth = {}

local modal: Frame
local body: TextLabel
local smallButton: TextButton
local dismissed = false

local function nextMultiplier(): number
	local current = 0
	local leaderstats = player:FindFirstChild("leaderstats")
	local value = leaderstats and leaderstats:FindFirstChild("Renacer")
	if value and value:IsA("IntValue") then
		current = value.Value
	end
	return 1 + Config.Rebirth.BonusPerRebirth * (current + 1)
end

local function refresh()
	local can = player:GetAttribute("CanRebirth") == true
	if not can then
		dismissed = false
	end
	body.Text = string.format(
		"Venciste a la forma final de Verity.\n\nSi renaces, tu campamento y tu oro empiezan de cero, pero desde ahora ganas x%.1f de oro para siempre.\n\nTus muertes de Verity y tus renacimientos se conservan.",
		nextMultiplier()
	)
	modal.Visible = can and not dismissed
	smallButton.Visible = can and dismissed
end

local function button(parent: Instance, text: string, color: Color3, position: UDim2): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(180, 44)
	b.Position = position
	b.AnchorPoint = Vector2.new(0.5, 1)
	b.BackgroundColor3 = color
	b.Font = Enum.Font.GothamBlack
	b.TextSize = 18
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = b
	return b
end

function Rebirth.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "RebirthUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20

	modal = Instance.new("Frame")
	modal.Size = UDim2.fromOffset(460, 300)
	modal.Position = UDim2.fromScale(0.5, 0.5)
	modal.AnchorPoint = Vector2.new(0.5, 0.5)
	modal.BackgroundColor3 = Color3.fromRGB(30, 22, 14)
	modal.BackgroundTransparency = 0.05
	modal.Visible = false
	modal.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = modal
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(235, 190, 80)
	stroke.Thickness = 2
	stroke.Parent = modal

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 50)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Fantasy
	title.TextSize = 34
	title.TextColor3 = Color3.fromRGB(235, 190, 80)
	title.Text = "¿RENACER?"
	title.Parent = modal

	body = Instance.new("TextLabel")
	body.Size = UDim2.new(1, -40, 0, 160)
	body.Position = UDim2.fromOffset(20, 52)
	body.BackgroundTransparency = 1
	body.Font = Enum.Font.Gotham
	body.TextSize = 16
	body.TextWrapped = true
	body.TextColor3 = Color3.fromRGB(240, 230, 210)
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Parent = modal

	local yes = button(modal, "Renacer", Color3.fromRGB(190, 120, 20), UDim2.new(0.28, 0, 1, -18))
	local no = button(modal, "Ahora no", Color3.fromRGB(70, 60, 50), UDim2.new(0.72, 0, 1, -18))
	yes.Activated:Connect(function()
		modal.Visible = false
		Net.fireServer("Rebirth")
	end)
	no.Activated:Connect(function()
		dismissed = true
		refresh()
	end)

	smallButton = Instance.new("TextButton")
	smallButton.Size = UDim2.fromOffset(150, 30)
	smallButton.Position = UDim2.new(0, 136, 1, -16)
	smallButton.AnchorPoint = Vector2.new(0, 1)
	smallButton.BackgroundColor3 = Color3.fromRGB(190, 120, 20)
	smallButton.Font = Enum.Font.GothamBold
	smallButton.TextSize = 15
	smallButton.TextColor3 = Color3.new(1, 1, 1)
	smallButton.Text = "Renacer..."
	smallButton.Visible = false
	smallButton.Parent = gui
	local smallCorner = Instance.new("UICorner")
	smallCorner.CornerRadius = UDim.new(0, 6)
	smallCorner.Parent = smallButton
	smallButton.Activated:Connect(function()
		dismissed = false
		refresh()
	end)

	gui.Parent = player:WaitForChild("PlayerGui")
end

function Rebirth.start()
	player:GetAttributeChangedSignal("CanRebirth"):Connect(refresh)
	refresh()
end

return Rebirth
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties>
<string name="Name">SoundDuck</string>
<string name="Source"><![CDATA[--!strict
-- Mientras suena un canto de garganta cerca (a menos de DuckRadius), todo lo
-- demas se ensordece: la musica y los efectos bajan de volumen y pierden los
-- agudos (como oidos bajo el agua), para que el canto se oiga claro.
-- El canto va en el grupo "Song" y nunca se toca.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local T = Config.ThroatSing
local DUCKED_GROUPS = { "Effects", "Music" }

local SoundDuck = {}

local duck = 0 -- 0 = normal, 1 = totalmente ensordecido

local function equalizer(group: SoundGroup): EqualizerSoundEffect
	local existing = group:FindFirstChild("SongDuck")
	if existing and existing:IsA("EqualizerSoundEffect") then
		return existing
	end
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "SongDuck"
	eq.HighGain = 0
	eq.MidGain = 0
	eq.LowGain = 0
	eq.Parent = group
	return eq
end

local function nearSong(): boolean
	local songUntil = (workspace:GetAttribute("SongUntil") :: number?) or 0
	if workspace:GetServerTimeNow() >= songUntil then
		return false
	end
	local songPos = workspace:GetAttribute("SongPos")
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if typeof(songPos) ~= "Vector3" or not (root and root:IsA("BasePart")) then
		return true -- sin posicion: mejor ensordecer igual
	end
	return (root.Position - songPos).Magnitude <= T.DuckRadius
end

function SoundDuck.start()
	RunService.Heartbeat:Connect(function(dt)
		local target = if nearSong() then 1 else 0
		-- entra rapido (0.15 s) y sale despacio (~0.8 s)
		local speed = if target > duck then 7 else 1.3
		duck += (target - duck) * math.min(1, dt * speed)
		if duck < 0.001 and target == 0 then
			duck = 0
		end
		for _, name in DUCKED_GROUPS do
			local group = SoundService:FindFirstChild(name)
			if group and group:IsA("SoundGroup") then
				group.Volume = 1 - (1 - T.DuckVolume) * duck
				local eq = equalizer(group)
				eq.HighGain = -40 * duck
				eq.MidGain = -18 * duck
				eq.LowGain = -4 * duck
			end
		end
	end)
end

return SoundDuck
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties>
<string name="Name">ThroatSing</string>
<string name="Source"><![CDATA[--!strict
-- Tecla G (o boton Y del mando, o boton en pantalla en movil): canto de garganta.
-- Solo pide al servidor que cante; el cooldown real lo valida el servidor.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local player = Players.LocalPlayer

local ThroatSing = {}

local ACTION = "ThroatSing"
local label: TextLabel

local function remaining(): number
	local readyAt = (player:GetAttribute("SingReadyAt") :: number?) or 0
	return readyAt - workspace:GetServerTimeNow()
end

local function onAction(_name: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if state == Enum.UserInputState.Begin and remaining() <= 0 then
		Net.fireServer("ThroatSing")
	end
	return Enum.ContextActionResult.Sink
end

function ThroatSing.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "ThroatSingHUD"
	gui.ResetOnSpawn = false
	label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(300, 26)
	label.Position = UDim2.new(1, -16, 1, -16)
	label.AnchorPoint = Vector2.new(1, 1)
	label.BackgroundTransparency = 0.4
	label.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(150, 210, 255)
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = label
	gui.Parent = player:WaitForChild("PlayerGui")
end

function ThroatSing.start()
	ContextActionService:BindAction(ACTION, onAction, true, Enum.KeyCode.G, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle(ACTION, "Canto")
	ContextActionService:SetPosition(ACTION, UDim2.new(1, -150, 1, -150))

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local r = remaining()
		label.Text = if r > 0
			then string.format("Canto de garganta (G): %ds", math.ceil(r))
			else "Canto de garganta (G): listo"
	end)
end

return ThroatSing
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties>
<string name="Name">VerityAnimator</string>
<string name="Source"><![CDATA[--!strict
-- Tomado del proyecto "Survive A Verity" (rama claude/keen-galileo-at0rx6).
-- Anima a Verity en cada cliente, con andares de monstruo:
--   - reposo: encorvada, con la cabeza muy ladeada (cuello roto), respiración
--     pesada, brazos colgando que se mecen y espasmos bruscos de cabeza,
--     hombros y dedos cada pocos segundos
--   - caminar (acechar): zancadas largas y lentas con las rodillas dobladas,
--     la cadera se balancea y gira, los brazos cuelgan y se balancean con
--     retraso, como sin vida (uno más que otro), y la cabeza ladeada cabecea
--   - correr (atributo Sprinting): se lanza hacia delante casi a cuatro patas,
--     torso muy inclinado, cabeza levantada mirando a la presa, brazos
--     abiertos estirados hacia delante agarrando el aire, zancadas enormes con
--     las rodillas muy altas y temblores nerviosos por todo el cuerpo
--   - agacharse (C): rodillas flexionadas que coinciden con la bajada de cadera
--   - transformación: se estira, abre los brazos y echa la cabeza atrás
--   - ataque (Q): sigue la misma línea de tiempo que usa el servidor
--
-- Funciona con cualquier rig (R15, R6 o personalizado): busca las uniones por
-- nombre y aplica las rotaciones en el marco del torso. Escribe C0 en local
-- (en vez de Motor6D.Transform), así ningún Animator de Roblox lo pisa, y
-- recoge las uniones aunque lleguen después del modelo.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Pose = require(ReplicatedStorage.Shared.VerityPose)

local JOINTS: { [string]: { string } } = {
	Waist = { "Waist" },
	Neck = { "Neck" },
	HeadJoint = { "HeadJoint" },
	LeftShoulder = { "LeftShoulder", "Left Shoulder" },
	RightShoulder = { "RightShoulder", "Right Shoulder" },
	LeftElbow = { "LeftElbow" },
	RightElbow = { "RightElbow" },
	LeftWrist = { "LeftWrist" },
	RightWrist = { "RightWrist" },
	LeftHip = { "LeftHip", "Left Hip" },
	RightHip = { "RightHip", "Right Hip" },
	LeftKnee = { "LeftKnee" },
	RightKnee = { "RightKnee" },
	LeftAnkle = { "LeftAnkle" },
	RightAnkle = { "RightAnkle" },
}

type Joint = { motor: Motor6D, base: CFrame, frame: CFrame }
type Rig = {
	model: Model,
	root: BasePart?,
	joints: { [string]: Joint },
	crouchAngle: number,
	phase: number,
	crouch: number,
	stride: number,
	run: number,
	tilt: number, -- ladeo de la cabeza (cambia de lado de vez en cuando)
	tiltTarget: number,
	tiltAt: number,
	spasm: number, -- espasmo de todo el cuerpo (decae)
	twitchAt: number,
	twitch: CFrame,
	seed: number,
	connection: RBXScriptConnection?,
}

local VerityAnimator = {}

local rigs: { [Model]: Rig } = {}

local function addJoint(rig: Rig, inst: Instance)
	if not inst:IsA("Motor6D") then
		return
	end
	for key, names in JOINTS do
		if not rig.joints[key] and table.find(names, inst.Name) then
			rig.joints[key] = { motor = inst, base = inst.C0, frame = inst.C0.Rotation }
		end
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or rigs[model] then
		return
	end
	local rig: Rig = {
		model = model,
		root = nil,
		joints = {},
		crouchAngle = Pose.read(model).crouchAngle,
		phase = 0,
		crouch = 0,
		stride = 0,
		run = 0,
		tilt = 0.45,
		tiltTarget = 0.45,
		tiltAt = os.clock() + 6,
		spasm = 0,
		twitchAt = os.clock() + 2,
		twitch = CFrame.identity,
		seed = math.random() * 100,
	}
	for _, inst in model:GetDescendants() do
		addJoint(rig, inst)
	end
	-- las piezas pueden llegar después que el modelo: se recogen al llegar
	rig.connection = model.DescendantAdded:Connect(function(inst)
		addJoint(rig, inst)
	end)
	rigs[model] = rig
end

local function untrack(model: Model)
	local rig = rigs[model]
	if rig and rig.connection then
		rig.connection:Disconnect()
	end
	rigs[model] = nil
end

-- Aplica una rotación expresada en el marco del modelo (X = derecha,
-- ángulo positivo = hacia delante) a la unión, sea cual sea su C0.
local function set(rig: Rig, name: string, rotation: CFrame)
	local joint = rig.joints[name]
	if joint and joint.motor.Parent then
		joint.motor.C0 = joint.base * (joint.frame:Inverse() * rotation * joint.frame)
	end
end

local function rx(a: number): CFrame
	return CFrame.Angles(a, 0, 0)
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function animate(rig: Rig, dt: number)
	local model = rig.model
	local root = rig.root
	if not root then
		local found = model:FindFirstChild("HumanoidRootPart")
		if found and found:IsA("BasePart") then
			rig.root = found
			root = found
		else
			return
		end
	end
	local clock = os.clock()

	-- Ataque (Q)
	local killStart = model:GetAttribute("KillStart") :: number?
	if killStart then
		local t = Workspace:GetServerTimeNow() - killStart
		local shoulder, elbow, waist = Pose.killAngles(t)
		local inward = math.rad(14) * math.clamp(shoulder / math.rad(60), 0, 1)
		set(rig, "Waist", rx(waist))
		set(rig, "LeftShoulder", rx(shoulder) * CFrame.Angles(0, 0, inward))
		set(rig, "RightShoulder", rx(shoulder) * CFrame.Angles(0, 0, -inward))
		set(rig, "LeftElbow", rx(elbow))
		set(rig, "RightElbow", rx(elbow))
		set(rig, "Neck", rx(-waist * 0.4) * CFrame.Angles(0, 0, math.sin(clock * 30) * 0.05))
		for _, name in { "HeadJoint", "LeftHip", "RightHip", "LeftKnee", "RightKnee", "LeftAnkle", "RightAnkle", "LeftWrist", "RightWrist" } do
			set(rig, name, CFrame.identity)
		end
		return
	end

	-- Transformación: se estira desde encogida, abre los brazos y ruge
	local transformStart = model:GetAttribute("TransformStart") :: number?
	if transformStart then
		local t = (Workspace:GetServerTimeNow() - transformStart) / Config.Verity.TransformTime
		local curl = 1 - smooth(t * 1.6) -- encogida al principio
		local open = smooth((t - 0.45) * 2.5) -- brazos abiertos al final
		local jitter = (1 - t) * 0.12
		local function j(): number
			return (math.random() - 0.5) * jitter
		end
		set(rig, "Waist", rx(math.rad(-55) * curl + math.rad(14) * open + j()))
		set(rig, "Neck", rx(math.rad(-30) * curl + math.rad(30) * open) * CFrame.Angles(j(), j(), j()))
		set(rig, "LeftShoulder", rx(math.rad(40) * curl + math.rad(60) * open) * CFrame.Angles(0, 0, -math.rad(70) * open + j()))
		set(rig, "RightShoulder", rx(math.rad(40) * curl + math.rad(60) * open) * CFrame.Angles(0, 0, math.rad(70) * open + j()))
		set(rig, "LeftElbow", rx(math.rad(90) * curl + j()))
		set(rig, "RightElbow", rx(math.rad(90) * curl + j()))
		set(rig, "LeftHip", rx(math.rad(60) * curl))
		set(rig, "RightHip", rx(math.rad(60) * curl))
		set(rig, "LeftKnee", rx(-math.rad(110) * curl))
		set(rig, "RightKnee", rx(-math.rad(110) * curl))
		set(rig, "LeftAnkle", rx(math.rad(50) * curl))
		set(rig, "RightAnkle", rx(math.rad(50) * curl))
		return
	end

	local velocity = root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
	local speed = velocity.Magnitude
	local walkSpeed = Config.Verity.WalkSpeed
	rig.stride += (math.clamp(speed / walkSpeed, 0, 1.6) - rig.stride) * math.min(1, dt * 8)
	-- corre cuando esprinta (jugador con Shift o la Verity NPC persiguiendo)
	local sprinting = model:GetAttribute("Sprinting") == true and speed > 8
	rig.run += ((if sprinting then 1 else 0) - rig.run) * math.min(1, dt * 5)
	local targetCrouch = if model:GetAttribute("Crouching") then 1 else 0
	rig.crouch += (targetCrouch - rig.crouch) * math.min(1, dt * 10)

	-- cadencia: piernas larguísimas; al correr, zancadas más rápidas
	rig.phase += dt * (1.5 + speed * 0.14 + rig.run * 1.2)
	local ph = rig.phase
	local s = math.sin(ph)
	local c = math.cos(ph)
	local stride = math.min(rig.stride, 1)
	local run = rig.run * stride
	local walk = stride * (1 - rig.run)
	local crouch = rig.crouch
	local theta = rig.crouchAngle * crouch
	local hasKnees = rig.joints.LeftKnee ~= nil
	local rest = 1 - math.min(1, rig.stride * 1.5)
	local seed = rig.seed
	-- ruido suave para temblores (más fuerte corriendo)
	local function noise(k: number, freq: number): number
		return math.noise(clock * freq, seed + k, 0) * 2
	end
	local shake = 0.03 + 0.07 * run

	-- espasmos: un tirón brusco de todo el cuerpo de vez en cuando
	if clock >= rig.twitchAt then
		rig.twitchAt = clock + 1.2 + math.random() * (if run > 0.5 then 1.5 else 3.5)
		rig.twitch = CFrame.Angles((math.random() - 0.5) * 0.6, (math.random() - 0.5) * 1.0, (math.random() - 0.5) * 0.9)
		rig.spasm = 1
	end
	rig.spasm = math.max(0, rig.spasm - dt * 3.5)
	local spasm = rig.spasm * rig.spasm

	-- la cabeza ladeada cambia de lado de golpe cada cierto tiempo
	if clock >= rig.tiltAt then
		rig.tiltAt = clock + 5 + math.random() * 6
		rig.tiltTarget = (if math.random() < 0.5 then -1 else 1) * (0.35 + math.random() * 0.25)
	end
	rig.tilt += (rig.tiltTarget - rig.tilt) * math.min(1, dt * 6)

	-- PIERNAS -----------------------------------------------------------------
	-- caminar: zancada larga con las rodillas siempre algo dobladas
	-- correr: zancadas enormes, rodillas muy altas, cadera adelantada
	local hipAmp = 0.5 * walk + 0.95 * run
	local hipBase = theta + 0.12 * walk + 0.45 * run
	local liftAmp = 0.85 * walk + 1.5 * run
	local bend = 0.18 * walk + 0.35 * run + 0.08 * rest
	local swing = s * hipAmp * (1 - crouch * 0.5)
	local liftL = math.max(0, c) * liftAmp
	local liftR = math.max(0, -c) * liftAmp
	set(rig, "LeftHip", rx(hipBase + swing) * CFrame.Angles(0, 0, -0.04 * run))
	set(rig, "RightHip", rx(hipBase - swing) * CFrame.Angles(0, 0, 0.04 * run))
	if hasKnees then
		set(rig, "LeftKnee", rx(-2 * theta - bend - liftL))
		set(rig, "RightKnee", rx(-2 * theta - bend - liftR))
		set(rig, "LeftAnkle", rx(theta + bend * 0.5 + liftL * 0.35 - math.max(0, -s) * 0.3 * stride))
		set(rig, "RightAnkle", rx(theta + bend * 0.5 + liftR * 0.35 - math.max(0, s) * 0.3 * stride))
	end

	-- TORSO -------------------------------------------------------------------
	-- reposo: encorvada y respirando hondo; caminar: cadera que se mece y
	-- gira; correr: casi a cuatro patas, el pecho sube y baja a cada zancada
	local breathe = math.sin(clock * 1.2) * 0.05 * rest
	local lean = -0.14 * rest - 0.3 * walk - 0.8 * run - 0.35 * crouch
	local heave = math.sin(ph * 2) * (0.05 * walk + 0.1 * run)
	local twist = s * (0.16 * walk + 0.22 * run)
	local sway = s * 0.09 * walk + noise(1, 1.3) * shake
	set(rig, "Waist", rx(lean + breathe + heave + noise(2, 2) * shake) * CFrame.Angles(0, twist, sway) * CFrame.identity:Lerp(rig.twitch, spasm * 0.3))

	-- BRAZOS ------------------------------------------------------------------
	-- caminar: cuelgan y se balancean con retraso (como peso muerto), el
	-- derecho más flojo que el izquierdo
	-- correr: abiertos y estirados hacia delante, alternando como si
	-- quisiera agarrar algo, con los dedos crispados
	local lag = math.sin(ph - 0.7)
	local walkArmL = -lag * 0.5 * walk
	local walkArmR = lag * 0.32 * walk
	local reach = 1.05 * run -- brazos hacia delante al correr
	local claw = s * 0.55 * run
	local dangle = math.sin(clock * 1.1) * 0.07 * rest
	local spread = 0.08 * rest + 0.1 * walk + 0.6 * run
	set(rig, "LeftShoulder",
		rx(walkArmL + reach - claw + dangle + 0.25 * crouch + noise(3, 3) * shake + 0.06 * rest)
			* CFrame.Angles(0, 0, -spread - noise(4, 2) * shake))
	set(rig, "RightShoulder",
		rx(walkArmR + reach + claw - dangle + 0.25 * crouch + noise(5, 3) * shake + 0.02 * rest)
			* CFrame.Angles(0, 0, spread + noise(6, 2) * shake))
	set(rig, "LeftElbow", rx(0.15 + math.max(0, -lag) * 0.45 * walk + (0.4 + math.max(0, -s) * 0.5) * run))
	set(rig, "RightElbow", rx(0.1 + math.max(0, lag) * 0.3 * walk + (0.4 + math.max(0, s) * 0.5) * run))
	set(rig, "LeftWrist", rx(-0.25 - 0.35 * run + math.sin(clock * 2.3) * 0.08 + noise(7, 6) * shake * 2))
	set(rig, "RightWrist", rx(-0.3 - 0.35 * run + math.sin(clock * 2.1 + 1) * 0.08 + noise(8, 6) * shake * 2))

	-- CABEZA ------------------------------------------------------------------
	-- siempre ladeada (cuello roto); al caminar cabecea con cada paso y al
	-- correr se levanta para mirar al frente pese al torso inclinado
	local look = -lean * (0.55 + 0.35 * run) + 0.05 * run
	local nod = c * 0.07 * walk + math.sin(ph * 2) * 0.06 * run
	local twitch = CFrame.identity:Lerp(rig.twitch, math.max(rest, spasm))
	set(rig, "Neck", rx(look + nod + noise(9, 4) * shake) * CFrame.Angles(0, noise(10, 0.7) * 0.15 * rest, rig.tilt * 0.45) * twitch)
	set(rig, "HeadJoint", CFrame.Angles(noise(11, 5) * shake, 0, rig.tilt * 0.55 + math.sin(clock * 0.6) * 0.1 * rest))
end

function VerityAnimator.start()
	for _, model in CollectionService:GetTagged("VerityRig") do
		track(model)
	end
	CollectionService:GetInstanceAddedSignal("VerityRig"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("VerityRig"):Connect(function(model)
		untrack(model :: Model)
	end)

	RunService.Stepped:Connect(function(_, dt)
		for model, rig in rigs do
			if not model.Parent then
				untrack(model)
				continue
			end
			local root = rig.root
			local busy = model:GetAttribute("KillStart") ~= nil or model:GetAttribute("TransformStart") ~= nil
			if busy or not root or not root.Anchored then
				animate(rig, dt)
			end
		end
	end)
end

return VerityAnimator
]]></string>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties>
<string name="Name">VerityFX</string>
<string name="Source"><![CDATA[--!strict
-- Ambiente de terror mientras Verity esta activo: noche, niebla, tinte rojo
-- y temblor de camara cuando esta cerca.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local VerityFX = {}

-- Con Atmosphere en Lighting, la niebla clasica (FogEnd) no hace nada: la
-- noche se hace oscureciendo la atmosfera y las nubes. El dia se lee del
-- servidor la primera vez (World.buildLighting).
local NIGHT = { ClockTime = 0.5, Brightness = 1 }
local FINAL = { ClockTime = 0.2, Brightness = 1.5 }
local NIGHT_ATMOS = { Density = 0.55, Color = Color3.fromRGB(30, 12, 12), Decay = Color3.fromRGB(10, 0, 0), Haze = 2.5, Glare = 0 }
local FINAL_ATMOS = { Density = 0.5, Color = Color3.fromRGB(110, 35, 10), Decay = Color3.fromRGB(70, 10, 0), Haze = 2.2, Glare = 0.2 }
local NIGHT_CLOUDS = { Cover = 0.85, Color = Color3.fromRGB(40, 32, 32) }
local FINAL_CLOUDS = { Cover = 0.8, Color = Color3.fromRGB(120, 40, 20) }

local day: { [string]: any }? = nil
local dayAtmos: { [string]: any }? = nil
local dayClouds: { [string]: any }? = nil

local function atmosphere(): Atmosphere?
	return Lighting:FindFirstChildOfClass("Atmosphere")
end

local function clouds(): Clouds?
	return workspace.Terrain:FindFirstChildOfClass("Clouds")
end

local function captureDay()
	if day then
		return
	end
	day = { ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness }
	local a = atmosphere()
	if a then
		dayAtmos = { Density = a.Density, Color = a.Color, Decay = a.Decay, Haze = a.Haze, Glare = a.Glare }
	end
	local c = clouds()
	if c then
		dayClouds = { Cover = c.Cover, Color = c.Color }
	end
end

local correction: ColorCorrectionEffect
local active = false
local current = "Day"

-- "Day", "Night" (Verity aqui o huyendo) o "Final" (batalla final, cielo rojo)
local function apply(look: string)
	if look == current then
		return
	end
	current = look
	active = look ~= "Day"
	captureDay()
	local info = TweenInfo.new(if active then 3 else 6)
	TweenService:Create(Lighting, info, if look == "Final" then FINAL elseif look == "Night" then NIGHT else day :: any):Play()
	local a = atmosphere()
	local atmosGoal = if look == "Final" then FINAL_ATMOS elseif look == "Night" then NIGHT_ATMOS else dayAtmos
	if a and atmosGoal then
		TweenService:Create(a, info, atmosGoal):Play()
	end
	local c = clouds()
	local cloudGoal = if look == "Final" then FINAL_CLOUDS elseif look == "Night" then NIGHT_CLOUDS else dayClouds
	if c and cloudGoal then
		TweenService:Create(c, info, cloudGoal):Play()
	end
	TweenService:Create(correction, info, {
		TintColor = if look == "Final" then Color3.fromRGB(255, 170, 140) elseif look == "Night" then Color3.fromRGB(255, 200, 200) else Color3.new(1, 1, 1),
		Saturation = if active then -0.35 else 0,
		Contrast = if active then 0.15 else 0,
	}):Play()
end

local function lookFor(phase: any): string
	if phase == "Final" then
		return "Final"
	elseif phase == "Active" or phase == "Fleeing" then
		return "Night"
	end
	return "Day"
end

function VerityFX.init()
	correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "VerityCorrection"
	correction.Parent = Lighting
end

function VerityFX.start()
	-- espera a que el servidor ponga la luz del dia antes de guardarla
	Lighting:WaitForChild("SteppeAtmosphere", 10)
	workspace.Terrain:WaitForChild("SteppeClouds", 10)
	workspace:GetAttributeChangedSignal("VerityPhase"):Connect(function()
		apply(lookFor(workspace:GetAttribute("VerityPhase")))
	end)
	apply(lookFor(workspace:GetAttribute("VerityPhase")))

	local camera = workspace.CurrentCamera
	RunService.RenderStepped:Connect(function()
		if not active then
			return
		end
		local verity = workspace:FindFirstChild("Verity")
		local character = Players.LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local vroot = verity and verity:IsA("Model") and verity.PrimaryPart
		if not (root and root:IsA("BasePart") and vroot) then
			return
		end
		local dist = (vroot.Position - root.Position).Magnitude
		local reach = if current == "Final" then 70 else 35
		if dist < reach then
			local k = (1 - dist / reach) * 0.012
			camera.CFrame *= CFrame.Angles((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
		end
	end)
end

return VerityFX
]]></string>
</Properties>
</Item>
