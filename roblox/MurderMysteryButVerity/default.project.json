{
  "name": "MurderMysteryButVerity",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "EnableMouseLockOption": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 4
      }
    },
    "Workspace": {
      "Lobby": {
        "$path": "src/world/Lobby.model.json"
      },
      "Maps": {
        "$path": "src/world/Maps"
      }
    },
    "ServerStorage": {
      "VerityCharacter": {
        "$path": "src/world/VerityCharacter.model.json"
      }
    }
  }
}
