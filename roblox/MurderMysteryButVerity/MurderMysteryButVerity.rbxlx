            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">BallFX</string>
              <string name="Source"><![CDATA[--!strict
-- Animación local de la bola sonriente (diseño original de Verity):
--   - espera: flota, se balancea y da tics como si mirara a su alrededor
--   - transformación (TransformStart): se retuerce cada vez más rápido,
--     tiembla, se eleva hasta el pecho del monstruo y se hunde en él
-- El servidor solo coloca la bola y marca TransformStart; todo el movimiento
-- es local (las piezas están ancladas).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Config = require(ReplicatedStorage.Shared.Config)

type Ball = {
	model: Model,
	base: CFrame,
	twitchAt: number,
	twitch: CFrame,
	goo: ParticleEmitter?,
}

local BallFX = {}

local balls: { [Model]: Ball } = {}

local function track(inst: Instance)
	if not inst:IsA("Model") or balls[inst] then
		return
	end
	local core = inst:WaitForChild("Core", 5)
	if not core then
		return
	end
	balls[inst] = { model = inst, base = inst:GetPivot(), twitchAt = os.clock() + 1, twitch = CFrame.identity }
end

local function gooEmitter(ball: Ball): ParticleEmitter?
	if ball.goo then
		return ball.goo
	end
	local core = ball.model:FindFirstChild("Core")
	if not (core and core:IsA("BasePart")) then
		return nil
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = if Assets.Splash ~= "" then Assets.Splash else Assets.GlowOrb
	emitter.Color = ColorSequence.new(Color3.fromRGB(240, 210, 70), Color3.fromRGB(150, 110, 20))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.1) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Rate = 0
	emitter.Parent = core
	ball.goo = emitter
	return emitter
end

local function update(ball: Ball)
	local model = ball.model
	local clock = os.clock()
	local transformStart = model:GetAttribute("TransformStart") :: number?

	if not transformStart then
		if clock >= ball.twitchAt then
			ball.twitchAt = clock + 1.2 + math.random() * 2.5
			ball.twitch = CFrame.Angles((math.random() - 0.5) * 0.4, (math.random() - 0.5) * 1.2, (math.random() - 0.5) * 0.5)
		end
		local float = CFrame.new(0, math.sin(clock * 1.6) * 0.35, 0)
		local sway = CFrame.Angles(0, math.sin(clock * 0.5) * 0.3, math.sin(clock * 1.1) * 0.06)
		model:PivotTo(ball.base * float * sway * ball.twitch)
		local breathe = 1 + math.sin(clock * 2) * 0.025
		if math.abs(model:GetScale() - breathe) > 0.001 then
			model:ScaleTo(breathe)
		end
		return
	end

	local p = math.clamp((Workspace:GetServerTimeNow() - transformStart) / Config.Round.TransformTime, 0, 1)
	local twist = math.clamp(p / 0.45, 0, 1)
	local rise = math.clamp((p - 0.45) / 0.35, 0, 1)
	local implode = math.clamp((p - 0.8) / 0.2, 0, 1)

	local spin = (twist ^ 2) * 9 + rise * 14 + implode * 10
	local shake = 0.45 * twist * (1 - implode)
	local offset = Vector3.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, (math.random() - 0.5) * shake)
	local wobble = math.sin(clock * 28) * 0.35 * twist
	local height = rise * rise * 7.5
	local scale = (1 + 0.22 * math.sin(clock * 32) * twist) * (1 - 0.4 * rise) * (1 - 0.95 * implode)

	model:PivotTo(ball.base * CFrame.new(offset + Vector3.new(0, height, 0)) * CFrame.Angles(wobble, spin, wobble * 0.6))
	model:ScaleTo(math.max(0.05, scale))

	local goo = gooEmitter(ball)
	if goo then
		goo.Rate = if p < 0.85 then 30 + 120 * twist else 0
	end
end

function BallFX.start()
	for _, inst in CollectionService:GetTagged("VerityBall") do
		task.spawn(track, inst)
	end
	CollectionService:GetInstanceAddedSignal("VerityBall"):Connect(function(inst)
		task.spawn(track, inst)
	end)
	CollectionService:GetInstanceRemovedSignal("VerityBall"):Connect(function(inst)
		balls[inst :: Model] = nil
	end)
	RunService.RenderStepped:Connect(function()
		for model, ball in balls do
			if model.Parent then
				update(ball)
			else
				balls[model] = nil
			end
		end
	end)
end

return BallFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">Cinematics</string>
              <string name="Source"><![CDATA[--!strict
-- Toques cinematográficos (solo cámara y pantalla, nunca bloquean el juego
-- más de unos segundos):
--   - inicio de ronda: barras de cine, título del mapa y la cámara rodea a tu
--     personaje (o a la bola, si eres Verity)
--   - transformación: si eres Verity, la cámara orbita a tu alrededor mientras
--     la bola se convierte en el monstruo
--   - ataque: pequeño zoom (campo de visión) mientras Verity levanta a la víctima

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Pose = require(ReplicatedStorage.Shared.VerityPose)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer

local Cinematics = {}

local gui: ScreenGui
local topBar: Frame
local bottomBar: Frame
local title: CanvasGroup
local titleLabel: TextLabel
local subtitleLabel: TextLabel
local busy = false

local function tween(inst: Instance, time: number, goal: { [string]: any })
	local t = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function letterbox(show: boolean)
	local h = if show then 0.09 else 0
	tween(topBar, 0.6, { Size = UDim2.fromScale(1, h) })
	tween(bottomBar, 0.6, { Size = UDim2.fromScale(1, h) })
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Cinematics",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 10,
		Parent = player:WaitForChild("PlayerGui"),
	})
	topBar = UI.new("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	bottomBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = gui,
	})
	title = UI.new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.9, -12),
		Size = UDim2.fromOffset(600, 80),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Parent = gui,
	})
	titleLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 46),
		FontFace = Font.new("rbxasset://fonts/families/Merriweather.json", Enum.FontWeight.Bold),
		TextSize = 40,
		TextColor3 = Color3.fromRGB(240, 232, 220),
		Parent = title,
	})
	subtitleLabel = UI.label({
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 14,
		TextColor3 = Color3.fromRGB(190, 180, 170),
		Parent = title,
	})
end

-- Distancia segura de cámara: no atraviesa paredes.
local function clampCamera(target: Vector3, wanted: Vector3, ignore: { Instance }): Vector3
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = ignore
	local direction = wanted - target
	local hit = Workspace:Raycast(target, direction, params)
	if hit then
		return target + direction.Unit * math.max(2, (hit.Position - target).Magnitude - 1)
	end
	return wanted
end

-- Órbita de cámara alrededor de `focus()` durante `duration`.
local function orbit(focus: () -> Vector3?, duration: number, radius: { number }, height: { number }, sweep: number, startAngle: number)
	local camera = Workspace.CurrentCamera
	if not camera or busy then
		return
	end
	busy = true
	local previousType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local start = os.clock()
	local ignore: { Instance } = {}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		local t = math.clamp((os.clock() - start) / duration, 0, 1)
		local eased = t * t * (3 - 2 * t)
		local target = focus()
		if not target then
			return
		end
		local angle = startAngle + sweep * eased
		local r = radius[1] + (radius[2] - radius[1]) * eased
		local h = height[1] + (height[2] - height[1]) * eased
		local wanted = target + Vector3.new(math.cos(angle) * r, h, math.sin(angle) * r)
		local position = clampCamera(target, wanted, ignore)
		camera.CFrame = CFrame.lookAt(position, target)
	end)
	task.delay(duration, function()
		connection:Disconnect()
		camera.CameraType = if previousType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else previousType
		busy = false
	end)
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root.Position else nil
end

local function ballPosition(): Vector3?
	for _, inst in Workspace:GetDescendants() do
		if inst:IsA("Model") and inst.Name == "VerityBall" and inst:GetAttribute("Owner") == player.Name then
			return inst:GetPivot().Position
		end
	end
	return nil
end

local function facingAngle(): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local look = root.CFrame.LookVector
		return math.atan2(look.Z, look.X)
	end
	return 0
end

local function roundIntro(mapName: string)
	titleLabel.Text = string.upper(mapName)
	local role = player:GetAttribute("Role")
	subtitleLabel.Text = if role == "Verity" then "Despierta y atrápalos a todos" else "Sobrevive hasta el amanecer"
	letterbox(true)
	tween(title, 0.8, { GroupTransparency = 0 })
	task.wait(0.4)
	local isVerity = role == "Verity"
	local focus = if isVerity then function()
		return ballPosition() or rootPosition()
	end else rootPosition
	orbit(focus, 3.6, if isVerity then { 18, 12 } else { 13, 9 }, { 6, 3 }, math.rad(110), facingAngle() + math.rad(130))
	task.wait(3.4)
	tween(title, 0.8, { GroupTransparency = 1 })
	letterbox(false)
end

local function transformShot()
	if player:GetAttribute("Role") ~= "Verity" then
		return
	end
	local rigHeight = 16
	local character = player.Character
	if character then
		rigHeight = (character:GetAttribute("RigHeight") :: number?) or 16
	end
	letterbox(true)
	orbit(function()
		local root = rootPosition()
		return if root then root + Vector3.new(0, rigHeight * 0.25, 0) else nil
	end, Config.Round.TransformTime + 0.5, { 16, 24 }, { 2, 9 }, math.rad(160), facingAngle() + math.rad(60))
	task.delay(Config.Round.TransformTime + 0.5, function()
		letterbox(false)
	end)
end

local function watchKills(character: Model)
	character:GetAttributeChangedSignal("KillStart"):Connect(function()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		if character:GetAttribute("KillStart") then
			tween(camera, 0.35, { FieldOfView = 58 })
			task.delay(Pose.KillImpact, function()
				tween(camera, 0.15, { FieldOfView = 76 })
			end)
		else
			tween(camera, 0.6, { FieldOfView = 70 })
		end
	end)
end

function Cinematics.init()
	build()
end

function Cinematics.start()
	Workspace:GetAttributeChangedSignal("MapName"):Connect(function()
		local name = Workspace:GetAttribute("MapName")
		if typeof(name) == "string" then
			task.wait(0.6) -- deja que el personaje llegue al mapa
			roundIntro(name)
		end
	end)
	Workspace:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = Workspace:GetAttribute("Phase")
		letterbox(phase == "Results")
	end)
	Net.get("Effect").OnClientEvent:Connect(function(kind)
		if kind == "Transform" then
			transformShot()
		end
	end)
	player.CharacterAdded:Connect(watchKills)
	if player.Character then
		watchKills(player.Character)
	end
end

return Cinematics
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- HUD discreto: píldora superior con fase y reloj, chip de oro, avisos
-- pequeños, tarjeta de rol y banner de resultados.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)
local Music = require(script.Parent.Music)

local player = Players.LocalPlayer
local C = UI.Colors

local HUD = {}

local PHASE_TEXT = {
	Waiting = "ESPERANDO JUGADORES",
	Intermission = "INTERMEDIO",
	Starting = "PREPARANDO",
	Playing = "SOBREVIVE",
	Results = "RESULTADOS",
}

local gui: ScreenGui
local phaseLabel: TextLabel
local timerLabel: TextLabel
local infoPill: Frame
local infoLabel: TextLabel
local goldChip: Frame
local goldLabel: TextLabel
local controls: Frame
local controlsLabel: TextLabel
local coinChip: Frame
local coinLabel: TextLabel
local staminaBar: Frame
local staminaFill: Frame
local toastList: Frame
local roleCard: CanvasGroup
local resultCard: CanvasGroup

local function formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Píldora superior
	local pill = UI.new("Frame", {
		Name = "TopPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(190, 50),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(14), UI.stroke() })
	phaseLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 6),
		TextSize = 11,
		FontFace = UI.FontBold,
		TextColor3 = C.Muted,
		Text = "",
		Parent = pill,
	})
	timerLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 19),
		TextSize = 24,
		FontFace = UI.FontHeavy,
		Text = "",
		Parent = pill,
	})

	infoPill = UI.new("Frame", {
		Name = "Info",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.4,
		Parent = gui,
	}, { UI.corner(12), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	infoLabel = UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		RichText = true,
		TextColor3 = C.Muted,
		Parent = infoPill,
	})

	-- Chip de oro (solo supervivientes en partida)
	goldChip = UI.new("Frame", {
		Name = "Gold",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(118, 42),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, { UI.corner(12), UI.stroke() })
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		Rotation = 45,
		BackgroundColor3 = C.Gold,
		Parent = goldChip,
	}, {
		UI.corner(4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(220, 150, 20)),
			Rotation = 90,
		}),
	})
	goldLabel = UI.label({
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -50, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.FontBold,
		TextSize = 16,
		Parent = goldChip,
	})

	-- Monedas de la ronda (abajo a la izquierda, encima del oro)
	coinChip = UI.new("Frame", {
		Name = "RoundCoins",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -66),
		Size = UDim2.fromOffset(118, 34),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		Visible = false,
		Parent = gui,
	}, { UI.corner(12) })
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.fromRGB(255, 196, 40),
		Parent = coinChip,
	}, { UI.corner(8), UI.stroke(0.4, Color3.fromRGB(150, 100, 10)) })
	coinLabel = UI.label({
		Position = UDim2.fromOffset(36, 0),
		Size = UDim2.new(1, -44, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.FontBold,
		TextSize = 14,
		Parent = coinChip,
	})

	-- Botón de música (debajo del de la tienda)
	local musicButton: TextButton = UI.new("TextButton", {
		Name = "Music",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 40),
		Size = UDim2.fromOffset(34, 26),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		FontFace = UI.FontBold,
		TextSize = 14,
		TextColor3 = C.Text,
		Text = "♪",
		Parent = gui,
	}, { UI.corner(8) })
	musicButton.Activated:Connect(function()
		Music.setEnabled(not Music.isEnabled())
		musicButton.TextColor3 = if Music.isEnabled() then C.Text else C.Muted
		musicButton.BackgroundTransparency = if Music.isEnabled() then 0.3 else 0.6
	end)

	-- Controles y estamina (abajo al centro, discretos)
	controls = UI.new("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.4,
		Visible = false,
		Parent = gui,
	}, { UI.corner(13), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	controlsLabel = UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		RichText = true,
		TextColor3 = C.Muted,
		Parent = controls,
	})
	staminaBar = UI.new("Frame", {
		Name = "Stamina",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -46),
		Size = UDim2.fromOffset(180, 6),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		Visible = false,
		Parent = gui,
	}, { UI.corner(3) })
	staminaFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Survivor,
		BorderSizePixel = 0,
		Parent = staminaBar,
	}, { UI.corner(3) })

	-- Avisos (esquina superior derecha, apilados)
	toastList = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 8),
		Size = UDim2.fromOffset(280, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Tarjeta de rol
	roleCard = UI.new("CanvasGroup", {
		Name = "RoleCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(380, 132),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })

	resultCard = UI.new("CanvasGroup", {
		Name = "Result",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.18),
		Size = UDim2.fromOffset(420, 118),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })
end

local toastOrder = 0
local TOAST_COLORS = { info = C.Muted, good = C.Good, warn = C.Warn, bad = C.Verity }

local function toast(text: string, kind: string?)
	toastOrder += 1
	local color = TOAST_COLORS[kind or "info"] or C.Muted
	local frame = UI.new("CanvasGroup", {
		LayoutOrder = toastOrder,
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		GroupTransparency = 1,
		Parent = toastList,
	}, {
		UI.corner(10),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12) }),
		UI.new("Frame", {
			Size = UDim2.new(0, 3, 1, -14),
			Position = UDim2.new(0, -8, 0, 7),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}, { UI.corner(2) }),
	})
	UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 14,
		Text = text,
		Parent = frame,
	})
	UI.tween(frame, 0.25, { GroupTransparency = 0 })
	-- máximo 4 avisos visibles
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("CanvasGroup") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	task.delay(4, function()
		if frame.Parent then
			UI.tween(frame, 0.4, { GroupTransparency = 1 }).Completed:Wait()
			frame:Destroy()
		end
	end)
end
HUD.toast = toast

local function showCard(card: CanvasGroup, title: string, headline: string, color: Color3, body: string, duration: number)
	card:ClearAllChildren()
	UI.corner(18).Parent = card
	UI.stroke(0.5, color).Parent = card
	UI.label({ Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 14), TextSize = 12, FontFace = UI.FontBold, TextColor3 = C.Muted, Text = title, Parent = card })
	UI.label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 32), TextSize = 34, FontFace = UI.FontHeavy, TextColor3 = color, Text = headline, Parent = card })
	UI.label({ Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, 76), TextSize = 14, TextWrapped = true, TextColor3 = C.Text, Text = body, Parent = card })

	card.Visible = true
	card.GroupTransparency = 1
	local scale = UI.new("UIScale", { Scale = 0.92, Parent = card })
	UI.tween(card, 0.35, { GroupTransparency = 0 })
	UI.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration, function()
		UI.tween(card, 0.5, { GroupTransparency = 1 }).Completed:Wait()
		card.Visible = false
	end)
end

local function onRoleReveal(role: string, killerName: string)
	if role == "Verity" then
		showCard(roleCard, "TU ROL", "ERES VERITY", C.Verity, "Eres una bola sonriente... por ahora. Al despertar: Q atrapar · Shift correr · C agacharse", 4.5)
	elseif role == "Survivor" then
		showCard(roleCard, "TU ROL", "SUPERVIVIENTE", C.Survivor, `Verity es {killerName}. Escóndete en armarios (R), busca oro y craftea tótems.`, 4.5)
	end
end

local function onRoundResult(winner: string, killerName: string, survivors: { string }, totems: number)
	if winner == "Verity" then
		showCard(resultCard, "FIN DE LA RONDA", "VERITY GANA", C.Verity, `{killerName} atrapó a todos. Tótems crafteados: {totems}`, Config.Round.ResultsTime - 0.5)
	else
		local names = if #survivors > 0 then table.concat(survivors, ", ") else "nadie"
		if #names > 70 then
			names = `{#survivors} supervivientes`
		end
		showCard(resultCard, "FIN DE LA RONDA", "SUPERVIVIENTES GANAN", C.Survivor, `Sobrevivieron: {names}. Tótems: {totems}`, Config.Round.ResultsTime - 0.5)
	end
end

local function update()
	local phase = (Workspace:GetAttribute("Phase") :: string?) or "Waiting"
	local endsAt = (Workspace:GetAttribute("PhaseEndsAt") :: number?) or 0
	local now = Workspace:GetServerTimeNow()
	local remaining = endsAt - now
	local role = (player:GetAttribute("Role") :: string?) or "Lobby"

	phaseLabel.Text = PHASE_TEXT[phase] or phase
	if phase == "Waiting" then
		local needed = if Workspace:GetAttribute("TestMode") then 1 else Config.Round.MinPlayers
		timerLabel.Text = `{#Players:GetPlayers()}/{needed}`
	elseif endsAt > 0 then
		timerLabel.Text = formatTime(remaining)
	else
		timerLabel.Text = "..."
	end
	local urgent = phase == "Playing" and remaining <= 10
	timerLabel.TextColor3 = if urgent then C.Verity else C.Text

	-- Línea de información contextual
	local info = ""
	if phase == "Waiting" or phase == "Intermission" or role == "Lobby" then
		local chance = (player:GetAttribute("VerityChance") :: number?) or 0
		info = `Probabilidad de Verity: <font color="#ff3b4e"><b>{chance}%</b></font>`
		if phase == "Playing" then
			info ..= "  ·  ronda en curso"
		end
	elseif phase == "Playing" then
		local releaseAt = (Workspace:GetAttribute("KillerReleaseAt") :: number?) or 0
		local totems = Workspace:GetAttribute("Totems") or 0
		local maxTotems = Workspace:GetAttribute("MaxTotems") or 0
		local alive = Workspace:GetAttribute("SurvivorsAlive") or 0
		if releaseAt > now then
			info = `Verity despierta en <font color="#ff3b4e"><b>{math.ceil(releaseAt - now)}s</b></font>`
		else
			info = `Tótems <font color="#ffc83c"><b>{totems}/{maxTotems}</b></font>  ·  Vivos <b>{alive}</b>`
		end
	end
	infoLabel.Text = info
	infoPill.Visible = info ~= ""

	local inRound = phase == "Playing" or phase == "Starting"
	local key = function(k: string, text: string)
		return `<font color="#f0ecf5"><b>{k}</b></font> {text}`
	end
	if inRound and role == "Verity" then
		controlsLabel.Text = `{key("Q", "Atrapar")}   {key("Shift", "Correr")}   {key("C", "Agacharse")}`
	elseif inRound and role == "Survivor" then
		controlsLabel.Text = `{key("Shift", "Correr")}   {key("E", "Oro / mesa")}   {key("F", "Craftear")}   {key("R", "Esconderse")}`
	else
		controlsLabel.Text = ""
	end
	controls.Visible = controlsLabel.Text ~= ""

	local stamina = (player:GetAttribute("Stamina") :: number?) or Config.Movement.StaminaMax
	staminaBar.Visible = inRound and role == "Survivor" and stamina < Config.Movement.StaminaMax
	staminaFill.Size = UDim2.fromScale(stamina / Config.Movement.StaminaMax, 1)
	staminaFill.BackgroundColor3 = if stamina < 25 then C.Warn else C.Survivor

	coinChip.Visible = phase == "Playing" and (role == "Survivor" or role == "Verity")
	if coinChip.Visible then
		local got = (player:GetAttribute("RoundCoins") :: number?) or 0
		coinLabel.Text = `{got}/{Config.Coins.MaxPerRound}`
	end

	local showGold = phase == "Playing" and role == "Survivor"
	goldChip.Visible = showGold
	if showGold then
		local gold = (player:GetAttribute("Gold") :: number?) or 0
		goldLabel.Text = `Oro {gold}/{Config.Crafting.MaxGoldCarried}`
	end
end

function HUD.init()
	build()
end

function HUD.start()
	-- el HUD se actualiza aunque los remotes tarden en llegar
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			update()
		end
	end)
	update()

	Net.get("Notify").OnClientEvent:Connect(toast)
	Net.get("RoleReveal").OnClientEvent:Connect(onRoleReveal)
	Net.get("RoundResult").OnClientEvent:Connect(onRoundResult)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!strict
-- Controles: Shift correr, C agacharse (Verity), Q atrapar (Verity).
-- Solo envía intenciones; el servidor valida rol, estamina y distancia.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local player = Players.LocalPlayer

local Input = {}

local action: RemoteEvent
local crouching = false

local function isVerity(): boolean
	return player:GetAttribute("Role") == "Verity"
end

local function onSprint(_, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		action:FireServer("Sprint", true)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		action:FireServer("Sprint", false)
	end
	return Enum.ContextActionResult.Pass
end

local function onCrouch(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin or not isVerity() then
		return Enum.ContextActionResult.Pass
	end
	crouching = not crouching
	action:FireServer("Crouch", crouching)
	return Enum.ContextActionResult.Sink
end

local lastKill = 0
local function onKill(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin or not isVerity() then
		return Enum.ContextActionResult.Pass
	end
	if os.clock() - lastKill > 0.25 then
		lastKill = os.clock()
		action:FireServer("Kill")
	end
	return Enum.ContextActionResult.Sink
end

function Input.start()
	action = Net.get("Action")
	ContextActionService:BindAction("Sprint", onSprint, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
	ContextActionService:BindAction("Crouch", onCrouch, false, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("Kill", onKill, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	player:GetAttributeChangedSignal("Role"):Connect(function()
		crouching = false
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">Music</string>
              <string name="Source"><![CDATA[--!strict
-- Música ambiente de terror en tres capas:
--   1. pista principal según la fase (lobby, ronda interior, ronda exterior,
--      resultados), con fundido entre pistas
--   2. zumbido metálico muy bajo durante la ronda
--   3. persecución: sube cuando Verity está cerca de alguien (si eres Verity,
--      cerca de un superviviente; si eres superviviente, cerca de Verity)
-- Pistas de DistroKid y APM oficiales en Roblox (uso permitido en experiencias),
-- encontradas con ForgeGUI. Se silencia todo con el botón ♪ del HUD.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local player = Players.LocalPlayer
local CHASE_RADIUS = 38

local Music = {}

local sound: Sound
local drone: Sound
local chase: Sound
local currentList: { number } = {}
local currentName = ""
local index = 0
local enabled = true
local transitioning = false

local function listFor(phase: string): (string, { number })
	if phase == "Starting" or phase == "Playing" then
		if Workspace:GetAttribute("MapOutdoor") then
			return "Outdoor", Config.Music.Outdoor
		end
		return "Round", Config.Music.Round
	elseif phase == "Results" then
		return "Results", Config.Music.Results
	end
	return "Lobby", Config.Music.Lobby
end

local function fade(target: Sound, volume: number, time: number): Tween
	local tween = TweenService:Create(target, TweenInfo.new(time, Enum.EasingStyle.Sine), { Volume = volume })
	tween:Play()
	return tween
end

local function playNext()
	if #currentList == 0 then
		sound:Stop()
		return
	end
	index = index % #currentList + 1
	sound.SoundId = `rbxassetid://{currentList[index]}`
	sound.TimePosition = 0
	sound.Volume = 0
	sound:Play()
	if enabled then
		fade(sound, Config.Music.Volume, 2)
	end
	-- si la pista no carga (moderada o no disponible), pasa a la siguiente
	local expected = sound.SoundId
	task.delay(8, function()
		if sound.SoundId == expected and sound.TimeLength == 0 and #currentList > 1 then
			playNext()
		end
	end)
end

local function onPhase()
	local phase = (Workspace:GetAttribute("Phase") :: string?) or "Waiting"
	local inRound = phase == "Playing" or phase == "Starting"
	fade(drone, if inRound and enabled then Config.Music.Volume * 0.35 else 0, 2)
	local name, list = listFor(phase)
	if name == currentName then
		return
	end
	currentName = name
	currentList = list
	index = math.random(0, math.max(0, #list - 1))
	transitioning = true
	if sound.IsPlaying then
		fade(sound, 0, 1.2).Completed:Wait()
	end
	playNext()
	task.delay(2.1, function()
		transitioning = false
	end)
end

-- Distancia entre Verity y el superviviente más cercano que me importa.
local function threatDistance(): number
	local role = player:GetAttribute("Role")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return math.huge
	end
	local best = math.huge
	local function consider(model: Instance?)
		local other = model and model:FindFirstChild("HumanoidRootPart")
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		if other and other:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			best = math.min(best, (other.Position - root.Position).Magnitude)
		end
	end
	if role == "Verity" then
		for _, other in Players:GetPlayers() do
			if other:GetAttribute("Role") == "Survivor" then
				consider(other.Character)
			end
		end
		for _, bot in CollectionService:GetTagged("Bot") do
			if not bot:GetAttribute("Hidden") then
				consider(bot)
			end
		end
	elseif role == "Survivor" then
		for _, other in Players:GetPlayers() do
			if other:GetAttribute("Role") == "Verity" and other.Character and other.Character:GetAttribute("Released") then
				consider(other.Character)
			end
		end
	end
	return best
end

function Music.setEnabled(value: boolean)
	enabled = value
	fade(sound, if value then Config.Music.Volume else 0, 0.6)
	onPhase()
end

function Music.isEnabled(): boolean
	return enabled
end

function Music.init()
	sound = Instance.new("Sound")
	sound.Name = "AmbientMusic"
	sound.Volume = 0
	sound.Parent = SoundService
	sound.Ended:Connect(playNext)

	drone = Instance.new("Sound")
	drone.Name = "AmbientDrone"
	drone.SoundId = `rbxassetid://{Config.Music.Drone}`
	drone.Looped = true
	drone.Volume = 0
	drone.Parent = SoundService

	chase = Instance.new("Sound")
	chase.Name = "ChaseMusic"
	chase.SoundId = `rbxassetid://{Config.Music.Chase}`
	chase.Looped = true
	chase.Volume = 0
	chase.Parent = SoundService
end

function Music.start()
	Workspace:GetAttributeChangedSignal("Phase"):Connect(function()
		task.spawn(onPhase)
	end)
	drone:Play()
	chase:Play()
	onPhase()

	-- la persecución sube y baja según la distancia; la música principal se agacha
	local accumulator = 0
	local chaseLevel = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.25 then
			return
		end
		accumulator = 0
		local phase = Workspace:GetAttribute("Phase")
		local target = 0
		if enabled and phase == "Playing" then
			local d = threatDistance()
			target = math.clamp(1 - (d - 12) / (CHASE_RADIUS - 12), 0, 1)
		end
		chaseLevel += (target - chaseLevel) * 0.35
		chase.Volume = chaseLevel * Config.Music.Volume * 1.6
		if enabled and sound.IsPlaying and not transitioning then
			sound.Volume = Config.Music.Volume * (1 - 0.7 * chaseLevel)
		end
	end)
end

return Music
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Tienda: pestañas Objetos (monedas), Skins de Verity (monedas) y Pases
-- (Robux). Se abre con el botón "Tienda" (fuera de partida) o desde el
-- mostrador del lobby. Las compras las valida el servidor (ShopRequest).

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer
local C = UI.Colors

local Shop = {}

type Tab = "Items" | "Skins" | "Passes"

local gui: ScreenGui
local openButton: TextButton
local openChance: TextLabel
local panel: CanvasGroup
local coinsLabel: TextLabel
local footer: TextLabel
local pages: { [Tab]: ScrollingFrame } = {}
local tabButtons: { [Tab]: TextButton } = {}
local refreshers: { () -> () } = {}
local isOpen = false
local request: RemoteEvent

local function decode(attr: string): { string }
	local raw = player:GetAttribute(attr)
	if typeof(raw) ~= "string" then
		return {}
	end
	local ok, result = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and typeof(result) == "table" then result else {}
end

local function coins(): number
	return (player:GetAttribute("Coins") :: number?) or 0
end

local function setTab(tab: Tab)
	for name, page in pages do
		page.Visible = name == tab
		local button = tabButtons[name]
		button.BackgroundColor3 = if name == tab then C.Verity else C.PanelLight
		button.TextColor3 = if name == tab then Color3.new(1, 1, 1) else C.Muted
	end
	footer.Visible = tab == "Items"
end

local function setOpen(open: boolean, tab: Tab?)
	isOpen = open
	if tab then
		setTab(tab)
	end
	if open then
		panel.Visible = true
		UI.tween(panel, 0.25, { GroupTransparency = 0 })
	else
		UI.tween(panel, 0.2, { GroupTransparency = 1 }).Completed:Connect(function()
			if not isOpen then
				panel.Visible = false
			end
		end)
	end
end

local function styleButton(button: TextButton, text: string, kind: "buy" | "neutral" | "done")
	button.Text = text
	if kind == "buy" then
		button.BackgroundColor3 = C.Gold
		button.TextColor3 = Color3.fromRGB(30, 20, 10)
	elseif kind == "neutral" then
		button.BackgroundColor3 = C.Survivor
		button.TextColor3 = Color3.fromRGB(10, 30, 25)
	else
		button.BackgroundColor3 = C.PanelLight
		button.TextColor3 = C.Good
	end
end

local function card(parent: Instance, order: number): (Frame, TextButton)
	local frame = UI.new("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.15,
		Parent = parent,
	}, { UI.corner(12) })
	local button: TextButton = UI.new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 30),
		FontFace = UI.FontBold,
		TextSize = 13,
		AutoButtonColor = true,
		Parent = frame,
	}, { UI.corner(8) })
	return frame, button
end

local function texts(frame: Frame, title: string, description: string)
	UI.label({ Position = UDim2.fromOffset(62, 12), Size = UDim2.new(1, -70, 0, 34), TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, FontFace = UI.FontBold, TextSize = 14, Text = title, Parent = frame })
	UI.label({ Position = UDim2.fromOffset(10, 58), Size = UDim2.new(1, -20, 0, 44), TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextSize = 11, TextColor3 = C.Muted, Text = description, Parent = frame })
end

local function buildItems(page: ScrollingFrame)
	for i, item in Config.Items do
		local frame, button = card(page, i)
		UI.new("TextLabel", {
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = item.Color,
			FontFace = UI.FontHeavy,
			TextSize = 13,
			TextColor3 = Color3.new(1, 1, 1),
			Text = item.Badge,
			Parent = frame,
		}, { UI.corner(10), UI.new("UIGradient", { Transparency = NumberSequence.new(0, 0.35), Rotation = 90 }) })
		texts(frame, item.Title, item.Description)
		local function refresh()
			local owned = table.find(decode("OwnedItems"), item.Key) ~= nil
			local equipped = table.find(decode("EquippedItems"), item.Key) ~= nil
			if not owned then
				styleButton(button, `Comprar · {item.Price}`, "buy")
				button.AutoButtonColor = coins() >= item.Price
				button.BackgroundTransparency = if coins() >= item.Price then 0 else 0.5
			elseif equipped then
				styleButton(button, "Equipado (quitar)", "done")
				button.BackgroundTransparency = 0
			else
				styleButton(button, "Equipar", "neutral")
				button.BackgroundTransparency = 0
			end
		end
		table.insert(refreshers, refresh)
		button.Activated:Connect(function()
			local owned = table.find(decode("OwnedItems"), item.Key) ~= nil
			request:FireServer(if owned then "EquipItem" else "BuyItem", item.Key)
		end)
	end
end

local function buildSkins(page: ScrollingFrame)
	for i, skin in Config.Skins do
		local s: any = skin
		local frame, button = card(page, i)
		-- muestra: círculo con el tinte y el contorno de la skin
		local base = Color3.fromRGB(214, 194, 92)
		UI.new("Frame", {
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = base:Lerp(s.Tint, s.Amount),
			BackgroundTransparency = if s.Ghost then 0.45 else 0,
			Parent = frame,
		}, { UI.corner(21), UI.stroke(if s.Outline then 0 else 0.7, s.Outline or Color3.new(1, 1, 1)) })
		texts(frame, s.Title, s.Description)
		local function refresh()
			local owned = table.find(decode("OwnedSkins"), s.Key) ~= nil or s.Price == 0
			local equipped = player:GetAttribute("Skin") == s.Key
			if equipped then
				styleButton(button, "Equipada", "done")
				button.BackgroundTransparency = 0
			elseif owned then
				styleButton(button, "Equipar", "neutral")
				button.BackgroundTransparency = 0
			else
				styleButton(button, `Comprar · {s.Price}`, "buy")
				button.BackgroundTransparency = if coins() >= s.Price then 0 else 0.5
			end
		end
		table.insert(refreshers, refresh)
		button.Activated:Connect(function()
			local owned = table.find(decode("OwnedSkins"), s.Key) ~= nil or s.Price == 0
			request:FireServer(if owned then "EquipSkin" else "BuySkin", s.Key)
		end)
	end
end

local function buildPasses(page: ScrollingFrame)
	local list = {}
	for _, pass in Config.GamePasses do
		table.insert(list, { kind = "pass", key = pass.Key, id = pass.Id, badge = `{pass.Multiplier}x`, title = pass.Title, description = pass.Description })
	end
	for _, product in Config.Products do
		table.insert(list, { kind = "product", key = product.Key, id = product.Id, badge = `x{product.Multiplier}`, title = product.Title, description = product.Description })
	end
	for i, entry in list do
		local frame, button = card(page, i)
		UI.new("TextLabel", {
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = if entry.kind == "product" then Color3.fromRGB(150, 80, 255) else C.Verity,
			FontFace = UI.FontHeavy,
			TextSize = 16,
			TextColor3 = Color3.new(1, 1, 1),
			Text = entry.badge,
			Parent = frame,
		}, { UI.corner(10) })
		texts(frame, entry.title, entry.description)
		if entry.id == 0 then
			styleButton(button, "Pronto", "done")
			button.TextColor3 = C.Muted
			button.AutoButtonColor = false
			continue
		end
		styleButton(button, "...", "buy")
		task.spawn(function()
			local infoType = if entry.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, entry.id, infoType)
			button.Text = if ok and info and info.PriceInRobux then `R$ {info.PriceInRobux}` else "Comprar"
		end)
		local function refresh()
			if entry.kind == "pass" and player:GetAttribute("Pass_" .. entry.key) then
				styleButton(button, "Adquirido", "done")
			end
		end
		table.insert(refreshers, refresh)
		button.Activated:Connect(function()
			if entry.kind == "pass" then
				if not player:GetAttribute("Pass_" .. entry.key) then
					MarketplaceService:PromptGamePassPurchase(player, entry.id)
				end
			else
				MarketplaceService:PromptProductPurchase(player, entry.id)
			end
		end)
	end
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})

	openButton = UI.new("TextButton", {
		Name = "OpenShop",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(132, 46),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		Text = "",
		AutoButtonColor = true,
		Parent = gui,
	}, { UI.corner(12), UI.stroke(0.6, C.Gold) })
	UI.label({ Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontBold, TextSize = 15, Text = "Tienda", Parent = openButton })
	openChance = UI.label({ Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, 25), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 11, TextColor3 = C.Muted, Parent = openButton })

	panel = UI.new("CanvasGroup", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(620, 450),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local camera = Workspace.CurrentCamera
		if camera then
			local view = camera.ViewportSize
			scale.Scale = math.min(1, (view.X - 24) / 620, (view.Y - 60) / 450)
		end
	end
	fit()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end

	-- cabecera
	UI.label({ Position = UDim2.fromOffset(18, 14), Size = UDim2.fromOffset(200, 26), TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.FontHeavy, TextSize = 22, Text = "TIENDA", Parent = panel })
	local coinPill = UI.new("Frame", {
		Position = UDim2.fromOffset(130, 14),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.PanelLight,
		Parent = panel,
	}, { UI.corner(13), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 30), PaddingRight = UDim.new(0, 12) }) })
	UI.new("Frame", { Position = UDim2.new(0, -22, 0.5, -8), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.Gold, Parent = coinPill }, { UI.corner(8) })
	coinsLabel = UI.label({ Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, FontFace = UI.FontBold, TextSize = 14, TextColor3 = C.Gold, Parent = coinPill })
	local close: TextButton = UI.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = C.PanelLight,
		FontFace = UI.FontBold,
		TextColor3 = C.Muted,
		TextSize = 14,
		Text = "X",
		Parent = panel,
	}, { UI.corner(15) })
	close.Activated:Connect(function()
		setOpen(false)
	end)

	-- pestañas
	local tabs = UI.new("Frame", {
		Position = UDim2.fromOffset(18, 50),
		Size = UDim2.new(1, -36, 0, 30),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local tabDefs: { { name: Tab, label: string } } = {
		{ name = "Items", label = "Objetos" },
		{ name = "Skins", label = "Skins de Verity" },
		{ name = "Passes", label = "Pases" },
	}
	for i, def in tabDefs do
		local name, label = def.name, def.label
		local button: TextButton = UI.new("TextButton", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = C.PanelLight,
			FontFace = UI.FontBold,
			TextSize = 13,
			TextColor3 = C.Muted,
			Text = label,
			Parent = tabs,
		}, { UI.corner(15), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
		tabButtons[name] = button
		button.Activated:Connect(function()
			setTab(name)
		end)

		local page: ScrollingFrame = UI.new("ScrollingFrame", {
			Position = UDim2.fromOffset(14, 90),
			Size = UDim2.new(1, -28, 1, -126),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = C.Muted,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			Parent = panel,
		}, {
			UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(186, 148), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			UI.new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 2) }),
		})
		pages[name] = page
	end
	footer = UI.label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -10), Size = UDim2.new(1, -36, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Left, TextSize = 11, TextColor3 = C.Muted, Parent = panel })

	buildItems(pages.Items)
	buildSkins(pages.Skins)
	buildPasses(pages.Passes)
	setTab("Items")

	openButton.Activated:Connect(function()
		setOpen(not isOpen)
	end)
end

local function refresh()
	local chance = (player:GetAttribute("VerityChance") :: number?) or 0
	openChance.Text = `{coins()} monedas · Verity {chance}%`
	coinsLabel.Text = tostring(coins())
	footer.Text = `Objetos equipados: {#decode("EquippedItems")}/{Config.MaxEquipped} · se llevan a las rondas`
	for _, fn in refreshers do
		fn()
	end
	local role = player:GetAttribute("Role")
	local inRound = role == "Survivor" or role == "Verity"
	openButton.Visible = not inRound
	if inRound and isOpen then
		setOpen(false)
	end
end

function Shop.init()
	build()
end

function Shop.start()
	request = Net.get("ShopRequest")
	for _, attr in { "VerityChance", "Coins", "OwnedItems", "EquippedItems", "OwnedSkins", "Skin", "Role", "Pass_Chance2x", "Pass_Chance3x" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	-- mostrador de la tienda en el lobby
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt:GetAttribute("OpensShop") then
			setOpen(true, "Items")
		end
	end)
	refresh()
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">VerityAnimator</string>
              <string name="Source"><![CDATA[--!strict
-- Anima a Verity en cada cliente:
--   - reposo: respiración, brazos colgando y tics de cabeza inquietantes
--   - caminar / correr: zancadas largas; al correr se encorva y los brazos
--     quedan atrás
--   - agacharse (C): rodillas flexionadas que coinciden con la bajada de cadera
--   - transformación: se estira, abre los brazos y echa la cabeza atrás
--   - ataque (Q): sigue la misma línea de tiempo que usa el servidor
--
-- Funciona con cualquier rig (R15, R6 o personalizado): busca las uniones por
-- nombre y aplica las rotaciones en el marco del torso. Escribe C0 en local
-- (en vez de Motor6D.Transform), así ningún Animator de Roblox lo pisa, y
-- recoge las uniones aunque lleguen después del modelo.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Pose = require(ReplicatedStorage.Shared.VerityPose)

local JOINTS: { [string]: { string } } = {
	Waist = { "Waist" },
	Neck = { "Neck" },
	HeadJoint = { "HeadJoint" },
	LeftShoulder = { "LeftShoulder", "Left Shoulder" },
	RightShoulder = { "RightShoulder", "Right Shoulder" },
	LeftElbow = { "LeftElbow" },
	RightElbow = { "RightElbow" },
	LeftWrist = { "LeftWrist" },
	RightWrist = { "RightWrist" },
	LeftHip = { "LeftHip", "Left Hip" },
	RightHip = { "RightHip", "Right Hip" },
	LeftKnee = { "LeftKnee" },
	RightKnee = { "RightKnee" },
	LeftAnkle = { "LeftAnkle" },
	RightAnkle = { "RightAnkle" },
}

type Joint = { motor: Motor6D, base: CFrame, frame: CFrame }
type Rig = {
	model: Model,
	root: BasePart?,
	joints: { [string]: Joint },
	crouchAngle: number,
	phase: number,
	crouch: number,
	stride: number,
	twitchAt: number,
	twitch: CFrame,
	connection: RBXScriptConnection?,
}

local VerityAnimator = {}

local rigs: { [Model]: Rig } = {}

local function addJoint(rig: Rig, inst: Instance)
	if not inst:IsA("Motor6D") then
		return
	end
	for key, names in JOINTS do
		if not rig.joints[key] and table.find(names, inst.Name) then
			rig.joints[key] = { motor = inst, base = inst.C0, frame = inst.C0.Rotation }
		end
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or rigs[model] then
		return
	end
	local rig: Rig = {
		model = model,
		root = nil,
		joints = {},
		crouchAngle = Pose.read(model).crouchAngle,
		phase = 0,
		crouch = 0,
		stride = 0,
		twitchAt = os.clock() + 2,
		twitch = CFrame.identity,
	}
	for _, inst in model:GetDescendants() do
		addJoint(rig, inst)
	end
	-- las piezas pueden llegar después que el modelo: se recogen al llegar
	rig.connection = model.DescendantAdded:Connect(function(inst)
		addJoint(rig, inst)
	end)
	rigs[model] = rig
end

local function untrack(model: Model)
	local rig = rigs[model]
	if rig and rig.connection then
		rig.connection:Disconnect()
	end
	rigs[model] = nil
end

-- Aplica una rotación expresada en el marco del modelo (X = derecha,
-- ángulo positivo = hacia delante) a la unión, sea cual sea su C0.
local function set(rig: Rig, name: string, rotation: CFrame)
	local joint = rig.joints[name]
	if joint and joint.motor.Parent then
		joint.motor.C0 = joint.base * (joint.frame:Inverse() * rotation * joint.frame)
	end
end

local function rx(a: number): CFrame
	return CFrame.Angles(a, 0, 0)
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function animate(rig: Rig, dt: number)
	local model = rig.model
	local root = rig.root
	if not root then
		local found = model:FindFirstChild("HumanoidRootPart")
		if found and found:IsA("BasePart") then
			rig.root = found
			root = found
		else
			return
		end
	end
	local clock = os.clock()

	-- Ataque (Q)
	local killStart = model:GetAttribute("KillStart") :: number?
	if killStart then
		local t = Workspace:GetServerTimeNow() - killStart
		local shoulder, elbow, waist = Pose.killAngles(t)
		local inward = math.rad(14) * math.clamp(shoulder / math.rad(60), 0, 1)
		set(rig, "Waist", rx(waist))
		set(rig, "LeftShoulder", rx(shoulder) * CFrame.Angles(0, 0, inward))
		set(rig, "RightShoulder", rx(shoulder) * CFrame.Angles(0, 0, -inward))
		set(rig, "LeftElbow", rx(elbow))
		set(rig, "RightElbow", rx(elbow))
		set(rig, "Neck", rx(-waist * 0.4) * CFrame.Angles(0, 0, math.sin(clock * 30) * 0.05))
		for _, name in { "HeadJoint", "LeftHip", "RightHip", "LeftKnee", "RightKnee", "LeftAnkle", "RightAnkle", "LeftWrist", "RightWrist" } do
			set(rig, name, CFrame.identity)
		end
		return
	end

	-- Transformación: se estira desde encogida, abre los brazos y ruge
	local transformStart = model:GetAttribute("TransformStart") :: number?
	if transformStart then
		local t = (Workspace:GetServerTimeNow() - transformStart) / Config.Round.TransformTime
		local curl = 1 - smooth(t * 1.6) -- encogida al principio
		local open = smooth((t - 0.45) * 2.5) -- brazos abiertos al final
		local jitter = (1 - t) * 0.12
		local function j(): number
			return (math.random() - 0.5) * jitter
		end
		set(rig, "Waist", rx(math.rad(-55) * curl + math.rad(14) * open + j()))
		set(rig, "Neck", rx(math.rad(-30) * curl + math.rad(30) * open) * CFrame.Angles(j(), j(), j()))
		set(rig, "LeftShoulder", rx(math.rad(40) * curl + math.rad(60) * open) * CFrame.Angles(0, 0, -math.rad(70) * open + j()))
		set(rig, "RightShoulder", rx(math.rad(40) * curl + math.rad(60) * open) * CFrame.Angles(0, 0, math.rad(70) * open + j()))
		set(rig, "LeftElbow", rx(math.rad(90) * curl + j()))
		set(rig, "RightElbow", rx(math.rad(90) * curl + j()))
		set(rig, "LeftHip", rx(math.rad(60) * curl))
		set(rig, "RightHip", rx(math.rad(60) * curl))
		set(rig, "LeftKnee", rx(-math.rad(110) * curl))
		set(rig, "RightKnee", rx(-math.rad(110) * curl))
		set(rig, "LeftAnkle", rx(math.rad(50) * curl))
		set(rig, "RightAnkle", rx(math.rad(50) * curl))
		return
	end

	local velocity = root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
	local speed = velocity.Magnitude
	local walkSpeed = Config.Movement.VerityWalk
	local targetStride = math.clamp(speed / walkSpeed, 0, 1.6)
	rig.stride += (targetStride - rig.stride) * math.min(1, dt * 8)
	local targetCrouch = if model:GetAttribute("Crouching") then 1 else 0
	rig.crouch += (targetCrouch - rig.crouch) * math.min(1, dt * 10)

	-- cadencia: piernas muy largas, más rápida al correr
	rig.phase += dt * (1.8 + speed * 0.17)
	local s = math.sin(rig.phase)
	local c = math.cos(rig.phase)
	local stride = math.min(rig.stride, 1)
	local run = math.clamp(rig.stride - 1, 0, 0.6) / 0.6 -- 0 caminando, 1 corriendo
	local crouch = rig.crouch
	local theta = rig.crouchAngle * crouch
	local hasKnees = rig.joints.LeftKnee ~= nil

	-- piernas
	local swing = s * (0.5 + 0.25 * run) * stride * (1 - crouch * 0.5)
	local liftL = math.max(0, c) * (0.8 + 0.5 * run) * stride
	local liftR = math.max(0, -c) * (0.8 + 0.5 * run) * stride
	set(rig, "LeftHip", rx(theta + swing + 0.15 * run))
	set(rig, "RightHip", rx(theta - swing + 0.15 * run))
	if hasKnees then
		set(rig, "LeftKnee", rx(-2 * theta - liftL))
		set(rig, "RightKnee", rx(-2 * theta - liftR))
		set(rig, "LeftAnkle", rx(theta + liftL * 0.4))
		set(rig, "RightAnkle", rx(theta + liftR * 0.4))
	end

	-- torso: respira en reposo, se encorva al correr y al agacharse
	local breathe = math.sin(clock * 1.4) * 0.03 * (1 - stride)
	local lean = -0.1 * stride - 0.45 * run - 0.35 * crouch
	local bob = math.abs(s) * 0.05 * stride
	set(rig, "Waist", rx(lean + breathe - bob) * CFrame.Angles(0, s * 0.1 * stride, s * 0.04 * stride))

	-- brazos: cuelgan y se balancean; al correr quedan atrás, como arrastrados
	local armSwing = -s * (0.55 - 0.25 * run) * stride
	local dangle = math.sin(clock * 1.1) * 0.06 * (1 - stride)
	local back = -0.7 * run
	set(rig, "LeftShoulder", rx(-armSwing + dangle + back + 0.25 * crouch) * CFrame.Angles(0, 0, -0.07 - 0.1 * run))
	set(rig, "RightShoulder", rx(armSwing - dangle + back + 0.25 * crouch) * CFrame.Angles(0, 0, 0.07 + 0.1 * run))
	set(rig, "LeftElbow", rx(math.max(0, -armSwing) * 0.5 + 0.12))
	set(rig, "RightElbow", rx(math.max(0, armSwing) * 0.5 + 0.12))
	set(rig, "LeftWrist", rx(-0.15 + math.sin(clock * 2.3) * 0.08))
	set(rig, "RightWrist", rx(-0.15 + math.sin(clock * 2.1 + 1) * 0.08))

	-- cabeza: compensa la inclinación; en reposo, tics bruscos cada pocos segundos
	if clock >= rig.twitchAt then
		rig.twitchAt = clock + 1.5 + math.random() * 3
		rig.twitch = CFrame.Angles((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.9, (math.random() - 0.5) * 0.8)
	end
	local rest = 1 - math.min(1, rig.stride * 1.5)
	local twitch = CFrame.identity:Lerp(rig.twitch, rest)
	set(rig, "Neck", rx(-lean * 0.7 + c * 0.05 * stride + 0.25 * run) * twitch)
	set(rig, "HeadJoint", CFrame.Angles(0, 0, math.sin(clock * 0.6) * 0.12 * rest))
end

function VerityAnimator.start()
	for _, model in CollectionService:GetTagged("VerityRig") do
		track(model)
	end
	CollectionService:GetInstanceAddedSignal("VerityRig"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("VerityRig"):Connect(function(model)
		untrack(model :: Model)
	end)

	RunService.Stepped:Connect(function(_, dt)
		for model, rig in rigs do
			if not model.Parent then
				untrack(model)
				continue
			end
			local root = rig.root
			local busy = model:GetAttribute("KillStart") ~= nil or model:GetAttribute("TransformStart") ~= nil
			if busy or not root or not root.Anchored then
				animate(rig, dt)
			end
		end
	end)
end

return VerityAnimator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[--!strict
-- Efectos locales: oro girando, lámparas parpadeantes, golpes, tótems,
-- viñeta de "radio de terror" y bloqueo de prompts para Verity.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer

local TERROR_RADIUS = 45

local WorldFX = {}

local goldBlocks: { [BasePart]: CFrame } = {}
local coins: { [BasePart]: CFrame } = {}
local vignette: Frame
local flash: Frame

local function playSound(id: string, position: Vector3, volume: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = Workspace
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.8
	sound.RollOffMaxDistance = 120
	sound.Parent = holder
	sound:Play()
	game:GetService("Debris"):AddItem(holder, 4)
	return holder
end

local function burst(position: Vector3, color: Color3, texture: string, count: number, speed: number)
	local holder = playSound("", position, 0)
	local emitter = Instance.new("ParticleEmitter")
	if texture ~= "" then
		emitter.Texture = texture
	end
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.35, 0.7)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
end

local function shockRing(position: Vector3)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Transparency = 1
	ring.Size = Vector3.new(1, 0.05, 1)
	ring.CFrame = CFrame.new(position)
	ring.Parent = Workspace
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = if Assets.ShockRing ~= "" then Assets.ShockRing else Assets.GlowOrb
	decal.Color3 = Color3.fromRGB(110, 230, 255)
	decal.Parent = ring
	UI.tween(ring, 0.9, { Size = Vector3.new(36, 0.05, 36) })
	UI.tween(decal, 0.9, { Transparency = 1 })
	game:GetService("Debris"):AddItem(ring, 1)
end

local screams: { Sound } = {}
local shakeUntil = 0
local shakeStrength = 0

-- Salpicadura de sangre: nube de líquido, gotas alargadas que caen y
-- sacudida de cámara según la distancia.
local function gore(position: Vector3)
	playSound("rbxasset://sounds/swordslash.wav", position, 1)
	playSound("rbxasset://sounds/collide.wav", position, 1)

	local holder = playSound("", position + Vector3.new(0, 1, 0), 0)
	local splash = Instance.new("ParticleEmitter")
	splash.Texture = if Assets.Splash ~= "" then Assets.Splash else Assets.GlowOrb
	splash.Color = ColorSequence.new(Color3.fromRGB(170, 8, 20), Color3.fromRGB(90, 0, 8))
	splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(0.4, 4), NumberSequenceKeypoint.new(1, 2.5) })
	splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) })
	splash.Lifetime = NumberRange.new(0.5, 0.9)
	splash.Speed = NumberRange.new(8, 22)
	splash.SpreadAngle = Vector2.new(70, 70)
	splash.EmissionDirection = Enum.NormalId.Top
	splash.Acceleration = Vector3.new(0, -45, 0)
	splash.Rotation = NumberRange.new(0, 360)
	splash.Rate = 0
	splash.Parent = holder
	splash:Emit(26)

	local drops = Instance.new("ParticleEmitter")
	drops.Texture = if Assets.Streak ~= "" then Assets.Streak else Assets.GlowOrb
	drops.Color = ColorSequence.new(Color3.fromRGB(150, 4, 14))
	drops.Size = NumberSequence.new(0.6, 0.2)
	drops.Lifetime = NumberRange.new(0.8, 1.4)
	drops.Speed = NumberRange.new(20, 45)
	drops.SpreadAngle = Vector2.new(80, 80)
	drops.EmissionDirection = Enum.NormalId.Top
	drops.Acceleration = Vector3.new(0, -70, 0)
	drops.Orientation = Enum.ParticleOrientation.VelocityParallel
	drops.Rate = 0
	drops.Parent = holder
	drops:Emit(60)

	local camera = Workspace.CurrentCamera
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		local strength = math.clamp(1 - distance / 70, 0, 1)
		if strength > 0 then
			shakeStrength = strength
			shakeUntil = os.clock() + 0.45
		end
		-- destello rojo si estás muy cerca
		if distance < 30 then
			flash.BackgroundTransparency = 0.45
			UI.tween(flash, 0.8, { BackgroundTransparency = 1 })
		end
	end
end

local function radar(targets: { Model })
	for _, model in targets do
		if typeof(model) == "Instance" and model:IsA("Model") and model.Parent then
			local highlight = Instance.new("Highlight")
			highlight.Name = "RadarHighlight"
			highlight.FillColor = Color3.fromRGB(255, 60, 90)
			highlight.FillTransparency = 0.5
			highlight.OutlineColor = Color3.fromRGB(255, 200, 210)
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = model
			game:GetService("Debris"):AddItem(highlight, 6)
		end
	end
	playSound("rbxasset://sounds/electronicpingshort.wav", Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position or Vector3.zero, 0.6)
end

-- Grito de la víctima: suena en ella (sube con ella) mientras Verity la levanta.
local function grabScream(victimRoot: Instance)
	if typeof(victimRoot) ~= "Instance" or not victimRoot:IsA("BasePart") then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "DeathScream"
	sound.SoundId = `rbxassetid://{Config.Music.DeathScream}`
	sound.Volume = 1.4
	sound.RollOffMinDistance = 15
	sound.RollOffMaxDistance = 160
	sound.Parent = victimRoot
	sound:Play()
	table.insert(screams, sound)
	game:GetService("Debris"):AddItem(sound, 6)
end

-- La explosión corta el grito en seco.
local function cutScreams()
	for _, sound in screams do
		sound:Stop()
		sound:Destroy()
	end
	table.clear(screams)
end

-- Crujidos de huesos durante la transformación.
local function boneCracks(position: Vector3)
	local id = Config.Sounds.BoneCracks
	if id ~= 0 then
		playSound(`rbxassetid://{id}`, position, 1.6)
		return
	end
	-- sustituto con sonidos internos: golpes secos agudos que se aceleran
	task.spawn(function()
		local t = 0
		local duration = Config.Round.TransformTime
		while t < duration do
			local progress = t / duration
			local holder = playSound("rbxasset://sounds/action_footsteps_plastic.mp3", position, 0.9 + progress * 0.6)
			local sound = holder:FindFirstChildOfClass("Sound")
			if sound then
				sound.PlaybackSpeed = 1.8 + math.random() * 1.2
				sound.TimePosition = math.random() * 0.2
			end
			local wait = (0.16 - progress * 0.11) * (0.6 + math.random() * 0.8)
			task.wait(wait)
			t += wait
		end
		local final = playSound("rbxasset://sounds/action_jump_land.mp3", position, 1.5)
		local sound = final:FindFirstChildOfClass("Sound")
		if sound then
			sound.PlaybackSpeed = 0.7
		end
	end)
end

local function transform(position: Vector3)
	boneCracks(position)
	burst(position, Color3.fromRGB(240, 210, 70), Assets.Splash, 30, 16)
	task.delay(Config.Round.TransformTime * 0.92, function()
		shockRing(position - Vector3.new(0, 7, 0))
		burst(position, Color3.fromRGB(255, 230, 120), Assets.GlowOrb, 40, 22)
		local camera = Workspace.CurrentCamera
		if camera then
			local strength = math.clamp(1 - (camera.CFrame.Position - position).Magnitude / 90, 0, 1)
			if strength > 0 then
				shakeStrength = strength
				shakeUntil = os.clock() + 0.6
			end
		end
	end)
end

local function onEffect(kind: string, position: any)
	if kind == "Grab" then
		grabScream(position)
		return
	elseif kind == "Transform" then
		transform(position)
		return
	end
	if kind == "Radar" then
		radar(position)
		return
	elseif kind == "Knockback" then
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and typeof(position) == "Vector3" then
			root.AssemblyLinearVelocity = position
		end
		return
	elseif kind == "Coin" then
		playSound("rbxasset://sounds/electronicpingshort.wav", position, 0.35)
		burst(position, Color3.fromRGB(255, 220, 90), Assets.Sparkle, 8, 5)
		return
	elseif kind == "Heal" then
		burst(position, Color3.fromRGB(120, 255, 140), Assets.Sparkle, 20, 6)
		return
	elseif kind == "Trap" then
		playSound("rbxasset://sounds/swordslash.wav", position, 0.9)
		burst(position, Color3.fromRGB(200, 200, 210), Assets.Sparkle, 12, 8)
		return
	elseif kind == "Push" then
		playSound("rbxasset://sounds/collide.wav", position, 0.8)
		shockRing(position)
		return
	end
	if kind == "Gore" then
		cutScreams()
		gore(position)
	elseif kind == "Totem" then
		playSound("rbxasset://sounds/electronicpingshort.wav", position, 1)
		burst(position + Vector3.new(0, 4, 0), Color3.fromRGB(120, 230, 255), Assets.Sparkle, 40, 10)
		shockRing(position + Vector3.new(0, 0.2, 0))
	elseif kind == "Pickup" then
		playSound("rbxasset://sounds/clickfast.wav", position, 0.6)
		burst(position, Color3.fromRGB(255, 220, 120), Assets.Sparkle, 14, 6)
	end
end

local function buildVignette()
	local gui = UI.new("ScreenGui", {
		Name = "TerrorVignette",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = -1,
		Parent = player:WaitForChild("PlayerGui"),
	})
	vignette = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	-- dos capas con degradado: bordes rojos, centro transparente
	for _, rotation in { 0, 90 } do
		UI.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(150, 0, 20),
			BorderSizePixel = 0,
			Parent = vignette,
		}, {
			UI.new("UIGradient", {
				Rotation = rotation,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.2),
					NumberSequenceKeypoint.new(0.18, 1),
					NumberSequenceKeypoint.new(0.82, 1),
					NumberSequenceKeypoint.new(1, 0.2),
				}),
			}),
		})
	end
	vignette.Visible = false
	flash = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(140, 0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
end

local function killerRoot(): BasePart?
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("Role") == "Verity" then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				return root
			end
		end
	end
	return nil
end

local function updateTerror()
	local intensity = 0
	if player:GetAttribute("Role") == "Survivor" then
		local character = player.Character
		local myRoot = character and character:FindFirstChild("HumanoidRootPart")
		local theirRoot = killerRoot()
		local released = theirRoot and theirRoot.Parent and (theirRoot.Parent :: Instance):GetAttribute("Released")
		if myRoot and myRoot:IsA("BasePart") and theirRoot and released then
			local distance = (myRoot.Position - theirRoot.Position).Magnitude
			intensity = math.clamp(1 - distance / TERROR_RADIUS, 0, 1)
		end
	end
	vignette.Visible = intensity > 0
	if intensity > 0 then
		-- pulso tipo latido, más rápido cuanto más cerca
		local beat = (math.sin(os.clock() * (4 + intensity * 6)) + 1) / 2
		local alpha = 1 - intensity * (0.55 + beat * 0.3)
		for _, layer in vignette:GetChildren() do
			if layer:IsA("Frame") then
				layer.BackgroundTransparency = alpha
			end
		end
	end
end

local function trackGold(inst: Instance)
	if inst:IsA("BasePart") then
		goldBlocks[inst] = inst.CFrame
	end
end

function WorldFX.init()
	buildVignette()
end

function WorldFX.start()
	Net.get("Effect").OnClientEvent:Connect(onEffect)

	for _, inst in CollectionService:GetTagged("GoldBlock") do
		trackGold(inst)
	end
	CollectionService:GetInstanceAddedSignal("GoldBlock"):Connect(trackGold)
	CollectionService:GetInstanceRemovedSignal("GoldBlock"):Connect(function(inst)
		goldBlocks[inst :: BasePart] = nil
	end)
	local function trackCoin(inst: Instance)
		if inst:IsA("BasePart") then
			coins[inst] = inst.CFrame
		end
	end
	for _, inst in CollectionService:GetTagged("Coin") do
		trackCoin(inst)
	end
	CollectionService:GetInstanceAddedSignal("Coin"):Connect(trackCoin)
	CollectionService:GetInstanceRemovedSignal("Coin"):Connect(function(inst)
		coins[inst :: BasePart] = nil
	end)

	local function applyRole()
		-- Verity no puede recoger oro ni craftear.
		ProximityPromptService.Enabled = player:GetAttribute("Role") ~= "Verity"
	end
	player:GetAttributeChangedSignal("Role"):Connect(applyRole)
	applyRole()

	local flickerClock = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for coin, base in coins do
			if coin.Parent then
				-- de canto, girando sobre sí misma
				coin.CFrame = base * CFrame.new(0, math.sin(t * 3 + base.X) * 0.2, 0) * CFrame.Angles(0, t * 3, 0)
			else
				coins[coin] = nil
			end
		end
		for block, base in goldBlocks do
			if block.Parent then
				block.CFrame = base * CFrame.new(0, math.sin(t * 2) * 0.25, 0) * CFrame.Angles(0, t * 1.5, math.rad(15))
			else
				goldBlocks[block] = nil
			end
		end

		flickerClock += dt
		if flickerClock > 0.08 then
			flickerClock = 0
			for _, lamp in CollectionService:GetTagged("MansionLamp") do
				if lamp:GetAttribute("Flicker") then
					local light = lamp:FindFirstChildOfClass("PointLight")
					if light then
						light.Brightness = if math.random() < 0.12 then 0.1 else 0.9
					end
				end
			end
		end

		updateTerror()
	end)

	-- la sacudida va después de la cámara para que no la sobrescriba
	RunService:BindToRenderStep("GoreShake", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = Workspace.CurrentCamera
		if camera and os.clock() < shakeUntil then
			local m = shakeStrength * (shakeUntil - os.clock()) / 0.45
			camera.CFrame *= CFrame.Angles(math.rad(math.random(-10, 10) / 10 * 2 * m), math.rad(math.random(-10, 10) / 10 * 2 * m), 0)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
