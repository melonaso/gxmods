          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- HUD discreto: píldora superior con fase y reloj, chip de oro, avisos
-- pequeños, tarjeta de rol y banner de resultados.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer
local C = UI.Colors

local HUD = {}

local PHASE_TEXT = {
	Waiting = "ESPERANDO JUGADORES",
	Intermission = "INTERMEDIO",
	Starting = "PREPARANDO",
	Playing = "SOBREVIVE",
	Results = "RESULTADOS",
}

local gui: ScreenGui
local phaseLabel: TextLabel
local timerLabel: TextLabel
local infoPill: Frame
local infoLabel: TextLabel
local goldChip: Frame
local goldLabel: TextLabel
local controls: Frame
local controlsLabel: TextLabel
local staminaBar: Frame
local staminaFill: Frame
local toastList: Frame
local roleCard: CanvasGroup
local resultCard: CanvasGroup

local function formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Píldora superior
	local pill = UI.new("Frame", {
		Name = "TopPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(190, 50),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(14), UI.stroke() })
	phaseLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 6),
		TextSize = 11,
		FontFace = UI.FontBold,
		TextColor3 = C.Muted,
		Text = "",
		Parent = pill,
	})
	timerLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 19),
		TextSize = 24,
		FontFace = UI.FontHeavy,
		Text = "",
		Parent = pill,
	})

	infoPill = UI.new("Frame", {
		Name = "Info",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.4,
		Parent = gui,
	}, { UI.corner(12), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	infoLabel = UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		RichText = true,
		TextColor3 = C.Muted,
		Parent = infoPill,
	})

	-- Chip de oro (solo supervivientes en partida)
	goldChip = UI.new("Frame", {
		Name = "Gold",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(118, 42),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, { UI.corner(12), UI.stroke() })
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		Rotation = 45,
		BackgroundColor3 = C.Gold,
		Parent = goldChip,
	}, {
		UI.corner(4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(220, 150, 20)),
			Rotation = 90,
		}),
	})
	goldLabel = UI.label({
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -50, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.FontBold,
		TextSize = 16,
		Parent = goldChip,
	})

	-- Controles y estamina (abajo al centro, discretos)
	controls = UI.new("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.4,
		Visible = false,
		Parent = gui,
	}, { UI.corner(13), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	controlsLabel = UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		RichText = true,
		TextColor3 = C.Muted,
		Parent = controls,
	})
	staminaBar = UI.new("Frame", {
		Name = "Stamina",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -46),
		Size = UDim2.fromOffset(180, 6),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		Visible = false,
		Parent = gui,
	}, { UI.corner(3) })
	staminaFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Survivor,
		BorderSizePixel = 0,
		Parent = staminaBar,
	}, { UI.corner(3) })

	-- Avisos (esquina superior derecha, apilados)
	toastList = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 8),
		Size = UDim2.fromOffset(280, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Tarjeta de rol
	roleCard = UI.new("CanvasGroup", {
		Name = "RoleCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(380, 132),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })

	resultCard = UI.new("CanvasGroup", {
		Name = "Result",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.18),
		Size = UDim2.fromOffset(420, 118),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })
end

local toastOrder = 0
local TOAST_COLORS = { info = C.Muted, good = C.Good, warn = C.Warn, bad = C.Verity }

local function toast(text: string, kind: string?)
	toastOrder += 1
	local color = TOAST_COLORS[kind or "info"] or C.Muted
	local frame = UI.new("CanvasGroup", {
		LayoutOrder = toastOrder,
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		GroupTransparency = 1,
		Parent = toastList,
	}, {
		UI.corner(10),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12) }),
		UI.new("Frame", {
			Size = UDim2.new(0, 3, 1, -14),
			Position = UDim2.new(0, -8, 0, 7),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}, { UI.corner(2) }),
	})
	UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 14,
		Text = text,
		Parent = frame,
	})
	UI.tween(frame, 0.25, { GroupTransparency = 0 })
	-- máximo 4 avisos visibles
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("CanvasGroup") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	task.delay(4, function()
		if frame.Parent then
			UI.tween(frame, 0.4, { GroupTransparency = 1 }).Completed:Wait()
			frame:Destroy()
		end
	end)
end
HUD.toast = toast

local function showCard(card: CanvasGroup, title: string, headline: string, color: Color3, body: string, duration: number)
	card:ClearAllChildren()
	UI.corner(18).Parent = card
	UI.stroke(0.5, color).Parent = card
	UI.label({ Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 14), TextSize = 12, FontFace = UI.FontBold, TextColor3 = C.Muted, Text = title, Parent = card })
	UI.label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 32), TextSize = 34, FontFace = UI.FontHeavy, TextColor3 = color, Text = headline, Parent = card })
	UI.label({ Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, 76), TextSize = 14, TextWrapped = true, TextColor3 = C.Text, Text = body, Parent = card })

	card.Visible = true
	card.GroupTransparency = 1
	local scale = UI.new("UIScale", { Scale = 0.92, Parent = card })
	UI.tween(card, 0.35, { GroupTransparency = 0 })
	UI.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration, function()
		UI.tween(card, 0.5, { GroupTransparency = 1 }).Completed:Wait()
		card.Visible = false
	end)
end

local function onRoleReveal(role: string, killerName: string)
	if role == "Verity" then
		showCard(roleCard, "TU ROL", "ERES VERITY", C.Verity, "Atrapa a todos antes de que acabe el tiempo. Q atrapar · Shift correr · C agacharse", 4)
	elseif role == "Survivor" then
		showCard(roleCard, "TU ROL", "SUPERVIVIENTE", C.Survivor, `Verity es {killerName}. Busca oro, craftea tótems y resiste. Shift para correr.`, 4)
	end
end

local function onRoundResult(winner: string, killerName: string, survivors: { string }, totems: number)
	if winner == "Verity" then
		showCard(resultCard, "FIN DE LA RONDA", "VERITY GANA", C.Verity, `{killerName} atrapó a todos. Tótems crafteados: {totems}`, Config.Round.ResultsTime - 0.5)
	else
		local names = if #survivors > 0 then table.concat(survivors, ", ") else "nadie"
		if #names > 70 then
			names = `{#survivors} supervivientes`
		end
		showCard(resultCard, "FIN DE LA RONDA", "SUPERVIVIENTES GANAN", C.Survivor, `Sobrevivieron: {names}. Tótems: {totems}`, Config.Round.ResultsTime - 0.5)
	end
end

local function update()
	local phase = (Workspace:GetAttribute("Phase") :: string?) or "Waiting"
	local endsAt = (Workspace:GetAttribute("PhaseEndsAt") :: number?) or 0
	local now = Workspace:GetServerTimeNow()
	local remaining = endsAt - now
	local role = (player:GetAttribute("Role") :: string?) or "Lobby"

	phaseLabel.Text = PHASE_TEXT[phase] or phase
	if phase == "Waiting" then
		local needed = if Workspace:GetAttribute("TestMode") then 1 else Config.Round.MinPlayers
		timerLabel.Text = `{#Players:GetPlayers()}/{needed}`
	elseif endsAt > 0 then
		timerLabel.Text = formatTime(remaining)
	else
		timerLabel.Text = "..."
	end
	local urgent = phase == "Playing" and remaining <= 10
	timerLabel.TextColor3 = if urgent then C.Verity else C.Text

	-- Línea de información contextual
	local info = ""
	if phase == "Waiting" or phase == "Intermission" or role == "Lobby" then
		local chance = (player:GetAttribute("VerityChance") :: number?) or 0
		info = `Probabilidad de Verity: <font color="#ff3b4e"><b>{chance}%</b></font>`
		if phase == "Playing" then
			info ..= "  ·  ronda en curso"
		end
	elseif phase == "Playing" then
		local releaseAt = (Workspace:GetAttribute("KillerReleaseAt") :: number?) or 0
		local totems = Workspace:GetAttribute("Totems") or 0
		local maxTotems = Workspace:GetAttribute("MaxTotems") or 0
		local alive = Workspace:GetAttribute("SurvivorsAlive") or 0
		if releaseAt > now then
			info = `Verity sale en <font color="#ff3b4e"><b>{math.ceil(releaseAt - now)}s</b></font>`
		else
			info = `Tótems <font color="#ffc83c"><b>{totems}/{maxTotems}</b></font>  ·  Vivos <b>{alive}</b>`
		end
	end
	infoLabel.Text = info
	infoPill.Visible = info ~= ""

	local inRound = phase == "Playing" or phase == "Starting"
	local key = function(k: string, text: string)
		return `<font color="#f0ecf5"><b>{k}</b></font> {text}`
	end
	if inRound and role == "Verity" then
		controlsLabel.Text = `{key("Q", "Atrapar")}   {key("Shift", "Correr")}   {key("C", "Agacharse")}`
	elseif inRound and role == "Survivor" then
		controlsLabel.Text = `{key("Shift", "Correr")}   {key("E", "Oro / mesa")}   {key("F", "Craftear")}`
	else
		controlsLabel.Text = ""
	end
	controls.Visible = controlsLabel.Text ~= ""

	local stamina = (player:GetAttribute("Stamina") :: number?) or Config.Movement.StaminaMax
	staminaBar.Visible = inRound and role == "Survivor" and stamina < Config.Movement.StaminaMax
	staminaFill.Size = UDim2.fromScale(stamina / Config.Movement.StaminaMax, 1)
	staminaFill.BackgroundColor3 = if stamina < 25 then C.Warn else C.Survivor

	local showGold = phase == "Playing" and role == "Survivor"
	goldChip.Visible = showGold
	if showGold then
		local gold = (player:GetAttribute("Gold") :: number?) or 0
		goldLabel.Text = `Oro {gold}/{Config.Crafting.MaxGoldCarried}`
	end
end

function HUD.init()
	build()
end

function HUD.start()
	-- el HUD se actualiza aunque los remotes tarden en llegar
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			update()
		end
	end)
	update()

	Net.get("Notify").OnClientEvent:Connect(toast)
	Net.get("RoleReveal").OnClientEvent:Connect(onRoleReveal)
	Net.get("RoundResult").OnClientEvent:Connect(onRoundResult)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!strict
-- Controles: Shift correr, C agacharse (Verity), Q atrapar (Verity).
-- Solo envía intenciones; el servidor valida rol, estamina y distancia.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local player = Players.LocalPlayer

local Input = {}

local action: RemoteEvent
local crouching = false

local function isVerity(): boolean
	return player:GetAttribute("Role") == "Verity"
end

local function onSprint(_, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		action:FireServer("Sprint", true)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		action:FireServer("Sprint", false)
	end
	return Enum.ContextActionResult.Pass
end

local function onCrouch(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin or not isVerity() then
		return Enum.ContextActionResult.Pass
	end
	crouching = not crouching
	action:FireServer("Crouch", crouching)
	return Enum.ContextActionResult.Sink
end

local lastKill = 0
local function onKill(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin or not isVerity() then
		return Enum.ContextActionResult.Pass
	end
	if os.clock() - lastKill > 0.25 then
		lastKill = os.clock()
		action:FireServer("Kill")
	end
	return Enum.ContextActionResult.Sink
end

function Input.start()
	action = Net.get("Action")
	ContextActionService:BindAction("Sprint", onSprint, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
	ContextActionService:BindAction("Crouch", onCrouch, false, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("Kill", onKill, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	player:GetAttributeChangedSignal("Role"):Connect(function()
		crouching = false
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Botón pequeño "Pases" (solo fuera de partida) y panel de compra de
-- multiplicadores de probabilidad.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer
local C = UI.Colors

local Shop = {}

local gui: ScreenGui
local openButton: TextButton
local openChance: TextLabel
local panel: CanvasGroup
local chanceLabel: TextLabel
local boostLabel: TextLabel
local isOpen = false

type Item = {
	kind: "pass" | "product",
	key: string,
	id: number,
	badge: string,
	title: string,
	description: string,
}

local function items(): { Item }
	local list: { Item } = {}
	for _, pass in Config.GamePasses do
		table.insert(list, { kind = "pass", key = pass.Key, id = pass.Id, badge = `{pass.Multiplier}x`, title = pass.Title, description = pass.Description })
	end
	for _, product in Config.Products do
		table.insert(list, { kind = "product", key = product.Key, id = product.Id, badge = `x{product.Multiplier}`, title = product.Title, description = product.Description })
	end
	return list
end

local function setOpen(open: boolean)
	isOpen = open
	if open then
		panel.Visible = true
		UI.tween(panel, 0.25, { GroupTransparency = 0 })
	else
		UI.tween(panel, 0.2, { GroupTransparency = 1 }).Completed:Connect(function()
			if not isOpen then
				panel.Visible = false
			end
		end)
	end
end

local function buildRow(item: Item, parent: Instance, order: number)
	local row = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.2,
		Parent = parent,
	}, { UI.corner(12) })

	local badgeColor = if item.kind == "product" then Color3.fromRGB(150, 80, 255) else C.Verity
	UI.new("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = badgeColor,
		FontFace = UI.FontHeavy,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 17,
		Text = item.badge,
		Parent = row,
	}, {
		UI.corner(10),
		UI.new("UIGradient", {
			Transparency = NumberSequence.new(0, 0.35),
			Rotation = 90,
		}),
	})
	UI.label({ Position = UDim2.fromOffset(64, 11), Size = UDim2.new(1, -170, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontBold, TextSize = 15, Text = item.title, Parent = row })
	UI.label({ Position = UDim2.fromOffset(64, 30), Size = UDim2.new(1, -170, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextSize = 12, TextColor3 = C.Muted, Text = item.description, Parent = row })

	local button: TextButton = UI.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(90, 34),
		BackgroundColor3 = C.Gold,
		FontFace = UI.FontBold,
		TextSize = 14,
		TextColor3 = Color3.fromRGB(30, 20, 10),
		AutoButtonColor = true,
		Text = "...",
		Parent = row,
	}, { UI.corner(10) })

	local function refreshOwned()
		if item.kind == "pass" and player:GetAttribute("Pass_" .. item.key) then
			button.Text = "Adquirido"
			button.BackgroundColor3 = C.PanelLight
			button.TextColor3 = C.Good
			button.Active = false
			button.AutoButtonColor = false
		end
	end

	if item.id == 0 then
		button.Text = "Pronto"
		button.BackgroundColor3 = C.PanelLight
		button.TextColor3 = C.Muted
		button.AutoButtonColor = false
		return
	end

	task.spawn(function()
		local infoType = if item.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, item.id, infoType)
		if button.Text == "..." then
			button.Text = if ok and info and info.PriceInRobux then `R$ {info.PriceInRobux}` else "Comprar"
		end
		refreshOwned()
	end)
	if item.kind == "pass" then
		player:GetAttributeChangedSignal("Pass_" .. item.key):Connect(refreshOwned)
	end

	button.Activated:Connect(function()
		if item.kind == "pass" then
			if not player:GetAttribute("Pass_" .. item.key) then
				MarketplaceService:PromptGamePassPurchase(player, item.id)
			end
		else
			MarketplaceService:PromptProductPurchase(player, item.id)
		end
	end)
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})

	openButton = UI.new("TextButton", {
		Name = "OpenShop",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(132, 46),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		Text = "",
		AutoButtonColor = true,
		Parent = gui,
	}, { UI.corner(12), UI.stroke(0.6, C.Verity) })
	UI.label({ Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontBold, TextSize = 15, Text = "Tienda", Parent = openButton })
	openChance = UI.label({ Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, 25), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 11, TextColor3 = C.Muted, Text = "", Parent = openButton })

	panel = UI.new("CanvasGroup", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(420, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(18),
		UI.stroke(0.8),
		UI.padding(16),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(420, 520) }),
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local header = UI.new("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, Parent = panel })
	UI.label({ Size = UDim2.new(1, -40, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontBold, TextSize = 11, TextColor3 = C.Muted, Text = "PROBABILIDAD DE SER VERITY", Parent = header })
	chanceLabel = UI.label({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -40, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontHeavy, TextSize = 28, TextColor3 = C.Verity, Text = "0%", Parent = header })
	boostLabel = UI.label({ Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, -40, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 12, TextColor3 = C.Muted, Text = "", Parent = header })
	local close: TextButton = UI.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = C.PanelLight,
		FontFace = UI.FontBold,
		TextColor3 = C.Muted,
		TextSize = 14,
		Text = "X",
		Parent = header,
	}, { UI.corner(15) })
	close.Activated:Connect(function()
		setOpen(false)
	end)

	for i, item in items() do
		buildRow(item, panel, i)
	end

	UI.label({
		LayoutOrder = 999,
		Size = UDim2.new(1, 0, 0, 28),
		TextWrapped = true,
		TextSize = 11,
		TextColor3 = C.Muted,
		Text = "Cada ronda que no eres Verity ganas suerte extra. Los pases multiplican tu probabilidad.",
		Parent = panel,
	})

	openButton.Activated:Connect(function()
		setOpen(not isOpen)
	end)
end

local function refresh()
	local chance = (player:GetAttribute("VerityChance") :: number?) or 0
	chanceLabel.Text = `{chance}%`
	openChance.Text = `Ser Verity: {chance}%`
	local mult = (player:GetAttribute("PassMultiplier") :: number?) or 1
	local boost = (player:GetAttribute("BoostRounds") :: number?) or 0
	local parts = {}
	if mult > 1 then
		table.insert(parts, `Pase activo: {mult}x`)
	end
	if boost > 0 then
		table.insert(parts, `Poción: {boost} ronda(s)`)
	end
	boostLabel.Text = if #parts > 0 then table.concat(parts, "  ·  ") else "Sin multiplicadores activos"

	local role = player:GetAttribute("Role")
	local inRound = role == "Survivor" or role == "Verity"
	openButton.Visible = not inRound
	if inRound and isOpen then
		setOpen(false)
	end
end

function Shop.init()
	build()
end

function Shop.start()
	for _, attr in { "VerityChance", "PassMultiplier", "BoostRounds", "Role" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	refresh()
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">VerityAnimator</string>
              <string name="Source"><![CDATA[--!strict
-- Anima a Verity en cada cliente modificando Motor6D.Transform:
--   - caminar / correr: zancadas largas, brazos colgando que se balancean
--   - agacharse (C): rodillas flexionadas que coinciden con la bajada de cadera
--   - ataque (Q): sigue la misma línea de tiempo que usa el servidor
-- No hay AnimationTracks: todo es procedural, así que no hace falta subir
-- animaciones a Roblox.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Pose = require(ReplicatedStorage.Shared.VerityPose)

type Rig = {
	model: Model,
	root: BasePart,
	motors: { [string]: Motor6D },
	phase: number,
	crouch: number, -- 0..1 suavizado
	stride: number, -- 0..1 suavizado según la velocidad
}

local VerityAnimator = {}

local rigs: { [Model]: Rig } = {}

local function track(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local root = model:WaitForChild("HumanoidRootPart", 5)
	if not (root and root:IsA("BasePart")) then
		return
	end
	local motors = {}
	for _, inst in model:GetDescendants() do
		if inst:IsA("Motor6D") then
			motors[inst.Name] = inst
		end
	end
	rigs[model] = { model = model, root = root, motors = motors, phase = 0, crouch = 0, stride = 0 }
end

local function set(rig: Rig, name: string, cf: CFrame)
	local motor = rig.motors[name]
	if motor then
		motor.Transform = cf
	end
end

local function rx(a: number): CFrame
	return CFrame.Angles(a, 0, 0)
end

local function animate(rig: Rig, dt: number)
	local model = rig.model
	local clock = os.clock()

	local killStart = model:GetAttribute("KillStart") :: number?
	if killStart then
		local t = Workspace:GetServerTimeNow() - killStart
		local shoulder, elbow, waist = Pose.killAngles(t)
		-- los brazos se cierran un poco hacia el centro para "sujetar"
		local inward = math.rad(14) * math.clamp(shoulder / math.rad(60), 0, 1)
		set(rig, "Waist", rx(waist))
		set(rig, "LeftShoulder", rx(shoulder) * CFrame.Angles(0, 0, inward))
		set(rig, "RightShoulder", rx(shoulder) * CFrame.Angles(0, 0, -inward))
		set(rig, "LeftElbow", rx(elbow))
		set(rig, "RightElbow", rx(elbow))
		set(rig, "Neck", rx(-waist * 0.4))
		set(rig, "HeadJoint", CFrame.Angles(math.rad(-10), 0, math.sin(clock * 30) * 0.05))
		for _, name in { "LeftHip", "RightHip", "LeftKnee", "RightKnee", "LeftAnkle", "RightAnkle", "LeftWrist", "RightWrist" } do
			set(rig, name, CFrame.identity)
		end
		return
	end

	local velocity = rig.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
	local speed = velocity.Magnitude
	local targetStride = math.clamp(speed / 20, 0, 1.3)
	rig.stride += (targetStride - rig.stride) * math.min(1, dt * 8)
	local targetCrouch = if model:GetAttribute("Crouching") then 1 else 0
	rig.crouch += (targetCrouch - rig.crouch) * math.min(1, dt * 10)

	-- cadencia lenta: piernas muy largas
	rig.phase += dt * (2.2 + speed * 0.16)
	local s = math.sin(rig.phase)
	local c = math.cos(rig.phase)
	local stride = rig.stride
	local crouch = rig.crouch
	local theta = Pose.CrouchAngle * crouch

	-- piernas
	local swing = s * 0.55 * stride * (1 - crouch * 0.5)
	local liftL = math.max(0, c) * 0.9 * stride
	local liftR = math.max(0, -c) * 0.9 * stride
	set(rig, "LeftHip", rx(theta + swing))
	set(rig, "RightHip", rx(theta - swing))
	set(rig, "LeftKnee", rx(-2 * theta - liftL))
	set(rig, "RightKnee", rx(-2 * theta - liftR))
	set(rig, "LeftAnkle", rx(theta + liftL * 0.4))
	set(rig, "RightAnkle", rx(theta + liftR * 0.4))

	-- torso: se inclina al correr y al agacharse; respiración en reposo
	local breathe = math.sin(clock * 1.6) * 0.02 * (1 - stride)
	local lean = -0.12 * stride - 0.35 * crouch
	set(rig, "Waist", rx(lean + breathe) * CFrame.Angles(0, s * 0.08 * stride, 0))

	-- brazos colgantes, desfasados de las piernas y con retraso
	local armSwing = -s * 0.5 * stride
	local dangle = math.sin(clock * 1.3) * 0.05
	set(rig, "LeftShoulder", rx(-armSwing + dangle + 0.25 * crouch) * CFrame.Angles(0, 0, -0.06))
	set(rig, "RightShoulder", rx(armSwing - dangle + 0.25 * crouch) * CFrame.Angles(0, 0, 0.06))
	set(rig, "LeftElbow", rx(math.max(0, -armSwing) * 0.5 + 0.1))
	set(rig, "RightElbow", rx(math.max(0, armSwing) * 0.5 + 0.1))
	set(rig, "LeftWrist", rx(-0.1))
	set(rig, "RightWrist", rx(-0.1))

	-- cabeza: compensa la inclinación y hace un ladeo inquietante en reposo
	local tilt = math.sin(clock * 0.7) * 0.18 * (1 - stride)
	set(rig, "Neck", rx(-lean * 0.7 + c * 0.04 * stride))
	set(rig, "HeadJoint", CFrame.Angles(0, math.sin(clock * 0.45) * 0.15, tilt))
end

function VerityAnimator.start()
	for _, model in CollectionService:GetTagged("VerityRig") do
		task.spawn(track, model)
	end
	CollectionService:GetInstanceAddedSignal("VerityRig"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("VerityRig"):Connect(function(model)
		rigs[model :: Model] = nil
	end)

	RunService.Stepped:Connect(function(_, dt)
		for model, rig in rigs do
			if model.Parent and rig.root.Parent then
				animate(rig, dt)
			else
				rigs[model] = nil
			end
		end
	end)
end

return VerityAnimator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[--!strict
-- Efectos locales: oro girando, lámparas parpadeantes, golpes, tótems,
-- viñeta de "radio de terror" y bloqueo de prompts para Verity.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer

local TERROR_RADIUS = 45

local WorldFX = {}

local goldBlocks: { [BasePart]: CFrame } = {}
local vignette: Frame
local flash: Frame

local function playSound(id: string, position: Vector3, volume: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = Workspace
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.8
	sound.RollOffMaxDistance = 120
	sound.Parent = holder
	sound:Play()
	game:GetService("Debris"):AddItem(holder, 4)
	return holder
end

local function burst(position: Vector3, color: Color3, texture: string, count: number, speed: number)
	local holder = playSound("", position, 0)
	local emitter = Instance.new("ParticleEmitter")
	if texture ~= "" then
		emitter.Texture = texture
	end
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.35, 0.7)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
end

local function shockRing(position: Vector3)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Transparency = 1
	ring.Size = Vector3.new(1, 0.05, 1)
	ring.CFrame = CFrame.new(position)
	ring.Parent = Workspace
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = if Assets.ShockRing ~= "" then Assets.ShockRing else Assets.GlowOrb
	decal.Color3 = Color3.fromRGB(110, 230, 255)
	decal.Parent = ring
	UI.tween(ring, 0.9, { Size = Vector3.new(36, 0.05, 36) })
	UI.tween(decal, 0.9, { Transparency = 1 })
	game:GetService("Debris"):AddItem(ring, 1)
end

local shakeUntil = 0
local shakeStrength = 0

-- Salpicadura de sangre: nube de líquido, gotas alargadas que caen y
-- sacudida de cámara según la distancia.
local function gore(position: Vector3)
	playSound("rbxasset://sounds/swordslash.wav", position, 1)
	playSound("rbxasset://sounds/collide.wav", position, 1)

	local holder = playSound("", position + Vector3.new(0, 1, 0), 0)
	local splash = Instance.new("ParticleEmitter")
	splash.Texture = if Assets.Splash ~= "" then Assets.Splash else Assets.GlowOrb
	splash.Color = ColorSequence.new(Color3.fromRGB(170, 8, 20), Color3.fromRGB(90, 0, 8))
	splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(0.4, 4), NumberSequenceKeypoint.new(1, 2.5) })
	splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) })
	splash.Lifetime = NumberRange.new(0.5, 0.9)
	splash.Speed = NumberRange.new(8, 22)
	splash.SpreadAngle = Vector2.new(70, 70)
	splash.EmissionDirection = Enum.NormalId.Top
	splash.Acceleration = Vector3.new(0, -45, 0)
	splash.Rotation = NumberRange.new(0, 360)
	splash.Rate = 0
	splash.Parent = holder
	splash:Emit(26)

	local drops = Instance.new("ParticleEmitter")
	drops.Texture = if Assets.Streak ~= "" then Assets.Streak else Assets.GlowOrb
	drops.Color = ColorSequence.new(Color3.fromRGB(150, 4, 14))
	drops.Size = NumberSequence.new(0.6, 0.2)
	drops.Lifetime = NumberRange.new(0.8, 1.4)
	drops.Speed = NumberRange.new(20, 45)
	drops.SpreadAngle = Vector2.new(80, 80)
	drops.EmissionDirection = Enum.NormalId.Top
	drops.Acceleration = Vector3.new(0, -70, 0)
	drops.Orientation = Enum.ParticleOrientation.VelocityParallel
	drops.Rate = 0
	drops.Parent = holder
	drops:Emit(60)

	local camera = Workspace.CurrentCamera
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		local strength = math.clamp(1 - distance / 70, 0, 1)
		if strength > 0 then
			shakeStrength = strength
			shakeUntil = os.clock() + 0.45
		end
		-- destello rojo si estás muy cerca
		if distance < 30 then
			flash.BackgroundTransparency = 0.45
			UI.tween(flash, 0.8, { BackgroundTransparency = 1 })
		end
	end
end

local function onEffect(kind: string, position: Vector3)
	if kind == "Gore" then
		gore(position)
	elseif kind == "Totem" then
		playSound("rbxasset://sounds/electronicpingshort.wav", position, 1)
		burst(position + Vector3.new(0, 4, 0), Color3.fromRGB(120, 230, 255), Assets.Sparkle, 40, 10)
		shockRing(position + Vector3.new(0, 0.2, 0))
	elseif kind == "Pickup" then
		playSound("rbxasset://sounds/clickfast.wav", position, 0.6)
		burst(position, Color3.fromRGB(255, 220, 120), Assets.Sparkle, 14, 6)
	end
end

local function buildVignette()
	local gui = UI.new("ScreenGui", {
		Name = "TerrorVignette",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = -1,
		Parent = player:WaitForChild("PlayerGui"),
	})
	vignette = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	-- dos capas con degradado: bordes rojos, centro transparente
	for _, rotation in { 0, 90 } do
		UI.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(150, 0, 20),
			BorderSizePixel = 0,
			Parent = vignette,
		}, {
			UI.new("UIGradient", {
				Rotation = rotation,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.2),
					NumberSequenceKeypoint.new(0.18, 1),
					NumberSequenceKeypoint.new(0.82, 1),
					NumberSequenceKeypoint.new(1, 0.2),
				}),
			}),
		})
	end
	vignette.Visible = false
	flash = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(140, 0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
end

local function killerRoot(): BasePart?
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("Role") == "Verity" then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				return root
			end
		end
	end
	return nil
end

local function updateTerror()
	local intensity = 0
	if player:GetAttribute("Role") == "Survivor" then
		local character = player.Character
		local myRoot = character and character:FindFirstChild("HumanoidRootPart")
		local theirRoot = killerRoot()
		local released = theirRoot and theirRoot.Parent and (theirRoot.Parent :: Instance):GetAttribute("Released")
		if myRoot and myRoot:IsA("BasePart") and theirRoot and released then
			local distance = (myRoot.Position - theirRoot.Position).Magnitude
			intensity = math.clamp(1 - distance / TERROR_RADIUS, 0, 1)
		end
	end
	vignette.Visible = intensity > 0
	if intensity > 0 then
		-- pulso tipo latido, más rápido cuanto más cerca
		local beat = (math.sin(os.clock() * (4 + intensity * 6)) + 1) / 2
		local alpha = 1 - intensity * (0.55 + beat * 0.3)
		for _, layer in vignette:GetChildren() do
			if layer:IsA("Frame") then
				layer.BackgroundTransparency = alpha
			end
		end
	end
end

local function trackGold(inst: Instance)
	if inst:IsA("BasePart") then
		goldBlocks[inst] = inst.CFrame
	end
end

function WorldFX.init()
	buildVignette()
end

function WorldFX.start()
	Net.get("Effect").OnClientEvent:Connect(onEffect)

	for _, inst in CollectionService:GetTagged("GoldBlock") do
		trackGold(inst)
	end
	CollectionService:GetInstanceAddedSignal("GoldBlock"):Connect(trackGold)
	CollectionService:GetInstanceRemovedSignal("GoldBlock"):Connect(function(inst)
		goldBlocks[inst :: BasePart] = nil
	end)

	local function applyRole()
		-- Verity no puede recoger oro ni craftear.
		ProximityPromptService.Enabled = player:GetAttribute("Role") ~= "Verity"
	end
	player:GetAttributeChangedSignal("Role"):Connect(applyRole)
	applyRole()

	local flickerClock = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for block, base in goldBlocks do
			if block.Parent then
				block.CFrame = base * CFrame.new(0, math.sin(t * 2) * 0.25, 0) * CFrame.Angles(0, t * 1.5, math.rad(15))
			else
				goldBlocks[block] = nil
			end
		end

		flickerClock += dt
		if flickerClock > 0.08 then
			flickerClock = 0
			for _, lamp in CollectionService:GetTagged("MansionLamp") do
				if lamp:GetAttribute("Flicker") then
					local light = lamp:FindFirstChildOfClass("PointLight")
					if light then
						light.Brightness = if math.random() < 0.12 then 0.1 else 0.9
					end
				end
			end
		end

		updateTerror()
	end)

	-- la sacudida va después de la cámara para que no la sobrescriba
	RunService:BindToRenderStep("GoreShake", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = Workspace.CurrentCamera
		if camera and os.clock() < shakeUntil then
			local m = shakeStrength * (shakeUntil - os.clock()) / 0.45
			camera.CFrame *= CFrame.Angles(math.rad(math.random(-10, 10) / 10 * 2 * m), math.rad(math.random(-10, 10) / 10 * 2 * m), 0)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="82">
          <Properties>
            <string name="Name">Lib</string>
          </Properties>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Ayudas mínimas para construir UI por código con un estilo consistente.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Panel = Color3.fromRGB(16, 13, 22),
	PanelLight = Color3.fromRGB(30, 25, 40),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(240, 236, 245),
	Muted = Color3.fromRGB(165, 156, 178),
	Verity = Color3.fromRGB(255, 59, 78),
	Survivor = Color3.fromRGB(70, 220, 190),
	Gold = Color3.fromRGB(255, 200, 60),
	Good = Color3.fromRGB(110, 230, 160),
	Warn = Color3.fromRGB(255, 190, 90),
}

UI.Font = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
UI.FontBold = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
UI.FontHeavy = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)

function UI.new(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(transparency: number?, color: Color3?): UIStroke
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Stroke,
		Transparency = transparency or 0.88,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextSize = 16,
		Text = "", -- evita el "Label" por defecto de Roblox
	}
	for k, v in props do
		defaults[k] = v
	end
	return UI.new("TextLabel", defaults)
end

function UI.tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

return UI
]]></string>
