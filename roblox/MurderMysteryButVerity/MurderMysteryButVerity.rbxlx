      <Item class="LocalScript" referent="17">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Único LocalScript: carga los controladores en dos fases.

local Controllers = script.Controllers

local loaded: { any } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		table.insert(loaded, require(child) :: any)
	end
end
for _, controller in loaded do
	if typeof(controller.init) == "function" then
		controller.init()
	end
end
for _, controller in loaded do
	if typeof(controller.start) == "function" then
		task.spawn(controller.start)
	end
end
]]></string>
        </Properties>
        <Item class="Folder" referent="18">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- HUD discreto: píldora superior con fase y reloj, chip de oro, avisos
-- pequeños, tarjeta de rol y banner de resultados.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer
local C = UI.Colors

local HUD = {}

local PHASE_TEXT = {
	Waiting = "ESPERANDO JUGADORES",
	Intermission = "INTERMEDIO",
	Starting = "PREPARANDO",
	Playing = "SOBREVIVE",
	Results = "RESULTADOS",
}

local gui: ScreenGui
local phaseLabel: TextLabel
local timerLabel: TextLabel
local infoPill: Frame
local infoLabel: TextLabel
local goldChip: Frame
local goldLabel: TextLabel
local toastList: Frame
local roleCard: CanvasGroup
local resultCard: CanvasGroup

local function formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Píldora superior
	local pill = UI.new("Frame", {
		Name = "TopPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(190, 50),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(14), UI.stroke() })
	phaseLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 6),
		TextSize = 11,
		FontFace = UI.FontBold,
		TextColor3 = C.Muted,
		Text = "",
		Parent = pill,
	})
	timerLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 19),
		TextSize = 24,
		FontFace = UI.FontHeavy,
		Text = "",
		Parent = pill,
	})

	infoPill = UI.new("Frame", {
		Name = "Info",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.4,
		Parent = gui,
	}, { UI.corner(12), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	infoLabel = UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		RichText = true,
		TextColor3 = C.Muted,
		Parent = infoPill,
	})

	-- Chip de oro (solo supervivientes en partida)
	goldChip = UI.new("Frame", {
		Name = "Gold",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(118, 42),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, { UI.corner(12), UI.stroke() })
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		Rotation = 45,
		BackgroundColor3 = C.Gold,
		Parent = goldChip,
	}, {
		UI.corner(4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(220, 150, 20)),
			Rotation = 90,
		}),
	})
	goldLabel = UI.label({
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -50, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.FontBold,
		TextSize = 16,
		Parent = goldChip,
	})

	-- Avisos (esquina superior derecha, apilados)
	toastList = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 8),
		Size = UDim2.fromOffset(280, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Tarjeta de rol
	roleCard = UI.new("CanvasGroup", {
		Name = "RoleCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(380, 132),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })

	resultCard = UI.new("CanvasGroup", {
		Name = "Result",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.18),
		Size = UDim2.fromOffset(420, 118),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(0.8) })
end

local toastOrder = 0
local TOAST_COLORS = { info = C.Muted, good = C.Good, warn = C.Warn, bad = C.Verity }

local function toast(text: string, kind: string?)
	toastOrder += 1
	local color = TOAST_COLORS[kind or "info"] or C.Muted
	local frame = UI.new("CanvasGroup", {
		LayoutOrder = toastOrder,
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		GroupTransparency = 1,
		Parent = toastList,
	}, {
		UI.corner(10),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12) }),
		UI.new("Frame", {
			Size = UDim2.new(0, 3, 1, -14),
			Position = UDim2.new(0, -8, 0, 7),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}, { UI.corner(2) }),
	})
	UI.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 14,
		Text = text,
		Parent = frame,
	})
	UI.tween(frame, 0.25, { GroupTransparency = 0 })
	-- máximo 4 avisos visibles
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("CanvasGroup") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	task.delay(4, function()
		if frame.Parent then
			UI.tween(frame, 0.4, { GroupTransparency = 1 }).Completed:Wait()
			frame:Destroy()
		end
	end)
end
HUD.toast = toast

local function showCard(card: CanvasGroup, title: string, headline: string, color: Color3, body: string, duration: number)
	card:ClearAllChildren()
	UI.corner(18).Parent = card
	UI.stroke(0.5, color).Parent = card
	UI.label({ Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 14), TextSize = 12, FontFace = UI.FontBold, TextColor3 = C.Muted, Text = title, Parent = card })
	UI.label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 32), TextSize = 34, FontFace = UI.FontHeavy, TextColor3 = color, Text = headline, Parent = card })
	UI.label({ Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, 76), TextSize = 14, TextWrapped = true, TextColor3 = C.Text, Text = body, Parent = card })

	card.Visible = true
	card.GroupTransparency = 1
	local scale = UI.new("UIScale", { Scale = 0.92, Parent = card })
	UI.tween(card, 0.35, { GroupTransparency = 0 })
	UI.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration, function()
		UI.tween(card, 0.5, { GroupTransparency = 1 }).Completed:Wait()
		card.Visible = false
	end)
end

local function onRoleReveal(role: string, killerName: string)
	if role == "Verity" then
		showCard(roleCard, "TU ROL", "ERES VERITY", C.Verity, "Atrapa a todos los supervivientes antes de que se acabe el tiempo.", 3.5)
	elseif role == "Survivor" then
		showCard(roleCard, "TU ROL", "SUPERVIVIENTE", C.Survivor, `Verity es {killerName}. Busca oro, craftea tótems y resiste.`, 3.5)
	end
end

local function onRoundResult(winner: string, killerName: string, survivors: { string }, totems: number)
	if winner == "Verity" then
		showCard(resultCard, "FIN DE LA RONDA", "VERITY GANA", C.Verity, `{killerName} atrapó a todos. Tótems crafteados: {totems}`, Config.Round.ResultsTime - 0.5)
	else
		local names = if #survivors > 0 then table.concat(survivors, ", ") else "nadie"
		if #names > 70 then
			names = `{#survivors} supervivientes`
		end
		showCard(resultCard, "FIN DE LA RONDA", "SUPERVIVIENTES GANAN", C.Survivor, `Sobrevivieron: {names}. Tótems: {totems}`, Config.Round.ResultsTime - 0.5)
	end
end

local function update()
	local phase = (Workspace:GetAttribute("Phase") :: string?) or "Waiting"
	local endsAt = (Workspace:GetAttribute("PhaseEndsAt") :: number?) or 0
	local now = Workspace:GetServerTimeNow()
	local remaining = endsAt - now
	local role = (player:GetAttribute("Role") :: string?) or "Lobby"

	phaseLabel.Text = PHASE_TEXT[phase] or phase
	if phase == "Waiting" then
		timerLabel.Text = `{#Players:GetPlayers()}/{Config.Round.MinPlayers}`
	elseif endsAt > 0 then
		timerLabel.Text = formatTime(remaining)
	else
		timerLabel.Text = "..."
	end
	local urgent = phase == "Playing" and remaining <= 10
	timerLabel.TextColor3 = if urgent then C.Verity else C.Text

	-- Línea de información contextual
	local info = ""
	if phase == "Waiting" or phase == "Intermission" or role == "Lobby" then
		local chance = (player:GetAttribute("VerityChance") :: number?) or 0
		info = `Probabilidad de Verity: <font color="#ff3b4e"><b>{chance}%</b></font>`
		if phase == "Playing" then
			info ..= "  ·  ronda en curso"
		end
	elseif phase == "Playing" then
		local releaseAt = (Workspace:GetAttribute("KillerReleaseAt") :: number?) or 0
		local totems = Workspace:GetAttribute("Totems") or 0
		local maxTotems = Workspace:GetAttribute("MaxTotems") or 0
		local alive = Workspace:GetAttribute("SurvivorsAlive") or 0
		if releaseAt > now then
			info = `Verity sale en <font color="#ff3b4e"><b>{math.ceil(releaseAt - now)}s</b></font>`
		else
			info = `Tótems <font color="#ffc83c"><b>{totems}/{maxTotems}</b></font>  ·  Vivos <b>{alive}</b>`
		end
	end
	infoLabel.Text = info
	infoPill.Visible = info ~= ""

	local showGold = phase == "Playing" and role == "Survivor"
	goldChip.Visible = showGold
	if showGold then
		local gold = (player:GetAttribute("Gold") :: number?) or 0
		goldLabel.Text = `Oro {gold}/{Config.Crafting.MaxGoldCarried}`
	end
end

function HUD.init()
	build()
end

function HUD.start()
	Net.get("Notify").OnClientEvent:Connect(toast)
	Net.get("RoleReveal").OnClientEvent:Connect(onRoleReveal)
	Net.get("RoundResult").OnClientEvent:Connect(onRoundResult)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			update()
		end
	end)
	update()
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Botón pequeño "Pases" (solo fuera de partida) y panel de compra de
-- multiplicadores de probabilidad.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer
local C = UI.Colors

local Shop = {}

local gui: ScreenGui
local openButton: TextButton
local panel: CanvasGroup
local chanceLabel: TextLabel
local boostLabel: TextLabel
local isOpen = false

type Item = {
	kind: "pass" | "product",
	key: string,
	id: number,
	badge: string,
	title: string,
	description: string,
}

local function items(): { Item }
	local list: { Item } = {}
	for _, pass in Config.GamePasses do
		table.insert(list, { kind = "pass", key = pass.Key, id = pass.Id, badge = `{pass.Multiplier}x`, title = pass.Title, description = pass.Description })
	end
	for _, product in Config.Products do
		table.insert(list, { kind = "product", key = product.Key, id = product.Id, badge = `x{product.Multiplier}`, title = product.Title, description = product.Description })
	end
	return list
end

local function setOpen(open: boolean)
	isOpen = open
	if open then
		panel.Visible = true
		UI.tween(panel, 0.25, { GroupTransparency = 0 })
	else
		UI.tween(panel, 0.2, { GroupTransparency = 1 }).Completed:Connect(function()
			if not isOpen then
				panel.Visible = false
			end
		end)
	end
end

local function buildRow(item: Item, parent: Instance, order: number)
	local row = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.2,
		Parent = parent,
	}, { UI.corner(12) })

	local badgeColor = if item.kind == "product" then Color3.fromRGB(150, 80, 255) else C.Verity
	UI.new("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = badgeColor,
		FontFace = UI.FontHeavy,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 17,
		Text = item.badge,
		Parent = row,
	}, {
		UI.corner(10),
		UI.new("UIGradient", {
			Transparency = NumberSequence.new(0, 0.35),
			Rotation = 90,
		}),
	})
	UI.label({ Position = UDim2.fromOffset(64, 11), Size = UDim2.new(1, -170, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontBold, TextSize = 15, Text = item.title, Parent = row })
	UI.label({ Position = UDim2.fromOffset(64, 30), Size = UDim2.new(1, -170, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextSize = 12, TextColor3 = C.Muted, Text = item.description, Parent = row })

	local button: TextButton = UI.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(90, 34),
		BackgroundColor3 = C.Gold,
		FontFace = UI.FontBold,
		TextSize = 14,
		TextColor3 = Color3.fromRGB(30, 20, 10),
		AutoButtonColor = true,
		Text = "...",
		Parent = row,
	}, { UI.corner(10) })

	local function refreshOwned()
		if item.kind == "pass" and player:GetAttribute("Pass_" .. item.key) then
			button.Text = "Adquirido"
			button.BackgroundColor3 = C.PanelLight
			button.TextColor3 = C.Good
			button.Active = false
			button.AutoButtonColor = false
		end
	end

	if item.id == 0 then
		button.Text = "Pronto"
		button.BackgroundColor3 = C.PanelLight
		button.TextColor3 = C.Muted
		button.AutoButtonColor = false
		return
	end

	task.spawn(function()
		local infoType = if item.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, item.id, infoType)
		if button.Text == "..." then
			button.Text = if ok and info and info.PriceInRobux then `R$ {info.PriceInRobux}` else "Comprar"
		end
		refreshOwned()
	end)
	if item.kind == "pass" then
		player:GetAttributeChangedSignal("Pass_" .. item.key):Connect(refreshOwned)
	end

	button.Activated:Connect(function()
		if item.kind == "pass" then
			if not player:GetAttribute("Pass_" .. item.key) then
				MarketplaceService:PromptGamePassPurchase(player, item.id)
			end
		else
			MarketplaceService:PromptProductPurchase(player, item.id)
		end
	end)
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})

	openButton = UI.new("TextButton", {
		Name = "OpenShop",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(58, 58),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		Text = "",
		AutoButtonColor = true,
		Parent = gui,
	}, { UI.corner(14), UI.stroke(0.6, C.Verity) })
	UI.label({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 8), FontFace = UI.FontHeavy, TextSize = 22, TextColor3 = C.Verity, Text = "2x", Parent = openButton })
	UI.label({ Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 35), FontFace = UI.FontBold, TextSize = 10, TextColor3 = C.Muted, Text = "PASES", Parent = openButton })

	panel = UI.new("CanvasGroup", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(420, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(18),
		UI.stroke(0.8),
		UI.padding(16),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(420, 520) }),
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local header = UI.new("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, Parent = panel })
	UI.label({ Size = UDim2.new(1, -40, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontBold, TextSize = 11, TextColor3 = C.Muted, Text = "PROBABILIDAD DE SER VERITY", Parent = header })
	chanceLabel = UI.label({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -40, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, FontFace = UI.FontHeavy, TextSize = 28, TextColor3 = C.Verity, Text = "0%", Parent = header })
	boostLabel = UI.label({ Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, -40, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 12, TextColor3 = C.Muted, Text = "", Parent = header })
	local close: TextButton = UI.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = C.PanelLight,
		FontFace = UI.FontBold,
		TextColor3 = C.Muted,
		TextSize = 14,
		Text = "X",
		Parent = header,
	}, { UI.corner(15) })
	close.Activated:Connect(function()
		setOpen(false)
	end)

	for i, item in items() do
		buildRow(item, panel, i)
	end

	UI.label({
		LayoutOrder = 999,
		Size = UDim2.new(1, 0, 0, 28),
		TextWrapped = true,
		TextSize = 11,
		TextColor3 = C.Muted,
		Text = "Cada ronda que no eres Verity ganas suerte extra. Los pases multiplican tu probabilidad.",
		Parent = panel,
	})

	openButton.Activated:Connect(function()
		setOpen(not isOpen)
	end)
end

local function refresh()
	local chance = (player:GetAttribute("VerityChance") :: number?) or 0
	chanceLabel.Text = `{chance}%`
	local mult = (player:GetAttribute("PassMultiplier") :: number?) or 1
	local boost = (player:GetAttribute("BoostRounds") :: number?) or 0
	local parts = {}
	if mult > 1 then
		table.insert(parts, `Pase activo: {mult}x`)
	end
	if boost > 0 then
		table.insert(parts, `Poción: {boost} ronda(s)`)
	end
	boostLabel.Text = if #parts > 0 then table.concat(parts, "  ·  ") else "Sin multiplicadores activos"

	local role = player:GetAttribute("Role")
	local inRound = role == "Survivor" or role == "Verity"
	openButton.Visible = not inRound
	if inRound and isOpen then
		setOpen(false)
	end
end

function Shop.init()
	build()
end

function Shop.start()
	for _, attr in { "VerityChance", "PassMultiplier", "BoostRounds", "Role" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	refresh()
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[--!strict
-- Efectos locales: oro girando, lámparas parpadeantes, golpes, tótems,
-- viñeta de "radio de terror" y bloqueo de prompts para Verity.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local player = Players.LocalPlayer

local TERROR_RADIUS = 45

local WorldFX = {}

local goldBlocks: { [BasePart]: CFrame } = {}
local vignette: Frame

local function playSound(id: string, position: Vector3, volume: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = Workspace
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.8
	sound.RollOffMaxDistance = 120
	sound.Parent = holder
	sound:Play()
	game:GetService("Debris"):AddItem(holder, 4)
	return holder
end

local function burst(position: Vector3, color: Color3, texture: string, count: number, speed: number)
	local holder = playSound("", position, 0)
	local emitter = Instance.new("ParticleEmitter")
	if texture ~= "" then
		emitter.Texture = texture
	end
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.35, 0.7)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
end

local function shockRing(position: Vector3)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Transparency = 1
	ring.Size = Vector3.new(1, 0.05, 1)
	ring.CFrame = CFrame.new(position)
	ring.Parent = Workspace
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = if Assets.ShockRing ~= "" then Assets.ShockRing else Assets.GlowOrb
	decal.Color3 = Color3.fromRGB(110, 230, 255)
	decal.Parent = ring
	UI.tween(ring, 0.9, { Size = Vector3.new(36, 0.05, 36) })
	UI.tween(decal, 0.9, { Transparency = 1 })
	game:GetService("Debris"):AddItem(ring, 1)
end

local function onEffect(kind: string, position: Vector3)
	if kind == "Slash" then
		playSound("rbxasset://sounds/swordslash.wav", position, 1)
		burst(position, Color3.fromRGB(255, 40, 60), Assets.GlowOrb, 28, 14)
	elseif kind == "Totem" then
		playSound("rbxasset://sounds/electronicpingshort.wav", position, 1)
		burst(position + Vector3.new(0, 4, 0), Color3.fromRGB(120, 230, 255), Assets.Sparkle, 40, 10)
		shockRing(position + Vector3.new(0, 0.2, 0))
	elseif kind == "Pickup" then
		playSound("rbxasset://sounds/clickfast.wav", position, 0.6)
		burst(position, Color3.fromRGB(255, 220, 120), Assets.Sparkle, 14, 6)
	end
end

local function buildVignette()
	local gui = UI.new("ScreenGui", {
		Name = "TerrorVignette",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = -1,
		Parent = player:WaitForChild("PlayerGui"),
	})
	vignette = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	-- dos capas con degradado: bordes rojos, centro transparente
	for _, rotation in { 0, 90 } do
		UI.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(150, 0, 20),
			BorderSizePixel = 0,
			Parent = vignette,
		}, {
			UI.new("UIGradient", {
				Rotation = rotation,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.2),
					NumberSequenceKeypoint.new(0.18, 1),
					NumberSequenceKeypoint.new(0.82, 1),
					NumberSequenceKeypoint.new(1, 0.2),
				}),
			}),
		})
	end
	vignette.Visible = false
end

local function killerRoot(): BasePart?
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("Role") == "Verity" then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				return root
			end
		end
	end
	return nil
end

local function updateTerror()
	local intensity = 0
	if player:GetAttribute("Role") == "Survivor" then
		local character = player.Character
		local myRoot = character and character:FindFirstChild("HumanoidRootPart")
		local theirRoot = killerRoot()
		if myRoot and myRoot:IsA("BasePart") and theirRoot and not theirRoot.Anchored then
			local distance = (myRoot.Position - theirRoot.Position).Magnitude
			intensity = math.clamp(1 - distance / TERROR_RADIUS, 0, 1)
		end
	end
	vignette.Visible = intensity > 0
	if intensity > 0 then
		-- pulso tipo latido, más rápido cuanto más cerca
		local beat = (math.sin(os.clock() * (4 + intensity * 6)) + 1) / 2
		local alpha = 1 - intensity * (0.55 + beat * 0.3)
		for _, layer in vignette:GetChildren() do
			if layer:IsA("Frame") then
				layer.BackgroundTransparency = alpha
			end
		end
	end
end

local function trackGold(inst: Instance)
	if inst:IsA("BasePart") then
		goldBlocks[inst] = inst.CFrame
	end
end

function WorldFX.init()
	buildVignette()
end

function WorldFX.start()
	Net.get("Effect").OnClientEvent:Connect(onEffect)

	for _, inst in CollectionService:GetTagged("GoldBlock") do
		trackGold(inst)
	end
	CollectionService:GetInstanceAddedSignal("GoldBlock"):Connect(trackGold)
	CollectionService:GetInstanceRemovedSignal("GoldBlock"):Connect(function(inst)
		goldBlocks[inst :: BasePart] = nil
	end)

	local function applyRole()
		-- Verity no puede recoger oro ni craftear.
		ProximityPromptService.Enabled = player:GetAttribute("Role") ~= "Verity"
	end
	player:GetAttributeChangedSignal("Role"):Connect(applyRole)
	applyRole()

	local flickerClock = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for block, base in goldBlocks do
			if block.Parent then
				block.CFrame = base * CFrame.new(0, math.sin(t * 2) * 0.25, 0) * CFrame.Angles(0, t * 1.5, math.rad(15))
			else
				goldBlocks[block] = nil
			end
		end

		flickerClock += dt
		if flickerClock > 0.08 then
			flickerClock = 0
			for _, lamp in CollectionService:GetTagged("MansionLamp") do
				if lamp:GetAttribute("Flicker") then
					local light = lamp:FindFirstChildOfClass("PointLight")
					if light then
						light.Brightness = if math.random() < 0.12 then 0.1 else 0.9
					end
				end
			end
		end

		updateTerror()
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="22">
          <Properties>
            <string name="Name">Lib</string>
          </Properties>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Ayudas mínimas para construir UI por código con un estilo consistente.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Panel = Color3.fromRGB(16, 13, 22),
	PanelLight = Color3.fromRGB(30, 25, 40),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(240, 236, 245),
	Muted = Color3.fromRGB(165, 156, 178),
	Verity = Color3.fromRGB(255, 59, 78),
	Survivor = Color3.fromRGB(70, 220, 190),
	Gold = Color3.fromRGB(255, 200, 60),
	Good = Color3.fromRGB(110, 230, 160),
	Warn = Color3.fromRGB(255, 190, 90),
}

UI.Font = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
UI.FontBold = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
UI.FontHeavy = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)

function UI.new(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(transparency: number?, color: Color3?): UIStroke
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Stroke,
		Transparency = transparency or 0.88,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextSize = 16,
	}
	for k, v in props do
		defaults[k] = v
	end
	return UI.new("TextLabel", defaults)
end

function UI.tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

return UI
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
