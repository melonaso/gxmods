      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Valores ajustables del juego. Este módulo es legible por el cliente:
-- toda validación real ocurre en el servidor.

local Config = {}

Config.Round = {
	MinPlayers = 2,
	IntermissionTime = 25,
	Duration = 240, -- segundos de una partida si nadie craftea tótems
	KillerReleaseDelay = 10, -- ventaja inicial de los supervivientes
	ResultsTime = 7,
	MinRemainingAfterTotem = 15, -- un tótem nunca deja el reloj por debajo de esto
}

-- MODO PRUEBA: permite jugar solo. El primer jugador del servidor es
-- Verity en todas las rondas y NPCs ocupan el lugar de los supervivientes.
-- Ponlo en false antes de publicar el juego.
Config.Testing = {
	Enabled = true,
	Bots = 5,
	IntermissionTime = 8,
}

Config.Killer = {
	Name = "Verity",
	KillRange = 9, -- distancia máxima para atrapar con Q
	KillConeDot = 0.2, -- el objetivo debe estar más o menos al frente
	KillCooldown = 1,
}

Config.Movement = {
	SurvivorWalk = 16,
	SurvivorSprint = 24, -- Shift
	StaminaMax = 100,
	StaminaDrain = 22, -- por segundo corriendo
	StaminaRegen = 14,
	StaminaRegenDelay = 0.8,
	VerityWalk = 18,
	VeritySprint = 28, -- más rápida que el sprint de los supervivientes
	VerityCrouch = 9, -- tecla C
	BotWalk = 15,
	BotFlee = 21,
}

Config.Crafting = {
	TableCount = 3,
	GoldPerTotem = 3, -- bloques de oro que necesita una mesa para craftear
	MaxGoldCarried = 2,
	TimeReductionPerTotem = 30, -- segundos que resta cada tótem
	MaxTotemsPerRound = 5,
	CraftHoldDuration = 3,
	PickupHoldDuration = 0.35,
	GoldRespawnDelay = 18,
	GoldMinBlocks = 6,
	GoldMaxBlocks = 18,
	GoldPerSurvivor = 3,
}

-- Probabilidad de ser Verity estilo MM2: cada ronda que no eres elegido
-- sumas +1 de "suerte"; al ser elegido vuelve a 0.
-- peso = (1 + suerte) * multiplicadorPase * multiplicadorPoción
Config.Chance = {
	LuckPerRound = 1,
	MaxLuck = 10,
}

-- Reemplaza Id = 0 por los IDs reales creados en el Creator Hub.
-- Si un jugador tiene varios pases se aplica el multiplicador más alto.
Config.GamePasses = {
	{ Key = "Chance2x", Id = 0, Multiplier = 2, Title = "2x Probabilidad", Description = "Doble probabilidad de ser Verity en cada ronda." },
	{ Key = "Chance3x", Id = 0, Multiplier = 3, Title = "3x Probabilidad", Description = "Triple probabilidad de ser Verity en cada ronda." },
}

-- Producto de desarrollador consumible: multiplica la probabilidad en las
-- próximas rondas (se acumulan rondas, no el multiplicador).
Config.Products = {
	{ Key = "VerityPotion", Id = 0, Multiplier = 5, Rounds = 1, Title = "Poción de Verity", Description = "x5 de probabilidad en tu próxima ronda." },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Punto único de definición de remotes. El servidor los crea al iniciar
-- (Net.setup); el cliente solo los espera. El estado continuo (fase,
-- temporizador, oro, estamina) viaja por atributos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- "Action" es el único remote cliente -> servidor (Shift, C, Q); el servidor
-- valida el rol y aplica límites.
export type RemoteName = "Notify" | "RoleReveal" | "RoundResult" | "Effect" | "Action"

local NAMES: { RemoteName } = { "Notify", "RoleReveal", "RoundResult", "Effect", "Action" }
local FOLDER_NAME = "Remotes"

local Net = {}

local function folder(): Folder
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			return existing :: Folder
		end
		local f = Instance.new("Folder")
		f.Name = FOLDER_NAME
		for _, name in NAMES do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

-- Debe llamarse en el servidor antes que nada: si no, el cliente se queda
-- esperando la carpeta y la interfaz nunca se actualiza.
function Net.setup()
	folder()
end

function Net.get(name: RemoteName): RemoteEvent
	return folder():WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">VerityPose</string>
          <string name="Source"><![CDATA[--!strict
-- Medidas del rig de Verity y línea de tiempo del ataque "levantar y
-- aplastar". El cliente la usa para animar y el servidor para saber dónde
-- están las manos (y mover a la víctima con ellas) sin depender de la red.
-- Las medidas deben coincidir con tools/verity_rig.py.

local Pose = {}

Pose.RootY = 8.2 -- altura del centro de HumanoidRootPart sobre los pies
Pose.HipHeight = 7
Pose.Waist = Vector3.new(0, 8.0, 0)
Pose.Shoulder = Vector3.new(1.35, 11.5, 0)
Pose.UpperArm = 3.6
Pose.ForearmToGrip = 4.2 -- antebrazo + mitad de la mano
Pose.Thigh = 3.5
Pose.Shin = 3.1
Pose.CrouchDrop = 3.5 -- cuánto baja la cadera al agacharse
Pose.CrouchAngle = math.acos((Pose.Thigh + Pose.Shin - Pose.CrouchDrop) / (Pose.Thigh + Pose.Shin))

Pose.KillGrab = 0.45 -- la víctima termina de llegar a las manos
Pose.KillImpact = 1.75 -- golpe contra el suelo
Pose.KillDuration = 2.4

local rad = math.rad
-- tiempo, hombro (adelante +), codo, cintura (adelante -)
local KEYS = {
	{ 0.00, 0, 0, 0 },
	{ 0.35, rad(60), rad(25), rad(-32) }, -- se inclina y alcanza
	{ 0.45, rad(60), rad(25), rad(-32) },
	{ 1.30, rad(168), rad(12), rad(8) }, -- levanta sobre la cabeza
	{ 1.55, rad(176), rad(18), rad(12) }, -- tensa antes del golpe
	{ 1.75, rad(48), rad(0), rad(-38) }, -- aplasta
	{ 2.40, 0, 0, 0 },
}

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

-- Devuelve (hombro, codo, cintura) en radianes para el instante t.
function Pose.killAngles(t: number): (number, number, number)
	if t <= 0 then
		return 0, 0, 0
	end
	for i = 1, #KEYS - 1 do
		local a, b = KEYS[i], KEYS[i + 1]
		if t <= b[1] then
			local alpha = smooth((t - a[1]) / (b[1] - a[1]))
			return a[2] + (b[2] - a[2]) * alpha, a[3] + (b[3] - a[3]) * alpha, a[4] + (b[4] - a[4]) * alpha
		end
	end
	return 0, 0, 0
end

-- Punto medio entre las dos manos, en espacio del modelo (pies en el origen).
function Pose.gripLocal(t: number): Vector3
	local shoulder, elbow, waist = Pose.killAngles(t)
	local upper = CFrame.Angles(shoulder, 0, 0)
	local elbowPos = Pose.Shoulder + upper:VectorToWorldSpace(Vector3.new(0, -Pose.UpperArm, 0))
	local grip = elbowPos + (upper * CFrame.Angles(elbow, 0, 0)):VectorToWorldSpace(Vector3.new(0, -Pose.ForearmToGrip, 0))
	grip = Pose.Waist + CFrame.Angles(waist, 0, 0):VectorToWorldSpace(grip - Pose.Waist)
	return Vector3.new(0, grip.Y, grip.Z)
end

return Pose
]]></string>
        </Properties>
