      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Punto único de definición de remotes. El servidor los crea al iniciar
-- (Net.setup); el cliente solo los espera. El estado continuo (fase,
-- temporizador, oro, estamina) viaja por atributos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Remotes cliente -> servidor: "Action" (Shift, C, Q) y "ShopRequest"
-- (comprar/equipar). El servidor valida rol, precio y límites.
export type RemoteName = "Notify" | "RoleReveal" | "RoundResult" | "Effect" | "Action" | "ShopRequest"

local NAMES: { RemoteName } = { "Notify", "RoleReveal", "RoundResult", "Effect", "Action", "ShopRequest" }
local FOLDER_NAME = "Remotes"

local Net = {}

local function folder(): Folder
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			return existing :: Folder
		end
		local f = Instance.new("Folder")
		f.Name = FOLDER_NAME
		for _, name in NAMES do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

-- Debe llamarse en el servidor antes que nada: si no, el cliente se queda
-- esperando la carpeta y la interfaz nunca se actualiza.
function Net.setup()
	folder()
end

function Net.get(name: RemoteName): RemoteEvent
	return folder():WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">VerityPose</string>
          <string name="Source"><![CDATA[--!strict
-- Línea de tiempo del ataque "levantar y aplastar" y medidas del rig de
-- Verity. Funciona con cualquier modelo: VerityModel (servidor) mide el rig
-- al prepararlo y guarda las medidas como atributos del modelo; el cliente
-- anima con ellas y el servidor calcula dónde están las manos para mover a
-- la víctima, sin depender de la red.

local Pose = {}

export type RigData = {
	rootY: number, -- altura del centro de HumanoidRootPart sobre los pies
	hipHeight: number,
	crouchDrop: number,
	crouchAngle: number,
	waist: Vector3, -- pivotes en espacio del modelo (pies en el origen, mirando a -Z)
	shoulder: Vector3,
	elbow: Vector3,
	grip: Vector3,
	hasWaist: boolean,
	hasArms: boolean,
}

Pose.KillGrab = 0.45 -- la víctima termina de llegar a las manos
Pose.KillImpact = 1.75 -- golpe contra el suelo
Pose.KillDuration = 2.4

local rad = math.rad
-- tiempo, hombro (adelante +), codo, cintura (adelante -)
local KEYS = {
	{ 0.00, 0, 0, 0 },
	{ 0.35, rad(60), rad(25), rad(-32) }, -- se inclina y alcanza
	{ 0.45, rad(60), rad(25), rad(-32) },
	{ 1.30, rad(168), rad(12), rad(8) }, -- levanta sobre la cabeza
	{ 1.55, rad(176), rad(18), rad(12) }, -- tensa antes del golpe
	{ 1.75, rad(48), rad(0), rad(-38) }, -- aplasta
	{ 2.40, 0, 0, 0 },
}

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

-- Devuelve (hombro, codo, cintura) en radianes para el instante t.
function Pose.killAngles(t: number): (number, number, number)
	if t <= 0 then
		return 0, 0, 0
	end
	for i = 1, #KEYS - 1 do
		local a, b = KEYS[i], KEYS[i + 1]
		if t <= b[1] then
			local alpha = smooth((t - a[1]) / (b[1] - a[1]))
			return a[2] + (b[2] - a[2]) * alpha, a[3] + (b[3] - a[3]) * alpha, a[4] + (b[4] - a[4]) * alpha
		end
	end
	return 0, 0, 0
end

-- Lee las medidas que VerityModel guardó en el modelo.
function Pose.read(model: Instance): RigData
	local function v(name: string, default: Vector3): Vector3
		local value = model:GetAttribute(name)
		return if typeof(value) == "Vector3" then value else default
	end
	local function n(name: string, default: number): number
		local value = model:GetAttribute(name)
		return if typeof(value) == "number" then value else default
	end
	local height = n("RigHeight", 16)
	return {
		rootY = n("RootY", height * 0.5),
		hipHeight = n("HipHeightStand", height * 0.42),
		crouchDrop = n("CrouchDrop", height * 0.2),
		crouchAngle = n("CrouchAngle", math.rad(60)),
		waist = v("PivotWaist", Vector3.new(0, height * 0.5, 0)),
		shoulder = v("PivotShoulder", Vector3.new(0, height * 0.72, 0)),
		elbow = v("PivotElbow", Vector3.new(0, height * 0.5, 0)),
		grip = v("PivotGrip", Vector3.new(0, height * 0.25, 0)),
		hasWaist = model:GetAttribute("HasWaist") == true,
		hasArms = model:GetAttribute("HasArms") == true,
	}
end

-- Punto medio entre las dos manos, en espacio del modelo, en el instante t.
function Pose.gripLocal(t: number, rig: RigData): Vector3
	local shoulder, elbow, waist = Pose.killAngles(t)
	if not rig.hasArms then
		-- modelo sin brazos articulados: la víctima "flota" siguiendo la curva
		local lift = math.sin(math.clamp(shoulder / rad(176), 0, 1) * math.pi * 0.5)
		return Vector3.new(0, rig.shoulder.Y * (0.55 + 0.6 * lift), -rig.shoulder.Y * 0.35 * (1 - lift * 0.6))
	end
	if not rig.hasWaist then
		waist = 0
	end
	local upper = CFrame.Angles(shoulder, 0, 0)
	local elbowPos = rig.shoulder + upper:VectorToWorldSpace(rig.elbow - rig.shoulder)
	local grip = elbowPos + (upper * CFrame.Angles(elbow, 0, 0)):VectorToWorldSpace(rig.grip - rig.elbow)
	grip = rig.waist + CFrame.Angles(waist, 0, 0):VectorToWorldSpace(grip - rig.waist)
	return Vector3.new(0, grip.Y, grip.Z)
end

return Pose
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Único Script del servidor: carga todos los sistemas en dos fases
-- (init síncrono para todos, luego start en paralelo). Cada sistema se
-- protege con pcall: si uno falla, el resto sigue funcionando y el error
-- queda en Output con el nombre del sistema.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Los remotes deben existir antes de que cualquier cliente los espere.
require(ReplicatedStorage.Shared.Net).setup()

local Systems = script.Systems

local loaded: { [string]: any } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			loaded[child.Name] = result
		else
			warn(`[Server] no se pudo cargar {child.Name}: {result}`)
		end
	end
end

local function run(name: string, phase: string)
	local system = loaded[name]
	if system and typeof(system[phase]) == "function" then
		local ok, err = pcall(system[phase])
		if not ok then
			warn(`[Server] {name}.{phase} falló: {err}`)
		end
	end
end

-- MapService primero: el lobby debe existir antes de que aparezcan jugadores.
local ORDER = {
	"MapService", "PlayerData", "Monetization", "VerityModel", "Killer", "Movement",
	"Items", "Shop", "Coins", "Crafting", "Hiding", "Bots", "Lobby", "Round",
}
for _, name in ORDER do
	run(name, "init")
end
for name in loaded do
	if not table.find(ORDER, name) then
		run(name, "init")
	end
end

for name in loaded do
	task.spawn(run, name, "start")
end
]]></string>
      </Properties>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Entity</string>
            <string name="Source"><![CDATA[--!strict
-- Un superviviente puede ser un Player o un NPC (Model). Estas funciones
-- ocultan la diferencia para Round, Crafting y Killer.

local Entity = {}

export type Entity = Instance -- Player | Model

function Entity.character(e: Entity): Model?
	if e:IsA("Player") then
		return e.Character
	end
	return if e:IsA("Model") then e else nil
end

function Entity.humanoid(e: Entity): Humanoid?
	local character = Entity.character(e)
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Entity.root(e: Entity): BasePart?
	local character = Entity.character(e)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function Entity.name(e: Entity): string
	if e:IsA("Player") then
		return e.DisplayName
	end
	local humanoid = Entity.humanoid(e)
	return if humanoid and humanoid.DisplayName ~= "" then humanoid.DisplayName else e.Name
end

function Entity.isPlayer(e: Entity): boolean
	return e:IsA("Player")
end

function Entity.exists(e: Entity): boolean
	return e.Parent ~= nil
end

return Entity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">VerityRig</string>
            <string name="Source"><![CDATA[--!strict
-- Ensambla el modelo ServerStorage.VerityCharacter: crea los Motor6D y las
-- soldaduras a partir de los atributos que escribe tools/verity_rig.py.
-- Debe llamarse ANTES de mover el modelo (las posiciones de los pivotes
-- están en el espacio original del modelo, pies en el origen).

local CollectionService = game:GetService("CollectionService")

local VerityRig = {}

function VerityRig.assemble(model: Model): BasePart
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	assert(root, "VerityCharacter necesita HumanoidRootPart")

	for _, part in model:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		part.Anchored = false
		local parentName = part:GetAttribute("JointParent")
		local weldTo = part:GetAttribute("WeldTo")
		if typeof(parentName) == "string" then
			local parent = model:FindFirstChild(parentName) :: BasePart
			local pivot = CFrame.new(part:GetAttribute("JointPivot") :: Vector3)
			local motor = Instance.new("Motor6D")
			motor.Name = (part:GetAttribute("Motor") :: string?) or part.Name
			motor.Part0 = parent
			motor.Part1 = part
			motor.C0 = parent.CFrame:Inverse() * pivot
			motor.C1 = part.CFrame:Inverse() * pivot
			motor.Parent = part
		elseif typeof(weldTo) == "string" then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = model:FindFirstChild(weldTo) :: BasePart
			weld.Part1 = part
			weld.Parent = part
		end
	end

	model.PrimaryPart = root
	CollectionService:AddTag(model, "VerityRig")
	return root
end

return VerityRig
]]></string>
          </Properties>
        </Item>
      </Item>
