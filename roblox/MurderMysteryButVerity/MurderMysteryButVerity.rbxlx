        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Bots</string>
            <string name="Source"><![CDATA[--!strict
-- NPCs supervivientes para el modo prueba. Cada uno:
--   1. huye si Verity está cerca (ya liberada),
--   2. si lleva menos oro del máximo, va por el bloque más cercano,
--   3. si lleva oro, lo deposita en la mesa más cercana,
--   4. si hay una mesa llena, craftea el tótem (se queda quieto 3 s),
--   5. si no, deambula.

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Crafting = require(script.Parent.Crafting)
local Hiding = require(script.Parent.Hiding)

export type Context = {
	parent: Instance,
	killerRoot: () -> BasePart?,
	killerReleased: () -> boolean,
	isAlive: (Model) -> boolean,
	points: { Vector3 }, -- puntos transitables del mapa para huir / deambular
}

local M = Config.Movement
local FLEE_RADIUS = 34
local REACH = 5.5

local NAMES = { "Lucas", "Sofía", "Mateo", "Valentina", "Diego", "Camila", "Tomás", "Isabella", "Martín", "Lucía", "Emma", "Leo" }

-- Animaciones R15 por defecto de Roblox (públicas, sirven en cualquier juego).
local ANIM_IDLE = "rbxassetid://507766666"
local ANIM_WALK = "rbxassetid://507777826"
local ANIM_RUN = "rbxassetid://507767714"

local Bots = {}

local running = false
local rng = Random.new()

local function randomDescription(): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromHSV(rng:NextNumber(0.03, 0.1), rng:NextNumber(0.2, 0.6), rng:NextNumber(0.45, 0.95))
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	local shirt = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.4, 0.8), rng:NextNumber(0.5, 0.9))
	desc.TorsoColor = shirt
	local pants = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.2, 0.5), rng:NextNumber(0.2, 0.5))
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	return desc
end

local function setupAnimations(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local function load(id: string): AnimationTrack
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local track = animator:LoadAnimation(anim)
		track.Looped = true
		return track
	end
	local idle, walk, run = load(ANIM_IDLE), load(ANIM_WALK), load(ANIM_RUN)
	idle:Play()
	local currentTrack = idle
	humanoid.Running:Connect(function(speed)
		local nextTrack = if speed < 0.5 then idle elseif speed > 18 then run else walk
		if nextTrack ~= currentTrack then
			currentTrack:Stop(0.2)
			nextTrack:Play(0.2)
			currentTrack = nextTrack
		end
	end)
end

local function nearest<T>(from: Vector3, items: { T }, position: (T) -> Vector3): (T?, number)
	local best: T? = nil
	local bestDistance = math.huge
	for _, item in items do
		local d = (position(item) - from).Magnitude
		if d < bestDistance then
			best, bestDistance = item, d
		end
	end
	return best, bestDistance
end

-- Camina hacia `target` con pathfinding. Devuelve cuando llega, falla o
-- `interrupt()` devuelve true.
local function walkTo(humanoid: Humanoid, root: BasePart, target: Vector3, interrupt: () -> boolean)
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5.5, AgentCanJump = false, WaypointSpacing = 6 })
	local ok = pcall(path.ComputeAsync, path, root.Position, target)
	local waypoints = if ok and path.Status == Enum.PathStatus.Success then path:GetWaypoints() else nil
	if not waypoints then
		humanoid:MoveTo(target)
		local deadline = os.clock() + 2
		while running and os.clock() < deadline and (root.Position - target).Magnitude > REACH and not interrupt() do
			task.wait(0.1)
		end
		return
	end
	for i, waypoint in waypoints do
		if i == 1 then
			continue
		end
		humanoid:MoveTo(waypoint.Position)
		local deadline = os.clock() + 1.5
		while running and os.clock() < deadline do
			if interrupt() or root.Anchored or humanoid.Health <= 0 then
				return
			end
			if ((root.Position - waypoint.Position) * Vector3.new(1, 0, 1)).Magnitude < 2.5 then
				break
			end
			task.wait(0.05)
		end
	end
end

local function think(bot: Model, ctx: Context)
	local humanoid = bot:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart

	local function threatened(): boolean
		local killer = ctx.killerRoot()
		if not killer or not ctx.killerReleased() then
			return false
		end
		-- con la Capa fantasma solo la notan si está muy cerca
		local invisible = killer.Parent ~= nil and (killer.Parent :: Instance):GetAttribute("Invisible") == true
		local radius = if invisible then 10 else FLEE_RADIUS
		return (killer.Position - root.Position).Magnitude < radius
	end

	while running and bot.Parent and ctx.isAlive(bot) and humanoid.Health > 0 do
		local killer = ctx.killerRoot()
		-- escondido: espera hasta que Verity lleve un rato lejos
		if Hiding.isHidden(bot) then
			local calm = 0
			while running and bot.Parent and Hiding.isHidden(bot) and ctx.isAlive(bot) do
				local k = ctx.killerRoot()
				local far = not k or (k.Position - root.Position).Magnitude > 50
				calm = if far then calm + 0.5 else 0
				if calm >= 5 then
					Hiding.unhide(bot)
					break
				end
				task.wait(0.5)
			end
			continue
		end
		if root.Anchored then
			task.wait(0.2) -- atrapado (cepo o en manos de Verity)
			continue
		end
		if killer and threatened() and rng:NextNumber() < 0.45 then
			-- intenta llegar a un escondite que no quede hacia Verity
			local best, bestDistance = nil, 32
			for _, spot in Hiding.freeSpots() do
				local d = (spot.exitPoint.Position - root.Position).Magnitude
				local towardKiller = (spot.exitPoint.Position - killer.Position).Magnitude < (root.Position - killer.Position).Magnitude * 0.7
				if d < bestDistance and not towardKiller then
					best, bestDistance = spot, d
				end
			end
			if best then
				humanoid.WalkSpeed = M.BotFlee
				walkTo(humanoid, root, best.exitPoint.Position, function()
					return best.occupant ~= nil
				end)
				if (root.Position - best.exitPoint.Position).Magnitude < 6 and Hiding.hide(bot, best) then
					continue
				end
			end
		end
		if killer and threatened() then
			-- huir: el punto más lejano de Verity que quede "hacia afuera"
			humanoid.WalkSpeed = M.BotFlee
			local away = (root.Position - killer.Position) * Vector3.new(1, 0, 1)
			away = if away.Magnitude > 0.1 then away.Unit else Vector3.xAxis
			local best, bestScore = nil, -math.huge
			for _, p in ctx.points do
				local offset = (p - root.Position) * Vector3.new(1, 0, 1)
				if offset.Magnitude > 8 then
					local score = offset.Unit:Dot(away) * 30 + (p - killer.Position).Magnitude - offset.Magnitude * 0.3
					if score > bestScore then
						best, bestScore = p, score
					end
				end
			end
			if best then
				walkTo(humanoid, root, best, function()
					return not threatened()
				end)
			end
			continue
		end

		humanoid.WalkSpeed = M.BotWalk
		local gold = (bot:GetAttribute("Gold") :: number?) or 0
		local maxGold = Config.Crafting.MaxGoldCarried
		local fullTable = nil
		local tables = Crafting.tables()
		for _, state in tables do
			if state.gold >= Config.Crafting.GoldPerTotem then
				fullTable = state
				break
			end
		end

		if fullTable and Crafting.canCraft() then
			walkTo(humanoid, root, fullTable.top.Position, threatened)
			if (root.Position - fullTable.top.Position).Magnitude < 8 and not threatened() then
				humanoid:MoveTo(root.Position)
				local finish = os.clock() + Config.Crafting.CraftHoldDuration
				while running and os.clock() < finish and not threatened() and not root.Anchored do
					task.wait(0.1)
				end
				if os.clock() >= finish then
					Crafting.craft(bot, fullTable)
				end
			end
		elseif gold > 0 and (gold >= maxGold or #Crafting.goldBlocks() == 0) and #tables > 0 then
			local target = nearest(root.Position, tables, function(t)
				return t.top.Position
			end)
			if target then
				walkTo(humanoid, root, target.top.Position, threatened)
				if (root.Position - target.top.Position).Magnitude < 8 then
					Crafting.deposit(bot, target)
				end
			end
		else
			local block = nearest(root.Position, Crafting.goldBlocks(), function(b)
				return b.Position
			end)
			if block and gold < maxGold then
				walkTo(humanoid, root, block.Position, function()
					return threatened() or block.Parent == nil
				end)
				if block.Parent and (root.Position - block.Position).Magnitude < REACH + 1 then
					Crafting.pickup(bot, block)
				end
			elseif #ctx.points > 0 then
				walkTo(humanoid, root, ctx.points[rng:NextInteger(1, #ctx.points)], threatened)
			end
		end
		task.wait(0.1)
	end
end

function Bots.spawn(count: number, spawns: { CFrame }, ctx: Context): { Model }
	running = true
	local bots = {}
	local names = table.clone(NAMES)
	for i = 1, count do
		local ok, bot = pcall(function()
			return Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R15)
		end)
		if not ok or not bot then
			warn(`[Bots] no se pudo crear el NPC: {bot}`)
			continue
		end
		local nameIndex = rng:NextInteger(1, #names)
		local name = table.remove(names, nameIndex) or `NPC {i}`
		bot.Name = `NPC_{name}`
		bot:SetAttribute("IsBot", true)
		game:GetService("CollectionService"):AddTag(bot, "Bot")
		bot:SetAttribute("Gold", 0)
		local humanoid = bot:FindFirstChildOfClass("Humanoid") :: Humanoid
		humanoid.DisplayName = `{name} (NPC)`
		humanoid.WalkSpeed = M.BotWalk
		humanoid.BreakJointsOnDeath = false
		bot:PivotTo(spawns[(i - 1) % #spawns + 1] + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)))
		bot.Parent = ctx.parent
		local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart
		pcall(root.SetNetworkOwner, root, nil)
		setupAnimations(humanoid)
		table.insert(bots, bot)
	end
	return bots
end

function Bots.startAI(bots: { Model }, ctx: Context)
	for _, bot in bots do
		task.spawn(think, bot, ctx)
	end
end

function Bots.stop()
	running = false
end

return Bots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Coins</string>
            <string name="Source"><![CDATA[--!strict
-- Monedas repartidas por el mapa en cada ronda. Se recogen con solo
-- acercarse (Verity tiene más alcance por su tamaño; el Imán lo triplica).
-- Cada jugador puede llevar como máximo Config.Coins.MaxPerRound por ronda.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local PlayerData = require(script.Parent.PlayerData)

local C = Config.Coins

local Coins = {}

local folder: Folder? = nil
local coins: { BasePart } = {}
local connection: RBXScriptConnection? = nil
local fullWarned: { [Player]: boolean } = {}

local function makeCoin(position: Vector3, parent: Instance): BasePart
	local coin = Instance.new("Part")
	coin.Name = "Coin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.25, 1.7, 1.7)
	coin.Color = Color3.fromRGB(255, 196, 40)
	coin.Material = Enum.Material.Neon
	coin.Anchored = true
	coin.CanCollide = false
	coin.CanQuery = false
	coin.CanTouch = false
	coin.CFrame = CFrame.new(position)
	CollectionService:AddTag(coin, "Coin")
	coin.Parent = parent
	return coin
end

-- Busca el suelo bajo un punto; descarta techos de muebles altos y muros.
local function groundAt(point: Vector3, map: Instance): Vector3?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { map }
	local hit = Workspace:Raycast(point + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0), params)
	if hit and hit.Position.Y < point.Y + 4 then
		return hit.Position
	end
	return nil
end

function Coins.start(map: Instance, points: { Vector3 })
	Coins.stop()
	local f = Instance.new("Folder")
	f.Name = "Coins"
	f.Parent = map
	folder = f
	table.clear(fullWarned)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("RoundCoins", 0)
	end

	local rng = Random.new()
	local attempts = 0
	while #coins < C.PerMap and attempts < C.PerMap * 6 and #points > 0 do
		attempts += 1
		local base = points[rng:NextInteger(1, #points)]
		local candidate = base + Vector3.new(rng:NextNumber(-9, 9), 0, rng:NextNumber(-9, 9))
		local ground = groundAt(candidate, map)
		if ground then
			table.insert(coins, makeCoin(ground + Vector3.new(0, 1.4, 0), f))
		end
	end

	local accumulator = 0
	connection = RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not (character and root and root:IsA("BasePart") and humanoid and humanoid.Health > 0) then
				continue
			end
			local role = player:GetAttribute("Role")
			if role ~= "Verity" and role ~= "Survivor" then
				continue
			end
			local radius = if role == "Verity" then C.VerityPickupRadius else C.PickupRadius
			if character:GetAttribute("CoinMagnet") then
				radius *= C.MagnetMultiplier
			end
			-- para Verity se mide desde los pies, no desde la cadera
			local feet = root.Position - Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)
			for i = #coins, 1, -1 do
				local coin = coins[i]
				local d1 = (coin.Position - root.Position).Magnitude
				local d2 = (coin.Position - feet).Magnitude
				if math.min(d1, d2) <= radius then
					local collected = (player:GetAttribute("RoundCoins") :: number?) or 0
					if collected >= C.MaxPerRound then
						if not fullWarned[player] then
							fullWarned[player] = true
							Net.get("Notify"):FireClient(player, "¡Bolsa de monedas llena!", "warn")
						end
						break
					end
					player:SetAttribute("RoundCoins", collected + 1)
					PlayerData.addCoins(player, 1)
					Net.get("Effect"):FireClient(player, "Coin", coin.Position)
					coin:Destroy()
					table.remove(coins, i)
				end
			end
		end
	end)
end

function Coins.award(player: Player, amount: number, reason: string)
	if amount <= 0 or not player.Parent then
		return
	end
	PlayerData.addCoins(player, amount)
	Net.get("Notify"):FireClient(player, `+{amount} monedas ({reason})`, "good")
end

function Coins.stop()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if folder then
		folder:Destroy()
		folder = nil
	end
	table.clear(coins)
end

return Coins
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Crafting</string>
            <string name="Source"><![CDATA[--!strict
-- Puzzle de oro: los supervivientes recogen bloques de oro, los depositan
-- en mesas de crafteo y, con una mesa llena, craftean un tótem que resta
-- tiempo a la partida. Funciona con jugadores (ProximityPrompts) y con NPCs
-- (llaman a pickup/deposit/craft directamente). "who" es un Player o el Model
-- del NPC; el oro que lleva se guarda en su atributo "Gold".

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

export type Context = {
	parent: Instance,
	goldSpawns: { Vector3 },
	tableSpots: { CFrame },
	survivorCount: number,
	isSurvivor: (Instance) -> boolean,
	onTotem: (Instance) -> boolean, -- devuelve false si no se pudo aplicar
	totemsCrafted: () -> number,
}

export type TableState = {
	model: Model,
	top: BasePart,
	gold: number,
	label: TextLabel,
	deposit: ProximityPrompt,
	craft: ProximityPrompt,
}

local CFG = Config.Crafting
local GOLD_COLOR = Color3.fromRGB(255, 196, 46)

local Crafting = {}

local ctx: Context? = nil
local folder: Folder? = nil
local occupied: { [number]: BasePart } = {} -- índice de goldSpawn -> bloque
local blocks: { [BasePart]: number | boolean } = {} -- bloque -> índice (o true si se soltó)
local tables: { TableState } = {}
local connections: { RBXScriptConnection } = {}
local active = false
local rng = Random.new()

local function setGold(who: Instance, amount: number)
	who:SetAttribute("Gold", amount)
end

local function getGold(who: Instance): number
	return (who:GetAttribute("Gold") :: number?) or 0
end

local function notify(who: Instance, text: string, kind: string?)
	if who:IsA("Player") then
		Net.get("Notify"):FireClient(who, text, kind or "info")
	end
end

local spawnGoldAt: (index: number?, position: Vector3?) -> ()

local function freeSpawnIndex(): number?
	local context = ctx
	if not context then
		return nil
	end
	local free = {}
	for i = 1, #context.goldSpawns do
		if not occupied[i] then
			table.insert(free, i)
		end
	end
	if #free == 0 then
		return nil
	end
	return free[rng:NextInteger(1, #free)]
end

local function scheduleRespawn()
	task.delay(CFG.GoldRespawnDelay, function()
		local context = ctx
		if active and context and context.totemsCrafted() < CFG.MaxTotemsPerRound then
			spawnGoldAt(freeSpawnIndex(), nil)
		end
	end)
end

spawnGoldAt = function(index: number?, position: Vector3?)
	local context = ctx
	local parent = folder
	if not context or not parent then
		return
	end
	local pos = position or (index and context.goldSpawns[index])
	if not pos then
		return
	end

	local block = Instance.new("Part")
	block.Name = "GoldBlock"
	block.Size = Vector3.new(1.6, 1.6, 1.6)
	block.Anchored = true
	block.CanCollide = false
	block.Color = GOLD_COLOR
	block.Material = Enum.Material.Foil
	block.Reflectance = 0.15
	block.CFrame = CFrame.new(pos)

	local light = Instance.new("PointLight")
	light.Color = GOLD_COLOR
	light.Range = 9
	light.Brightness = 1.2
	light.Parent = block

	local sparkles = Instance.new("ParticleEmitter")
	if Assets.Sparkle ~= "" then
		sparkles.Texture = Assets.Sparkle
	end
	sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 230, 140))
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.6, 1)
	sparkles.Rate = 4
	sparkles.Speed = NumberRange.new(0.5, 1.2)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Parent = block

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Recoger oro"
	prompt.ObjectText = "Bloque de oro"
	prompt.HoldDuration = CFG.PickupHoldDuration
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = block

	if index then
		occupied[index] = block
	end
	blocks[block] = index or true
	CollectionService:AddTag(block, "GoldBlock")
	block.Parent = parent

	table.insert(connections, prompt.Triggered:Connect(function(player)
		Crafting.pickup(player, block)
	end))
end

function Crafting.pickup(who: Instance, block: BasePart): boolean
	local context = ctx
	if not active or not context or not block.Parent or blocks[block] == nil or not context.isSurvivor(who) then
		return false
	end
	local carried = getGold(who)
	if carried >= CFG.MaxGoldCarried then
		notify(who, `Solo puedes llevar {CFG.MaxGoldCarried} bloques. ¡Llévalos a una mesa!`, "warn")
		return false
	end
	setGold(who, carried + 1)
	local index = blocks[block]
	if typeof(index) == "number" then
		occupied[index] = nil
	end
	blocks[block] = nil
	if who:IsA("Player") then
		Net.get("Effect"):FireClient(who, "Pickup", block.Position)
	end
	block:Destroy()
	scheduleRespawn()
	return true
end

local function refreshTable(state: TableState)
	local full = state.gold >= CFG.GoldPerTotem
	state.label.Text = if full then "¡Listo para craftear!" else `Oro {state.gold}/{CFG.GoldPerTotem}`
	state.label.TextColor3 = if full then Color3.fromRGB(120, 255, 200) else Color3.fromRGB(255, 220, 120)
	state.deposit.Enabled = not full
	state.craft.Enabled = full
end

local function buildTable(spot: CFrame, parent: Instance): TableState
	local model = Instance.new("Model")
	model.Name = "CraftingTable"

	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = spot * offset
		p.Color = color
		p.Material = material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local top = piece("Top", Vector3.new(6, 0.6, 4), CFrame.new(0, 3.2, 0), Color3.fromRGB(120, 82, 52), Enum.Material.WoodPlanks)
	for _, x in { -2.6, 2.6 } do
		for _, z in { -1.6, 1.6 } do
			piece("Leg", Vector3.new(0.6, 2.9, 0.6), CFrame.new(x, 1.45, z), Color3.fromRGB(80, 54, 36), Enum.Material.Wood)
		end
	end
	piece("Anvil", Vector3.new(2, 0.8, 1.2), CFrame.new(0, 3.9, 0), Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
	local rune = piece("Rune", Vector3.new(5.4, 0.05, 3.4), CFrame.new(0, 3.53, 0), Color3.fromRGB(90, 220, 255), Enum.Material.Neon)
	rune.Transparency = 0.75
	model.PrimaryPart = top

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(110, 220, 255)
	light.Range = 14
	light.Brightness = 1.4
	light.Parent = top

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(180, 34)
	billboard.StudsOffset = Vector3.new(0, 3.6, 0)
	billboard.MaxDistance = 70
	billboard.AlwaysOnTop = true
	billboard.Parent = top
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(14, 12, 20)
	label.BackgroundTransparency = 0.3
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = label
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingBottom = UDim.new(0, 6)
	padding.Parent = label

	local deposit = Instance.new("ProximityPrompt")
	deposit.ActionText = "Depositar oro"
	deposit.ObjectText = "Mesa de crafteo"
	deposit.HoldDuration = 0.4
	deposit.MaxActivationDistance = 10
	deposit.RequiresLineOfSight = false
	deposit.Parent = top

	local craft = Instance.new("ProximityPrompt")
	craft.ActionText = "Craftear tótem"
	craft.ObjectText = "Mesa de crafteo"
	craft.HoldDuration = CFG.CraftHoldDuration
	craft.MaxActivationDistance = 10
	craft.RequiresLineOfSight = false
	craft.KeyboardKeyCode = Enum.KeyCode.F
	craft.Parent = top

	model.Parent = parent
	local state: TableState = { model = model, top = top, gold = 0, label = label, deposit = deposit, craft = craft }
	refreshTable(state)
	return state
end

local function spawnTotemVisual(state: TableState)
	local totem = Instance.new("Part")
	totem.Name = "Totem"
	totem.Anchored = true
	totem.CanCollide = false
	totem.Size = Vector3.new(1.1, 2.4, 1.1)
	totem.Color = GOLD_COLOR
	totem.Material = Enum.Material.Foil
	totem.CFrame = state.top.CFrame * CFrame.new(rng:NextNumber(-2.2, 2.2), 1.5, rng:NextNumber(-1.2, 1.2))
	local eye = Instance.new("Part")
	eye.Anchored = true
	eye.CanCollide = false
	eye.Size = Vector3.new(0.7, 0.25, 0.1)
	eye.Material = Enum.Material.Neon
	eye.Color = Color3.fromRGB(90, 230, 255)
	eye.CFrame = totem.CFrame * CFrame.new(0, 0.6, -0.56)
	eye.Parent = totem
	totem.Parent = state.model
end

function Crafting.deposit(who: Instance, state: TableState): boolean
	local context = ctx
	if not active or not context or not context.isSurvivor(who) then
		return false
	end
	local carried = getGold(who)
	if carried <= 0 then
		notify(who, "Necesitas bloques de oro. ¡Búscalos por el mapa!", "warn")
		return false
	end
	local moved = math.min(carried, CFG.GoldPerTotem - state.gold)
	if moved <= 0 then
		return false
	end
	state.gold += moved
	setGold(who, carried - moved)
	refreshTable(state)
	return true
end

function Crafting.craft(who: Instance, state: TableState): boolean
	local context = ctx
	if not active or not context or not context.isSurvivor(who) or state.gold < CFG.GoldPerTotem then
		return false
	end
	if context.totemsCrafted() >= CFG.MaxTotemsPerRound then
		notify(who, "El reloj ya no puede acelerarse más esta ronda.", "warn")
		return false
	end
	if not context.onTotem(who) then
		notify(who, "¡Ya casi amanece! El tótem no tendría efecto.", "warn")
		return false
	end
	state.gold = 0
	refreshTable(state)
	spawnTotemVisual(state)
	Net.get("Effect"):FireAllClients("Totem", state.top.Position)
	return true
end

local function connectTable(state: TableState)
	table.insert(connections, state.deposit.Triggered:Connect(function(player)
		Crafting.deposit(player, state)
	end))
	table.insert(connections, state.craft.Triggered:Connect(function(player)
		Crafting.craft(player, state)
	end))
end

-- Lectura para la IA de los NPCs.
function Crafting.goldBlocks(): { BasePart }
	local list = {}
	for block in blocks do
		if block.Parent then
			table.insert(list, block)
		end
	end
	return list
end

function Crafting.tables(): { TableState }
	return tables
end

function Crafting.canCraft(): boolean
	local context = ctx
	return active and context ~= nil and context.totemsCrafted() < CFG.MaxTotemsPerRound
end

-- Suelta el oro que llevaba un superviviente al morir.
function Crafting.dropGold(who: Instance, position: Vector3)
	local carried = getGold(who)
	setGold(who, 0)
	if not active then
		return
	end
	for i = 1, carried do
		local angle = (i / math.max(carried, 1)) * math.pi * 2
		spawnGoldAt(nil, position + Vector3.new(math.cos(angle) * 2, 0, math.sin(angle) * 2))
	end
end

function Crafting.start(context: Context)
	ctx = context
	active = true
	local f = Instance.new("Folder")
	f.Name = "Crafting"
	f.Parent = context.parent
	folder = f

	for _, spot in context.tableSpots do
		local state = buildTable(spot, f)
		table.insert(tables, state)
		connectTable(state)
	end

	local count = math.clamp(context.survivorCount * CFG.GoldPerSurvivor, CFG.GoldMinBlocks, CFG.GoldMaxBlocks)
	for _ = 1, math.min(count, #context.goldSpawns) do
		spawnGoldAt(freeSpawnIndex(), nil)
	end
end

function Crafting.stop()
	active = false
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	table.clear(tables)
	table.clear(occupied)
	table.clear(blocks)
	if folder then
		folder:Destroy()
		folder = nil
	end
	ctx = nil
end

return Crafting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Hiding</string>
            <string name="Source"><![CDATA[--!strict
-- Escondites (armarios, taquillas, ataúdes, confesionarios). Un superviviente
-- (jugador o NPC) se mete con el ProximityPrompt "Esconderse": queda quieto e
-- invisible dentro. Sale con el mismo prompt ("Salir"). Verity no ve el
-- prompt, pero si se planta delante del escondite y pulsa Q, saca a quien
-- esté dentro (Killer lo encuentra porque su raíz está ahí).

local Players = game:GetService("Players")

local Entity = require(script.Parent.Parent.Lib.Entity)

export type Spot = {
	model: Model,
	door: BasePart,
	hidePoint: BasePart,
	exitPoint: BasePart,
	prompt: ProximityPrompt,
	occupant: Instance?,
}

export type Context = {
	isSurvivor: (Instance) -> boolean,
}

local Hiding = {}

local spots: { Spot } = {}
local byOccupant: { [Instance]: Spot } = {}
local saved: { [Instance]: { [BasePart]: number } } = {}
local connections: { RBXScriptConnection } = {}
local ctx: Context? = nil

local function setVisible(character: Model, who: Instance, visible: boolean)
	if visible then
		for part, value in saved[who] or {} do
			if part.Parent then
				part.Transparency = value
			end
		end
		saved[who] = nil
		for _, inst in character:GetDescendants() do
			if inst:IsA("Decal") then
				inst.Transparency = 0
			end
		end
	else
		local list: { [BasePart]: number } = {}
		for _, inst in character:GetDescendants() do
			if inst:IsA("BasePart") then
				list[inst] = inst.Transparency
				inst.Transparency = 1
			elseif inst:IsA("Decal") then
				inst.Transparency = 1
			end
		end
		saved[who] = list
	end
	-- la etiqueta con el nombre también delataría al escondido
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = if visible then Enum.HumanoidDisplayDistanceType.Viewer else Enum.HumanoidDisplayDistanceType.None
	end
end

local function refreshPrompt(spot: Spot)
	spot.prompt.ActionText = if spot.occupant then "Salir" else "Esconderse"
	spot.prompt.ObjectText = if spot.occupant then "Escondido" else "Escondite"
end

function Hiding.isHidden(who: Instance): boolean
	return byOccupant[who] ~= nil
end

function Hiding.hide(who: Instance, spot: Spot): boolean
	local context = ctx
	if not context or spot.occupant or byOccupant[who] or not context.isSurvivor(who) then
		return false
	end
	local character = Entity.character(who)
	local root = Entity.root(who)
	if not (character and root) or root.Anchored then
		return false
	end
	spot.occupant = who
	byOccupant[who] = spot
	root.Anchored = true
	character:PivotTo(spot.hidePoint.CFrame)
	setVisible(character, who, false)
	character:SetAttribute("Hidden", true)
	refreshPrompt(spot)
	return true
end

-- Sale del escondite. keepAnchored: lo usa Verity al sacarte (te sujeta ella).
function Hiding.unhide(who: Instance, keepAnchored: boolean?)
	local spot = byOccupant[who]
	if not spot then
		return
	end
	byOccupant[who] = nil
	spot.occupant = nil
	refreshPrompt(spot)
	local character = Entity.character(who)
	if character then
		setVisible(character, who, true)
		character:SetAttribute("Hidden", nil)
		if not keepAnchored then
			character:PivotTo(spot.exitPoint.CFrame)
			local root = Entity.root(who)
			if root and root:GetAttribute("Grabbed") ~= true then
				root.Anchored = false
			end
		end
	end
end

-- Escondites libres (para la IA de los NPCs).
function Hiding.freeSpots(): { Spot }
	local list = {}
	for _, spot in spots do
		if not spot.occupant and spot.model.Parent then
			table.insert(list, spot)
		end
	end
	return list
end

function Hiding.start(map: Instance, context: Context)
	Hiding.stop()
	ctx = context
	for _, inst in map:GetDescendants() do
		if inst:IsA("Model") and inst:GetAttribute("HideSpot") then
			local door = inst:FindFirstChild("Door")
			local hidePoint = inst:FindFirstChild("HidePoint")
			local exitPoint = inst:FindFirstChild("ExitPoint")
			if not (door and door:IsA("BasePart") and hidePoint and hidePoint:IsA("BasePart") and exitPoint and exitPoint:IsA("BasePart")) then
				continue
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.HoldDuration = 0.35
			prompt.MaxActivationDistance = 7
			prompt.RequiresLineOfSight = false
			prompt.KeyboardKeyCode = Enum.KeyCode.R
			prompt.Parent = door
			local spot: Spot = { model = inst, door = door, hidePoint = hidePoint, exitPoint = exitPoint, prompt = prompt, occupant = nil }
			refreshPrompt(spot)
			table.insert(spots, spot)
			table.insert(connections, prompt.Triggered:Connect(function(player)
				if spot.occupant == player then
					Hiding.unhide(player)
				elseif not spot.occupant then
					Hiding.hide(player, spot)
				end
			end))
		end
	end
end

function Hiding.stop()
	for who in byOccupant do
		Hiding.unhide(who)
	end
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	table.clear(spots)
	table.clear(byOccupant)
	table.clear(saved)
	ctx = nil
end

function Hiding.init()
	Players.PlayerRemoving:Connect(function(player)
		local spot = byOccupant[player]
		if spot then
			spot.occupant = nil
			byOccupant[player] = nil
			refreshPrompt(spot)
		end
	end)
end

return Hiding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--!strict
-- Objetos de la tienda (Tools). Cada jugador recibe los objetos que tiene
-- equipados al aparecer (lobby y rondas, también como Verity). Todo el
-- efecto ocurre en el servidor; el cliente solo dibuja efectos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Movement = require(script.Parent.Movement)
local PlayerData = require(script.Parent.PlayerData)

local Items = {}

type ItemDef = { Key: string, Title: string, Description: string, Color: Color3 }

local defs: { [string]: ItemDef } = {}
for _, item in Config.Items do
	defs[item.Key] = item :: any
end

local cooldowns: { [Player]: { [string]: number } } = {}
local traps: { [Player]: { BasePart } } = {}
local trapFolder: Folder? = nil

local function notify(player: Player, text: string, kind: string?)
	Net.get("Notify"):FireClient(player, text, kind or "info")
end

local function ready(player: Player, key: string, seconds: number): boolean
	local list = cooldowns[player]
	if not list then
		list = {}
		cooldowns[player] = list
	end
	local now = os.clock()
	local readyAt = list[key] or 0
	if now < readyAt then
		notify(player, `Recargando... {math.ceil(readyAt - now)} s`, "warn")
		return false
	end
	list[key] = now + seconds
	return true
end

local function characterParts(character: Model): { BasePart }
	local list = {}
	for _, inst in character:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
			table.insert(list, inst)
		end
	end
	return list
end

local function inRound(): boolean
	return Workspace:GetAttribute("Phase") == "Playing"
end

-- ¿Es `model` un superviviente vivo (jugador o NPC)?
local function isSurvivorCharacter(model: Model): boolean
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if model:GetAttribute("IsBot") then
		return true
	end
	local player = Players:GetPlayerFromCharacter(model)
	return player ~= nil and player:GetAttribute("Role") == "Survivor"
end

local function survivorCharacters(): { Model }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Role") == "Survivor" and player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, inst in Workspace:GetDescendants() do
		if inst:IsA("Model") and inst:GetAttribute("IsBot") and isSurvivorCharacter(inst) then
			table.insert(list, inst)
		end
	end
	return list
end

-- Construcción de la herramienta ------------------------------------------

local function makeHandle(def: ItemDef): Part
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.7, 0.7, 1.6)
	handle.Color = def.Color
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Massless = true
	local function decor(size: Vector3, offset: CFrame, color: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.Massless = true
		p.CFrame = handle.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
		p.Parent = handle
	end
	local key = def.Key
	if key == "SpeedCoil" or key == "GravityCoil" or key == "FusionCoil" then
		-- bobina: anillos de neón alrededor de un núcleo
		handle.Size = Vector3.new(0.5, 0.5, 1.8)
		for i = -2, 2 do
			decor(Vector3.new(0.25, 1.1, 1.1), CFrame.new(0, 0, i * 0.35) * CFrame.Angles(0, math.rad(90), 0), def.Color, Enum.Material.Neon)
		end
	elseif key == "Medkit" then
		handle.Size = Vector3.new(1.4, 1, 0.6)
		handle.Color = Color3.fromRGB(240, 240, 240)
		decor(Vector3.new(0.9, 0.25, 0.65), CFrame.new(), Color3.fromRGB(220, 30, 40), Enum.Material.SmoothPlastic)
		decor(Vector3.new(0.25, 0.9, 0.65), CFrame.new(), Color3.fromRGB(220, 30, 40), Enum.Material.SmoothPlastic)
	elseif key == "EnergyDrink" then
		handle.Shape = Enum.PartType.Cylinder
		handle.Size = Vector3.new(1.2, 0.6, 0.6)
		handle.Material = Enum.Material.Foil
	elseif key == "Flashlight" then
		handle.Size = Vector3.new(0.45, 0.45, 1.8)
		handle.Color = Color3.fromRGB(40, 40, 45)
		decor(Vector3.new(0.6, 0.6, 0.2), CFrame.new(0, 0, -0.9), def.Color, Enum.Material.Neon)
		local light = Instance.new("SpotLight")
		light.Name = "Beam"
		light.Face = Enum.NormalId.Front
		light.Range = 50
		light.Angle = 50
		light.Brightness = 3
		light.Color = Color3.fromRGB(255, 240, 210)
		light.Enabled = false
		light.Shadows = true
		light.Parent = handle
	elseif key == "BearTrap" then
		handle.Size = Vector3.new(1.4, 0.3, 1.4)
		decor(Vector3.new(1.4, 0.4, 0.15), CFrame.new(0, 0.3, 0.55), Color3.fromRGB(180, 180, 190), Enum.Material.Metal)
		decor(Vector3.new(1.4, 0.4, 0.15), CFrame.new(0, 0.3, -0.55), Color3.fromRGB(180, 180, 190), Enum.Material.Metal)
	elseif key == "PushHammer" then
		handle.Size = Vector3.new(0.3, 0.3, 3)
		handle.Color = Color3.fromRGB(110, 75, 45)
		handle.Material = Enum.Material.Wood
		decor(Vector3.new(1.4, 1, 1), CFrame.new(0, 0, -1.4), def.Color, Enum.Material.Metal)
	else
		decor(Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 0, -0.9), def.Color, Enum.Material.Neon)
	end
	return handle
end

local function setGravity(character: Model, factor: number?)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return
	end
	local existing = root:FindFirstChild("CoilLift")
	if existing then
		existing:Destroy()
	end
	local attachment = root:FindFirstChild("CoilAttachment") :: Attachment?
	if factor then
		if not attachment then
			local a = Instance.new("Attachment")
			a.Name = "CoilAttachment"
			a.Parent = root
			attachment = a
		end
		local force = Instance.new("VectorForce")
		force.Name = "CoilLift"
		force.Attachment0 = attachment
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.ApplyAtCenterOfMass = true
		force.Force = Vector3.new(0, root.AssemblyMass * Workspace.Gravity * (1 - factor), 0)
		force.Parent = root
	end
end

local function ghost(character: Model, seconds: number)
	local saved: { [BasePart]: number } = {}
	for _, part in characterParts(character) do
		saved[part] = part.Transparency
		part.Transparency = math.max(part.Transparency, 0.9)
	end
	local skin = character:FindFirstChild("VeritySkin")
	if skin and skin:IsA("Highlight") then
		skin.Enabled = false
	end
	character:SetAttribute("Invisible", true)
	task.delay(seconds, function()
		for part, value in saved do
			if part.Parent then
				part.Transparency = value
			end
		end
		if skin and skin:IsA("Highlight") and skin.Parent then
			skin.Enabled = true
		end
		character:SetAttribute("Invisible", nil)
	end)
end

local function placeTrap(player: Player, character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	if not inRound() then
		notify(player, "Los cepos solo funcionan durante la ronda.", "warn")
		return
	end
	local list = traps[player] or {}
	traps[player] = list
	for i = #list, 1, -1 do
		if not list[i].Parent then
			table.remove(list, i)
		end
	end
	if #list >= 2 then
		notify(player, "Ya tienes 2 cepos colocados.", "warn")
		return
	end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { character }
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -40, 0), params)
	if not hit then
		return
	end
	local folder = trapFolder
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "Traps"
		f.Parent = Workspace
		trapFolder = f
		folder = f
	end
	local trap = Instance.new("Part")
	trap.Name = "BearTrap"
	trap.Anchored = true
	trap.CanCollide = false
	trap.Size = Vector3.new(3, 0.3, 3)
	trap.Color = Color3.fromRGB(120, 120, 130)
	trap.Material = Enum.Material.Metal
	trap.CFrame = CFrame.new(hit.Position + Vector3.new(0, 0.15, 0))
	for _, z in { -1.2, 1.2 } do
		local jaw = Instance.new("Part")
		jaw.Anchored = true
		jaw.CanCollide = false
		jaw.CanTouch = false
		jaw.Size = Vector3.new(3, 0.5, 0.15)
		jaw.Color = Color3.fromRGB(190, 190, 200)
		jaw.Material = Enum.Material.Metal
		jaw.CFrame = trap.CFrame * CFrame.new(0, 0.3, z)
		jaw.Parent = trap
	end
	trap.Parent = folder
	table.insert(list, trap)

	local sprung = false
	trap.Touched:Connect(function(other)
		if sprung then
			return
		end
		local model = other:FindFirstAncestorOfClass("Model")
		if not model or model == character or not isSurvivorCharacter(model) then
			return
		end
		local victimRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not victimRoot or victimRoot.Anchored then
			return
		end
		sprung = true
		victimRoot.Anchored = true
		Net.get("Effect"):FireAllClients("Trap", trap.Position)
		task.delay(3, function()
			if victimRoot.Parent and victimRoot:GetAttribute("Grabbed") ~= true then
				victimRoot.Anchored = false
			end
			trap:Destroy()
		end)
	end)
	notify(player, "Cepo colocado.", "good")
end

local function push(player: Player, character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local forward = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	forward = if forward.Magnitude > 0 then forward.Unit else Vector3.zAxis
	local function hit(model: Model)
		local targetRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not targetRoot or targetRoot.Anchored then
			return
		end
		local offset = (targetRoot.Position - root.Position) * Vector3.new(1, 0, 1)
		if offset.Magnitude > 12 or offset.Magnitude < 0.01 or offset.Unit:Dot(forward) < 0.3 then
			return
		end
		local velocity = forward * 90 + Vector3.new(0, 35, 0)
		local owner = Players:GetPlayerFromCharacter(model)
		if owner then
			-- el personaje lo simula su cliente: le pedimos que aplique el empujón
			Net.get("Effect"):FireClient(owner, "Knockback", velocity)
		else
			targetRoot.AssemblyLinearVelocity = velocity
		end
	end
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			hit(other.Character)
		end
	end
	for _, inst in Workspace:GetDescendants() do
		if inst:IsA("Model") and inst:GetAttribute("IsBot") then
			hit(inst)
		end
	end
	Net.get("Effect"):FireAllClients("Push", root.Position + forward * 4)
end

local function radar(player: Player, character: Model)
	local targets: { Model } = {}
	if player:GetAttribute("Role") == "Verity" then
		targets = survivorCharacters()
	else
		for _, other in Players:GetPlayers() do
			if other:GetAttribute("Role") == "Verity" and other.Character then
				table.insert(targets, other.Character)
			end
		end
	end
	if #targets == 0 then
		notify(player, "El radar no detecta a nadie.", "info")
		return
	end
	Net.get("Effect"):FireClient(player, "Radar", targets)
end

local function build(player: Player, key: string): Tool?
	local def = defs[key]
	if not def then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = def.Title
	tool.ToolTip = def.Description
	tool.CanBeDropped = false
	tool:SetAttribute("ShopItem", key)
	makeHandle(def).Parent = tool

	local function character(): Model?
		local parent = tool.Parent
		return if parent and parent:IsA("Model") then parent else nil
	end

	tool.Equipped:Connect(function()
		local c = character()
		if not c then
			return
		end
		if key == "SpeedCoil" or key == "FusionCoil" then
			c:SetAttribute("SpeedMult", 1.35)
		end
		if key == "GravityCoil" or key == "FusionCoil" then
			setGravity(c, 0.3)
		end
		if key == "CoinMagnet" then
			c:SetAttribute("CoinMagnet", true)
		end
	end)
	tool.Unequipped:Connect(function()
		-- al desequipar, el Tool ya volvió a la mochila: usamos el personaje del jugador
		local c = player.Character
		if not c then
			return
		end
		if key == "SpeedCoil" or key == "FusionCoil" then
			c:SetAttribute("SpeedMult", nil)
		end
		if key == "GravityCoil" or key == "FusionCoil" then
			setGravity(c, nil)
		end
		if key == "CoinMagnet" then
			c:SetAttribute("CoinMagnet", nil)
		end
		if key == "Flashlight" then
			local beam = tool.Handle:FindFirstChild("Beam")
			if beam and beam:IsA("SpotLight") then
				beam.Enabled = false
			end
		end
	end)
	tool.Activated:Connect(function()
		local c = character()
		if not c then
			return
		end
		local humanoid = c:FindFirstChildOfClass("Humanoid")
		if key == "Medkit" and humanoid and ready(player, key, 20) then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 50)
			Net.get("Effect"):FireClient(player, "Heal", (c:GetPivot()).Position)
		elseif key == "EnergyDrink" and ready(player, key, 30) then
			Movement.energize(player, 6)
			Net.get("Effect"):FireClient(player, "Heal", (c:GetPivot()).Position)
			notify(player, "¡Estamina infinita durante 6 s!", "good")
		elseif key == "Flashlight" then
			local beam = tool.Handle:FindFirstChild("Beam")
			if beam and beam:IsA("SpotLight") then
				beam.Enabled = not beam.Enabled
			end
		elseif key == "GhostCloak" and ready(player, key, 40) then
			ghost(c, 6)
		elseif key == "SoulRadar" and ready(player, key, 30) then
			radar(player, c)
		elseif key == "BearTrap" and ready(player, key, 2) then
			placeTrap(player, c)
		elseif key == "PushHammer" and ready(player, key, 8) then
			push(player, c)
		end
	end)
	return tool
end

-- Da al jugador los objetos que tiene equipados (sin duplicar).
function Items.give(player: Player)
	local data = PlayerData.get(player)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not (data and character and backpack) then
		return
	end
	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("ShopItem") then
				child:Destroy()
			end
		end
	end
	character:SetAttribute("SpeedMult", nil)
	character:SetAttribute("CoinMagnet", nil)
	setGravity(character, nil)
	for _, key in data.equipped do
		if table.find(data.items, key) then
			local tool = build(player, key)
			if tool then
				tool.Parent = backpack
			end
		end
	end
end

function Items.cleanup()
	if trapFolder then
		trapFolder:Destroy()
		trapFolder = nil
	end
	table.clear(traps)
end

function Items.init()
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			-- espera a que la mochila exista y a que los datos estén cargados
			task.wait(0.5)
			local deadline = os.clock() + 20
			while player.Parent and not PlayerData.isLoaded(player) and os.clock() < deadline do
				task.wait(0.5)
			end
			Items.give(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		traps[player] = nil
	end)
end

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Killer</string>
            <string name="Source"><![CDATA[--!strict
-- Verity: transforma al asesino en la criatura (modelo preparado por
-- VerityModel, con la skin equipada) y resuelve el ataque de la tecla Q: agarra a la víctima, la levanta sobre
-- la cabeza y la aplasta contra el suelo, que la hace volar en pedazos.
-- La animación la reproducen los clientes con VerityPose; el servidor usa la
-- misma línea de tiempo para mover a la víctima entre las manos.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Pose = require(ReplicatedStorage.Shared.VerityPose)
local Entity = require(script.Parent.Parent.Lib.Entity)
local VerityModel = require(script.Parent.VerityModel)

export type Context = {
	survivors: () -> { Instance },
	onGrab: (victim: Instance, position: Vector3) -> (), -- la víctima ya cuenta como muerta
	goreParent: Instance,
}

local K = Config.Killer
local BLOOD = Color3.fromRGB(120, 4, 12)

local Killer = {}

local current: Player? = nil
local context: Context? = nil
local released = false
local killing = false
local lastKill = 0
local rig: Pose.RigData? = nil
local ball: Model? = nil
local hiddenParts: { [BasePart]: number } = {}
local cameraOffset = Vector3.zero

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	return Entity.root(player)
end

-- Crea a Verity en `spawn` (CFrame a 3 studs sobre el suelo) y la asigna
-- como personaje del jugador. Queda anclada hasta release().
local function morph(player: Player, spawn: CFrame): Model?
	local skin = player:GetAttribute("Skin")
	local model, data = VerityModel.create(if typeof(skin) == "string" then skin else nil)
	if not (model and data) then
		warn("[Killer] no hay modelo de Verity disponible")
		return nil
	end
	rig = data
	model.Name = player.Name
	local root = model.PrimaryPart :: BasePart
	local floorY = spawn.Position.Y - 3
	local look = spawn.LookVector * Vector3.new(1, 0, 1)
	local facing = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local position = Vector3.new(spawn.Position.X, floorY + data.rootY + 0.1, spawn.Position.Z)
	model:PivotTo(CFrame.lookAt(position, position + facing))
	root.Anchored = true

	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	-- cámara a la altura de la cabeza
	humanoid.CameraOffset = Vector3.new(0, math.max(0, (model:GetAttribute("RigHeight") :: number? or 16) * 0.85 - data.rootY), 0)
	humanoid.WalkSpeed = Config.Movement.VerityWalk
	humanoid.HipHeight = data.hipHeight

	local old = player.Character
	player.Character = model
	model.Parent = Workspace
	if old then
		old:Destroy()
	end
	return model
end

local function bloodPool(position: Vector3, size: number, parent: Instance)
	local pool = Instance.new("Part")
	pool.Name = "BloodPool"
	pool.Anchored = true
	pool.CanCollide = false
	pool.CanQuery = false
	pool.Shape = Enum.PartType.Cylinder
	pool.Color = BLOOD
	pool.Material = Enum.Material.Glass
	pool.Reflectance = 0.12
	pool.Size = Vector3.new(0.06, 0.5, 0.5)
	-- el eje del cilindro es X: se gira para que quede plano en el suelo
	pool.CFrame = CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi, math.rad(90))
	pool.Parent = parent
	TweenService:Create(pool, TweenInfo.new(0.6 + math.random() * 0.6, Enum.EasingStyle.Quint), { Size = Vector3.new(0.06, size, size) }):Play()
end

local function bleedingEmitter(part: BasePart)
	local emitter = Instance.new("ParticleEmitter")
	if Assets.Splash ~= "" then
		emitter.Texture = Assets.Splash
	end
	emitter.Color = ColorSequence.new(Color3.fromRGB(150, 6, 16), Color3.fromRGB(80, 0, 6))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.1) })
	emitter.Transparency = NumberSequence.new(0, 0.8)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Rate = 30
	emitter.Speed = NumberRange.new(1, 4)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Parent = part
	task.delay(1.6, function()
		emitter.Enabled = false
	end)
end

-- Rompe a la víctima en pedazos que salen volando.
local function explode(character: Model, impact: Vector3, parent: Instance)
	for _, inst in character:GetDescendants() do
		if inst:IsA("JointInstance") or inst:IsA("WeldConstraint") or inst:IsA("Motor6D") then
			inst:Destroy()
		end
	end
	for _, inst in character:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.Anchored = false
			-- el servidor simula los pedazos (si no, el cliente de la víctima los congela)
			pcall(inst.SetNetworkOwner, inst, nil)
			inst.CanCollide = inst.Name ~= "HumanoidRootPart"
			if inst.Name == "HumanoidRootPart" then
				inst.Transparency = 1
			end
			local dir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
			dir = if dir.Magnitude > 0.01 then dir.Unit else Vector3.xAxis
			inst.AssemblyLinearVelocity = dir * math.random(25, 55) + Vector3.new(0, math.random(35, 65), 0)
			inst.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
			if inst.Name ~= "HumanoidRootPart" then
				bleedingEmitter(inst)
				if inst.Size.Magnitude > 1 then
					inst.Color = inst.Color:Lerp(BLOOD, 0.35)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end
	-- charcos y salpicaduras en el suelo
	bloodPool(impact + Vector3.new(0, 0.05, 0), 9, parent)
	for _ = 1, 6 do
		local offset = Vector3.new(math.random(-9, 9), 0.04, math.random(-9, 9))
		bloodPool(impact + offset, 1.5 + math.random() * 3, parent)
	end
	Net.get("Effect"):FireAllClients("Gore", impact)
	if not Players:GetPlayerFromCharacter(character) then
		Debris:AddItem(character, 12)
	end
end

local function findVictim(root: BasePart, ctx: Context): Instance?
	local forward = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	forward = if forward.Magnitude > 0 then forward.Unit else Vector3.zAxis
	local best: Instance? = nil
	local bestDistance = K.KillRange
	for _, survivor in ctx.survivors() do
		local targetRoot = Entity.root(survivor)
		local humanoid = Entity.humanoid(survivor)
		if targetRoot and humanoid and humanoid.Health > 0 and targetRoot:GetAttribute("Grabbed") ~= true then
			local offset = (targetRoot.Position - root.Position) * Vector3.new(1, 0, 1)
			local distance = offset.Magnitude
			local facing = if distance > 0.01 then offset.Unit:Dot(forward) else 1
			if distance <= bestDistance and (facing >= K.KillConeDot or distance < 4) then
				best = survivor
				bestDistance = distance
			end
		end
	end
	return best
end

function Killer.tryKill(player: Player)
	local ctx = context
	if player ~= current or not ctx or not released or killing then
		return
	end
	if os.clock() - lastKill < K.KillCooldown then
		return
	end
	local character = player.Character
	local root = rootOf(player)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local data = rig
	if not (character and root and humanoid and data) then
		return
	end
	local victim = findVictim(root, ctx)
	if not victim then
		return
	end
	local victimCharacter = Entity.character(victim)
	local victimRoot = Entity.root(victim)
	if not (victimCharacter and victimRoot) then
		return
	end

	killing = true
	ctx.onGrab(victim, victimRoot.Position)
	-- el grito suena en la víctima mientras la levanta; la explosión lo corta
	Net.get("Effect"):FireAllClients("Grab", victimRoot)

	-- Verity se queda quieta y de pie mientras dura la animación (si estaba
	-- agachada, se la levanta: el cálculo de las manos parte de los pies).
	local feetY = root.Position.Y - root.Size.Y / 2 - humanoid.HipHeight
	character:SetAttribute("Crouching", false)
	humanoid.HipHeight = data.hipHeight
	root.Anchored = true
	root.CFrame = CFrame.new(root.Position.X, feetY + data.rootY, root.Position.Z) * root.CFrame.Rotation
	local killerCF = root.CFrame
	victimRoot.Anchored = true
	victimRoot:SetAttribute("Grabbed", true) -- un cepo no debe soltarla
	local victimStart = victimRoot.CFrame
	local start = now()
	character:SetAttribute("KillStart", start)

	-- La víctima mira a Verity mientras cuelga de sus manos
	local hangRotation = (killerCF - killerCF.Position) * CFrame.Angles(0, math.pi, 0)
	local origin = CFrame.new(killerCF.Position.X, feetY, killerCF.Position.Z) * killerCF.Rotation

	local connection: RBXScriptConnection
	local impacted = false
	connection = RunService.Heartbeat:Connect(function()
		local t = now() - start
		if not victimRoot.Parent then
			connection:Disconnect()
			return
		end
		if t < Pose.KillImpact then
			local grip = origin:PointToWorldSpace(Pose.gripLocal(t, data))
			local target = CFrame.new(grip - Vector3.new(0, 1.2, 0)) * hangRotation
			local alpha = math.clamp((t - 0.2) / (Pose.KillGrab - 0.2), 0, 1)
			victimRoot.CFrame = victimStart:Lerp(target, alpha * alpha * (3 - 2 * alpha))
		elseif not impacted then
			impacted = true
			connection:Disconnect()
			local grip = origin:PointToWorldSpace(Pose.gripLocal(Pose.KillImpact, data))
			local ground = Vector3.new(grip.X, origin.Position.Y, grip.Z)
			explode(victimCharacter, ground, ctx.goreParent)
		end
	end)

	task.delay(Pose.KillDuration, function()
		if connection.Connected then
			connection:Disconnect()
		end
		if character.Parent then
			character:SetAttribute("KillStart", nil)
			root.Anchored = false
		end
		killing = false
		lastKill = os.clock()
	end)
end

-- La bola sonriente (diseño original de Verity) que espera durante la
-- ventaja inicial. El monstruo ya está en su sitio, pero invisible.
local function spawnBall(character: Model, spawn: CFrame, parent: Instance)
	local template = ServerStorage:FindFirstChild("VerityBall")
	if not (template and template:IsA("Model")) then
		return
	end
	local model = template:Clone()
	local core = model:FindFirstChild("Core")
	if core and core:IsA("BasePart") then
		model.PrimaryPart = core
	end
	local floorY = spawn.Position.Y - 3
	local look = spawn.LookVector * Vector3.new(1, 0, 1)
	local facing = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local center = Vector3.new(spawn.Position.X, floorY + 3.6, spawn.Position.Z)
	model:PivotTo(CFrame.lookAt(center, center + facing))
	model.Name = "VerityBall"
	model:SetAttribute("Owner", character.Name)
	game:GetService("CollectionService"):AddTag(model, "VerityBall")
	model.Parent = parent
	ball = model

	-- el monstruo queda invisible hasta la transformación
	table.clear(hiddenParts)
	for _, inst in character:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
			hiddenParts[inst] = inst.Transparency
			inst.Transparency = 1
		elseif inst:IsA("Highlight") or inst:IsA("ParticleEmitter") then
			inst.Enabled = false
		elseif inst:IsA("Decal") or inst:IsA("SurfaceGui") then
			if inst:IsA("SurfaceGui") then
				inst.Enabled = false
			else
				inst.Transparency = 1
			end
		end
	end
	-- cámara a la altura de la bola
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and rig then
		cameraOffset = humanoid.CameraOffset
		humanoid.CameraOffset = Vector3.new(0, 4 - rig.rootY, 0)
	end
end

function Killer.setup(player: Player, spawn: CFrame, ctx: Context)
	current = player
	context = ctx
	released = false
	killing = false
	local character = morph(player, spawn)
	if character then
		spawnBall(character, spawn, ctx.goreParent)
	end
end

-- La bola se retuerce (huesos crujiendo) y se convierte en el monstruo.
-- Los clientes animan la bola con TransformStart; aquí se revela el
-- monstruo poco a poco y se libera al terminar.
function Killer.release()
	local player = current
	if not player then
		return
	end
	local character = player.Character
	local root = rootOf(player)
	local duration = Config.Round.TransformTime
	local start = now()
	local ballModel = ball
	if ballModel then
		ballModel:SetAttribute("TransformStart", start)
	end
	if character then
		character:SetAttribute("TransformStart", start)
	end
	Net.get("Effect"):FireAllClients("Transform", if root then root.Position else Vector3.zero)

	task.spawn(function()
		local steps = 14
		local revealFrom = duration * 0.35
		task.wait(revealFrom)
		for i = 1, steps do
			local alpha = i / steps
			for part, base in hiddenParts do
				if part.Parent then
					part.Transparency = 1 - (1 - base) * alpha
				end
			end
			task.wait((duration - revealFrom) / steps)
		end
		if character and character.Parent then
			for _, inst in character:GetDescendants() do
				if inst:IsA("Highlight") or inst:IsA("ParticleEmitter") or inst:IsA("SurfaceGui") then
					inst.Enabled = true
				elseif inst:IsA("Decal") then
					inst.Transparency = 0
				end
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.CameraOffset = cameraOffset
			end
			character:SetAttribute("TransformStart", nil)
			character:SetAttribute("Released", true)
		end
		if ballModel then
			ballModel:Destroy()
		end
		ball = nil
		table.clear(hiddenParts)
		if root and root.Parent then
			root.Anchored = false
		end
		released = true
	end)
end

function Killer.current(): Player?
	return current
end

function Killer.isKilling(): boolean
	return killing
end

function Killer.cleanup()
	if ball then
		ball:Destroy()
		ball = nil
	end
	table.clear(hiddenParts)
	rig = nil
	current = nil
	context = nil
	released = false
	killing = false
end

function Killer.init()
	Players.PlayerRemoving:Connect(function(player)
		if player == current then
			current = nil
		end
	end)
end

return Killer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby: coloca el modelo real de Verity en el pedestal (mirando al spawn)
-- y gestiona el obby: la lava te devuelve al inicio y el cofre de la meta
-- da monedas (con espera entre premios).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Coins = require(script.Parent.Coins)
local VerityModel = require(script.Parent.VerityModel)

local Lobby = {}

local lastReward: { [Player]: number } = {}
local lastLava: { [Player]: number } = {}

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return if model then Players:GetPlayerFromCharacter(model) else nil
end

local function placeStatue(lobby: Instance)
	local statue = lobby:FindFirstChild("VerityStatue")
	local spot = statue and statue:FindFirstChild("StatueSpot")
	if not (statue and spot and spot:IsA("BasePart")) then
		return
	end
	if VerityModel.source() == "ServerStorage.VerityFallback" then
		return -- la estatua de piezas ya es ese mismo modelo
	end
	local model = VerityModel.statue()
	if not model then
		return
	end
	for _, child in statue:GetChildren() do
		if child:GetAttribute("StatueBody") then
			child:Destroy()
		end
	end
	local rootY = (model:GetAttribute("RootY") :: number?) or 8
	-- StatueSpot está girado 180°: el modelo (que mira a -Z) queda mirando al spawn
	model:PivotTo(spot.CFrame * CFrame.new(0, rootY, 0))
	model.Name = "VerityModel"
	model.Parent = statue
end

local function setupObby(lobby: Instance)
	local obby = lobby:FindFirstChild("Obby")
	if not obby then
		return
	end
	local start = obby:FindFirstChild("ObbyStart") :: BasePart?
	local spawnPoint = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
	for _, part in obby:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		if part:GetAttribute("ObbyLava") then
			part.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				local character = player and player.Character
				if not (player and character and start) then
					return
				end
				if os.clock() - (lastLava[player] or 0) < 0.5 then
					return
				end
				lastLava[player] = os.clock()
				character:PivotTo(start.CFrame + Vector3.new(0, 4, 0))
			end)
		elseif part:GetAttribute("ObbyGoal") then
			part.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				local character = player and player.Character
				if not (player and character) then
					return
				end
				local now = os.clock()
				local wait = Config.Coins.ObbyCooldown - (now - (lastReward[player] or -math.huge))
				if wait > 0 then
					return
				end
				lastReward[player] = now
				Coins.award(player, Config.Coins.ObbyReward, "obby completado")
				if spawnPoint then
					character:PivotTo(spawnPoint.CFrame + Vector3.new(0, 4, 0))
				end
			end)
		end
	end
end

function Lobby.start()
	local lobby = Workspace:WaitForChild("Lobby", 10)
	if not lobby then
		return
	end
	placeStatue(lobby)
	setupObby(lobby)
	Players.PlayerRemoving:Connect(function(player)
		lastReward[player] = nil
		lastLava[player] = nil
	end)
end

return Lobby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby, mapas y ambientación.
--
-- Los mapas viven en Workspace/Maps para poder verlos y editarlos en Studio;
-- al iniciar, el servidor los mueve a ServerStorage/Maps y clona uno por ronda.
-- Cada mapa es un Model con:
--   SurvivorSpawns (Folder de Parts), KillerSpawn (Part),
--   GoldSpawns (Folder de Parts), CraftingTables (Folder de Parts: la mesa
--   se coloca encima de cada Part). Si no hay ninguno, se genera una mansión.

local Lighting = game:GetService("Lighting")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

export type MapInfo = {
	model: Model,
	name: string,
	survivorSpawns: { CFrame },
	killerSpawn: CFrame,
	goldSpawns: { Vector3 },
	tableSpots: { CFrame },
	outdoor: boolean, -- mapas al aire libre de noche (atributo Outdoor del modelo)
}

local LOBBY_HEIGHT = 300
local CELL = 40
local GRID = 4
local WALL_HEIGHT = 24
local DOOR_WIDTH = 12
local DOOR_TOP = 18 -- Verity mide ~16 studs

local MapService = {}

local lobbySpawn: CFrame = CFrame.new(0, LOBBY_HEIGHT + 4, 0)
local rng = Random.new()

local function part(props: { [string]: any }, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function buildLobby(): Model
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"

	local y = LOBBY_HEIGHT
	part({ Name = "Floor", Size = Vector3.new(90, 2, 90), CFrame = CFrame.new(0, y, 0), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(92, 64, 51) }, lobby)
	part({ Name = "Rug", Size = Vector3.new(30, 0.2, 30), CFrame = CFrame.new(0, y + 1.1, 0), Material = Enum.Material.Fabric, Color = Color3.fromRGB(110, 22, 32) }, lobby)
	for i = 0, 3 do
		local angle = math.rad(i * 90)
		local cf = CFrame.new(0, y, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 7, -45)
		part({ Name = "Wall", Size = Vector3.new(90, 12, 2), CFrame = cf, Material = Enum.Material.Brick, Color = Color3.fromRGB(60, 46, 58) }, lobby)
	end
	for _, x in { -30, 30 } do
		for _, z in { -30, 30 } do
			local lamp = part({ Name = "Lamp", Size = Vector3.new(1.5, 1.5, 1.5), Shape = Enum.PartType.Ball, CFrame = CFrame.new(x, y + 10, z), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 196, 120), CanCollide = false }, lobby)
			local light = Instance.new("PointLight")
			light.Range = 40
			light.Brightness = 1.4
			light.Color = Color3.fromRGB(255, 200, 140)
			light.Parent = lamp
		end
	end

	-- Cartel con el nombre del juego
	local sign = part({ Name = "Sign", Size = Vector3.new(36, 9, 1), CFrame = CFrame.new(0, y + 7, -43.5), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(20, 14, 20) }, lobby)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 30
	surface.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "MURDER MYSTERY\nbut <font color=\"#ff3b4e\">VERITY</font>"
	label.RichText = true
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = surface

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, y + 1.5, 10)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = lobby

	lobby.Parent = Workspace
	return lobby
end

function MapService.ensureLobby()
	local lobby = Workspace:FindFirstChild("Lobby") or buildLobby()
	local spawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		lobbySpawn = spawn.CFrame + Vector3.new(0, 3, 0)
	end
	-- Solo el lobby debe ser punto de aparición.
	for _, inst in Workspace:GetDescendants() do
		if inst:IsA("SpawnLocation") and not inst:IsDescendantOf(lobby) then
			inst.Enabled = false
		end
	end
end

function MapService.lobbyCFrame(): CFrame
	return lobbySpawn * CFrame.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
end

-- Mansión procedural ---------------------------------------------------------

local WALL_COLOR = Color3.fromRGB(70, 58, 72)
local FLOOR_COLOR = Color3.fromRGB(78, 54, 44)

local function wallWithDoor(parent: Instance, from: Vector3, to: Vector3)
	local dir = to - from
	local length = dir.Magnitude
	local unit = dir.Unit
	local look = CFrame.lookAt(Vector3.zero, unit)

	-- 15% sin pared (habitación abierta), resto con 1 puerta (a veces 2)
	if rng:NextNumber() < 0.15 then
		return
	end
	local doors = if rng:NextNumber() < 0.3 then 2 else 1
	local gaps: { number } = {}
	if doors == 1 then
		table.insert(gaps, rng:NextNumber(DOOR_WIDTH, length - DOOR_WIDTH))
	else
		table.insert(gaps, rng:NextNumber(DOOR_WIDTH * 0.75, length / 2 - DOOR_WIDTH * 0.75))
		table.insert(gaps, rng:NextNumber(length / 2 + DOOR_WIDTH * 0.75, length - DOOR_WIDTH * 0.75))
	end

	local cursor = 0
	local function segment(a: number, b: number)
		if b - a < 0.5 then
			return
		end
		local mid = from + unit * ((a + b) / 2)
		part({
			Name = "Wall",
			Size = Vector3.new(1.5, WALL_HEIGHT, b - a),
			CFrame = CFrame.new(mid + Vector3.new(0, WALL_HEIGHT / 2, 0)) * look,
			Material = Enum.Material.Plaster,
			Color = WALL_COLOR,
		}, parent)
	end
	for _, center in gaps do
		segment(cursor, center - DOOR_WIDTH / 2)
		-- dintel sobre la puerta
		local mid = from + unit * center
		part({
			Name = "Lintel",
			Size = Vector3.new(1.5, WALL_HEIGHT - DOOR_TOP, DOOR_WIDTH),
			CFrame = CFrame.new(mid + Vector3.new(0, DOOR_TOP + (WALL_HEIGHT - DOOR_TOP) / 2, 0)) * look,
			Material = Enum.Material.Plaster,
			Color = WALL_COLOR,
		}, parent)
		cursor = center + DOOR_WIDTH / 2
	end
	segment(cursor, length)
end

local FURNITURE = {
	{ size = Vector3.new(6, 4, 3), color = Color3.fromRGB(101, 67, 45), material = Enum.Material.Wood }, -- cómoda
	{ size = Vector3.new(4, 9, 2), color = Color3.fromRGB(84, 56, 40), material = Enum.Material.Wood }, -- estantería
	{ size = Vector3.new(4, 4, 4), color = Color3.fromRGB(140, 104, 66), material = Enum.Material.WoodPlanks }, -- caja
	{ size = Vector3.new(8, 3, 4), color = Color3.fromRGB(96, 30, 40), material = Enum.Material.Fabric }, -- sofá
}

local function buildMansion(): MapInfo
	local model = Instance.new("Model")
	model.Name = "Mansión de Verity"
	local half = CELL * GRID / 2

	part({ Name = "Floor", Size = Vector3.new(CELL * GRID, 2, CELL * GRID), CFrame = CFrame.new(0, -1, 0), Material = Enum.Material.WoodPlanks, Color = FLOOR_COLOR }, model)
	-- Muros exteriores
	for i = 0, 3 do
		local cf = CFrame.Angles(0, math.rad(i * 90), 0) * CFrame.new(0, WALL_HEIGHT / 2, -half)
		part({ Name = "OuterWall", Size = Vector3.new(CELL * GRID + 2, WALL_HEIGHT, 2), CFrame = cf, Material = Enum.Material.Brick, Color = Color3.fromRGB(52, 40, 50) }, model)
	end
	part({ Name = "Ceiling", Size = Vector3.new(CELL * GRID, 1, CELL * GRID), CFrame = CFrame.new(0, WALL_HEIGHT + 0.5, 0), Material = Enum.Material.Plaster, Color = Color3.fromRGB(30, 24, 32) }, model)

	-- Paredes interiores con puertas
	for i = 1, GRID - 1 do
		local c = -half + i * CELL
		for j = 0, GRID - 1 do
			local a = -half + j * CELL
			wallWithDoor(model, Vector3.new(c, 0, a), Vector3.new(c, 0, a + CELL))
			wallWithDoor(model, Vector3.new(a, 0, c), Vector3.new(a + CELL, 0, c))
		end
	end

	local centers: { Vector3 } = {}
	local blocked: { Vector3 } = {}
	for gx = 0, GRID - 1 do
		for gz = 0, GRID - 1 do
			local center = Vector3.new(-half + (gx + 0.5) * CELL, 0, -half + (gz + 0.5) * CELL)
			table.insert(centers, center)

			-- Lámpara por habitación
			local lamp = part({ Name = "Lamp", Size = Vector3.new(2, 0.6, 2), CFrame = CFrame.new(center + Vector3.new(0, WALL_HEIGHT - 0.4, 0)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 170, 110), CanCollide = false }, model)
			local light = Instance.new("PointLight")
			light.Range = 26
			light.Brightness = 0.9
			light.Color = Color3.fromRGB(255, 170, 120)
			light.Shadows = true
			light.Parent = lamp
			lamp:SetAttribute("Flicker", rng:NextNumber() < 0.35)
			lamp:AddTag("MansionLamp")

			-- Muebles cerca de las paredes para tener cobertura
			for _ = 1, rng:NextInteger(1, 3) do
				local f = FURNITURE[rng:NextInteger(1, #FURNITURE)]
				local offset = Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(-14, 14))
				if offset.Magnitude > 7 then
					local pos = center + offset + Vector3.new(0, f.size.Y / 2, 0)
					part({ Name = "Furniture", Size = f.size, CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(rng:NextInteger(0, 3) * 90), 0), Material = f.material, Color = f.color }, model)
					table.insert(blocked, pos)
				end
			end
		end
	end

	local function freeSpot(center: Vector3): Vector3
		for _ = 1, 12 do
			local p = center + Vector3.new(rng:NextNumber(-15, 15), 0, rng:NextNumber(-15, 15))
			local ok = true
			for _, b in blocked do
				if (Vector3.new(b.X, 0, b.Z) - p).Magnitude < 6 then
					ok = false
					break
				end
			end
			if ok then
				return p
			end
		end
		return center
	end

	-- Mesas: en habitaciones distintas, lejos del centro del mapa
	local shuffled = table.clone(centers)
	for i = #shuffled, 2, -1 do
		local j = rng:NextInteger(1, i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	local tableSpots: { CFrame } = {}
	for _, c in shuffled do
		if #tableSpots >= 3 then
			break
		end
		if c.Magnitude > CELL * 0.8 then
			local spot = freeSpot(c)
			table.insert(blocked, spot)
			table.insert(tableSpots, CFrame.new(spot) * CFrame.Angles(0, math.rad(rng:NextInteger(0, 3) * 90), 0))
		end
	end

	local goldSpawns: { Vector3 } = {}
	for _, c in centers do
		for _ = 1, 2 do
			table.insert(goldSpawns, freeSpot(c) + Vector3.new(0, 1.6, 0))
		end
	end

	local survivorSpawns: { CFrame } = {}
	for _, c in centers do
		if c.Magnitude > CELL then
			table.insert(survivorSpawns, CFrame.new(freeSpot(c) + Vector3.new(0, 3, 0)))
		end
	end

	-- Verity aparece en una de las habitaciones centrales
	local killerSpawn = CFrame.new(freeSpot(centers[GRID + 2]) + Vector3.new(0, 3, 0))

	model.Parent = Workspace
	return {
		model = model,
		name = model.Name,
		outdoor = false,
		survivorSpawns = survivorSpawns,
		killerSpawn = killerSpawn,
		goldSpawns = goldSpawns,
		tableSpots = tableSpots,
	}
end

local function loadCustomMap(template: Model): MapInfo?
	local model = template:Clone()
	local function cframes(folderName: string): { CFrame }
		local list = {}
		local folder = model:FindFirstChild(folderName)
		if folder then
			for _, child in folder:GetChildren() do
				if child:IsA("BasePart") then
					child.Transparency = 1
					child.CanCollide = false
					-- se usa la base de la Part (a ras de suelo)
					table.insert(list, child.CFrame - Vector3.new(0, child.Size.Y / 2, 0))
				end
			end
		end
		return list
	end
	local survivors = cframes("SurvivorSpawns")
	local gold = cframes("GoldSpawns")
	local tables = cframes("CraftingTables")
	local killer = model:FindFirstChild("KillerSpawn")
	if #survivors == 0 or #gold == 0 or #tables == 0 or not (killer and killer:IsA("BasePart")) then
		warn(`[MapService] el mapa {template.Name} no tiene la estructura requerida; se usa la mansión`)
		model:Destroy()
		return nil
	end
	killer.Transparency = 1
	killer.CanCollide = false
	local goldPositions = {}
	for _, cf in gold do
		table.insert(goldPositions, cf.Position + Vector3.new(0, 1.6, 0))
	end
	model.Parent = Workspace
	local spawnsUp = {}
	for _, cf in survivors do
		table.insert(spawnsUp, cf + Vector3.new(0, 3, 0))
	end
	return {
		model = model,
		name = template.Name,
		outdoor = template:GetAttribute("Outdoor") == true,
		survivorSpawns = spawnsUp,
		killerSpawn = killer.CFrame + Vector3.new(0, 3 - killer.Size.Y / 2, 0),
		goldSpawns = goldPositions,
		tableSpots = tables,
	}
end

function MapService.load(): MapInfo
	local maps = ServerStorage:FindFirstChild("Maps")
	if maps then
		local options = {}
		for _, child in maps:GetChildren() do
			if child:IsA("Model") then
				table.insert(options, child)
			end
		end
		if #options > 0 then
			local info = loadCustomMap(options[rng:NextInteger(1, #options)])
			if info then
				return info
			end
		end
	end
	return buildMansion()
end

-- Ambientación ----------------------------------------------------------------

-- Tres ambientes cinematográficos: lobby (atardecer cálido), interiores de
-- noche (oscuro, frío, contraste alto) y exteriores de noche (luna y niebla).
-- Con Lighting.Technology = Future (en default.project.json) las luces de
-- cada habitación proyectan sombras reales.
type Preset = {
	lighting: { [string]: any },
	atmosphere: { [string]: any },
	color: { [string]: any },
	bloom: { [string]: any },
	dof: { [string]: any },
	rays: number,
}

local PRESETS: { [string]: Preset } = {
	Lobby = {
		lighting = { ClockTime = 18.6, Brightness = 1.6, ExposureCompensation = 0, Ambient = Color3.fromRGB(70, 58, 66), OutdoorAmbient = Color3.fromRGB(110, 90, 110) },
		atmosphere = { Density = 0.28, Offset = 0.1, Color = Color3.fromRGB(199, 160, 180), Decay = Color3.fromRGB(110, 80, 110), Glare = 0.4, Haze = 1.2 },
		color = { Brightness = 0, Contrast = 0.1, Saturation = 0.05, TintColor = Color3.fromRGB(255, 240, 228) },
		bloom = { Intensity = 0.6, Size = 24, Threshold = 1.4 },
		dof = { FarIntensity = 0.12, FocusDistance = 45, InFocusRadius = 50, NearIntensity = 0 },
		rays = 0.06,
	},
	Indoor = {
		lighting = { ClockTime = 0, Brightness = 0.2, ExposureCompensation = -0.15, Ambient = Color3.fromRGB(20, 16, 26), OutdoorAmbient = Color3.fromRGB(16, 14, 22) },
		atmosphere = { Density = 0.42, Offset = 0, Color = Color3.fromRGB(40, 32, 48), Decay = Color3.fromRGB(18, 14, 24), Glare = 0, Haze = 2.2 },
		color = { Brightness = -0.02, Contrast = 0.2, Saturation = -0.25, TintColor = Color3.fromRGB(225, 230, 255) },
		bloom = { Intensity = 0.9, Size = 30, Threshold = 1.2 },
		dof = { FarIntensity = 0.35, FocusDistance = 25, InFocusRadius = 32, NearIntensity = 0 },
		rays = 0,
	},
	Outdoor = {
		lighting = { ClockTime = 0.3, Brightness = 0.7, ExposureCompensation = -0.1, Ambient = Color3.fromRGB(24, 27, 40), OutdoorAmbient = Color3.fromRGB(44, 50, 74) },
		atmosphere = { Density = 0.38, Offset = 0.05, Color = Color3.fromRGB(80, 92, 122), Decay = Color3.fromRGB(28, 32, 52), Glare = 0.2, Haze = 2.6 },
		color = { Brightness = -0.01, Contrast = 0.16, Saturation = -0.3, TintColor = Color3.fromRGB(210, 222, 255) },
		bloom = { Intensity = 1, Size = 32, Threshold = 1.1 },
		dof = { FarIntensity = 0.3, FocusDistance = 30, InFocusRadius = 45, NearIntensity = 0 },
		rays = 0,
	},
}

local function effect(className: string, name: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

local function apply(target: Instance, props: { [string]: any })
	for k, v in props do
		(target :: any)[k] = v
	end
end

function MapService.setAtmosphere(inRound: boolean, outdoor: boolean?)
	local preset = PRESETS[if not inRound then "Lobby" elseif outdoor then "Outdoor" else "Indoor"]
	apply(Lighting, preset.lighting)
	apply(effect("Atmosphere", "CinematicAtmosphere"), preset.atmosphere)
	apply(effect("ColorCorrectionEffect", "CinematicGrade"), preset.color)
	apply(effect("BloomEffect", "CinematicBloom"), preset.bloom)
	apply(effect("DepthOfFieldEffect", "CinematicDepth"), preset.dof)
	local rays = effect("SunRaysEffect", "CinematicRays") :: SunRaysEffect
	rays.Intensity = preset.rays
	rays.Spread = 0.6
	local sky = effect("Sky", "NightSky") :: Sky
	sky.StarCount = 3000
	sky.MoonAngularSize = 14
	sky.CelestialBodiesShown = true
end

-- Mueve los mapas visibles en el editor fuera de Workspace.
local function stashMaps()
	local source = Workspace:FindFirstChild("Maps")
	if not source then
		return
	end
	local target = ServerStorage:FindFirstChild("Maps")
	if not target then
		target = Instance.new("Folder")
		target.Name = "Maps"
		target.Parent = ServerStorage
	end
	for _, child in source:GetChildren() do
		child.Parent = target
	end
	source:Destroy()
end

function MapService.init()
	stashMaps()
	MapService.ensureLobby()
	MapService.setAtmosphere(false)
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Pases de juego (multiplicador permanente de probabilidad) y productos
-- consumibles (Poción de Verity).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local PlayerData = require(script.Parent.PlayerData)

local Monetization = {}

local function refreshPasses(player: Player)
	local best = 1
	for _, pass in Config.GamePasses do
		local owned = false
		if pass.Id ~= 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			owned = ok and result == true
		end
		player:SetAttribute("Pass_" .. pass.Key, owned)
		if owned then
			best = math.max(best, pass.Multiplier)
		end
	end
	player:SetAttribute("PassMultiplier", best)
	PlayerData.setPassMultiplier(player, best)
end

local function findProduct(productId: number)
	for _, product in Config.Products do
		if product.Id == productId then
			return product
		end
	end
	return nil
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = findProduct(receipt.ProductId)
	if not player or not product or not PlayerData.isLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if player:GetAttribute("DataUnsaved") then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if PlayerData.grantProduct(player, receipt.PurchaseId, product.Multiplier, product.Rounds) then
		Net.get("Notify"):FireClient(player, `{product.Title} activada: x{product.Multiplier} en tus próximas {product.Rounds} ronda(s).`, "good")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function Monetization.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.Id == passId then
				refreshPasses(player)
				Net.get("Notify"):FireClient(player, `¡{pass.Title} activado!`, "good")
				return
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		-- Espera a que PlayerData cargue para que el multiplicador cuente.
		local deadline = os.clock() + 30
		while player.Parent and not PlayerData.isLoaded(player) and os.clock() < deadline do
			task.wait(0.25)
		end
		if player.Parent then
			refreshPasses(player)
		end
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(refreshPasses, player)
	end
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- Velocidades autoritativas en el servidor.
--   Shift: correr (supervivientes con estamina; Verity sin límite y más rápida)
--   C:     agacharse (solo Verity)
--   Q:     atrapar (solo Verity, lo resuelve Killer)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Killer = require(script.Parent.Killer)

local M = Config.Movement
local MAX_ACTIONS_PER_SECOND = 15

type State = {
	sprint: boolean,
	crouch: boolean,
	stamina: number,
	lastDrain: number,
	energizedUntil: number,
	actions: number,
	window: number,
}

local Movement = {}

local states: { [Player]: State } = {}

local function state(player: Player): State
	local s = states[player]
	if not s then
		s = { sprint = false, crouch = false, stamina = M.StaminaMax, lastDrain = 0, energizedUntil = 0, actions = 0, window = os.clock() }
		states[player] = s
	end
	return s
end

local function onAction(player: Player, action: unknown, value: unknown)
	local s = state(player)
	local clock = os.clock()
	if clock - s.window > 1 then
		s.window = clock
		s.actions = 0
	end
	s.actions += 1
	if s.actions > MAX_ACTIONS_PER_SECOND then
		return
	end

	local role = player:GetAttribute("Role")
	if action == "Sprint" and typeof(value) == "boolean" then
		s.sprint = value
	elseif action == "Crouch" and typeof(value) == "boolean" then
		s.crouch = value and role == "Verity"
	elseif action == "Kill" and role == "Verity" then
		Killer.tryKill(player)
	end
end

local function update(dt: number)
	local clock = os.clock()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not (character and humanoid) or humanoid.Health <= 0 then
			continue
		end
		local s = state(player)
		local role = player:GetAttribute("Role")
		local moving = humanoid.MoveDirection.Magnitude > 0.1
		-- bobinas de velocidad (las pone Items en el personaje)
		local mult = (character:GetAttribute("SpeedMult") :: number?) or 1
		local energized = clock < s.energizedUntil

		if role == "Verity" then
			local busy = Killer.isKilling()
			if busy then
				s.crouch = false
				humanoid.WalkSpeed = 0
			else
				local speed = if s.crouch then M.VerityCrouch elseif s.sprint then M.VeritySprint else M.VerityWalk
				humanoid.WalkSpeed = speed * mult
				local stand = (character:GetAttribute("HipHeightStand") :: number?) or humanoid.HipHeight
				local drop = (character:GetAttribute("CrouchDrop") :: number?) or 0
				humanoid.HipHeight = if s.crouch then stand - drop else stand
			end
			if character:GetAttribute("Crouching") ~= s.crouch then
				character:SetAttribute("Crouching", s.crouch)
			end
		elseif role == "Survivor" then
			if energized then
				s.stamina = M.StaminaMax
			end
			if s.sprint and moving and s.stamina > 0 then
				if not energized then
					s.stamina = math.max(0, s.stamina - M.StaminaDrain * dt)
				end
				s.lastDrain = clock
				humanoid.WalkSpeed = M.SurvivorSprint * mult
			else
				if clock - s.lastDrain > M.StaminaRegenDelay then
					s.stamina = math.min(M.StaminaMax, s.stamina + M.StaminaRegen * dt)
				end
				humanoid.WalkSpeed = M.SurvivorWalk * mult
			end
		else
			-- lobby: correr libre
			s.stamina = M.StaminaMax
			humanoid.WalkSpeed = (if s.sprint then M.SurvivorSprint else M.SurvivorWalk) * mult
		end

		local shown = player:GetAttribute("Stamina") :: number?
		local rounded = math.floor(s.stamina + 0.5)
		if shown ~= rounded then
			player:SetAttribute("Stamina", rounded)
		end
	end
end

-- Al empezar una ronda todos arrancan con la estamina llena y de pie.
function Movement.reset(player: Player)
	local s = state(player)
	s.stamina = M.StaminaMax
	s.crouch = false
	s.sprint = false
end

-- Bebida energética: estamina llena e infinita durante `seconds`.
function Movement.energize(player: Player, seconds: number)
	local s = state(player)
	s.stamina = M.StaminaMax
	s.energizedUntil = os.clock() + seconds
end

function Movement.init()
	Net.get("Action").OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

function Movement.start()
	RunService.Heartbeat:Connect(update)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[--!strict
-- Datos persistentes (suerte, pociones, victorias, monedas, objetos y skins)
-- y cálculo de la probabilidad de ser Verity.
--
-- Si el DataStore no está disponible (archivo local sin publicar o sin
-- "Enable Studio Access to API Services"), todo funciona en memoria y se
-- avisa una vez en Output. Antes, el error de GetDataStore detenía el
-- servidor completo.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

export type Data = {
	luck: number,
	boostRounds: number,
	boostMultiplier: number,
	wins: number,
	coins: number,
	items: { string }, -- objetos comprados
	equipped: { string }, -- objetos que se llevan a las rondas
	skins: { string }, -- skins de Verity compradas
	skin: string, -- skin equipada
	receipts: { string },
}

local MAX_STORED_RECEIPTS = 50
local STORE_NAME = "MurderMysteryButVerity_v1"

local PlayerData = {}

local store: DataStore? = nil
local memoryOnly = false
local sessions: { [Player]: Data } = {}
local passMultiplier: { [Player]: number } = {}

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function useMemory(reason: string)
	if not memoryOnly then
		memoryOnly = true
		warn(`[PlayerData] DataStore no disponible ({reason}). Los datos se guardan solo en memoria durante esta sesión.`)
	end
end

local function getStore(): DataStore?
	if memoryOnly then
		return nil
	end
	if store then
		return store
	end
	if game.PlaceId == 0 then
		useMemory("lugar sin publicar")
		return nil
	end
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, STORE_NAME)
	if not ok then
		useMemory(tostring(result))
		return nil
	end
	store = result
	return store
end

-- Errores que no se arreglan reintentando (Studio sin acceso a API, etc.).
local function isPermanent(err: string): boolean
	local lower = string.lower(err)
	return string.find(lower, "publish", 1, true) ~= nil
		or string.find(lower, "studio", 1, true) ~= nil
		or string.find(lower, "403", 1, true) ~= nil
		or string.find(lower, "api", 1, true) ~= nil
end

local function call<T>(fn: (DataStore) -> T): (boolean, T?)
	for attempt = 1, 3 do
		local ds = getStore()
		if not ds then
			return false, nil
		end
		local ok, result = pcall(fn, ds)
		if ok then
			return true, result
		end
		local message = tostring(result)
		if isPermanent(message) then
			useMemory(message)
			return false, nil
		end
		warn(`[PlayerData] intento {attempt} falló: {message}`)
		task.wait(attempt * 2)
	end
	return false, nil
end

local function defaults(): Data
	return {
		luck = 0,
		boostRounds = 0,
		boostMultiplier = 1,
		wins = 0,
		coins = 0,
		items = {},
		equipped = {},
		skins = { "Classic" },
		skin = "Classic",
		receipts = {},
	}
end

local function stringList(raw: any): { string }
	local list = {}
	if typeof(raw) == "table" then
		for _, v in raw do
			if typeof(v) == "string" and not table.find(list, v) then
				table.insert(list, v)
			end
		end
	end
	return list
end

local function sanitize(raw: any): Data
	local data = defaults()
	if typeof(raw) == "table" then
		data.luck = tonumber(raw.luck) or 0
		data.boostRounds = tonumber(raw.boostRounds) or 0
		data.boostMultiplier = tonumber(raw.boostMultiplier) or 1
		data.wins = tonumber(raw.wins) or 0
		data.coins = math.max(0, math.floor(tonumber(raw.coins) or 0))
		data.items = stringList(raw.items)
		data.equipped = stringList(raw.equipped)
		data.skins = stringList(raw.skins)
		if not table.find(data.skins, "Classic") then
			table.insert(data.skins, 1, "Classic")
		end
		data.skin = if typeof(raw.skin) == "string" and table.find(data.skins, raw.skin) then raw.skin else "Classic"
		data.receipts = stringList(raw.receipts)
	end
	return data
end

-- Publica en atributos lo que el cliente necesita mostrar.
local function publish(player: Player)
	local data = sessions[player]
	if not data then
		return
	end
	player:SetAttribute("BoostRounds", data.boostRounds)
	player:SetAttribute("Coins", data.coins)
	player:SetAttribute("OwnedItems", HttpService:JSONEncode(data.items))
	player:SetAttribute("EquippedItems", HttpService:JSONEncode(data.equipped))
	player:SetAttribute("OwnedSkins", HttpService:JSONEncode(data.skins))
	player:SetAttribute("Skin", data.skin)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local wins = leaderstats:FindFirstChild("Victorias")
		if wins and wins:IsA("IntValue") then
			wins.Value = data.wins
		end
		local coins = leaderstats:FindFirstChild("Monedas")
		if coins and coins:IsA("IntValue") then
			coins.Value = data.coins
		end
	end
end
PlayerData.publish = publish

function PlayerData.get(player: Player): Data?
	return sessions[player]
end

function PlayerData.isLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

function PlayerData.isMemoryOnly(): boolean
	return memoryOnly
end

function PlayerData.save(player: Player): boolean
	local data = sessions[player]
	if not data then
		return false
	end
	if memoryOnly then
		return true
	end
	local ok = call(function(ds)
		return ds:UpdateAsync(key(player), function()
			return data
		end)
	end)
	return ok or memoryOnly
end

-- Monedas -----------------------------------------------------------------

function PlayerData.addCoins(player: Player, amount: number)
	local data = sessions[player]
	if data and amount > 0 then
		data.coins += math.floor(amount)
		publish(player)
	end
end

function PlayerData.spendCoins(player: Player, amount: number): boolean
	local data = sessions[player]
	if not data or data.coins < amount then
		return false
	end
	data.coins -= amount
	publish(player)
	return true
end

-- Probabilidad de ser Verity ----------------------------------------------

function PlayerData.setPassMultiplier(player: Player, multiplier: number)
	passMultiplier[player] = multiplier
	PlayerData.refreshChances()
end

function PlayerData.weight(player: Player): number
	local data = sessions[player]
	if not data then
		return 0
	end
	local weight = (1 + data.luck) * (passMultiplier[player] or 1)
	if data.boostRounds > 0 then
		weight *= data.boostMultiplier
	end
	return weight
end

-- Publica en cada jugador su probabilidad actual (0-100) como atributo.
function PlayerData.refreshChances()
	local total = 0
	for player in sessions do
		total += PlayerData.weight(player)
	end
	for player in sessions do
		local chance = if total > 0 then PlayerData.weight(player) / total * 100 else 0
		player:SetAttribute("VerityChance", math.floor(chance * 10 + 0.5) / 10)
	end
end

function PlayerData.pickKiller(candidates: { Player }): Player?
	local total = 0
	for _, player in candidates do
		total += PlayerData.weight(player)
	end
	if total <= 0 then
		return candidates[math.random(1, #candidates)]
	end
	local roll = math.random() * total
	for _, player in candidates do
		roll -= PlayerData.weight(player)
		if roll <= 0 then
			return player
		end
	end
	return candidates[#candidates]
end

-- Se llama al empezar una ronda: el elegido pierde su suerte, el resto gana,
-- y todos los participantes consumen una ronda de poción.
function PlayerData.applyRoundRoles(killer: Player, participants: { Player })
	for _, player in participants do
		local data = sessions[player]
		if data then
			if player == killer then
				data.luck = 0
			else
				data.luck = math.min(data.luck + Config.Chance.LuckPerRound, Config.Chance.MaxLuck)
			end
			if data.boostRounds > 0 then
				data.boostRounds -= 1
				if data.boostRounds == 0 then
					data.boostMultiplier = 1
				end
			end
			publish(player)
		end
	end
	PlayerData.refreshChances()
end

function PlayerData.addWin(player: Player)
	local data = sessions[player]
	if data then
		data.wins += 1
		publish(player)
	end
end

-- Concede un producto de forma idempotente. Devuelve true solo si quedó
-- guardado (o ya estaba concedido); si no, Roblox reintentará el recibo.
function PlayerData.grantProduct(player: Player, receiptId: string, multiplier: number, rounds: number): boolean
	local data = sessions[player]
	if not data then
		return false
	end
	if table.find(data.receipts, receiptId) then
		return true
	end
	local before = table.clone(data)
	before.receipts = table.clone(data.receipts)

	data.boostRounds += rounds
	data.boostMultiplier = math.max(data.boostMultiplier, multiplier)
	table.insert(data.receipts, receiptId)
	while #data.receipts > MAX_STORED_RECEIPTS do
		table.remove(data.receipts, 1)
	end

	if not PlayerData.save(player) then
		sessions[player] = before
		return false
	end
	publish(player)
	PlayerData.refreshChances()
	return true
end

local function onPlayerAdded(player: Player)
	if sessions[player] then
		return
	end
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Monedas"
	coins.Parent = leaderstats
	local wins = Instance.new("IntValue")
	wins.Name = "Victorias"
	wins.Parent = leaderstats
	leaderstats.Parent = player

	local ok, raw = call(function(ds)
		return ds:GetAsync(key(player))
	end)
	if not player.Parent then
		return
	end
	local data = sanitize(if ok then raw else nil)
	if not ok and not memoryOnly then
		-- El DataStore existe pero falló: no guardamos para no pisar datos reales.
		player:SetAttribute("DataUnsaved", true)
	end
	if Config.Testing.Enabled and data.coins < Config.Testing.StartingCoins then
		data.coins = Config.Testing.StartingCoins
	end
	sessions[player] = data
	publish(player)
	PlayerData.refreshChances()
end

local function onPlayerRemoving(player: Player)
	if not player:GetAttribute("DataUnsaved") then
		PlayerData.save(player)
	end
	sessions[player] = nil
	passMultiplier[player] = nil
	PlayerData.refreshChances()
end

function PlayerData.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	game:BindToClose(function()
		if memoryOnly then
			return
		end
		local pending = 0
		for player in sessions do
			if not player:GetAttribute("DataUnsaved") then
				pending += 1
				task.spawn(function()
					PlayerData.save(player)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[--!strict
-- Bucle principal: espera -> intermedio -> partida -> resultados.
-- El estado se replica con atributos de Workspace:
--   Phase, PhaseEndsAt (GetServerTimeNow), Totems, MaxTotems, SurvivorsAlive,
--   MapName, KillerReleaseAt
-- Los supervivientes pueden ser jugadores o NPCs (modo prueba).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Entity = require(script.Parent.Parent.Lib.Entity)
local Bots = require(script.Parent.Bots)
local Coins = require(script.Parent.Coins)
local Crafting = require(script.Parent.Crafting)
local Hiding = require(script.Parent.Hiding)
local Items = require(script.Parent.Items)
local Killer = require(script.Parent.Killer)
local MapService = require(script.Parent.MapService)
local Movement = require(script.Parent.Movement)
local PlayerData = require(script.Parent.PlayerData)

local R = Config.Round
local T = Config.Testing

local Round = {}

local survivors: { [Instance]: boolean } = {} -- Player o NPC -> vivo
local endsAt = 0
local totems = 0
local currentMap: Model? = nil

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function minPlayers(): number
	return if T.Enabled then 1 else R.MinPlayers
end

local function setPhase(phase: string, duration: number?)
	Workspace:SetAttribute("Phase", phase)
	Workspace:SetAttribute("PhaseEndsAt", if duration then now() + duration else 0)
end

local function eligiblePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if PlayerData.isLoaded(player) and player.Character then
			table.insert(list, player)
		end
	end
	return list
end

local function aliveSurvivors(): { Instance }
	local list = {}
	for who, alive in survivors do
		if alive and Entity.exists(who) then
			table.insert(list, who)
		end
	end
	return list
end

local function publishAlive()
	Workspace:SetAttribute("SurvivorsAlive", #aliveSurvivors())
end

local function notifyAll(text: string, kind: string?)
	Net.get("Notify"):FireAllClients(text, kind or "info")
end

local function markDead(who: Instance, position: Vector3?)
	if not survivors[who] then
		return
	end
	survivors[who] = false
	if Hiding.isHidden(who) then
		Hiding.unhide(who, true)
	end
	if who:IsA("Player") then
		who:SetAttribute("Role", "Dead")
	end
	if position then
		Crafting.dropGold(who, position)
	else
		who:SetAttribute("Gold", 0)
	end
	publishAlive()
end

local function onTotem(who: Instance): boolean
	local remaining = endsAt - now()
	if remaining <= R.MinRemainingAfterTotem then
		return false
	end
	endsAt = math.max(now() + R.MinRemainingAfterTotem, endsAt - Config.Crafting.TimeReductionPerTotem)
	totems += 1
	Workspace:SetAttribute("PhaseEndsAt", endsAt)
	Workspace:SetAttribute("Totems", totems)
	notifyAll(`{Entity.name(who)} crafteó un tótem: -{Config.Crafting.TimeReductionPerTotem}s`, "good")
	return true
end

local function waitForPlayers()
	setPhase("Waiting")
	while #eligiblePlayers() < minPlayers() do
		task.wait(1)
	end
end

local function intermission(): boolean
	local duration = if T.Enabled then T.IntermissionTime else R.IntermissionTime
	setPhase("Intermission", duration)
	local deadline = os.clock() + duration
	while os.clock() < deadline do
		if #eligiblePlayers() < minPlayers() then
			return false
		end
		task.wait(0.5)
	end
	return true
end

local function chooseKiller(participants: { Player }): Player?
	if T.Enabled then
		-- modo prueba: el primer jugador del servidor siempre es Verity
		return participants[1]
	end
	return PlayerData.pickKiller(participants)
end

local function playRound()
	local participants = eligiblePlayers()
	local killer = chooseKiller(participants)
	if not killer then
		return
	end
	PlayerData.applyRoundRoles(killer, participants)

	setPhase("Starting")
	local map = MapService.load()
	currentMap = map.model
	MapService.setAtmosphere(true, map.outdoor)
	Workspace:SetAttribute("MapOutdoor", map.outdoor)
	Workspace:SetAttribute("MapName", map.name)
	notifyAll(`Mapa: {map.name}`, "info")

	table.clear(survivors)
	totems = 0
	Workspace:SetAttribute("Totems", 0)
	Workspace:SetAttribute("MaxTotems", Config.Crafting.MaxTotemsPerRound)

	local deathConnections: { RBXScriptConnection } = {}
	local function watchDeath(who: Instance, humanoid: Humanoid, character: Model)
		table.insert(deathConnections, humanoid.Died:Connect(function()
			local root = character:FindFirstChild("HumanoidRootPart")
			markDead(who, if root and root:IsA("BasePart") then root.Position else nil)
		end))
	end

	local spawnIndex = 0
	local function nextSpawn(): CFrame
		spawnIndex = spawnIndex % #map.survivorSpawns + 1
		return map.survivorSpawns[spawnIndex]
	end

	for _, player in participants do
		player:SetAttribute("Gold", 0)
		Movement.reset(player)
		if player == killer then
			player:SetAttribute("Role", "Verity")
		else
			player:SetAttribute("Role", "Survivor")
			survivors[player] = true
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if character and humanoid and humanoid.Health > 0 then
				character:PivotTo(nextSpawn())
				watchDeath(player, humanoid, character)
			else
				survivors[player] = false
				player:SetAttribute("Role", "Dead")
			end
		end
		Net.get("RoleReveal"):FireClient(player, player:GetAttribute("Role"), killer.DisplayName)
	end

	Killer.setup(killer, map.killerSpawn, {
		survivors = aliveSurvivors,
		onGrab = function(victim, position)
			-- si estaba escondida, Verity la saca del escondite (visible y sujeta)
			if Hiding.isHidden(victim) then
				Hiding.unhide(victim, true)
			end
			markDead(victim, position)
			notifyAll(`Verity atrapó a {Entity.name(victim)}`, "bad")
			Coins.award(killer, Config.Coins.RewardKill, "atrapar")
		end,
		goreParent = map.model,
	})
	Items.give(killer)
	-- Si Verity se reinicia o muere, pierde la ronda.
	local killerCharacter = killer.Character
	local killerHumanoid = killerCharacter and killerCharacter:FindFirstChildOfClass("Humanoid")

	-- Monedas por el mapa (antes de crear NPCs para que no caigan encima de ellos)
	local coinPoints: { Vector3 } = {}
	for _, cf in map.survivorSpawns do
		table.insert(coinPoints, cf.Position)
	end
	for _, p in map.goldSpawns do
		table.insert(coinPoints, p)
	end
	Coins.start(map.model, coinPoints)

	-- Escondites (armarios, taquillas, ataúdes...)
	Hiding.start(map.model, {
		isSurvivor = function(who)
			return survivors[who] == true
		end,
	})

	-- NPCs para completar la partida (modo prueba)
	local bots: { Model } = {}
	if T.Enabled and T.Bots > 0 then
		local points: { Vector3 } = {}
		for _, cf in map.survivorSpawns do
			table.insert(points, cf.Position)
		end
		for _, p in map.goldSpawns do
			table.insert(points, p)
		end
		local botCtx = {
			parent = map.model,
			killerRoot = function(): BasePart?
				return Entity.root(killer)
			end,
			killerReleased = function(): boolean
				return (Workspace:GetAttribute("KillerReleaseAt") :: number? or math.huge) <= now()
			end,
			isAlive = function(bot: Model): boolean
				return survivors[bot] == true
			end,
			points = points,
		}
		local spawns = {}
		for _ = 1, T.Bots do
			table.insert(spawns, nextSpawn())
		end
		bots = Bots.spawn(T.Bots, spawns, botCtx)
		for _, bot in bots do
			survivors[bot] = true
			watchDeath(bot, bot:FindFirstChildOfClass("Humanoid") :: Humanoid, bot)
		end
		Bots.startAI(bots, botCtx)
	end
	publishAlive()

	Crafting.start({
		parent = map.model,
		goldSpawns = map.goldSpawns,
		tableSpots = map.tableSpots,
		survivorCount = #aliveSurvivors(),
		isSurvivor = function(who)
			return survivors[who] == true
		end,
		onTotem = onTotem,
		totemsCrafted = function()
			return totems
		end,
	})

	endsAt = now() + R.Duration
	setPhase("Playing")
	Workspace:SetAttribute("PhaseEndsAt", endsAt)
	Workspace:SetAttribute("KillerReleaseAt", now() + R.KillerReleaseDelay)

	local released = false
	local winner: string
	while true do
		task.wait(0.25)
		if not released and (Workspace:GetAttribute("KillerReleaseAt") :: number) <= now() then
			released = true
			Killer.release()
			notifyAll("¡Verity ha sido liberada!", "bad")
		end
		for who, alive in survivors do
			if alive and not Entity.exists(who) then
				markDead(who, nil)
			end
		end
		if not killer.Parent then
			winner = "Survivors"
			notifyAll("Verity abandonó la partida.", "info")
			break
		end
		if killer.Character ~= killerCharacter or not killerHumanoid or killerHumanoid.Health <= 0 then
			winner = "Survivors"
			notifyAll("Verity ha caído.", "info")
			break
		end
		if #aliveSurvivors() == 0 and not Killer.isKilling() then
			winner = "Verity"
			break
		end
		if now() >= endsAt then
			winner = "Survivors"
			break
		end
	end

	-- Resultados
	local survivorNames = {}
	if winner == "Survivors" then
		for _, who in aliveSurvivors() do
			if who:IsA("Player") then
				PlayerData.addWin(who)
				Coins.award(who, Config.Coins.RewardSurvive + Config.Coins.RewardWin, "sobrevivir")
			end
			table.insert(survivorNames, Entity.name(who))
		end
	elseif killer.Parent then
		PlayerData.addWin(killer)
		Coins.award(killer, Config.Coins.RewardWin, "victoria")
	end
	for _, player in participants do
		if player.Parent then
			task.spawn(PlayerData.save, player)
		end
	end
	Net.get("RoundResult"):FireAllClients(winner, killer.DisplayName, survivorNames, totems)
	setPhase("Results", R.ResultsTime)

	for _, c in deathConnections do
		c:Disconnect()
	end
	Bots.stop()
	Crafting.stop()
	Coins.stop()
	Hiding.stop()
	Items.cleanup()
	Killer.cleanup()
	task.wait(R.ResultsTime)

	map.model:Destroy() -- también elimina NPCs y restos
	currentMap = nil
	MapService.setAtmosphere(false)
	Workspace:SetAttribute("MapName", nil)
	Workspace:SetAttribute("MapOutdoor", nil)
	Workspace:SetAttribute("KillerReleaseAt", nil)
	table.clear(survivors)
	for _, player in participants do
		if player.Parent then
			player:SetAttribute("Role", "Lobby")
			player:SetAttribute("Gold", 0)
			-- Devuelve a todos al lobby con su avatar normal.
			task.spawn(function()
				pcall(player.LoadCharacter, player)
			end)
		end
	end
end

function Round.init()
	Workspace:SetAttribute("Totems", 0)
	Workspace:SetAttribute("MaxTotems", Config.Crafting.MaxTotemsPerRound)
	Workspace:SetAttribute("TestMode", T.Enabled)
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("Role", "Lobby")
		player:SetAttribute("Gold", 0)
	end)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Role", "Lobby")
	end
end

function Round.start()
	while true do
		waitForPlayers()
		if intermission() then
			local ok, err = pcall(playRound)
			if not ok then
				warn(`[Round] error en la ronda: {err}`)
				Bots.stop()
				Crafting.stop()
				Coins.stop()
				Hiding.stop()
				Items.cleanup()
				Killer.cleanup()
				MapService.setAtmosphere(false)
				if currentMap then
					currentMap:Destroy()
					currentMap = nil
				end
				for _, player in Players:GetPlayers() do
					player:SetAttribute("Role", "Lobby")
					task.spawn(function()
						pcall(player.LoadCharacter, player)
					end)
				end
				task.wait(3)
			end
		end
	end
end

return Round
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- Compras con monedas: objetos y skins de Verity. El cliente solo pide
-- ("BuyItem", key) / ("EquipItem", key) / ("BuySkin", key) / ("EquipSkin", key);
-- aquí se valida todo (existencia, precio, propiedad, límite de equipados).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Items = require(script.Parent.Items)
local PlayerData = require(script.Parent.PlayerData)

local Shop = {}

local lastRequest: { [Player]: number } = {}

local function find(list: { any }, key: string): any?
	for _, entry in list do
		if entry.Key == key then
			return entry
		end
	end
	return nil
end

local function notify(player: Player, text: string, kind: string?)
	Net.get("Notify"):FireClient(player, text, kind or "info")
end

local function persist(player: Player)
	task.spawn(PlayerData.save, player)
end

local function onRequest(player: Player, action: unknown, key: unknown)
	local now = os.clock()
	if now - (lastRequest[player] or 0) < 0.25 then
		return
	end
	lastRequest[player] = now
	if typeof(action) ~= "string" or typeof(key) ~= "string" then
		return
	end
	local data = PlayerData.get(player)
	if not data then
		return
	end

	if action == "BuyItem" then
		local item = find(Config.Items, key)
		if not item or table.find(data.items, key) then
			return
		end
		if not PlayerData.spendCoins(player, item.Price) then
			notify(player, `Te faltan {item.Price - data.coins} monedas.`, "warn")
			return
		end
		table.insert(data.items, key)
		if #data.equipped < Config.MaxEquipped then
			table.insert(data.equipped, key)
		end
		PlayerData.publish(player)
		Items.give(player)
		notify(player, `Compraste {item.Title}.`, "good")
		persist(player)
	elseif action == "EquipItem" then
		if not table.find(data.items, key) then
			return
		end
		local index = table.find(data.equipped, key)
		if index then
			table.remove(data.equipped, index)
		elseif #data.equipped >= Config.MaxEquipped then
			notify(player, `Solo puedes llevar {Config.MaxEquipped} objetos. Quita uno primero.`, "warn")
			return
		else
			table.insert(data.equipped, key)
		end
		PlayerData.publish(player)
		Items.give(player)
		persist(player)
	elseif action == "BuySkin" then
		local skin = find(Config.Skins, key)
		if not skin or table.find(data.skins, key) then
			return
		end
		if not PlayerData.spendCoins(player, skin.Price) then
			notify(player, `Te faltan {skin.Price - data.coins} monedas.`, "warn")
			return
		end
		table.insert(data.skins, key)
		data.skin = key
		PlayerData.publish(player)
		notify(player, `Skin {skin.Title} comprada y equipada.`, "good")
		persist(player)
	elseif action == "EquipSkin" then
		if not table.find(data.skins, key) then
			return
		end
		data.skin = key
		PlayerData.publish(player)
		persist(player)
	end
end

function Shop.init()
	Net.get("ShopRequest").OnServerEvent:Connect(onRequest)
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">VerityModel</string>
            <string name="Source"><![CDATA[--!strict
-- Prepara el modelo de Verity a partir de cualquier fuente:
--   1. ServerStorage.VerityCharacter  (importado del Toolbox por el usuario)
--   2. InsertService:LoadAsset(Config.Verity.AssetId)
--   3. ServerStorage.VerityFallback   (modelo de respaldo hecho con piezas)
--
-- "Preparar" significa: quitar scripts (los modelos gratis pueden traer
-- virus), asegurar Humanoid y HumanoidRootPart, soldar piezas sueltas,
-- escalar a Config.Verity.Height, medir hombros/codos/manos para la
-- animación del ataque y añadir el punto de agarre para los objetos.

local CollectionService = game:GetService("CollectionService")
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Config = require(ReplicatedStorage.Shared.Config)
local Pose = require(ReplicatedStorage.Shared.VerityPose)
local VerityRig = require(script.Parent.Parent.Lib.VerityRig)

local VerityModel = {}

local template: Model? = nil
local sourceName = "ninguna"

local NAMES = {
	waist = { "Waist" },
	rightShoulder = { "RightShoulder", "Right Shoulder" },
	leftShoulder = { "LeftShoulder", "Left Shoulder" },
	rightElbow = { "RightElbow" },
	leftElbow = { "LeftElbow" },
	rightHip = { "RightHip", "Right Hip" },
	rightKnee = { "RightKnee" },
	rightAnkle = { "RightAnkle" },
}
local HAND_PARTS = { "RightHand", "Right Arm", "RightLowerArm" }
local REMOVE_CLASSES = { "BaseScript", "ModuleScript", "HumanoidDescription", "Tool", "ForceField", "ProximityPrompt", "ClickDetector", "Sound" }
local SCALE_VALUES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale", "BodyProportionScale", "BodyTypeScale" }

local function findMotor(model: Model, names: { string }): Motor6D?
	for _, inst in model:GetDescendants() do
		if inst:IsA("Motor6D") and table.find(names, inst.Name) then
			return inst
		end
	end
	return nil
end

local function verticalExtent(part: BasePart): number
	local cf, half = part.CFrame, part.Size / 2
	return math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z
end

-- Altura más baja y más alta de las piezas (sin contar la raíz).
local function verticalBounds(model: Model, root: BasePart): (number, number)
	local low, high = math.huge, -math.huge
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and inst ~= root then
			local e = verticalExtent(inst)
			low = math.min(low, inst.Position.Y - e)
			high = math.max(high, inst.Position.Y + e)
		end
	end
	if low == math.huge then
		low, high = root.Position.Y - root.Size.Y / 2, root.Position.Y + root.Size.Y / 2
	end
	return low, high
end

-- Suelda a la raíz toda pieza que no esté conectada a ella por uniones.
local function weldLoose(model: Model, root: BasePart)
	local links: { [BasePart]: { BasePart } } = {}
	local function link(a: Instance?, b: Instance?)
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			links[a] = links[a] or {}
			links[b] = links[b] or {}
			table.insert(links[a], b)
			table.insert(links[b], a)
		end
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("JointInstance") then
			link(inst.Part0, inst.Part1)
		elseif inst:IsA("WeldConstraint") then
			link(inst.Part0, inst.Part1)
		end
	end
	local seen: { [BasePart]: boolean } = { [root] = true }
	local queue = { root }
	while #queue > 0 do
		local current = table.remove(queue) :: BasePart
		for _, other in links[current] or {} do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and not seen[inst] then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = inst
			weld.Parent = inst
		end
	end
end

local function prepare(source: Instance): Model?
	local model: Model
	if source:IsA("Model") then
		model = source:Clone()
	else
		local wrapper = Instance.new("Model")
		source:Clone().Parent = wrapper
		model = wrapper
	end
	-- Si el Humanoid está en un submodelo, ese submodelo es el personaje.
	local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
	if humanoid and humanoid.Parent ~= model and humanoid.Parent and humanoid.Parent:IsA("Model") then
		local inner = humanoid.Parent :: Model
		inner.Parent = nil
		model:Destroy()
		model = inner
	end

	-- Seguridad: fuera scripts y cosas que no deben venir con el modelo.
	for _, inst in model:GetDescendants() do
		for _, class in REMOVE_CLASSES do
			if inst:IsA(class) then
				inst:Destroy()
				break
			end
		end
	end

	if model:GetAttribute("VerityRig") and not model:FindFirstChildWhichIsA("Motor6D", true) then
		VerityRig.assemble(model)
	end

	local hasParts = false
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") then
			hasParts = true
			inst.Anchored = false
		end
	end
	if not hasParts then
		model:Destroy()
		return nil
	end

	humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		humanoid = Instance.new("Humanoid")
		humanoid.Parent = model
	end
	local hum = humanoid :: Humanoid
	for _, name in SCALE_VALUES do
		local value = hum:FindFirstChild(name)
		if value then
			value:Destroy()
		end
	end

	local rootInstance = model:FindFirstChild("HumanoidRootPart")
	local root: BasePart
	if rootInstance and rootInstance:IsA("BasePart") then
		root = rootInstance
	else
		local cf, size = model:GetBoundingBox()
		local newRoot = Instance.new("Part")
		newRoot.Name = "HumanoidRootPart"
		newRoot.Size = Vector3.new(math.max(2, size.X * 0.35), math.max(2, size.Y * 0.15), math.max(1, size.Z * 0.35))
		newRoot.CFrame = CFrame.new(cf.Position)
		newRoot.Parent = model
		root = newRoot
	end
	model.PrimaryPart = root
	weldLoose(model, root)

	-- Escala a la altura deseada.
	local low, high = verticalBounds(model, root)
	if high - low > 0.1 then
		model:ScaleTo(model:GetScale() * Config.Verity.Height / (high - low))
	end
	low, high = verticalBounds(model, root)
	local height = high - low

	-- Física: solo la raíz colisiona y tiene masa.
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") then
			local isRoot = inst == root
			inst.CanCollide = isRoot
			inst.Massless = not isRoot
			inst.CanTouch = true
			if isRoot then
				inst.Transparency = 1
			end
		end
	end

	-- Medidas del rig en espacio del modelo (pies en el origen, mirando a -Z).
	local origin = CFrame.new(root.Position.X, low, root.Position.Z) * root.CFrame.Rotation
	local function local_(p: Vector3): Vector3
		return origin:PointToObjectSpace(p)
	end
	local function pivot(motor: Motor6D): Vector3
		return local_(((motor.Part0 :: BasePart).CFrame * motor.C0).Position)
	end
	local function centered(a: Vector3?, b: Vector3?): Vector3?
		if a and b then
			local m = (a + b) / 2
			return Vector3.new(0, m.Y, m.Z)
		end
		local only = a or b
		return if only then Vector3.new(0, only.Y, only.Z) else nil
	end

	local rootY = root.Position.Y - low
	local hipHeight = math.max(0, root.Position.Y - root.Size.Y / 2 - low)
	model:SetAttribute("RigHeight", height)
	model:SetAttribute("RootY", rootY)
	model:SetAttribute("HipHeightStand", hipHeight)

	local rs, ls = findMotor(model, NAMES.rightShoulder), findMotor(model, NAMES.leftShoulder)
	local re, le = findMotor(model, NAMES.rightElbow), findMotor(model, NAMES.leftElbow)
	local handPart: BasePart? = nil
	for _, name in HAND_PARTS do
		local found = model:FindFirstChild(name, true)
		if found and found:IsA("BasePart") then
			handPart = found
			break
		end
	end
	local shoulder = centered(rs and pivot(rs), ls and pivot(ls))
	if shoulder and handPart then
		local grip = local_(handPart.Position - Vector3.new(0, verticalExtent(handPart) * 0.6, 0))
		grip = Vector3.new(0, grip.Y, grip.Z)
		local elbow = centered(re and pivot(re), le and pivot(le)) or grip
		model:SetAttribute("HasArms", true)
		model:SetAttribute("PivotShoulder", shoulder)
		model:SetAttribute("PivotElbow", elbow)
		model:SetAttribute("PivotGrip", grip)
	else
		model:SetAttribute("HasArms", false)
		model:SetAttribute("PivotShoulder", Vector3.new(0, height * 0.72, 0))
	end
	local waist = findMotor(model, NAMES.waist)
	model:SetAttribute("HasWaist", waist ~= nil)
	model:SetAttribute("PivotWaist", if waist then centered(pivot(waist), nil) else Vector3.new(0, rootY, 0))

	-- Agacharse: cuánto baja la cadera y cuánto se doblan las rodillas.
	local hip, knee, ankle = findMotor(model, NAMES.rightHip), findMotor(model, NAMES.rightKnee), findMotor(model, NAMES.rightAnkle)
	if hip and knee then
		local thigh = (pivot(hip) - pivot(knee)).Magnitude
		local shin = if ankle then (pivot(knee) - pivot(ankle)).Magnitude else pivot(knee).Y
		local legs = thigh + shin
		local drop = math.min(legs * 0.45, hipHeight * 0.8)
		model:SetAttribute("CrouchDrop", drop)
		model:SetAttribute("CrouchAngle", math.acos(math.clamp((legs - drop) / legs, -1, 1)))
	else
		model:SetAttribute("CrouchDrop", math.min(height * 0.12, hipHeight * 0.8))
		model:SetAttribute("CrouchAngle", math.rad(30))
	end

	-- Punto de agarre para los objetos de la tienda (Tools).
	local rightHand = model:FindFirstChild("RightHand")
	if not (rightHand and rightHand:IsA("BasePart")) then
		local anchorPart = handPart or root
		local hand = Instance.new("Part")
		hand.Name = "RightHand"
		hand.Size = Vector3.new(0.6, 0.6, 0.6)
		hand.Transparency = 1
		hand.CanCollide = false
		hand.Massless = true
		hand.CFrame = CFrame.new(anchorPart.Position - Vector3.new(0, verticalExtent(anchorPart) * 0.8, 0)) * root.CFrame.Rotation
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = anchorPart
		weld.Part1 = hand
		weld.Parent = hand
		hand.Parent = model
		rightHand = hand
	end
	if not (rightHand :: Instance):FindFirstChild("RightGripAttachment") then
		local attachment = Instance.new("Attachment")
		attachment.Name = "RightGripAttachment"
		attachment.Position = Vector3.new(0, -(rightHand :: BasePart).Size.Y / 2, 0)
		attachment.Parent = rightHand
	end

	hum.RigType = Enum.HumanoidRigType.R15
	hum.AutomaticScalingEnabled = false
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.HipHeight = hipHeight
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = 100
	hum.Health = 100

	model.Name = "Verity"
	model:SetAttribute("VerityRig", true)
	CollectionService:AddTag(model, "VerityRig")
	return model
end

local function tryLoadAsset(id: number): Instance?
	if id == 0 then
		return nil
	end
	local ok, container = pcall(InsertService.LoadAsset, InsertService, id)
	if not ok or not container then
		return nil
	end
	local first = (container :: Instance):FindFirstChildWhichIsA("Model") or (container :: Instance):GetChildren()[1]
	return first
end

local function resolve()
	local candidates: { { name: string, get: () -> Instance? } } = {
		{ name = "ServerStorage.VerityCharacter", get = function()
			return ServerStorage:FindFirstChild("VerityCharacter")
		end },
		{ name = `Toolbox {Config.Verity.AssetId}`, get = function()
			return tryLoadAsset(Config.Verity.AssetId)
		end },
		{ name = "ServerStorage.VerityFallback", get = function()
			return ServerStorage:FindFirstChild("VerityFallback")
		end },
	}
	for _, candidate in candidates do
		local source = candidate.get()
		if source then
			local ok, result = pcall(prepare, source)
			if ok and result then
				template = result
				sourceName = candidate.name
				print(`[VerityModel] usando el modelo de {candidate.name} ({string.format("%.1f", result:GetAttribute("RigHeight") :: number)} studs)`)
				Workspace:SetAttribute("VeritySource", sourceName)
				return
			end
			warn(`[VerityModel] no se pudo preparar {candidate.name}: {result}`)
		end
	end
	warn("[VerityModel] no hay ningún modelo de Verity disponible")
end

local function skinDef(key: string)
	for _, skin in Config.Skins do
		if skin.Key == key then
			return skin
		end
	end
	return Config.Skins[1]
end

function VerityModel.applySkin(model: Model, key: string)
	local skin: any = skinDef(key)
	if skin.Amount <= 0 and not skin.Outline and not skin.Aura and not skin.Ghost then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "VeritySkin"
	highlight.FillColor = skin.Tint
	highlight.FillTransparency = 1 - skin.Amount
	highlight.OutlineColor = skin.Outline or skin.Tint
	highlight.OutlineTransparency = if skin.Outline then 0.15 else 1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	if skin.Ghost then
		for _, inst in model:GetDescendants() do
			if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
				inst.Transparency = math.max(inst.Transparency, 0.45)
			end
		end
	end
	if skin.Aura then
		local root = model.PrimaryPart
		if root then
			local aura = Instance.new("ParticleEmitter")
			aura.Name = "SkinAura"
			aura.Texture = if key == "Bloody" and Assets.Streak ~= "" then Assets.Streak else Assets.GlowOrb
			aura.Color = ColorSequence.new(skin.Aura)
			aura.LightEmission = if key == "Bloody" then 0 else 0.8
			aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
			aura.Transparency = NumberSequence.new(0.2, 1)
			aura.Lifetime = NumberRange.new(0.8, 1.4)
			aura.Rate = if key == "Bloody" then 18 else 10
			aura.Speed = NumberRange.new(1, 3)
			aura.SpreadAngle = Vector2.new(180, 180)
			aura.Acceleration = if key == "Bloody" then Vector3.new(0, -30, 0) else Vector3.new(0, 2, 0)
			aura.Parent = root
		end
	end
end

-- Devuelve un Verity nuevo (sin parent) con la skin aplicada.
function VerityModel.create(skin: string?): (Model?, Pose.RigData?)
	if not template then
		return nil, nil
	end
	local model = template:Clone()
	VerityModel.applySkin(model, skin or "Classic")
	return model, Pose.read(model)
end

-- Copia anclada para la estatua del lobby.
function VerityModel.statue(): Model?
	if not template then
		return nil
	end
	local model = template:Clone()
	CollectionService:RemoveTag(model, "VerityRig")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Destroy()
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.Anchored = true
			inst.CanCollide = false
		end
	end
	return model
end

function VerityModel.source(): string
	return sourceName
end

function VerityModel.init()
	resolve()
end

return VerityModel
